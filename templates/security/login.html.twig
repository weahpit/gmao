{% extends 'loginBase.html.twig' %}

{% block title %}Connexion — CITRAC GMAO{% endblock %}

{% block login_body %}
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-brand">
                <h1 class="login-logo">
                    <img src="{{ asset('images/CITRAC.png') }}" alt="" style="margin-right: 10px;">
                    <span class="fw-light mt-0">Process</span>
                </h1>
                <p class="login-tagline" style="color: #693c28">Stock- GMAO - Logistique - Production</p>

            </div>
            {% if error %}
                <div class="alert alert-danger">
                    <i data-lucide="alert-circle"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            <form method="post" class="login-form">
                <div class="form-group">
                    <label for="username">Identifiant</label>
                    <input type="text" id="inputEmail" name="email" value="{{ last_username }}" class="input" placeholder="Nom d'utilisateur" autocomplete="username" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="inputPassword" name="password" class="input" placeholder="Mot de passe" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" name="_remember_me"> Remember me
                    </label>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
            </form>

            <div class="apk-download" style="margin-top:18px;text-align:center;">
                <a href="{{ asset('downloads/citrac_mobile.apk') }}"
                   download
                   class="btn-apk"
                   style="display:inline-flex;align-items:center;justify-content:center;gap:8px;
                          padding:10px 18px;border-radius:10px;text-decoration:none;
                          background:#693c28;color:#fff;font-weight:600;border:1px solid #58301f;">
                    <i data-lucide="smartphone-nfc"></i>
                    Télécharger l'application Android (APK)
                </a>
                <p style="margin-top:6px;font-size:12px;color:#8a6650;">
                    Version mobile pour Android · installée hors Play Store
                </p>
            </div>

            <div class="login-footer">
                <p>San Pedro, Côte d'Ivoire</p>
            </div>
        </div>
    </div>
{% endblock %}
