{% extends 'loginBase.html.twig' %}

{% block title %}Connexion — CITRAC GMAO{% endblock %}

{% block login_body %}
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-brand">
                <h1 class="login-logo"><img src="{{ asset('images/logo.png') }}" alt="" height="40px" style="margin-right: 10px;">CITRAC</h1>
                <p class="login-tagline" style="color: #693c28">GMAO — Gestion de Maintenance Assistée par Ordinateur</p>
            </div>
            {% if error %}
                <div class="alert alert-danger">
                    <i data-lucide="alert-circle"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                <div class="form-group">
                    <label for="username">Identifiant</label>
                    <input type="text" id="inputEmail" name="email" value="{{ last_username }}" class="input" placeholder="Nom d'utilisateur" autocomplete="username" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="inputPassword" name="password" class="input" placeholder="Mot de passe" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" name="_remember_me"> Remember me
                    </label>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
            </form>

            <div class="login-footer">
                <p>San Pedro, Côte d'Ivoire</p>
            </div>
        </div>
    </div>
{% endblock %}
