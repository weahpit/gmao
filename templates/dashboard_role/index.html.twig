{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord — {{ roleLibelle }}{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('tdb_role') }}">Accueil</a></span>
    <span class="breadcrumb-item">Mon tableau de bord</span>
{% endblock %}

{% block stylesheets %}
<style>
    /* Tableau de bord par role — teintes vives et sobres, non destructif.
       Chaque carte recoit sa propre teinte (variable --tdb-accent), ce qui
       distingue les blocs sans quitter une palette elegante. */
    .tdb-role-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 999px;
        background: var(--tdb-soft, #f3e9df);
        color: var(--tdb-accent, #5a371e);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
    }
    .tdb-role-pill svg { width: 15px; height: 15px; }

    .tdb-roles { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .tdb-chip {
        border: 1px solid #e0d2c4;
        background: #fff;
        color: #7a4c33;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all .15s ease;
    }
    .tdb-chip:hover { border-color: var(--tdb-accent, #a5714f); background: var(--tdb-soft, #fbf6f1); }
    .tdb-chip.active { background: var(--tdb-accent, #5a371e); border-color: var(--tdb-accent, #5a371e); color: #fff; }

    /* Bandeau d'entete : degrade discret de la teinte du tableau de bord */
    .tdb-hero {
        background:
            radial-gradient(1200px 180px at 0% 0%, var(--tdb-soft, #f3e9df) 0%, rgba(255,255,255,0) 70%),
            linear-gradient(180deg, rgba(255,255,255,.6) 0%, rgba(255,255,255,0) 100%);
        border: 1px solid #eceff4;
        border-radius: 16px;
        padding: 16px 18px;
    }
    .tdb-hero h1 { color: #1f2937; }

    .tdb-card {
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg, var(--tdb-soft, #ffffff) 0%, #ffffff 78px);
        border: 1px solid #e9eef5;
        border-top: 3px solid var(--tdb-accent, #5a371e);
        border-radius: 14px;
        padding: 16px 18px 14px;
        box-shadow: 0 2px 10px rgba(31, 41, 55, .06);
        height: 100%;
    }
    .tdb-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
    .tdb-card-title h2 { color: #243447; font-size: 15px; font-weight: 700; margin: 0 0 2px; }
    .tdb-card-title p { font-size: 12px; line-height: 1.35; margin: 0; }
    .tdb-tools { display: flex; gap: 2px; flex: 0 0 auto; }
    .tdb-tools button, .tdb-tool {
        border: 1px solid transparent;
        background: transparent;
        color: #a08b7a;
        border-radius: 8px;
        padding: 4px 6px;
        line-height: 1;
        transition: all .15s ease;
    }
    .tdb-tools button:hover, .tdb-tool:hover { background: #f6ede5; color: #5a371e; border-color: #e9ded5; }
    .tdb-tools svg, .tdb-tool svg { width: 16px; height: 16px; }

    .tdb-kpi { font-size: 2.4rem; font-weight: 800; line-height: 1; color: var(--tdb-accent, #5a371e); }
    .tdb-kpi .tdb-unite { font-size: .85rem; font-weight: 600; color: #a08b7a; margin-left: 6px; }
    .tdb-kpi-detail { color: #8a6a58; font-size: 12.5px; margin: 10px 0 0; }
    .tdb-fiche { margin: 0; }
    .tdb-fiche div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px dashed #efe4d9; font-size: 13px; }
    .tdb-fiche div:last-child { border-bottom: 0; }
    .tdb-fiche dt { color: #8a6a58; font-weight: 500; margin: 0; }
    .tdb-fiche dd { margin: 0; color: #3f2a1d; font-weight: 600; text-align: right; }

    .tdb-chart { width: 100%; min-height: 265px; }

    /* Tableaux (recapitulatif des stocks, saisies du jour) */
    .tdb-table-wrap {
        max-height: 430px;
        overflow: auto;
        border: 1px solid #f1e8df;
        border-radius: 10px;
        background: #fff;
    }
    .tdb-table { font-size: 12.5px; margin: 0; }
    .tdb-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--tdb-soft, #fbf6f1);
        color: #6b5140;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        white-space: nowrap;
        border-bottom: 1px solid #e9ded5;
    }
    .tdb-table tbody td { color: #3f2a1d; border-bottom-color: #f4ece4; }
    .tdb-table tbody tr:last-child td { border-bottom: 0; }
    .tdb-table tbody tr:hover td { background: #fdf8f3; }
    .tdb-table td:first-child, .tdb-table th:first-child { white-space: nowrap; }
    .tdb-note { color: #a08b7a; font-size: 11.5px; line-height: 1.4; margin: 8px 0 0; }
    .tdb-total { border-top: 1px dashed #efe4d9; margin-top: 8px; padding-top: 8px; font-size: 12px; color: #a08b7a; }
    .tdb-error { background: #fdf3ee; border: 1px solid #f0d8c8; color: #8a4b2a; border-radius: 10px; padding: 10px 12px; font-size: 12.5px; }

    .tdb-card-off { background: #faf7f3; }
    .tdb-card-off .tdb-card-body { opacity: .75; }
    .tdb-off-msg { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: #8a6a58; font-size: 12.5px; padding: 12px 0; }

    .tdb-panel { background: #fff; border: 1px solid #e9eef5; border-radius: 14px; padding: 16px 18px; }
    .tdb-panel h2 { font-size: 15px; color: #5a371e; font-weight: 700; }
    .tdb-panel table { font-size: 13px; }
    .tdb-panel th { color: #a08b7a; font-weight: 600; font-size: 11.5px; text-transform: uppercase; letter-spacing: .03em; border-bottom-color: #e9ded5; }
    .tdb-panel td { vertical-align: middle; border-bottom-color: #f1e8df; }
    .tdb-panel .btn { --bs-btn-padding-y: .15rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: 11.5px; }

    .tdb-empty { background: #fff; border: 1px dashed #ddcbb9; border-radius: 14px; padding: 34px 20px; text-align: center; color: #8a6a58; }

    @media (max-width: 575.98px) {
        .tdb-kpi { font-size: 2rem; }
        .tdb-card { padding: 14px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-3">

    <div class="page-header tdb-hero d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"
         style="--tdb-accent: {{ roleCouleur }}; --tdb-soft: {{ roleCouleurDouce }};">
        <div>
            <span class="tdb-role-pill mb-2">
                <i data-lucide="{{ roleIcone }}"></i> {{ roleLibelle }}
            </span>
            <h1 class="h4 mb-1 mt-2">Mon tableau de bord</h1>
            <p class="text-muted mb-0">{{ roleAccroche }}</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse"
                    data-bs-target="#panneauPersonnalisation" aria-expanded="false" aria-controls="panneauPersonnalisation">
                Personnaliser mes gadgets
            </button>
            <a href="{{ path('tdb_role') }}" class="btn btn-sm btn-outline-secondary">Tableau de bord general</a>
        </div>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} py-2">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if roles|length > 1 %}
        <div class="tdb-roles mb-3">
            <span class="text-muted small">Mes tableaux de bord :</span>
            {% for cle, libelle in roles %}
                <form method="post" action="{{ path('tdb_role_changer') }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_role') }}">
                    <input type="hidden" name="role" value="{{ cle }}">
                    <button type="submit" class="tdb-chip{{ cle == role ? ' active' }}">{{ libelle }}</button>
                </form>
            {% endfor %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------------
       Panneau de personnalisation : chaque gadget peut etre affiche ou
       masque, active ou desactive, et deplace dans la grille.
       ------------------------------------------------------------------ #}
    <div class="collapse mb-3" id="panneauPersonnalisation">
        <div class="tdb-panel">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div>
                    <h2 class="mb-1">Personnaliser mes gadgets</h2>
                    <p class="text-muted small mb-0">
                        {{ nb_affichees }} gadget(s) affiche(s){% if nb_masquees > 0 %}, {{ nb_masquees }} masque(s){% endif %}{% if nb_desactivees > 0 %}, {{ nb_desactivees }} desactive(s){% endif %}.
                        Un gadget masque disparait de la grille ; un gadget desactive reste visible mais ne calcule plus rien.
                    </p>
                </div>
                <form method="post" action="{{ path('tdb_role_reinitialiser') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                    <input type="hidden" name="role" value="{{ role }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Retablir l'affichage par defaut</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Gadget</th>
                            <th class="text-center">Affichage</th>
                            <th class="text-center">Etat</th>
                            <th class="text-center">Ordre</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for carte in cartes %}
                        <tr>
                            <td>
                                <div class="fw-semibold d-flex align-items-center gap-2" style="color:#243447;">
                                    <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ carte.couleur }};"></span>
                                    {{ carte.libelle }}
                                </div>
                                <div class="text-muted" style="font-size:11.5px;">{{ carte.description }}</div>
                            </td>
                            <td class="text-center">
                                <form method="post" action="{{ path('tdb_role_gadget') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="{{ carte.visible ? 'masquer' : 'afficher' }}">
                                    <button type="submit" class="btn {{ carte.visible ? 'btn-outline-secondary' : 'btn-cacao' }}">
                                        {{ carte.visible ? 'Masquer' : 'Afficher' }}
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <form method="post" action="{{ path('tdb_role_gadget') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="{{ carte.actif ? 'desactiver' : 'activer' }}">
                                    <button type="submit" class="btn {{ carte.actif ? 'btn-outline-secondary' : 'btn-cacao' }}">
                                        {{ carte.actif ? 'Desactiver' : 'Activer' }}
                                    </button>
                                </form>
                            </td>
                            <td class="text-center text-nowrap">
                                <form method="post" action="{{ path('tdb_role_gadget') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="monter">
                                    <button type="submit" class="tdb-tool" title="Monter" aria-label="Monter"><i data-lucide="arrow-up"></i></button>
                                </form>
                                <form method="post" action="{{ path('tdb_role_gadget') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="descendre">
                                    <button type="submit" class="tdb-tool" title="Descendre" aria-label="Descendre"><i data-lucide="arrow-down"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if nb_affichees == 0 %}
        <div class="tdb-empty">
            <p class="mb-3">Tous les gadgets de ce tableau de bord sont masques ou desactives.</p>
            <form method="post" action="{{ path('tdb_role_reinitialiser') }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                <input type="hidden" name="role" value="{{ role }}">
                <button type="submit" class="btn btn-sm btn-cacao">Retablir l'affichage par defaut</button>
            </form>
        </div>
    {% endif %}

    <div class="row g-3">
        {% for carte in cartes %}
            {% if carte.visible %}
                {% set largeurCarte = carte.largeur > 12 ? 12 : carte.largeur %}
                <div class="col-12 {{ largeurCarte >= 12 ? '' : 'col-md-6' }} col-xl-{{ largeurCarte }}">
                    <div class="tdb-card{{ carte.actif ? '' : ' tdb-card-off' }}"
                         style="--tdb-accent: {{ carte.couleur }}; --tdb-soft: {{ carte.couleurDouce }};">
                        <div class="tdb-card-head">
                            <div class="tdb-card-title">
                                <h2>{{ carte.libelle }}</h2>
                                <p class="text-muted">{{ carte.description }}</p>
                            </div>
                            <div class="tdb-tools">
                                <form method="post" action="{{ path('tdb_role_gadget') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="{{ carte.actif ? 'desactiver' : 'activer' }}">
                                    <button type="submit" title="{{ carte.actif ? 'Desactiver ce gadget' : 'Reactiver ce gadget' }}" aria-label="Activer ou desactiver">
                                        <i data-lucide="{{ carte.actif ? 'power' : 'power-off' }}"></i>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('tdb_role_gadget') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                    <input type="hidden" name="role" value="{{ role }}">
                                    <input type="hidden" name="code" value="{{ carte.code }}">
                                    <input type="hidden" name="action" value="masquer">
                                    <button type="submit" title="Masquer ce gadget" aria-label="Masquer">
                                        <i data-lucide="eye-off"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="tdb-card-body flex-grow-1">
                            {% if not carte.actif %}
                                <div class="tdb-off-msg">
                                    <span>Gadget desactive : aucune donnee n'est chargee.</span>
                                    <form method="post" action="{{ path('tdb_role_gadget') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('tdb_gadget') }}">
                                        <input type="hidden" name="role" value="{{ role }}">
                                        <input type="hidden" name="code" value="{{ carte.code }}">
                                        <input type="hidden" name="action" value="activer">
                                        <button type="submit" class="btn btn-sm btn-cacao">Reactiver</button>
                                    </form>
                                </div>
                            {% elseif carte.donnees is null %}
                                <div class="tdb-error">Aucune donnee n'a pu etre chargee pour ce gadget.</div>
                            {% elseif carte.donnees.erreur is defined %}
                                <div class="tdb-error">
                                    Donnees indisponibles : {{ carte.donnees.erreur }}
                                </div>
                            {% elseif carte.type == 'chiffre' %}
                                <div class="tdb-kpi">
                                    {{ carte.donnees.valeur }}{% if carte.donnees.unite is defined and carte.donnees.unite %}<span class="tdb-unite">{{ carte.donnees.unite }}</span>{% endif %}
                                </div>
                                <p class="tdb-kpi-detail">{{ carte.donnees.detail|default('') }}</p>
                            {% elseif carte.type == 'fiche' %}
                                <dl class="tdb-fiche">
                                    {% for ligne in carte.donnees.lignes %}
                                        <div>
                                            <dt>{{ ligne.libelle }}</dt>
                                            <dd>{{ ligne.valeur }}</dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            {% elseif carte.type == 'tableau' %}
                                {% if carte.donnees.lignes is not defined or carte.donnees.lignes is empty %}
                                    <div class="tdb-off-msg">{{ carte.donnees.vide|default('Aucune donnée à afficher pour le moment.') }}</div>
                                {% else %}
                                    <div class="tdb-table-wrap">
                                        <table class="table table-sm align-middle tdb-table mb-0">
                                            <thead>
                                                <tr>
                                                    {% for colonne in carte.donnees.colonnes %}
                                                        <th>{{ colonne }}</th>
                                                    {% endfor %}
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for ligne in carte.donnees.lignes %}
                                                    <tr>
                                                        {% for cellule in ligne %}
                                                            {% set titreColonne = carte.donnees.colonnes[loop.index0]|default('')|lower %}
                                                            <td>{% if titreColonne in ['stock final', 'stock actuel', 'stock après'] %}<strong>{{ cellule }}</strong>{% else %}{{ cellule }}{% endif %}</td>
                                                        {% endfor %}
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    {% if carte.donnees.sous_titre is defined %}
                                        <div class="tdb-total">{{ carte.donnees.sous_titre }}</div>
                                    {% endif %}
                                    {% if carte.donnees.note is defined %}
                                        <p class="tdb-note">{{ carte.donnees.note }}</p>
                                    {% endif %}
                                {% endif %}
                                {% if carte.donnees.lien is defined and carte.donnees.lien %}
                                    <div class="mt-3">
                                        <a href="{{ path(carte.donnees.lien.route, carte.donnees.lien.parametres|default({})) }}" class="btn btn-sm btn-cacao">
                                            <i data-lucide="{{ carte.donnees.lien.icone|default('external-link') }}"></i>
                                            {{ carte.donnees.lien.libelle }}
                                        </a>
                                    </div>
                                {% endif %}
                            {% else %}
                                <div id="graphe-{{ carte.code }}" class="tdb-chart"></div>
                                {% if carte.donnees.total is defined %}
                                    <div class="tdb-total">Total sur la periode : <strong>{{ carte.donnees.total }}</strong></div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

<script>
(function () {
    var graphiques = {{ graphiques|json_encode|raw }};

    function dessiner() {
        if (typeof ApexCharts === 'undefined') {
            document.querySelectorAll('.tdb-chart').forEach(function (element) {
                element.innerHTML = '<div class="tdb-error">Graphiques indisponibles : la bibliotheque de graphiques est indisponible.</div>';
            });
            return;
        }

        Object.keys(graphiques || {}).forEach(function (identifiant) {
            var element = document.getElementById(identifiant);
            if (!element) {
                return;
            }
            element.innerHTML = '';
            new ApexCharts(element, graphiques[identifiant]).render();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', dessiner);
    } else {
        dessiner();
    }
})();
</script>
{% endblock %}
