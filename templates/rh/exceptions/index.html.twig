        function affichePermission(id_permission){
            $.ajax({
                url : '{{ path('rh_accueil') }}/affichePermission/' + id_permission,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    slug = reponse.slug;
                    // Vérifie le type MIME
                    let preview = document.querySelector("#afficheFichier");
                    document.querySelector("#lbl_affiche_fichier").innerHTML = '<h2>Permission N° <span class="text-danger">' + reponse.id + '</span> accordée à ' + reponse.nom + '</h2>';

                    if (reponse.extension  === "jpg" || reponse.extension  === "png" || reponse.extension  === "jpeg" || reponse.extension  === "bmp"  ) {
                        preview.innerHTML = '<img class="img_fichier" src="{{ asset('rh/assets/permissions/') }}'   + reponse.fichier + '"  alt="aperçu" style="max-width:600px;height:500px; border-radius:12px; box-shadow:0 4px 4px rgba(0,0,0,0.25);">';
                    } else if (reponse.extension  === "pdf") {
                        preview.innerHTML = `<embed  class="img_fichier" src="{{ asset('rh/assets/permissions/') }}${reponse.fichier}" type="application/pdf" width="100%" height="500px" style="border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.25);"> `;
                    } else {
                        preview.innerHTML = `<p>Type de fichier non supporté : ${reponse.fichier}</p>`;
                    }
                }
            })
        }

        function loadPermission(id_permission){
            reinitialise_permission()
            $.ajax({
                url : '{{ path('rh_accueil') }}/affichePermission/' + id_permission,
