{% extends 'base.html.twig' %}{% block title %}Dossier candidat — CITRAC{% endblock %}{% block body %}<div class="container-fluid py-3"><h1 class="h4">{{ nouveau ? 'Accueil — nouveau candidat' : candidat.nomComplet }}</h1><a href="{{ path('rh_vivier') }}">Retour au vivier</a>{% for e in erreurs %}<div class="alert alert-danger">{{ e }}</div>{% endfor %}<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('rh_vivier') }}"><input type="hidden" name="action" value="enregistrer"><div class="row g-2">{% for cle,label in {nom:'Nom',prenoms:'Prénoms',telephone:'Téléphone',email:'Email',adresse:'Adresse',poste:'Poste recherché',diplomes:'Diplômes',experiences:'Expériences',observations:'Observations de l’accueil'} %}{% set ancien=cle=='poste'?candidat.posteRecherche:(cle=='observations'?candidat.observationsAccueil:attribute(candidat,cle)) %}<div class="col-md-6"><label class="form-label">{{ label }}</label>{% if cle in ['diplomes','experiences','observations'] %}<textarea class="form-control form-control-sm" name="{{ cle }}" maxlength="20000">{{ donnees[cle]|default(ancien) }}</textarea>{% else %}<input class="form-control form-control-sm" name="{{ cle }}" type="{{ cle=='email'?'email':'text' }}" value="{{ donnees[cle]|default(ancien) }}" {{ cle in ['nom','prenoms']?'required':'' }} maxlength="{{ {nom:100,prenoms:150,telephone:30,email:180,adresse:255,poste:150}[cle] }}">{% endif %}</div>{% endfor %}<div class="col-12"><label class="form-label">Pièces du dossier (CV, diplômes, justificatifs)</label><input type="file" name="documents[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx,.odt,.ods" class="form-control form-control-sm"><small>10 pièces maximum par envoi, 10 Mo par pièce.</small></div></div><button class="btn btn-sm btn-cacao my-3">Enregistrer le dossier</button></form>{% if not nouveau %}<h2 class="h5">Pièces enregistrées</h2><ul>{% for doc in documents %}<li><a href="{{ path('rh_document_telecharger',{id:doc.id}) }}">{{ doc.titre }}</a></li>{% else %}<li>Aucune pièce.</li>{% endfor %}</ul><h2 class="h5">Prendre en compte dans un recrutement</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('rh_vivier') }}"><input type="hidden" name="action" value="recruter"><select name="offre" required class="form-select form-select-sm"><option value="">Sélectionner une offre publiée</option>{% for offre in offres %}<option value="{{ offre.id }}">{{ offre.reference }} — {{ offre.intitule }}</option>{% endfor %}</select><button class="btn btn-sm btn-cacao my-3">Rattacher au recrutement</button></form><ul>{% for ca in candidatures %}<li><a href="{{ path('rh_recrutement_candidature',{id:ca.id}) }}">{{ ca.reference }}</a> — {{ ca.statut }}</li>{% endfor %}</ul>{% endif %}</div>{% endblock %}
