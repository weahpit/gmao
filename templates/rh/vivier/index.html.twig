{% extends 'base.html.twig' %}{% block title %}Vivier des candidats — CITRAC{% endblock %}{% block body %}<div class="container-fluid py-3"><h1 class="h4">Vivier des candidats / dossiers spontanés</h1><p>Enregistrez les personnes qui viennent chercher du travail, même sans offre en cours. Rattachez ensuite leur dossier à un recrutement.</p><a href="{{ path('rh_vivier_new') }}" class="btn btn-sm btn-cacao">+ Enregistrer un dossier</a> <a href="{{ path('rh_recrutement') }}" class="btn btn-sm btn-outline-secondary">Recrutements</a><form method="get" class="my-3"><input class="form-control form-control-sm" name="q" value="{{ q }}" placeholder="Nom, poste recherché, contact"><button class="btn btn-sm btn-cacao">Rechercher</button></form><p>{{ total }} candidat(s)</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Candidat</th><th>Contact</th><th>Poste recherché</th><th>Accueil</th><th></th></tr></thead><tbody>{% for c in candidats %}<tr><td>{{ c.nomComplet }}</td><td>{{ c.telephone }} {{ c.email }}</td><td>{{ c.posteRecherche }}</td><td>{{ c.dossierSpontane ? 'Dossier spontané' : 'Candidature existante' }} — {{ c.createdAt|date('d/m/Y') }}</td><td><a href="{{ path('rh_vivier_fiche',{id:c.id}) }}">Dossier / Recruter</a></td></tr>{% else %}<tr><td colspan="5">Aucun candidat.</td></tr>{% endfor %}</tbody></table></div>{% if page>1 %}<a href="{{ path('rh_vivier',{q:q,page:page-1}) }}">Précédent</a>{% endif %} Page {{ page }}/{{ pages }} {% if page<pages %}<a href="{{ path('rh_vivier',{q:q,page:page+1}) }}">Suivant</a>{% endif %}</div>{% endblock %}
