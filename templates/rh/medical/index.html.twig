{% extends 'base.html.twig' %}
{% block title %}Santé au travail — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_dashboard') }}">Ressources humaines</a></span>
    <span class="breadcrumb-item">Santé au travail</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }} py-2">{{ message }}</div>{% endfor %}
    {% endfor %}
    <div class="alert py-2 small" style="background:#f6efe8; border:1px solid #e9ded5; color:#5a371e;">
        Données médicales confidentielles : accès réservé au médecin du travail et à l'infirmerie.
    </div>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Santé au travail</h1>
            <p class="text-muted mb-0">Dossiers médicaux, visites, vaccinations et accidents du travail.</p>
        </div>
        <a href="{{ path('rh_medical_dossier_new') }}" class="btn btn-sm btn-cacao">+ Nouveau dossier</a>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Dossiers</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ nbDossiers }}</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Inaptitudes</div>
                <div class="h4 mb-0" style="color:#a15c1e;">{{ nbInaptitudes }}</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Visites à renouveler (60 j)</div>
                <div class="h4 mb-0" style="color:#a15c1e;">{{ renouvellements|length }}</div>
            </div>
        </div>
    </div>

    {% if renouvellements is not empty %}
        <div class="p-3 mb-3" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#5a371e;">Renouvellements à prévoir</h2>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Employé</th><th>Dernière visite</th><th>Prochaine</th><th>Aptitude</th></tr></thead>
                    <tbody>
                    {% for visite in renouvellements %}
                        <tr>
                            <td class="small">{{ visite.dossier and visite.dossier.employe ? visite.dossier.employe.nomComplet : '—' }}</td>
                            <td class="small">{{ visite.date ? visite.date|date('d/m/Y') : '—' }}</td>
                            <td class="small">{{ visite.dateProchaine ? visite.dateProchaine|date('d/m/Y') : '—' }}</td>
                            <td class="small">{{ visite.aptitudeLibelle }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="table-responsive mb-3" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Dossier</th><th>Employé</th><th>Groupe</th><th>Dernière visite</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            {% for dossier in dossiers %}
                <tr>
                    <td class="small">{{ dossier.numeroDossier }}</td>
                    <td>
                        <strong>{{ dossier.employe ? dossier.employe.nomComplet : '—' }}</strong>
                        {% if dossier.employe %}<div class="small text-muted">{{ dossier.employe.matricule }}</div>{% endif %}
                    </td>
                    <td class="small">{{ dossier.groupeSanguin ?: '—' }}</td>
                    <td class="small">
                        {% set derniere = dossier.derniereVisite %}
                        {{ derniere and derniere.date ? derniere.date|date('d/m/Y') : '—' }}
                    </td>
                    <td class="text-end"><a href="{{ path('rh_medical_dossier', {id: dossier.id}) }}" class="btn btn-sm btn-outline-secondary">Ouvrir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-3">Aucun dossier médical enregistré.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if dernieres is not empty %}
        <div class="p-3" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#5a371e;">Dernières visites</h2>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Date</th><th>Employé</th><th>Type</th><th>Aptitude</th></tr></thead>
                    <tbody>
                    {% for visite in dernieres %}
                        <tr>
                            <td class="small">{{ visite.date ? visite.date|date('d/m/Y') : '—' }}</td>
                            <td class="small">{{ visite.dossier and visite.dossier.employe ? visite.dossier.employe.nomComplet : '—' }}</td>
                            <td class="small">{{ visite.typeLibelle }}</td>
                            <td class="small">{{ visite.aptitudeLibelle }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
