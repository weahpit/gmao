{% extends 'rh/_layout.html.twig' %}

{% block title %}Postes{% endblock %}

{% block rh_contenu %}
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="mb-1">Postes de travail</h1>
                <p class="mb-0 small">Chaque poste est rattaché à un département. Les postes servent à classer les employés dans le fichier du personnel.</p>
            </div>
            <a href="{{ path('rh_app_departements') }}" class="btn btn-outline-dark">
                <i class="fa fa-building-o me-1"></i> Gérer les départements
            </a>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header bg-white fw-semibold" style="color:#5a371e;">
                        Liste des postes ({{ postes|length }})
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0" id="tbl_postes">
                            <thead>
                                <tr>
                                    <th>Poste</th>
                                    <th>Département</th>
                                    <th class="text-center">Employés</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for poste in postes %}
                                <tr>
                                    <td class="fw-semibold">{{ poste.libelle }}</td>
                                    <td>{{ poste.departement }}</td>
                                    <td class="text-center">{{ poste.nb_employes }}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-supprimer-poste="{{ poste.id }}"
                                                data-libelle-poste="{{ poste.libelle }}">
                                            <i class="fa fa-trash-o"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-4">Aucun poste enregistré pour le moment.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-white fw-semibold" style="color:#5a371e;">Ajouter un poste</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label" for="poste_departement">Département</label>
                            <select class="form-select" id="poste_departement">
                                {% for departement in departements %}
                                    <option value="{{ departement.id }}">{{ departement.libelle }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="poste_libelle">Libellé du poste</label>
                            <input type="text" class="form-control" id="poste_libelle" placeholder="Ex. : Opérateur de production">
                        </div>
                        <button type="button" class="btn btn-primary w-100" id="btn_ajout_poste">
                            <i class="fa fa-plus me-1"></i> Enregistrer
                        </button>
                        <div class="small mt-3" id="poste_message"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var urlAjout = '{{ path('rh_add_poste', {id_departement: 0, libelle: '__LIBELLE__'}) }}';
            var urlSuppression = '{{ path('rh_delete_poste', {id_poste: 0}) }}';

            function message(texte, ok) {
                var zone = document.getElementById('poste_message');
                zone.className = 'small mt-3 ' + (ok ? 'text-success' : 'text-danger');
                zone.textContent = texte;
            }

            document.getElementById('btn_ajout_poste').addEventListener('click', function () {
                var departement = document.getElementById('poste_departement').value;
                var libelle = document.getElementById('poste_libelle').value.trim();

                if (libelle === '') {
                    message('Renseignez le libellé du poste.', false);
                    return;
                }

                var url = urlAjout.replace('/0/', '/' + departement + '/')
                                  .replace('__LIBELLE__', encodeURIComponent(libelle));

                fetch(url, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (r) { return r.json(); })
                    .then(function () { window.location.reload(); })
                    .catch(function () { message('Le poste n\'a pas pu être enregistré. Vérifiez la connexion au serveur.', false); });
            });

            document.querySelectorAll('[data-supprimer-poste]').forEach(function (bouton) {
                bouton.addEventListener('click', function () {
                    var libelle = bouton.getAttribute('data-libelle-poste');
                    if (!window.confirm('Supprimer définitivement le poste « ' + libelle + ' » ?')) {
                        return;
                    }
                    var url = urlSuppression.replace('/0', '/' + bouton.getAttribute('data-supprimer-poste'));
                    fetch(url, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
                        .then(function (r) { return r.json(); })
                        .then(function () { window.location.reload(); })
                        .catch(function () { message('La suppression a échoué. Vérifiez la connexion au serveur.', false); });
                });
            });
        })();
    </script>
{% endblock %}