{% extends 'base.html.twig' %}
{% block title %}Absences et conges — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_dashboard') }}">Ressources humaines</a></span>
    <span class="breadcrumb-item">Absences et conges</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Absences et conges</h1>
            <p class="text-muted mb-0">Demandes, validations hierarchiques et synthese {{ annee }}.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('rh_temps_absence_new') }}" class="btn btn-sm btn-cacao">+ Nouvelle demande</a>
            <a href="{{ path('rh_temps_absences_pdf') }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Synthese PDF</a>
        </div>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }} py-2">{{ message }}</div>{% endfor %}
    {% endfor %}

    {% if enAttente is not empty %}
        <div class="p-3 mb-3" style="background:#fdf6ef; border:1px solid #e9ded5; border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#a15c1e;">En attente de validation ({{ enAttente|length }})</h2>
            <ul class="small mb-0">
            {% for demande in enAttente %}
                <li>
                    <a href="{{ path('rh_temps_absence', {id: demande.id}) }}" class="text-decoration-none">
                        {{ demande.employe ? demande.employe.nomComplet : 'Employe supprime' }}
                    </a>
                    — {{ demande.typeLibelle }} du {{ demande.dateDebut ? demande.dateDebut|date('d/m/Y') : '-' }}
                    au {{ demande.dateFin ? demande.dateFin|date('d/m/Y') : '-' }} ({{ demande.nombreJours }} j)
                </li>
            {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="get" class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="type">Type</label>
                <select id="type" name="type" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    {% for cle, libelle in types %}<option value="{{ cle }}" {{ cle == type ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="statut">Statut</label>
                <select id="statut" name="statut" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    {% for cle, libelle in statuts %}<option value="{{ cle }}" {{ cle == statut ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button class="btn btn-sm btn-cacao" type="submit">Filtrer</button>
                <a href="{{ path('rh_temps_absences') }}" class="btn btn-sm btn-outline-secondary">Effacer</a>
            </div>
        </div>
    </form>

    {% if joursParType is not empty %}
        <div class="d-flex flex-wrap gap-2 mb-3">
            {% for libelle, total in joursParType %}
                <span class="badge" style="background:#f2e7dd; color:#5a371e;">{{ libelle }} : {{ total }} j</span>
            {% endfor %}
        </div>
    {% endif %}

    <div class="table-responsive" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Reference</th><th>Employe</th><th>Type</th><th>Periode</th><th>Jours</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            {% for absence in absences %}
                <tr>
                    <td class="small">{{ absence.reference }}</td>
                    <td class="small">{{ absence.employe ? absence.employe.nomComplet : '—' }}</td>
                    <td class="small">{{ absence.typeLibelle }}</td>
                    <td class="small">{{ absence.periodeLibelle }}</td>
                    <td class="small">{{ absence.nombreJours }}</td>
                    <td><span class="badge" style="background:#f2e7dd; color:#5a371e;">{{ absence.statutLibelle }}</span></td>
                    <td class="text-end"><a href="{{ path('rh_temps_absence', {id: absence.id}) }}" class="btn btn-sm btn-outline-secondary">Ouvrir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune demande ne correspond au filtre.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
