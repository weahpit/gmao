{% extends 'base.html.twig' %}
{% block title %}Nouvelle demande d'absence — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_temps_absences') }}">Absences et conges</a></span>
    <span class="breadcrumb-item">Nouvelle demande</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header mb-3">
        <h1 class="h4 mb-1">Nouvelle demande d'absence</h1>
        <p class="text-muted mb-0">La demande est transmise au responsable puis au service RH.</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger py-2"><ul class="mb-0 small">{% for e in erreurs %}<li>{{ e }}</li>{% endfor %}</ul></div>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px; max-width:820px;">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_absence') }}">
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="employe">Employe *</label>
                <select id="employe" name="employe" class="form-select form-select-sm" required>
                    <option value="">Choisir...</option>
                    {% for e in employes %}<option value="{{ e.id }}" {{ e.id == donnees.employe ? 'selected' : '' }}>{{ e.nomComplet }} ({{ e.matricule }})</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="type">Type d'absence</label>
                <select id="type" name="type" class="form-select form-select-sm">
                    {% for cle, libelle in types %}<option value="{{ cle }}" {{ cle == donnees.type ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="date_debut">Du *</label>
                <input type="date" id="date_debut" name="date_debut" value="{{ donnees.date_debut }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="date_fin">Au *</label>
                <input type="date" id="date_fin" name="date_fin" value="{{ donnees.date_fin }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="justificatif">Justificatif</label>
                <input type="file" id="justificatif" name="justificatif" class="form-control form-control-sm">
                <div class="form-text">Certificat medical, convocation, etc.</div>
            </div>
            <div class="col-12">
                <label class="form-label small mb-1" for="motif">Motif</label>
                <textarea id="motif" name="motif" rows="3" class="form-control form-control-sm">{{ donnees.motif }}</textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-cacao" type="submit">Transmettre la demande</button>
            <a href="{{ path('rh_temps_absences') }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
