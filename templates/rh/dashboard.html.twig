{% extends 'base.html.twig' %}
{% block title %}Ressources humaines — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-item">Ressources humaines</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Tableau de bord RH</h1>
            <p class="text-muted mb-0">Effectif, mouvements, absences et echeances — annee {{ annee }}.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('rh_employes_new') }}" class="btn btn-sm btn-cacao">+ Nouvel employe</a>
            <a href="{{ path('rh_contrats_new') }}" class="btn btn-sm btn-outline-secondary">+ Contrat</a>
            <a href="{{ path('rh_temps_absence_new') }}" class="btn btn-sm btn-outline-secondary">+ Demande d'absence</a>
        </div>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} py-2">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="row g-2 mb-3">
        {% set cartes = [
            {libelle: 'Effectif actif', valeur: effectif, detail: hommes ~ ' hommes / ' ~ femmes ~ ' femmes'},
            {libelle: 'Absenteisme du mois', valeur: tauxAbsenteisme ~ ' %', detail: joursAbsenceMois ~ ' jours cumules'},
            {libelle: 'Demandes en attente', valeur: absencesEnAttente, detail: 'conges a valider'},
            {libelle: 'Recrutements ' ~ annee, valeur: recrutementsAnnee, detail: candidaturesEnCours ~ ' candidatures en cours'}
        ] %}
        {% for carte in cartes %}
            <div class="col-6 col-lg-3">
                <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                    <div class="text-muted small text-uppercase" style="letter-spacing:.03em;">{{ carte.libelle }}</div>
                    <div class="h4 mb-0" style="color:#7a4c33;">{{ carte.valeur }}</div>
                    <div class="small text-muted">{{ carte.detail }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <h2 class="h6 mb-2" style="color:#5a371e;">Effectif par service</h2>
                {% if parService is empty %}
                    <p class="text-muted small mb-0">Aucun employe enregistre.</p>
                {% else %}
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                        {% for service, total in parService %}
                            <tr>
                                <td>{{ service is iterable ? service.service|default('-') : service }}</td>
                                <td class="text-end">{{ total is iterable ? total.total|default(0) : total }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <h2 class="h6 mb-2" style="color:#5a371e;">Echeances des 30 prochains jours</h2>
                {% if echeances is empty %}
                    <p class="text-muted small mb-0">Aucune echeance imminente.</p>
                {% else %}
                    <ul class="list-unstyled small mb-0">
                    {% for contrat in echeances %}
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <span>{{ contrat.employe ? contrat.employe.nomComplet : 'Employe supprime' }} — {{ contrat.typeLibelle|default('-') }}</span>
                            <span class="text-muted">{{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : 'sans terme' }}</span>
                        </li>
                    {% endfor %}
                    </ul>
                {% endif %}
                {% set nbExpires = contratsExpires is iterable ? contratsExpires|length : (contratsExpires|default(0)) %}
                {% if nbExpires > 0 %}
                    <p class="small mt-2 mb-1" style="color:#a15c1e;">{{ nbExpires }} contrat(s) termine(s) a regulariser.</p>
                    {% if contratsExpiresListe is defined and contratsExpiresListe is not empty %}
                        <ul class="list-unstyled small mb-0" style="color:#8a6a58;">
                            {% for contratExpire in contratsExpiresListe|slice(0, 4) %}
                                <li class="py-1 border-bottom">
                                    {{ contratExpire.employe ? contratExpire.employe.nomComplet : 'Employe supprime' }}
                                    — fin le {{ contratExpire.dateFin ? contratExpire.dateFin|date('d/m/Y') : '-' }}
                                </li>
                            {% endfor %}
                            {% if nbExpires > 4 %}
                                <li class="pt-1">... et {{ nbExpires - 4 }} autre(s).</li>
                            {% endif %}
                        </ul>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <h2 class="h6 mb-2" style="color:#5a371e;">Pipeline de recrutement</h2>
                {% if pipeline is empty %}
                    <p class="text-muted small mb-0">Aucune candidature en cours.</p>
                {% else %}
                    {% for etape, total in pipeline %}
                        <div class="d-flex justify-content-between small py-1 border-bottom">
                            <span>{{ etape|replace({'_': ' '})|capitalize }}</span><span>{{ total }}</span>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <h2 class="h6 mb-2" style="color:#5a371e;">Formations a venir</h2>
                {% if formationsAVenir is empty %}
                    <p class="text-muted small mb-0">Aucune formation planifiee.</p>
                {% else %}
                    <ul class="list-unstyled small mb-0">
                    {% for formation in formationsAVenir %}
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <a href="{{ path('rh_formations_detail', {id: formation.id}) }}" class="text-decoration-none">{{ formation.intitule }}</a>
                            <span class="text-muted">{{ formation.periodeLibelle }}</span>
                        </li>
                    {% endfor %}
                    </ul>
                {% endif %}
                {% if coutFormation is not null %}
                    <p class="small mt-2 mb-0 text-muted">Budget formation {{ annee }} : {{ coutFormation }} FCFA</p>
                {% endif %}
            </div>
        </div>
    </div>

    {% if visitesMedicales %}
        <div class="p-3 mt-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#5a371e;">Sante au travail — visites a renouveler (60 jours)</h2>
            {% if visitesARenouveler is empty %}
                <p class="text-muted small mb-0">Aucune visite a renouveler.</p>
            {% else %}
                <ul class="list-unstyled small mb-0">
                {% for visite in visitesARenouveler %}
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <span>{{ visite.dossier.employe ? visite.dossier.employe.nomComplet : 'Employe supprime' }}</span>
                        <span class="text-muted">{{ visite.dateProchaine ? visite.dateProchaine|date('d/m/Y') : 'a planifier' }}</span>
                    </li>
                {% endfor %}
                </ul>
            {% endif %}
            <p class="small text-muted mt-2 mb-0">{{ accidentsAnnee }} accident(s) du travail en {{ annee }} — {{ joursArretAnnee }} jours d'arret cumules.</p>
        </div>
    {% endif %}

    {% if peutVoirSalaires and masseSalariale is not null %}
        <p class="small text-muted mt-3 mb-0">Masse salariale mensuelle estimee : {{ masseSalariale }} FCFA</p>
    {% endif %}
</div>
{% endblock %}
