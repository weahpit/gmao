{% extends 'rh/_layout.html.twig' %}

{% block title %}Equipes de Quarts{% endblock %}

{% block rh_contenu %}
    <div class="mx-auto text-center mt-5">
        <h1 class="mb-2 fw-bold">Equipes de Quarts</h1>
        <button id="btn-ajout" style="border: 2px solid #5a371e; font-size: 16px;width: 250px;background: #5a371e;color: white;" data-bs-target="#modal_equipes" data-bs-toggle="modal">Ajouter une équipe</button>
        <div class="mt-2 div_contenu">

        </div>

    </div>

    <div class="modal fade" id="modal_equipes" aria-hidden="true" aria-labelledby="modal_equipes" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalToggleLabel">Ajouter équipes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="text" id="txt_equipe" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;" placeholder="Entrez le nom d'équipe...">
                </div>
                <div class="modal-footer">
                    <button class="btn w-100 btn_equipe" style="border: 2px solid #5a371e;background: #5a371e;color: white">Ajouter l'équipe</button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal" id="modal_users" aria-hidden="true" aria-labelledby="modal_users" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sélectionnez des Employés</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <span class="fw-bold text dark">Agents disponible : </span><select class="ms-2 me-2 " name="id_user" id="id_user" style="border: 2px solid #5a371e;width: 75%;background: #d2cbcb">

                    </select>
                    <a href="#" id="add_user" class="btn btn-sm text-white" style="background:#5a371e; width: 30px;font-size: 14px;height: 30px;">+</a>
                    <div class="m-2 contenudiv" style="border: 2px solid #5a371e;height:500px;overflow-y: scroll;">

                    </div>

                </div>
                <div class="modal-footer">
                    <h5 class="fw-bold text-danger lbl_nb_agents"></h5>
{#                    <button class="btn w-100 btn_add_poste" style="border: 2px solid #5a371e;background: #5a371e;color: white">Ajouter l'équipe</button>#}
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('rh/assets/js/utilitaires.js') }}"></script>
    <script>
        let id_equipe = 0;
        getEquipes();

        $('.btn_equipe').on('click', function() {
            addEquipe();
        });

        $('#add_user').on('click', function() {
            let id_user = $('#id_user').val()
            addUser(id_user);
            getUsers();
        });

        document.getElementById("txt_equipe").addEventListener("keydown", function(event) {
            if (event.key === "Enter") {
                addEquipe();
            }
        });

        function addEquipe(){

            let libelle = $("#txt_equipe").val();

            if (libelle){
                $.ajax({
                    url : '{{ path('rh_accueil') }}/AddEquipe/' + libelle,
                    type: 'POST',
                    success : function(response){
                        let reponse = JSON.parse(response)
                        if (reponse[0].code === "SUCCESS"){
                            getEquipes();
                            $('#txt_equipe').val('');
                            $('#txt_equipe').focus();
                        }
                    }
                })
            }
        }


        function getEquipes(){
            let contenu = "";
            $.ajax({
                url : '{{ path('rh_get_equipes') }}',
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse.length > 0) {
                        let contenu = '<table class="table mx-auto mt-2 border" style="width: 500px;">' +
                            '<thead>' +
                            '<tr>' +
                            '<th class="bg-light">Nom</th>' +
                            '<th class="bg-light">Sélectionner Employés</th>' +
                            '<th class="bg-light">Actions</th>' +
                            '</tr>' +
                            '</thead>' +
                            '<tbody class="body_contenu">';
                        for (var i = 0; i < reponse.length; i++) {
                            contenu = contenu + '<tr>'
                            contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow">' + reponse[i].libelle + '</span></td>'
                            contenu = contenu + '<td class="fw-bold text-danger" style="background: #e2e202"><i class="fa fa-people-group text-dark users" style="cursor: pointer;" id="'+ reponse[i].id + '" data-bs-target="#modal_users" data-bs-toggle="modal"></i></td>'
                            contenu = contenu + '<td class="fw-bold text-danger" style="background: lightyellow"><i class="fa fa-edit text-primary" style="cursor: pointer;"></i><i class="fa fa-trash ms-2 text-danger" style="cursor: pointer;"></i> </td>'
                            contenu = contenu + '</tr>'
                        }

                        document.querySelector('.div_contenu').innerHTML = contenu;
                        //alert('Ajouté');
                    } else {
                        document.querySelector('.div_contenu').innerHTML = '<h3 class="text-danger">Aucun département enregistré</h3>';
                    }
                }
            })
        }
        function getEmployees(){
            let contenu = "";
            document.querySelector('#id_user').innerHTML = null;
            $.ajax({
                url : '{{ path('rh_get_agents_quarts_se') }}',
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse.length > 0) {
                        let contenu = '';
                        for (var i = 0; i < reponse.length; i++) {
                                contenu = contenu + '<option value="' + reponse[i].id + '">' + reponse[i].nom + '</option>'
                        }
                        document.querySelector('#id_user').innerHTML = contenu;
                    } else {
                        contenu = contenu + '<option value="0">Aucun employé disponible</option>'
                    }

                }
            })

        }

        $('body').on('click', '.users', function (){
            id_equipe  = this.id;
            getEmployees();
            getUsers();
        })
        $('body').on('click', '.supprime_user', function (){
            let id_user = this.id;
            supprime_user(id_user);
        })

        function getUsers(){
            let contenu = '';
            document.querySelector('.contenudiv').innerHTML = '<h3 class="text-primary">Chargement de l\'équpe</h3>';
            $.ajax({
                url : '{{ path('rh_accueil') }}/getUsers/' + id_equipe,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse.length > 0){
                        contenu = contenu +  '<table class="table">' +
                            contenu +  '<thead>' +
                            contenu +  '<tr>' +
                            contenu +  '<th class="bg-light"></th>' +
                            contenu +  '<th class="bg-light">Mle</th>' +
                            contenu +  '<th class="bg-light">Nom et Prénoms</th>' +
                            contenu +  '<th class="bg-light">Département</th>' +
                            contenu +  '<th class="bg-light">Poste</th>' +
                            contenu +  '<th class="bg-light">Chef de Quart</th>' +
                            contenu +  '<th class="bg-light">Retirer</th>' +
                            contenu +  '</tr>' +
                            contenu +  '</thead>' +
                            contenu +  '</tbody>';

                        for (var i = 0; i < reponse.length; i++) {
                            contenu = contenu + '<tr>'
                            if (reponse[i].chef_quart === true){
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="48" alt=""></span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue">' + reponse[i].mle + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue">' + reponse[i].departement + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue">' + reponse[i].poste + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightskyblue"><input type="radio" class="btn-check" name="options-outlined" id="success-outlined" autocomplete="off" checked>' +
                                    '<label class="btn btn-outline-success" for="success-outlined">Chef de Quart</label>'
                                contenu = contenu + '<td class="fw-bold text-danger" style="background: lightskyblue"><i class="fa fa-trash ms-2 text-danger supprime_user" id="'+ reponse[i].id + '" style="cursor: pointer;"></i> </td>'

                            } else {
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="48" alt=""></span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow">' + reponse[i].mle + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow">' + reponse[i].departement + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow">' + reponse[i].poste + '</span></td>'
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow"><input type="checkbox" class="btn-check change_chef" id="'+ reponse[i].id +'" autocomplete="off">' +
                                    '<label class="btn btn-outline-primary" for="'+ reponse[i].id +'">Opérateur simple</label><br></span></td>'
                                contenu = contenu + '<td class="fw-bold text-danger" style="background: lightyellow"><i class="fa fa-trash ms-2 text-danger supprime_user" id="'+ reponse[i].id + '" style="cursor: pointer;"></i> </td>'
                            }


                            contenu = contenu + '</tr>'

                        }

                        contenu = contenu +  '</tbody>';
                        contenu = contenu +  '</table>';
                        $('.modal-title').html('Ajouter des agents à  <span class="text-danger">' + reponse[0].equipe ) + '</span>';

                    } else {
                        contenu = '<h1 class="fw-light text-center text-danger">Aucun employé ajouté à cette équipe !</h1>'
                    }
                   $('.lbl_nb_agents').html(reponse.length + ' agent(s)') + '</span>';
                    document.querySelector('.contenudiv').innerHTML = contenu;
                }
            })
        }
        $('body').on('click', '.change_chef', function() {
            change_chef(this.id)
          })
        function change_chef(id_user){
            $.ajax({
                url : '{{ path('rh_accueil') }}/changeChefQuart/' + id_user,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                        render_toast_value(reponse.msg, reponse.code)
                        if (reponse.code === 1){
                            getUsers()
                            getEmployees();
                        }
                }
            })
        }

        function addUser(id_user){
            $.ajax({
                url : '{{ path('rh_accueil') }}/AddUser/' + id_user + '/' + id_equipe,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse[0].code === "SUCCESS"){
                        render_toast_value('Employé ajouté à l\'équipe !', 1)
                        getUsers()
                        getEmployees();
                    }
                }
            })
        }
        function supprime_user(id_user){
            $.ajax({
                url : '{{ path('rh_accueil') }}/removeUserFromEquipe/' + id_user,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse[0].code === "SUCCESS"){
                        render_toast_value('Employé retiré de l\'équipe avec Succès !', 1)
                        getUsers()
                        getEmployees()
                    }
                }
            })
        }

    </script>
{% endblock %}
