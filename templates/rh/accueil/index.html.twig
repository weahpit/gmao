        function getUsers(date){
            let contenu = "";
            document.querySelector('.div_presences').innerHTML = '<div class="text-center w-100" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
            $.ajax({
                url : '{{ path('rh_accueil') }}/presencesJour/' + date,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    contenu = contenu + '<table class="table" id="tbl_presences" style="">'
                    contenu = contenu + '<thead>'
                    contenu = contenu + '<tr class="bg-warning">'
                    contenu = contenu + '<th class="bg-warning"></th>'
                    contenu = contenu + '<th class="bg-warning">Nom & Prenoms</th>'
                    contenu = contenu + '<th class="bg-warning">Type Horaire</th>'
                    contenu = contenu + '<th class="bg-warning">Heure arrivée</th>'
                    contenu = contenu + '<th class="bg-warning">Absences (min)</th>'
                    contenu = contenu + '</tr>'
                    contenu = contenu + '</thead>'
                    contenu = contenu + '<tbody class="body_presences">'

                        for (var i = 0; i < reponse.length; i++) {
                            contenu = contenu + '<tr>'

                            if (reponse[i].minutes > 0) {
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightpink"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="48" alt=""></span></td>'
                                contenu = contenu + '<td class="" style="background: #f9e1e5;color: red;">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="" style="background: #f9e1e5;color: red;"></span>' + reponse[i].type_horaires + '</span><br><span class="text-danger fw-bold">' + reponse[i].equipe + '</span></td>'
                                contenu = contenu + '<td class="" style="background: #f9e1e5;color: red;">' + reponse[i].heure_entree + '</span></td>'
                                contenu = contenu + '<td class="" style="background: #f9e1e5;color: red;">' + reponse[i].minutes + '</span></td>'
                            }else {
                                contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="48" alt=""></span></td>'
                                contenu = contenu + '<td class="" style="background: lightyellow">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="" style="background: lightyellow"></span>' + reponse[i].type_horaires + '</span><br><span class="text-danger fw-bold">' + reponse[i].equipe + '</span></td>'
                                contenu = contenu + '<td class="" style="background: lightyellow">' + reponse[i].heure_entree + '</span></td>'
                                contenu = contenu + '<td class="" style="background: lightyellow">' + reponse[i].minutes + '</span></td>'
                            }
                            contenu = contenu + '</tr>'
                        }
                    contenu = contenu + '</tbody>'
                    contenu = contenu + '</table>'

                    document.querySelector('.div_presences').innerHTML = contenu;
                    let table = new DataTable('#tbl_presences', {
                        layout: {
                            topStart: {
                                buttons: [
                                    {
                                        extend: 'excelHtml5',
                                        title: 'Présences du ' + today.toLocaleDateString().split('T')[0],
                                        text: 'Exporter en excel',
                                        customize: function (xlsx) {
                                            var sheet = xlsx.xl.worksheets['sheet1.xml'];

                                            sheet.querySelectorAll('row c[r^="C"]').forEach((el) => {
                                                el.setAttribute('s', '2');
                                            });
                                        }
                                    }
                                ]
                            }
                        },
                        pageLength: 100,
                        colReorder: true,
                        order: [[4, 'desc']],
                        language: {
                            processing:     "Traitement en cours...",
                            search:         "Rechercher&nbsp;:",
                            lengthMenu:    "Afficher _MENU_ &eacute;l&eacute;ments",
                            info:           "Affichage de l'&eacute;lement _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                            infoEmpty:      "Affichage de l'&eacute;lement 0 &agrave; 0 sur 0 &eacute;l&eacute;ments",
                            infoFiltered:   "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                            infoPostFix:    "",
                            loadingRecords: "Chargement en cours...",
                            zeroRecords:    "Aucun &eacute;l&eacute;ment &agrave; afficher",
                            emptyTable:     "Aucune donnée disponible dans le tableau",
                            paginate: {
                                first:      "Premier",
                                previous:   "Pr&eacute;c&eacute;dent",
                                next:       "Suivant",
                                last:       "Dernier"
                            },
                            aria: {
                                sortAscending:  ": activer pour trier la colonne par ordre croissant",
                                sortDescending: ": activer pour trier la colonne par ordre décroissant"
                            }
                        }
                    });
                }
            })
        }

        function getQuartsAjourdhui(date) {
            let contenu = "";
            $.ajax({
                url: '{{ path('rh_accueil') }}/getQuartsDuJour/' + date,
                type: 'POST',
                success: function (response) {
                    let reponse = JSON.parse(response)
                    contenu += '<div class="p-1 d-inline-flex text-center">'

                    for (var i = 0; i < reponse.length; i++)    {
                        let quart =  reponse[i].quart;
                        if (reponse[i].title === "EQUIPE A"){
                            contenu += '<div class="p-2 ms-2 div_a" id="div_a" style="height: 520px;background: #f5f1ec;border-radius: 10px;"><a class="btn equipeA m-1" href="#" style="font-size: 14px;height: 40px;">[' + quart + '] ' + '<span class="badge bg-white text-dark fw-bold m-1" style="box-shadow:2px 2px;">' + reponse[i].title + '</span></a></div>'
                            affiche_equipe(reponse[i].id_equipe, "div_a", $('#date1').val())
                        }else if (reponse[i].title === "EQUIPE B"){
                            contenu += '<div class="p-2 ms-2 div_b" id="div_b" style="height: 520px;background: #f5f1ec;border-radius: 10px;"><a class="btn equipeB m-1" href="#" style="font-size: 14px;height: 40px;">[' +quart + '] ' + '<span class="badge bg-white text-dark fw-bold m-1" style="box-shadow:2px 2px;">' + reponse[i].title + '</span></a></div>'
                            affiche_equipe(reponse[i].id_equipe, "div_b",$('#date1').val())
                        }else if (reponse[i].title === "EQUIPE C"){
                            contenu += '<div class="p-2 ms-2 div_c" id="div_c" style="height: 520px;background: #f5f1ec;border-radius: 10px;"><a class="btn equipeC m-1" href="#" style="font-size: 14px;height: 40px;">[' + quart + '] ' + '<span class="badge bg-white text-dark fw-bold m-1" style="box-shadow:2px 2px;">' + reponse[i].title + '</span></a></div>'
                            affiche_equipe(reponse[i].id_equipe, "div_c",$('#date1').val())
                        }else if (reponse[i].title === "EQUIPE D"){
                            contenu += '<div class="p-2 ms-2 div_d" id="div_d" style="height: 520px;background: #f5f1ec;border-radius: 10px;"><a class="btn equipeD m-1" href="#" style="font-size: 14px;height: 40px;">[' + quart + '] ' + '<span class="badge bg-white text-dark fw-bold m-1" style="box-shadow:2px 2px;">' + reponse[i].title + '</span></a></div>'
                            affiche_equipe(reponse[i].id_equipe, "div_d",$('#date1').val())
                        }
                    }
                    contenu += '</div>'
                    document.querySelector(".quarts_jour").innerHTML = contenu;
                    document.querySelector(".acc_quart").innerHTML = 'Quarts de ce jour <span class="ms-5">( ' + presents_jour  + '/' + effectif_quart+ ')</span>';

                }
            });
        }

        function affiche_equipe(id_equipe, controle, date) {
            let contenu = "";
            var nb_total = 0;
            var nb_absent = 0;
            var nb_presents = 0;
            $.ajax({
                url: '{{ path('rh_accueil') }}/getUsers/' + id_equipe + '/' + date,
                type: 'POST',
                success: function (response) {
                    let reponse = JSON.parse(response);
                    contenu += '<hr><div class="bg white p-1 text-left" style="background:white;border-radius:20px;border-top: 2px solid darkblue;height: 450px;overflow-y: scroll;text-align: left;">'
                    if (id_equipe === 1){
                        contenu += '<div class="mb-2 text-center container sticky-top" id="div_totalA" style="font-size: 14px;background-color: #f7f7c5;border-radius: 25px;"></div>'
                    } else if (id_equipe === 2){
                        contenu += '<div class="mb-2 text-center container sticky-top" id="div_totalB" style="font-size: 14px;background-color: #f7f7c5;border-radius: 25px;"></div>'
                    } else if (id_equipe === 3){
                        contenu += '<div class="mb-2 text-center container sticky-top" id="div_totalC" style="font-size: 14px;background-color: #f7f7c5;border-radius: 25px;"></div>'
                    } else if (id_equipe ===4){
                        contenu += '<div class="mb-2 text-center container sticky-top" id="div_totalD" style="font-size: 14px;background-color: #f7f7c5;border-radius: 25px;"></div>'
                    }
                     for (var i = 0; i < reponse.length; i++) {
                         if (reponse[i].perm !== true) {
                        nb_total = nb_total +1;
                         effectif_quart = effectif_quart + 1;
                        if (reponse[i].present === true) {
                            presents_jour = presents_jour + 1;
                            nb_presents = nb_presents + 1;

                            if (reponse[i].chef_quart === true) {
                                contenu = contenu + '<div class="row me-2 text-white fw-bold w-100 p-1 row_employe" data-bs-target="#modal_details" data-bs-toggle="modal" id="'+ reponse[i].id + '" style="background:#67b36d;border-radius:25px;border-bottom:3px solid darkgreen;margin-right:10px;"><div class="col-5"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></div><div class="col-6"><label class="ms-2" style="font-size:13px;font-weight:bold;width:100px;position:left;">' + reponse[i].poste + '</label><label class="ms-2 text-dark fw-bold" style="font-size:10px;font-weight:bold;width:100px;position:left;">' + reponse[i].nom + '</label></div><div class="col-1"><i class="fa-solid fa-award ms-2 text-primary" title="Chef de quart"></i></div></div><br>'
                                    } else {
                                        contenu = contenu + '<div class="row me-2 fw-bold text-dark w-100 p-1 row_employe" data-bs-target="#modal_details" data-bs-toggle="modal" id="'+ reponse[i].id + '"  style="background:#c9f7cd;border-radius:25px;border-bottom:3px solid darkgreen;margin-right:10px;"><div class="col-5"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></div><div class="col-7"><label class="ms-2 text-dark" style="font-size:9px;font-weight:bold;width:100px;position:left;">' + reponse[i].poste + '</label><br><label class="ms-2 text-danger fw-bold" style="font-size:10px;font-weight:bold;width:100px;position:left;">' + reponse[i].nom + '</label></div></div><br>'
                                    }
                                } else {
                                    nb_absent = nb_absent + 1
                                    if (reponse[i].chef_quart === true) {
                                        contenu = contenu + '<div class="row me-2 text-danger fw-bold w-100 p-1 row_employe" data-bs-target="#modal_details" data-bs-toggle="modal" id="'+ reponse[i].id + '"   style="background:#f7b6b6;border-radius:25px;border-bottom:3px solid red;margin-right:10px;"><div class="col-5"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></div><div class="col-6"><label class="ms-2" style="font-size:13px;font-weight:bold;width:100px;position:left;">' + reponse[i].poste + '</label><label class="ms-2 text-dark fw-bold" style="font-size:10px;font-weight:bold;width:100px;position:left;">' + reponse[i].nom + '</label></div><div class="col-1"><i class="fa-solid fa-award ms-2 text-primary" title="Chef de quart"></i></div></div><br>'
                                    } else {
                                        contenu = contenu + '<div class="row me-2 fw-bold text-dark w-100 p-1 row_employe" data-bs-target="#modal_details" data-bs-toggle="modal" id="'+ reponse[i].id + '"   style="background:#fae3e3;border-radius:25px;border-bottom:3px solid red;margin-right:10px;"><div class="col-5"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></div><div class="col-7"><label class="ms-2 text-dark" style="font-size:11px;font-weight:bold;width:100px;position:left;">' + reponse[i].poste + '</label><br><label class="ms-2 text-danger fw-bold" style="font-size:10px;font-weight:bold;width:100px;position:left;">' + reponse[i].nom + '</label></div></div><br>'
                                    }
                                }
                         }
                    }
                    effectif_quart = effectif_quart + nb_total;
                    contenu += '</div>'

                    document.getElementById(controle).insertAdjacentHTML("beforeend", contenu);

                    if (id_equipe === 1){
                        document.getElementById("div_totalA").innerHTML = '<span class="fw-bold">Nb Total :</span><span class="fw-bold text-danger ms-1">'+ nb_total + '</span><span class="fw-bold ms-4">Absents :</span><span class="fw-bold text-danger ms-1">'+ nb_absent + '</span>';
                    } else if (id_equipe === 2){
                        document.getElementById("div_totalB").innerHTML = '<span class="fw-bold">Nb Total :</span><span class="fw-bold text-danger ms-1">'+ nb_total + '</span><span class="fw-bold ms-4">Absents :</span><span class="fw-bold text-danger ms-1">'+ nb_absent + '</span>';
                    } else if (id_equipe === 3){
                        document.getElementById("div_totalC").innerHTML = '<span class="fw-bold">Nb Total :</span><span class="fw-bold text-danger ms-1">'+ nb_total + '</span><span class="fw-bold ms-4">Absents :</span><span class="fw-bold text-danger ms-1">'+ nb_absent + '</span>';
                    } else if (id_equipe ===4){
                        document.getElementById("div_totalD").innerHTML = '<span class="fw-bold">Nb Total :</span><span class="fw-bold text-danger ms-1">'+ nb_total + '</span><span class="fw-bold ms-4">Absents :</span><span class="fw-bold text-danger ms-1">'+ nb_absent + '</span>';
                    }
                }
            });
        }

        function getHnAjourdhui(date) {
            let contenu = "";
            let nb_presents = 0;
            let nb_absents = 0;
            let nb_attentes = 0;
            $.ajax({
                url: '{{ path('rh_accueil') }}/getHnDuJour/' + date,
                type: 'POST',
                success: function (response) {
                    let reponse = JSON.parse(response)
                    contenu += '<div class="row container ms-5"><label class="p-1 m-1 sticky-top" style="background: #d4d1d1;border-right: 10px;" id="lbl_nb_hn"></label>'
                    contenu += '<div class="d-inline-flex text-white m-1 py-auto" style="border-bottom: 2px solid white;"><span class="me-4">Légende : </span><span class="me-2 mt-2" style="width: 15px;height: 15px;background-color: #9de3bb;"></span>présent<span class="ms-4 me-2 mt-2" style="width: 15px;height: 15px;background-color: #e3cc9d;"></span>Pas encore arrivé<span class="ms-4 me-2 mt-2" style="width: 15px;height: 15px;background-color: #e39daf;"></span>absent<i class="fa fa-check-circle ms-5 rounded-circle  mt-2" style="font-size: 16px;color: aquamarine"></i> à l\'heure<i class="fa fa-thumbs-down ms-3 rounded-circle  mt-2" style="font-size: 16px;color: hotpink"></i> en retard</div>'

                    for (var i = 0; i < reponse.length; i++) {
                        presents_jour_hn = presents_jour_hn + 1;
                        if (reponse[i].present === true){
                            nb_presents = nb_presents + 1;
                            contenu += '<div class="col-3 m-2 row_employe" id="'+ reponse[i].id + '" data-bs-target="#modal_details" data-bs-toggle="modal" style="background: #9de3bb;border: 1px lightgrey; border-top: 3px solid darkgreen;border-radius: 10px;box-shadow: 2px 2px #868a87;">'
                        } else {
                            if (reponse[i].attente === true && reponse[i].heure_arrivee === ""){
                                nb_attentes = nb_attentes +1;
                                contenu += '<div class="col-3 m-2 row_employe"  id="'+ reponse[i].id + '"  data-bs-target="#modal_details" data-bs-toggle="modal" style="background: #f9e1bf;border: 1px lightgrey; border-top: 3px solid darkgreen;border-radius: 10px;box-shadow: 2px 2px #868a87;">'
                            } else {
                                nb_absents = nb_absents +1;
                                contenu += '<div class="col-3 m-2 row_employe"  id="'+ reponse[i].id + '"  data-bs-target="#modal_details" data-bs-toggle="modal" style="background: #e39daf;border: 1px lightgrey; border-top: 3px solid red;border-radius: 10px;box-shadow: 2px 2px #cdbac3;">'
                            }
                           }

                        contenu += '<div style="height:150px;" class="text-center"><img class="rounded-circle thumbnail mx-auto" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" width="64" alt=""> '
                        contenu += '<div class="fw-bold p-0" style="font-size: 16px">' + reponse[i].nom + '</div>'
                        contenu += '<div class="fw-bold text-danger" style="font-size: 11px">' + reponse[i].poste + '</div></div>'

                        if (reponse[i].present === true){
                            contenu += '<div class="fw-bold text-white bg-primary mt-1 mb-1 conttainer" style="font-size: 14px;border-radius: 10px;">' + reponse[i].heure_travail  + ' <i class="fa-solid fa-arrow-right text-white ms-2 me-2"></i>' + reponse[i].heure_arrivee
                            if (reponse[i].retard === false) {
                                contenu += '<i class="fa fa-check-circle ms-3 rounded-circle m-1 bg-white text-success" style="font-size: 16px;padding: 1px;padding-right: 5px;"></i></div>'
                            } else {
                                contenu += '<i class="fa fa-thumbs-down ms-3 rounded-circle m-1 p-1 bg-white text-danger" style="font-size: 16px;"></i></div>'
                            }
                        } else {
                            if (reponse[i].attente === true && reponse[i].heure_arrivee === ""){
                                contenu += '<div class="fw-bold text-dark bg-warning p-1 mt-1 mb-1 conttainer" style="font-size: 14px;border-radius: 10px;">' + reponse[i].heure_travail
                            } else {
                                contenu += '<div class="fw-bold text-white bg-danger p-1 mt-1 mb-1 conttainer" style="font-size: 14px;border-radius: 10px;">' + reponse[i].heure_travail
                            }
                            contenu += '</div>'
                        }
                            contenu += '</div>'
                    }
                    contenu += '</div>'
                    document.querySelector(".hn_jour").innerHTML = contenu;
                    document.querySelector("#lbl_nb_hn").innerHTML = '<span class="fw-bold">Présents :</span><span class="fw-bold text-danger ms-1">'+ nb_presents + '</span><span class="fw-bold ms-4">En attente :</span><span class="fw-bold text-danger ms-1">'+ nb_attentes + '</span><span class="fw-bold ms-4">Absents :</span><span class="fw-bold text-danger ms-1">'+ nb_absents + '</span>';
                    $(".btn-presents").text(presents_jour + " présent(s)")

                    document.querySelector(".acc_hn").innerHTML ='Heures normales et personnalisées <span class="ms-5">( ' + nb_presents + '/' + presents_jour_hn + ')</span>';

                }
            });
        }

        function getEmployeDetail(date, id_employe) {
            let contenu = "";
            document.querySelector(".details_emp").innerHTML = '<h3 class="text-primary">Chargement détails...</h3>'
            $.ajax({
                url: '{{ path('rh_accueil') }}/getDetailsPresenceEmploye/json/' + date + '/'  + id_employe,
                type: 'POST',
                success: function (response) {
                    let reponse = JSON.parse(response)

                    contenu += '<div class="col-5 text-center">'
                    contenu += '<img class="employe_img" src="{{ asset('/images/users/') }}' + reponse.PHOTO + '" alt="user">'
                    contenu += '<h5 class="fw-bold  text-center employe_name">' + reponse.NAME + '</h5>'
                    contenu += '<h6 class="fw-bold text-center p-2 mt-2 employe_poste" style="background: #d2f3d7;color: #095439">' + reponse.POSTE + '</h5>'
                    contenu += '</div>'
                    contenu += '<div class="col-6 offset-1 text-center" style="border-left: 1px solid lightgrey;max-height: 500px;overflow-y: scroll;">'
                    contenu += '<div class="steps-vertical details_horaires">'

                    if (reponse.DATA.length > 0){
                        for(var i=0; i < reponse.DATA.length; i++){
                            if (reponse.DATA[i].TYPE_ACCES === "ENTREE"){
                                contenu += '<div class="step-vertical complete">'
                                contenu += '<div class="step-vertical-icon">'
                                contenu += '<i class="fas fa-check"></i>'
                            } else {
                                contenu += '<div class="step-vertical out">'
                                contenu += '<div class="step-vertical-icon">'
                                contenu += '<i class="fas fa-sign-out"></i>'
                            }
                            contenu += '</div>'
                            contenu += '<div class="step-vertical-content">'
                            contenu += '<h4 class="fw-bold">' + reponse.DATA[i].TYPE_ACCES + '</h4>'

                            const date = new Date(reponse.DATA[i].CHECKTIME_DAY);
                            const options = { day: '2-digit', month: '2-digit', year: 'numeric' };
                            const formattedDate = date.toLocaleDateString('fr-FR', options);

                            if (reponse.DATA[i].TYPE_ACCES === "ENTREE"){
                                contenu += '<small class="fw-bold text-primary right"><span style="color: #5B21B6">' + reponse.DATA[i].CHECKTIME_TIME + '</span><span class="ms-2">' +  formattedDate + '</span></small>'
                            } else {
                                contenu += '<small class="fw-bold text-danger"><span>' + reponse.DATA[i].CHECKTIME_TIME + '</span><span class="ms-2 text-danger">' +   formattedDate + '</span></small>'
                            }
                            contenu += '</div>'
                            contenu += '</div>'
                        }

                    } else {
                        contenu += '<div class="bg-warning text-danger text-center p-2 mt-2 h6 mx-auto" style="width: 100%;border 2px solid red">Aucune donnée de présence</div>'
                    }

                    contenu += '</div>'
                    contenu += '</div>'

                    document.querySelector(".details_emp").innerHTML = contenu;
                },
                error : function (){
                    document.querySelector(".details_emp").innerHTML = '<h3 class="text-danger">Erreur chargement...</h3>'
                }
            });
        }

        function presents(){
            presents_jour = 0;
            effectif_quart = 0;
            presents_jour_hn = 0;
            $(".btn-presents").text("Chargement...")
            getQuartsAjourdhui($('#date1').val())
            getHnAjourdhui($('#date1').val())
        }
    </script>
{% endblock %}

