{% extends 'rh/_layout.html.twig' %}

{% block title %}Historique des mouvements{% endblock %}

{% block rh_contenu %}
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="mb-1">Historique des mouvements</h1>
                <p class="mb-0 small">Chaque changement d'équipe, d'horaire ou de régime de pointage est conservé ici, avec sa date.</p>
            </div>
            <a href="{{ path('rh_app_employes') }}" class="btn btn-outline-dark">
                <i class="fa fa-users me-1"></i> Fichier employés
            </a>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label" for="historique_employe">Employé</label>
                        <select class="form-select" id="historique_employe">
                            <option value="0">Sélectionnez un employé…</option>
                            {% for employe in employes %}
                                <option value="{{ employe.id }}">{{ employe.nomPrenoms }}{% if employe.matricule %} — {{ employe.matricule }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <button type="button" class="btn btn-outline-danger w-100" id="btn_reinit" disabled>
                            <i class="fa fa-undo me-1"></i> Réinitialiser l'historique
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center" style="color:#5a371e;">
                <span>Mouvements enregistrés</span>
                <span class="badge" style="background:#f3ece4;color:#5a371e;" id="historique_total">0</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" id="tbl_historique">
                    <thead>
                        <tr>
                            <th style="width:140px;">Date</th>
                            <th style="width:260px;">Opération</th>
                            <th>Nouvelle valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="3" class="text-center py-4" id="historique_vide">
                                Sélectionnez un employé pour afficher son historique.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var urlListe = '{{ path('rh_get_data_historique', {id_employe: 0}) }}';
            var urlReinit = '{{ path('rh_initialize_history', {id_employe: 0}) }}';
            var select = document.getElementById('historique_employe');
            var bouton = document.getElementById('btn_reinit');
            var corps = document.querySelector('#tbl_historique tbody');
            var total = document.getElementById('historique_total');

            var libelles = {
                'Changement Equipe': 'Changement d’équipe',
                'Changement Type Horaire': 'Changement de type d’horaire',
                'Changement Type Etat': 'Changement de régime de pointage'
            };

            function echapper(texte) {
                var d = document.createElement('div');
                d.textContent = texte === null || texte === undefined ? '' : String(texte);
                return d.innerHTML;
            }

            function charger() {
                var id = select.value;
                if (id === '0') {
                    corps.innerHTML = '<tr><td colspan="3" class="text-center py-4">Sélectionnez un employé pour afficher son historique.</td></tr>';
                    total.textContent = '0';
                    bouton.disabled = true;
                    return;
                }

                bouton.disabled = false;
                corps.innerHTML = '<tr><td colspan="3" class="text-center py-4">Chargement…</td></tr>';

                fetch(urlListe.replace('/0', '/' + id), {headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (r) { return r.json(); })
                    .then(function (donnees) {
                        var lignes = '';
                        var nombre = 0;
                        (donnees || []).forEach(function (item) {
                            if (item.resultat) {
                                return;
                            }
                            nombre++;
                            var operation = libelles[item.operation] || item.operation || '—';
                            lignes += '<tr>'
                                + '<td>' + echapper(item.date_operation) + '</td>'
                                + '<td>' + echapper(operation) + '</td>'
                                + '<td>' + echapper(item.valeur) + '</td>'
                                + '</tr>';
                        });

                        if (nombre === 0) {
                            corps.innerHTML = '<tr><td colspan="3" class="text-center py-4">Aucun mouvement enregistré pour cet employé.</td></tr>';
                        } else {
                            corps.innerHTML = lignes;
                        }
                        total.textContent = String(nombre);
                    })
                    .catch(function () {
                        corps.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-danger">Impossible de charger l’historique : vérifiez la connexion au serveur.</td></tr>';
                    });
            }

            select.addEventListener('change', charger);

            bouton.addEventListener('click', function () {
                var id = select.value;
                if (id === '0') { return; }
                if (!window.confirm('Réinitialiser l’historique de cet employé ? Les mouvements enregistrés seront supprimés.')) {
                    return;
                }
                fetch(urlReinit.replace('/0', '/' + id), {headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (r) { return r.json(); })
                    .then(function () { charger(); })
                    .catch(function () { window.alert('La réinitialisation a échoué : vérifiez la connexion au serveur.'); });
            });
        })();
    </script>
{% endblock %}