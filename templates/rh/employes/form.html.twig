{% extends 'base.html.twig' %}
{% block title %}{{ estCreation ? 'Nouvel employe' : 'Modifier l\'employe' }} — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_employes') }}">Employes</a></span>
    <span class="breadcrumb-item">{{ estCreation ? 'Nouveau' : employe.nomComplet }}</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header mb-3">
        <h1 class="h4 mb-1">{{ estCreation ? 'Nouvel employe' : 'Modifier ' ~ employe.nomComplet }}</h1>
        <p class="text-muted mb-0">Matricule {{ donnees.matricule ? donnees.matricule : 'attribue a l\'enregistrement' }}</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger py-2">
            <ul class="mb-0 small">{% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_employe') }}">

        <div class="row g-3 align-items-center mb-3">
            <div class="col-auto">
                {% if employe.photo %}
                    <img src="{{ asset('data/rh/' ~ employe.photo) }}" alt="Photo de l'employe"
                         style="width:88px;height:88px;object-fit:cover;border-radius:50%;border:2px solid #e9ded5;">
                {% else %}
                    <div style="width:88px;height:88px;border-radius:50%;background:#faf6f2;border:2px dashed #e9ded5;display:flex;align-items:center;justify-content:center;color:#7a4c33;font-size:.72rem;text-align:center;line-height:1.1;">Sans<br>photo</div>
                {% endif %}
            </div>
            <div class="col">
                <label class="form-label small mb-1" for="photo">Photo de l'employe (facultative)</label>
                <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm">
                <div class="form-text">JPG, PNG ou WEBP, 4 Mo maximum. Laisser vide pour conserver la photo actuelle.</div>
            </div>
        </div>

        <h2 class="h6 mb-2" style="color:#5a371e;">Identite</h2>
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="matricule">Matricule</label>
                <input id="matricule" name="matricule" value="{{ donnees.matricule }}" class="form-control form-control-sm" placeholder="Auto si vide">
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="nom">Nom *</label>
                <input id="nom" name="nom" value="{{ donnees.nom }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="prenoms">Prenoms *</label>
                <input id="prenoms" name="prenoms" value="{{ donnees.prenoms }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="date_naissance">Date de naissance</label>
                <input type="date" id="date_naissance" name="date_naissance" value="{{ donnees.date_naissance }}" class="form-control form-control-sm">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="sexe">Sexe</label>
                <select id="sexe" name="sexe" class="form-select form-select-sm">
                    {% for cle, libelle in sexes %}<option value="{{ cle }}" {{ cle == donnees.sexe ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="situation">Situation matrimoniale</label>
                <select id="situation" name="situation" class="form-select form-select-sm">
                    {% for cle, libelle in situations %}<option value="{{ cle }}" {{ cle == donnees.situation ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="nationalite">Nationalite</label>
                <input id="nationalite" name="nationalite" value="{{ donnees.nationalite }}" class="form-control form-control-sm">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="numero_cnps">Numero CNPS</label>
                <input id="numero_cnps" name="numero_cnps" value="{{ donnees.numero_cnps }}" class="form-control form-control-sm">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="code_pointage">Code de pointage (ZKTECO)</label>
                <input id="code_pointage" name="code_pointage" value="{{ donnees.code_pointage|default('') }}" class="form-control form-control-sm" placeholder="Badge / Badgenumber">
                <div class="form-text">Numero de badge de la pointeuse, pour l'import des presences.</div>
            </div>
        </div>

        <h2 class="h6 mb-2" style="color:#5a371e;">Coordonnees</h2>
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="telephone">Telephone</label>
                <input id="telephone" name="telephone" value="{{ donnees.telephone }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ donnees.email }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="adresse">Adresse</label>
                <input id="adresse" name="adresse" value="{{ donnees.adresse }}" class="form-control form-control-sm">
            </div>
        </div>

        <h2 class="h6 mb-2" style="color:#5a371e;">Affectation</h2>
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="direction">Direction</label>
                <select id="direction" name="direction" class="form-select form-select-sm">
                    <option value="">Non affecte</option>
                    {% for d in directions %}<option value="{{ d.id }}" {{ d.id == donnees.direction ? 'selected' : '' }}>{{ d.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="service">Service</label>
                <select id="service" name="service" class="form-select form-select-sm">
                    <option value="">Non affecte</option>
                    {% for s in services %}<option value="{{ s.id }}" {{ s.id == donnees.service ? 'selected' : '' }}>{{ s.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="poste">Poste</label>
                <select id="poste" name="poste" class="form-select form-select-sm">
                    <option value="">Non affecte</option>
                    {% for p in postes %}<option value="{{ p.id }}" {{ p.id == donnees.poste ? 'selected' : '' }}>{{ p.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="manager">Responsable hierarchique</label>
                <select id="manager" name="manager" class="form-select form-select-sm">
                    <option value="">Aucun</option>
                    {% for m in managers %}<option value="{{ m.id }}" {{ m.id == donnees.manager ? 'selected' : '' }}>{{ m.nomComplet }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="utilisateur">Compte utilisateur lie</label>
                <select id="utilisateur" name="utilisateur" class="form-select form-select-sm">
                    <option value="">Aucun compte</option>
                    {% for u in utilisateurs %}<option value="{{ u.id }}" {{ u.id == donnees.utilisateur ? 'selected' : '' }}>{{ u.nom }} {{ u.prenoms }} ({{ u.email }})</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="date_embauche">Date d'embauche</label>
                <input type="date" id="date_embauche" name="date_embauche" value="{{ donnees.date_embauche }}" class="form-control form-control-sm">
            </div>
        </div>

        <h2 class="h6 mb-2" style="color:#5a371e;">Statut</h2>
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="statut">Statut</label>
                <select id="statut" name="statut" class="form-select form-select-sm">
                    {% for cle, libelle in statuts %}<option value="{{ cle }}" {{ cle == donnees.statut ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="date_sortie">Date de sortie</label>
                <input type="date" id="date_sortie" name="date_sortie" value="{{ donnees.date_sortie }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="motif_sortie">Motif de sortie</label>
                <input id="motif_sortie" name="motif_sortie" value="{{ donnees.motif_sortie }}" class="form-control form-control-sm">
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-cacao" type="submit">Enregistrer</button>
            <a href="{{ estCreation ? path('rh_employes') : path('rh_employes_fiche', {id: employe.id}) }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
