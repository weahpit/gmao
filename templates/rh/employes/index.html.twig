        function supprimeEmploye(id_employe){
            $.ajax({
                url : '{{ path('rh_accueil') }}/rmEmploye/' + id_employe,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse.code === "SUCCESS"){
                        render_toast_value("Employé retiré avec succès !", 1)
                        getListeEmployes()
                    } else {
                        render_toast_value("Erreur constatée !", 0)
                    }
                },
                error : function (erreur){
                    render_toast_value("Erreur constatée !" + erreur, 0)
                }
            })
            $('#modal_supprimer .btn-close').click()
        }

