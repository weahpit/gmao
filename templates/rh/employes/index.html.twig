        function afficheEmployeDetails(id_employe){
            let contenu = "";
            console.log("OK");
            // document.querySelector('.div_presences').innerHTML = '<div class="text-center w-100" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
            $.ajax({
                url : '{{ path('rh_accueil') }}/getEmployeData/' + id_employe,
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)

                    if (reponse.length > 0) {
                        $('#lbl_employe').html('<i class="fa fa-user-edit me-2"></i>Modifier l\'agent <span class="text-danger">' + reponse[0].nom + '</span>')
                        document.querySelector('.modal-header').style = "background:lightblue;"


                        $('.btn_add').text('Modifier l\'employé');
                        $('#modal_employes').modal('show');
                        $("#id_employe").val(reponse[0].id);
                        $("#mle").val(reponse[0].mle);
                        $("#nom").val(reponse[0].nom);
                        $("#datenaiss").val(reponse[0].datenaiss);
                        $("#genre").val(reponse[0].sexe);
                        $("#zkteco").val(reponse[0].code_zkteco);
                        $("#type_horaire").val(reponse[0].type_horaire);
                        if (reponse[0].type_horaire === 3){
                            document.querySelector("#lbl_personnalise").innerText = reponse[0].h_personnalise
                        } else {
                            document.querySelector("#lbl_personnalise").innerText = ""
                        }
                        $("#departement").val(reponse[0].departement);
                        getPostes(reponse[0].departement);
                        setTimeout( function (){
                            $('#poste').val(reponse[0].poste)
                        }, 1000)


                        document.querySelector('#poste').value = reponse[0].poste
                        if (reponse[0].soumi === true){
                            $('#soumi').val("1");
                            //document.querySelector("#soumi").checked == true;
                        } else {
                            $('#soumi').val("2");
                        }
                        let url = "{{ asset('/images/users/') }}" + reponse[0].photo
                        document.getElementById("photo").src = url;

                        //document.querySelector("#poste").value = reponse[0].fonction;

                    } else {
                        render_toast_value('Une erreur s\'est produite !', 0)
                    }
                }
            })

        }

