            obj.type_horaire =  $("#type_horaire").val();
            obj.personnalise =  $("#personnalise").val();
            let id_employe = $('#id_employe').val()
            var data = JSON.stringify(obj);
            console.log(data);

            const formData = new FormData();
            formData.append("photo", fileInput.files[0]);
