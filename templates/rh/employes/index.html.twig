{% extends 'base.html.twig' %}
{% block title %}Employes — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('tdb_role') }}">Accueil</a></span>
    <span class="breadcrumb-item"><a href="{{ path('rh_dashboard') }}">Ressources humaines</a></span>
    <span class="breadcrumb-item">Employes</span>
{% endblock %}
{% block body %}<link rel="stylesheet" href="{{ asset('css/citrac/evolutions-v5.css') }}">
<div class="container-fluid py-3">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Employes</h1>
            <p class="text-muted mb-0">{{ effectif }} employe(s) correspondant au filtre.</p>
        </div>
        <a href="{{ path('rh_employes_new') }}" class="btn btn-sm btn-cacao">+ Nouvel employe</a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }} py-2">{{ message }}</div>{% endfor %}
    {% endfor %}

    <form method="get" action="{{ path('rh_employes') }}" class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="q">Recherche</label>
                <input type="search" id="q" name="q" value="{{ terme }}" class="form-control form-control-sm" placeholder="Matricule, nom, prenom, email">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="service">Service</label>
                <select id="service" name="service" class="form-select form-select-sm">
                    <option value="">Tous les services</option>
                    {% for s in services %}<option value="{{ s.id }}" {{ s.id == serviceId ? 'selected' : '' }}>{{ s.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="statut">Statut</label>
                <select id="statut" name="statut" class="form-select form-select-sm">
                    <option value="">Tous les statuts</option>
                    {% for cle, libelle in statuts %}<option value="{{ cle }}" {{ cle == statut ? 'selected' : '' }}>{{ libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-sm btn-cacao" type="submit">Filtrer</button>
                <a href="{{ path('rh_employes') }}" class="btn btn-sm btn-outline-secondary">Effacer</a>
            </div>
        </div>
    </form>

    <div class="table-responsive" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Matricule</th><th>Nom</th><th>Service</th><th>Poste</th><th>Embauche</th><th>Statut</th><th></th>
                </tr>
            </thead>
            <tbody>
            {% for employe in employes %}
                <tr class="{{ employe.statut == 'sorti' ? 'rh-sorti' : '' }}">
                    <td>{{ employe.matricule }}</td>
                    <td>
                        <span class="d-inline-flex align-items-center gap-2">
                            {% if employe.photo %}
                                <img src="{{ asset('data/rh/' ~ employe.photo) }}" alt=""
                                     style="width:26px;height:26px;border-radius:50%;object-fit:cover;border:1px solid #e9ded5;">
                            {% endif %}
                            <a href="{{ path('rh_employes_fiche', {id: employe.id}) }}" class="text-decoration-none">{{ employe.nomComplet }}</a>
                        </span>
                        <div class="small text-muted">{{ employe.email ? employe.email : '' }}</div>
                    </td>
                    <td>{{ employe.service ? employe.service.libelle : '-' }}</td>
                    <td>{{ employe.poste ? employe.poste.libelle : '-' }}</td>
                    <td>{{ employe.dateEmbauche ? employe.dateEmbauche|date('d/m/Y') : '-' }}</td>
                    <td><span class="badge {{ employe.statut == 'actif' ? 'rh-actif' : '' }}" style="background:#f2e7dd; color:#5a371e;">{{ employe.statutLibelle }}</span></td>
                    <td class="text-end"><a href="{{ path('rh_employes_fiche', {id: employe.id}) }}" class="btn btn-sm btn-outline-secondary">Fiche</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucun employe ne correspond a la recherche.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
