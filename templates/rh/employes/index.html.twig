{% extends 'rh/_layout.html.twig' %}

{% block title %}Fichier Employés{% endblock %}

{% block rh_contenu %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
    <div class="mx-auto container mt-1" style="background: linear-gradient(#fffdfb, #f4ece3);border-top: 3px solid #7a4c33;">
        <h1 class="mb-2 fw-bold text-center">Fichier Employés <button class="mx-auto text-center p-1 pb-2 mt-2" id="btn-ajout" style="border: 2px solid #5a371e; font-size: 16px;width: 100px;background: #5a371e;color: white;float: right;" data-bs-target="#modal_employes"  data-bs-toggle="modal">Ajouter</button></h1>

        <div class="text-center container w-auto p-2 bg-light mb-2 mt-2 border border-2 border-dark">
            <label for="critere" class="fw-bold me-4" style="font-size: 24px;">Filtre</label>
            <select class="mt-2 text-dark mb-2" name="critere" id="critere" style="border: #a89b8c 1px solid;background: rgba(61,41,41,0.14);padding: 5px;font-size: 18px;width: 250px;border-bottom: 2px solid #a89b8c">
                <option value="0">Sélectionnez un critère</option>
                <option value="1">Par Equipe</option>
                <option value="2">Par Département</option>
                <option value="3">Par Poste</option>
            </select>
            <select class="mt-2 text-dark" name="select_equipe" id="select_equipe" style="border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;width: 250px;display: none;">
                <option value="0">Sélectionnez une équipe</option>
            </select>
            <select class="mt-2 text-dark" name="select_departement" id="select_departement" style="border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;width: 250px;display: none;">
                <option value="0">Sélectionnez un département</option>
            </select>
            <select class="mt-2 text-dark" name="select_poste" id="select_poste" style="border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;width: 250px;display: none;">
                <option value="0">Sélectionnez un poste</option>
            </select>
        </div>
        <div class="fw-bold d-inline-flex mx-auto">
            <span style="text-decoration: underline">légende : </span><div class="p-1 ms-5 me-2" style="width: 20px;height: 20px; background: #f3ece4;font-size:14px;;border: 1px solid #abf9cf"></div></center>Soumis au pointage
        </div>
        <hr style="border: 2px solid black;">

        <div class="mt-2 div_contenu m-4 bg-white p-2" style="border: 1px lightgrey;border-top: 3px solid #5a371e;"></div>



    </div>

    <div class="modal fade" id="modal_employes" aria-hidden="true" aria-labelledby="modal_horaires" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered  modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="lbl_employe">Ajouter un employé</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="row col-md-8">
                            <div class="col md 4">
                                <input class="mb-2" type="hidden" disabled id="id_employe" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                <label class="fw-bold" for="mle">Matricule</label><input class="mb-2" type="text" id="mle" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                <label class="fw-bold" for="zkteco">Code ZKTeco</label><input class="mb-2" type="text" id="zkteco" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                <label class="fw-bold" for="nom">Nom & Prénoms</label><input class="mb-2" type="text" id="nom" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                <label class="fw-bold" for="datenaiss">Date de naissance</label><input class="mb-2" type="date" id="datenaiss" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">

                            </div>
                            <div class="col md 4">
                                <label class="fw-bold" for="genre">Genre</label>
                                <select class="mb-2" name="genre" id="genre" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                    <option value="2">Masculin</option>
                                    <option value="1">Féminin</option>
                                </select>
                                <label class="fw-bold" for="departement">Département</label>
                                <select name="departement" id="departement" class="mb-2" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                </select>
                                <label class="fw-bold" for="poste">Poste</label>
                                <select name="poste" id="poste" class="mb-2" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                </select>
                            </div>
                            <div class="col md 4">
                                <label class="fw-bold text-danger" for="soumi">Soumi à la pointeuse ?</label>
                                <select name="soumi" class="mb-2" id="soumi" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                    <option value="1">OUI</option>
                                    <option value="2">NON</option>
                                </select>
                                <label class="fw-bold mt-2" for="type_horaire">Type Horraire</label>
                                <select name="type_horaire" class="mb-2" id="type_horaire" style="border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;">
                                </select>
                                <label class="text-danger fw-bold p-1 text-center w-100" style="border-radius: 25px;background: #dbdcdb" id="lbl_personnalise"></label>
                                <select name="personnalise" class="mb-2" id="personnalise" style="display: none">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-body profile-card">
                                <center class="mt-4">
                                    <img src=""
                                         style="border: #7a4c33 dashed 2px;" width="200" id="photo"/>

                                    <div class="w-100 mt-3">
                                        <input type="file" id="fileInput" name="photo">
                                    </div>
                                </center>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn_add" data-bs-dismiss="modal" aria-label="Close" style="border: 2px solid #5a371e;background: #5a371e;color: white">Ajouter l'employé</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal_postes" aria-hidden="true" aria-labelledby="modal_postes" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Postes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input class="ms-2" type="text" id="txt_poste" style="border: 2px solid #5a371e; font-size: 16px;margin-right: 10px;width: 97%;text-transform: uppercase;" placeholder="saisissez le poste...">
                    <div class="m-2 contenudiv  " style="border: 2px solid #5a371e;height:250px;overflow-y: scroll;">

                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn w-100 btn_add_poste" style="border: 2px solid #5a371e;background: #5a371e;color: white">Ajouter le poste</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal_photo" aria-hidden="true" aria-labelledby="modal_postes" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-center">
            <div class="modal-content">

                <div class="modal-body text-center">
                    <img src="" alt="" id="photo_grand" height="512">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal_supprimer" aria-hidden="true" aria-labelledby="modal_postes" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-center">
            <div class="modal-content" style="border-radius: 0; border: 4px solid #7a4c33;">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h1 class="fw-light text-center">Voulez-vous supprimer cet employé ?</h1>
                    <div class="d-inline-flex text-center mt-2">
                        <a href="#" class="btn btn-primary p-2 m-1"  data-bs-dismiss="modal" aria-label="Close" style="font-size: 18px;border-radius: 0;width: 200px;" id="btn-refuser">Annuler</a>
                        <a href="#" class="btn btn-danger p-2 m-1" style="font-size: 18px;border-radius: 0;width: 200px;" id="btn-retirer">Retirer</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="//cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.dataTables.css">

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.html5.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('rh/assets/js/utilitaires.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('rh/assets/js/utilitaires.js') }}"></script>
    <script>
        let id_dept = 0;
        let id_employe = 0;
        let id_poste = 0;
        getListeEmployes();
        getDepartements();
        getEquipes();
        getTypeHoraires()
        getPersonnalise()
        document.querySelector('#critere').value="0"
        $('#btn-ajout').on('click', function() {
            const fileInput = document.querySelector("#fileInput");

            $('#id_employe').val(0)
            $('#lbl_employe').html('<i class="fa fa-user me-2"></i>Ajouter Agent')
            document.querySelector('.modal-header').style = "background:lightgreen;"
            fileInput.value = "";
            $('.btn_add').text('Ajouter l\'employé');

            reinitialise_modal_employes()
            getDepartements();
            // document.getElementById("poste").disabled = false;
            document.getElementById("soumi").disabled = false;
            document.getElementById("type_horaire").disabled = false;
        });
        $('.btn_add').on('click', function() {
            ajout_employe();
        });
        $('#critere').on('change', function() {
            let value = $('#critere').val();
            document.querySelector('#select_departement').value="0"
            document.querySelector('#select_poste').value="0"
            document.querySelector('#select_equipe').value="0"
            if (value === "0"){
                document.querySelector('#select_departement').style="display:none"
                document.querySelector('#select_poste').style="display:none"
                document.querySelector('#select_equipe').style="display:none"
                getListeEmployes();
            } else if  (value === "1"){
                document.querySelector('#select_departement').style="display:none"
                document.querySelector('#select_poste').style="display:none"
                document.querySelector('#select_equipe').style="display:inline;border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;font-weight:bold;width: 250px;border-bottom: 2px solid #ff6700;"
            }else if  (value === "2"){
                document.querySelector('#select_departement').style="display:inline;border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;font-weight:bold;width: 300px;border-bottom: 2px solid #ff6700;"
                document.querySelector('#select_poste').style="display:none"
                document.querySelector('#select_equipe').style="display:none"
            }else if  (value === "3"){
                document.querySelector('#select_departement').style="display:inline;border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;font-weight:bold;width: 300px;border-bottom: 2px solid #ff6700;"
                document.querySelector('#select_poste').style="display:inline;border: #a89b8c 1px solid;background: rgba(101,116,75,0.14);padding: 5px;font-size: 18px;font-weight:bold;width: 250px;border-bottom: 2px solid #ff6700;"
                document.querySelector('#select_equipe').style="display:none"
            }
        });

        $('#select_departement').on('change', function() {
            if ($('#critere').val() === "2" && this.value !== "0"){
                getEmployesByDepartement(this.value)
            } else {
                document.querySelector('.div_contenu').innerHTML = '<h1 class="text-center text-secondary fw-light mt-5">Merci de sélectionner un département SVP!</h1>'
            }
        });
        $('#select_poste').on('change', function() {
            if (this.value !== "0") {
                getEmployesByPoste(this.value)
            } else {
                document.querySelector('.div_contenu').innerHTML = '<h1 class="text-center text-secondary fw-light mt-5">Merci de sélectionner un poste SVP!</h1>'
            }
        })
        $('#select_equipe').on('change', function() {
            if (this.value !== "0") {
                getEmployesByEquipe(this.value)
            } else {
                document.querySelector('.div_contenu').innerHTML = '<h1 class="text-center text-secondary fw-light mt-5">Merci de sélectionner une équipe SVP!</h1>'
            }
        })
        $('#type_horaire').on('change', function() {
            document.querySelector('#personnalise').value = null;
            if (this.value === "3") {
                document.querySelector('#personnalise').style = "display: inline-block;border: 2px solid #5a371e; font-size: 16px;width: 100%;text-transform: uppercase;"
            } else {
                document.querySelector('#personnalise').style = "display:none"
            }
        })

        $('body').on('click','.a_photo', function() {
            document.querySelector("#photo_grand").src = "{{ asset('images/users/') }}" + this.id;
        });
        $('body').on('click','.btn_delete', function() {
            id_employe = this.id;
            $('#modal_supprimer').modal('show')
        });
        $('#btn-retirer').on('click', function() {
            supprimeEmploye(id_employe);
        });
        $('#departement').on('change', function() {
            getPostes(this.value);
        });
        $('#select_departement').on('change', function() {
            getSelectPostes(this.value);
        });
        $('.btn_add_poste').on('click', function() {
            let libelle = $('#txt_poste').val()
            addPoste(id_dept, libelle);
        });

        $('body').on('click', '.btn_edit' , function() {
            reinitialise_modal_employes()
            afficheEmployeDetails(this.id);
            //document.getElementById("poste").disabled = true;
            document.getElementById("soumi").disabled = true;
            document.getElementById("type_horaire").disabled = true;
        });

        $('#fileInput').on('change', function() {
            document.querySelector("#photo_grand").src = this.value;
        });
        document.getElementById("txt_poste").addEventListener("keydown", function(event) {
            if (event.key === "Enter") {
                addPoste(id_dept, this.value);
            }
        });

        /*           Fonctions              */
        function addDepartement(){

            let libelle = $("#lbl_dpt").val();

            if (libelle){

                $.ajax({
                    url : '{{ path('rh_accueil') }}/AddDepartement/' + libelle,
                    type: 'POST',
                    success : function(response){
                        let reponse = JSON.parse(response)
                        if (reponse[0].code === "SUCCESS"){
                            render_toast_value('Département ajouté avec Succès !', 1)
                            getDepartements();
                            $('#lbl_dpt').val('');
                            $('#lbl_dpt').focus();
                        }
                    },
                    error: function (erreur){
                        render_toast_value('Erreur lors de l\'ajout du département !', 0)
                    }
                })
            }
        }

        function getListeEmployes(){
            let contenu = "";
            document.querySelector('.div_contenu').innerHTML = '<div class="text-center w-100 mx-auto" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
            $.ajax({
                url : '{{ path('rh_get_employes') }}',
                type: 'POST',
                success : function(response){
                    let reponse = JSON.parse(response)
                    if (reponse.length > 0) {
                        let contenu = '<div class="text-center" id="lbl_nb_employes"></div><table class="table mx-auto m-2 border" id="tbl_employes" style="width: 100%;">' +
                            '<thead>' +
                            '<tr>' +
                            '<th style="background-color: #8a6a58;color: white;"><i class="fa fa-user" style="font-size: 24px;"></i> </th>' +
                            '<th style="background-color: #8a6a58;color: white;">Matricule</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Code ZKTeco</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Nom et Prénoms</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Sexe</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Date de Naissance</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Département</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Poste</th>' +
                            '<th class="text-center" style="background-color: #8a6a58;color: white;">Type Horaire</th>' +
                            '<th style="background-color: #8a6a58;color: white;">Actions</th>' +
                            '</tr>' +
                            '</thead>' +
                            '<tbody class="body_contenu">';
                        for (var i = 0; i < reponse.length; i++) {

                            contenu = contenu + '<tr style="border-bottom: #7a4c33 1px solid;">'
                            if (reponse[i].soumi === true){
                                if (reponse[i].est_absent === true){
                                    contenu = contenu + '<td class="text-dark" style="background: #e9ded5;font-size:14px;border-bottom: 3px solid red;">';
                                } else {
                                    contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">';
                                }

                                if (reponse[i].photo){
                                    contenu = contenu +'<a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '">' +
                                        '<img style="border-radius:10px;" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></a>' +
                                        ''}
                                contenu = contenu + '</td>';
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].mle + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].code_zkteco + '</span></td>'
                                contenu = contenu + '<td class="text-dark fw-bold" style="background: #f3ece4;font-size:14px;min-width: 300px;">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].sexe + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].datenaiss + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].departement + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">' + reponse[i].fonction + '</span></td>'

                                if (reponse[i].h_personnalise){
                                    contenu = contenu + '<td class="text-dark text-center" style="background: #f3ece4;font-size:14px;"><span>' + reponse[i].type_horaire + '<br><span class="text-danger fw-bold">' + reponse[i].h_personnalise + '</span></span></td>'
                                } else {
                                    if (reponse[i].equipe){
                                        contenu = contenu + '<td class="text-dark text-center" style="background: #f3ece4;font-size:14px;"><span>' + reponse[i].type_horaire + '<br><span class="text-danger fw-bold">' + reponse[i].equipe + '</span></span></td>'
                                    } else {
                                        contenu = contenu + '<td class="text-dark text-center" style="background: #f3ece4;font-size:14px;"><span>' + reponse[i].type_horaire + '</span></td>'
                                    }
                                }


                                contenu = contenu + '<td class="fw-bold text-danger" style="background: #f3ece4;font-size:14px;width: 150px;"><i class="fa fa-edit text-primary btn_edit" data-bs-target="#modal_employes" data-bs-toggle="modal" id="' + reponse[i].id + '" style="cursor: pointer;font-size: 24px;" title="Modifier l\'utilisateur"></i><i class="fa fa-trash ms-2 text-danger btn_delete" id="' + reponse[i].id + '" style="cursor: pointer;font-size: 24px;" title="Supprimer l\'utilisateur"></i> </td>'
                            } else {
                                if (reponse[i].est_absent === true){
                                    contenu = contenu + '<td class="text-dark" style="background: #e9ded5;font-size:14px;border-bottom: 3px solid red;">';
                                } else {
                                    contenu = contenu + '<td class="text-dark" style="background: #f3ece4;font-size:14px;">';
                                }

                                if (reponse[i].photo){contenu = contenu +'<a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '">' +
                                    '<img style="border-radius:10px;" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="64" alt=""></a>'}
                                contenu = contenu + '</td>';
                                contenu = contenu + '<td class="text-dark" style="background: lightyellow">' + reponse[i].mle + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: lightyellow">' + reponse[i].code_zkteco + '</span></td>'
                                contenu = contenu + '<td class="text-dark fw-bold" style="background: lightyellow;min-width: 300px;">' + reponse[i].nom + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: lightyellow">' + reponse[i].sexe + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: lightyellow">' + reponse[i].datenaiss + '</span></td>'
                                contenu = contenu + '<td class="text-dark" style="background: lightyellow">' + reponse[i].departement + '</span></td>'
