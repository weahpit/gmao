{% extends 'base.html.twig' %}
{% block title %}Affecter {{ employe.nomComplet }} — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_employes') }}">Employes</a></span>
    <span class="breadcrumb-item"><a href="{{ path('rh_employes_fiche', {id: employe.id}) }}">{{ employe.nomComplet }}</a></span>
    <span class="breadcrumb-item">Affectation</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header mb-3">
        <h1 class="h4 mb-1">Nouvelle affectation</h1>
        <p class="text-muted mb-0">{{ employe.nomComplet }} — {{ employe.matricule }}. L'affectation actuelle est archivee automatiquement.</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger py-2"><ul class="mb-0 small">{% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}</ul></div>
    {% endif %}

    <form method="post" class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px; max-width:820px;">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_affectation_' ~ employe.id) }}">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="direction">Direction</label>
                <select id="direction" name="direction" class="form-select form-select-sm">
                    <option value="">Inchangee</option>
                    {% for d in directions %}<option value="{{ d.id }}" {{ d.id == donnees.direction ? 'selected' : '' }}>{{ d.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="service">Service</label>
                <select id="service" name="service" class="form-select form-select-sm">
                    <option value="">Inchange</option>
                    {% for s in services %}<option value="{{ s.id }}" {{ s.id == donnees.service ? 'selected' : '' }}>{{ s.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="poste">Poste</label>
                <select id="poste" name="poste" class="form-select form-select-sm">
                    <option value="">Inchange</option>
                    {% for p in postes %}<option value="{{ p.id }}" {{ p.id == donnees.poste ? 'selected' : '' }}>{{ p.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="date_debut">Date d'effet</label>
                <input type="date" id="date_debut" name="date_debut" value="{{ donnees.date_debut }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label small mb-1" for="motif">Motif</label>
                <input id="motif" name="motif" value="{{ donnees.motif }}" class="form-control form-control-sm" placeholder="Promotion, reorganisation, remplacement...">
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-cacao" type="submit">Enregistrer l'affectation</button>
            <a href="{{ path('rh_employes_fiche', {id: employe.id}) }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
