{% extends 'rh/_layout.html.twig' %}

{% block title %}Options{% endblock %}

{% block rh_contenu %}
    <div class="mx-auto text-center mt-5">
        <h1 class="mb-2 fw-bold">Gérer les options</h1>

        <div class="mt-2 div_contenu container">
            <table class="table">
                <thead>
                    <tr>
                        <th style="background-color: #e7e2e2">Libelle</th>
                        <th style="background-color: #e7e2e2">valeur</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="h3 fw-light">
                        <td>Appliquer une tolérance <span class="text-danger">Retard</span></td>
                        <td>
                            <label for="tolerane"></label>
                            <input class="text-center" style="width: 250px;" type="text" id="tolerance" value="{{ options.tolerance }}">
                            <a href="#" class="btn h3 btn-primary" id="btn-tolerance">Appliquer</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('rh/assets/js/utilitaires.js') }}"></script>
    <script>

        $('#btn-tolerance').on("click", function() {
            let tolerance = $('#tolerance').val()

            $.ajax({
                url : '{{ path('rh_accueil') }}/options/edit/' + tolerance,
                type : 'POST',
                success : function (response){
                    render_toast_value('Valeurs mises à jour avec Succès !', 1)
                }
            })
        })

    </script>

{% endblock %}
