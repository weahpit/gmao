{% extends 'base.html.twig' %}
{% block title %}Campagne — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_dashboard') }}">Ressources humaines</a></span>
    <span class="breadcrumb-item">Évaluations</span>
    <span class="breadcrumb-item">Campagne</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }} py-2">{{ message }}</div>{% endfor %}
    {% endfor %}

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">{{ campagne.libelle }}</h1>
            <p class="text-muted mb-0">
                {{ campagne.annee }} · {{ campagne.statutLibelle }}
                {% if campagne.dateDebut %} · du {{ campagne.dateDebut|date('d/m/Y') }}{% endif %}
                {% if campagne.dateFin %} au {{ campagne.dateFin|date('d/m/Y') }}{% endif %}
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('rh_evaluations') }}" class="btn btn-sm btn-outline-secondary">Retour</a>
            <a href="{{ path('rh_evaluations_campagne_pdf', {id: campagne.id}) }}" class="btn btn-sm btn-outline-secondary" target="_blank">Rapport PDF</a>
            {% if estRh and campagne.statut == 'ouverte' %}
                <form method="post" action="{{ path('rh_evaluations_cloturer', {id: campagne.id}) }}" onsubmit="return confirm('Clôturer cette campagne ? Les fiches resteront consultables.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('rh_campagne_cloture_' ~ campagne.id) }}">
                    <button type="submit" class="btn btn-sm btn-cacao">Clôturer la campagne</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 col-md-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Fiches</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ fiches|length }}</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Note moyenne</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ moyenne is not null ? moyenne|number_format(2, ',', ' ') ~ ' / 5' : '—' }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="p-3 h-100" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
                <div class="small text-muted text-uppercase">Critères</div>
                <div class="small">{{ campagne.criteres|length }} critère(s) — poids total {{ campagne.poidsTotal }}</div>
            </div>
        </div>
    </div>

    {% if parStatut is not empty %}
        <div class="p-3 mb-3 d-flex flex-wrap gap-2" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
            {% for cle, total in parStatut %}
                <span class="badge" style="background:#f2e7dd; color:#5a371e;">{{ statuts[cle] ?? cle }} : {{ total }}</span>
            {% endfor %}
        </div>
    {% endif %}

    <div class="table-responsive mb-3" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Employé</th><th>Type</th><th>Note</th><th>Statut</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            {% for fiche in fiches %}
                <tr>
                    <td><strong>{{ fiche.employe ? fiche.employe.nomComplet : 'Employé supprimé' }}</strong></td>
                    <td class="small">{{ fiche.typeLibelle }}</td>
                    <td>{{ fiche.noteGlobale is not null ? fiche.noteGlobale|number_format(2, ',', ' ') : '—' }}</td>
                    <td class="small">{{ fiche.statutLibelle }}</td>
                    <td class="text-end">
                        {% if fiche.employe %}
                            <a href="{{ path('rh_evaluations_saisie', {id: campagne.id, employeId: fiche.employe.id}) }}" class="btn btn-sm btn-outline-secondary">Saisir</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-3">Aucune fiche enregistrée pour cette campagne.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if estRh %}
        <div class="p-3" style="background:#fff;border:1px solid #e9ded5;border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#5a371e;">Démarrer une évaluation</h2>
            <p class="small text-muted mb-2">Choisissez un employé actif pour ouvrir ou reprendre sa fiche.</p>
            <div class="d-flex flex-wrap gap-2">
                {% for employe in employes|slice(0, 40) %}
                    <a href="{{ path('rh_evaluations_saisie', {id: campagne.id, employeId: employe.id}) }}" class="btn btn-sm btn-outline-secondary">{{ employe.nomComplet }}</a>
                {% else %}
                    <span class="text-muted small">Aucun employé actif.</span>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
