<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Présences Journalières</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
<nav class="navbar navbar-expand-lg" style="background: #5a371e;color: white;">
    <div class="container-fluid">
        <a class="navbar-brand" href="#"><img src="{{ asset('rh/assets/images/logo.jpg') }}" alt="" height="48" style="border-bottom: 2px solid #5a371e"></a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <h1 class="mx-auto text-center">PAYROLL - ZKTeco</h1>
            <i class="fa fa-clock me-2" style="font-size: 32px;"></i><span class="text-white fw-bold d-inline-flex flex-right" id="clock"></span>
        </div>
    </div>
</nav>
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </div>
</div>
<div class="m-2" style="border: 3px solid #7a4c33;background-color: #f7f1e9;min-height: 700px;">
    {% if pointage_erreur is defined and pointage_erreur %}
        <div class="alert alert-warning m-2" role="alert">
            <strong>Pointage indisponible.</strong> {{ pointage_erreur }}
        </div>
    {% endif %}
    <h1 class="text-center p-2" style="color: #7a4c33;">Présences Journalières <input class="btn btn-primary btn-sm ms-4 fw-bold p-1" style="border-bottom: 2px solid grey;font-size: 14px;" type="submit" value="Plein écran" id="fullscreenBtn"></h1>
    <div class="text-center"><input  style="border: 2px solid #7a4c33;background-color: #e3d9d3;font-weight: bold;font-size: 24px;" id="date1" type="date"><input class="btn btn-sm ms-4 fw-bold p-1" style="border-bottom: 2px solid grey;font-size: 24px;" type="submit" value="Actualiser" id="btn-envoyer"></div>
    <hr style="color: #6a5e07;border: 2px solid #998701;">
    <div class="p-1" style="background: linear-gradient(rgba(61,41,41,0.07),rgba(61,41,41,0.03),rgba(61,41,41,0.49),rgba(61,41,41,0.8));">
        <a class="btn btn-primary" style="border: 2px solid black" href="{{ path('rh_accueil') }}" >retour à la page d'accueil</a>
        <div class="d-inline-flex" style="float: right;min-width:500px;">
            <label for=""  style="width: 150px;font-weight: bold;text-decoration: underline;">Légende : </label>
            <div class="me-2" style="width: 25px;height:25px;background: #d1cece;border: #5a371e 2px solid;"></div> <span class="italic fw-bold">Absents</span>
            <div class="ms-3 me-2" style="width: 25px;height:25px;background: lightpink;border: #5a371e 2px solid;"></div> <span class="italic fw-bold">Retardataires</span>
            <div class="ms-3 me-2" style="width: 25px;height:25px;background: lightyellow;border: #5a371e 2px solid;"></div> <span class="italic fw-bold">Tolérance Retard</span>
            <div class="ms-3 me-2" style="width: 25px;height:25px;background: white;border: #5a371e 2px solid;"></div> <span class="italic fw-bold">Ponctuels</span>
        </div>
    </div>
    <div class="m-2 div_presences p-2 bg-white m-2" style="min-height: 500px; max-height: 100vh;overflow-y: scroll;font-size: 24px;border: 1px solid lightgrey;">
    </div>
</div>

<div class="modal fade" id="modal_photo" aria-hidden="true" aria-labelledby="modal_postes" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-center">
        <div class="modal-content">

            <div class="modal-body text-center">
                <img src="" alt="" id="photo_grand" height="512">
            </div>
        </div>
    </div>
</div>
<div class="modal" id="modal_details" aria-hidden="true" aria-labelledby="modal_horaires" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: rgba(61,41,41,0.75)">
                <h5 class="modal-title" id="lbl_employe">Détails Présences</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body " style="background: linear-gradient(#f7f1e9, #e9ded5, #a89b8c)">
                <div class="p-2" style="border: 1px solid black;">
                    <div class="text-center">
                        <select class="btn form-control-sm select mx-auto"  style="min-width: 200px;border: 1px solid black;" name="sel_employes" id="sel_employes">
                            <option value="0">-- Employés --</option>
                        </select>
                    </div>

                    <hr>
                    <div class="row" id="divrow">
                        <div class="col-md-4 text-center" style="border-right: 2px solid black;padding: 10px;">
                            <a class="btn btn-outline-success fw-bold w-100" id="btn-equipe" style="display: none;font-size: 14px;">Changement Equipe</a>
                            <a class="btn btn-outline-primary mt-2 fw-bold w-100" id="btn-horaire" style="display: none;font-size: 14px;">Changement Type Horaire</a>
                            <a class="btn btn-outline-dark fw-bold w-100" id="btn-etat" style="display: none;font-size: 14px;">Changement Type Etat</a>
                            <hr>
                            <a class="btn btn-outline-danger fw-bold w-100 mt-2" id="btn-reinitialise" style="display: none;font-size: 14px;">Réinitialiser</a>
                        </div>
                        <div class="col-md-4 text-center" style="border-right: 2px solid black;background: linear-gradient(#dbeae0, rgba(74,59,59,0.21))">
                            <div class="mx-auto" id="div_choix">
                                <h6 class="text-danger" id="txt" style="text-shadow: #fed063 4px 4px"></h6>
                                <label class="label  mb-2 w-100">
                                    Date : <input class="form-control text-center" type="date" style="border-bottom: 2px solid black;min-width: 200px;" id="date_mvt" disabled>
                                </label>
                                <br>
                                <select class="btn form-control-sm select bg-white w-100"  style="min-width: 200px;border: 1px solid black;display: none;" name="sel_equipe" id="sel_equipe">
                                    <option value="0">--Equipes--</option>
                                </select>
                                <select class="btn form-control-sm bg-white w-100" style="min-width: 200px;border: 1px solid black;display: none;" name="sel_horaire" id="sel_horaire">
                                </select>
                                <select class="btn form-control-sm bg-white w-100" style="min-width: 200px;border: 1px solid black;display: none;" name="sel_personnalise" id="sel_personnalise">
                                </select>
                                <select name="personalise" class="mb-2" id="personalise" style="display: none">
                                </select>
                                <select class="btn form-control-sm bg-white w-100" style="min-width: 200px;border: 1px solid black;display: none;" name="sel_etat" id="sel_etat">
                                    <option value="0">-- soumi à la pointeuse ? --</option>
                                    <option value="1">-- Oui --</option>
                                    <option value="2">-- Non --</option>
                                </select><br>
                                <button class="btn btn-primary mt-2 mb-2 w-100" id="btn_choix" style="width: 200px;display: none;">OK</button>
                            </div>

                        </div>
                        <div class="col-md-4 div_content">

                        </div>
                    </div>
                    <div class="div_details mt-2"></div>
                </div>
            </div>
        </div>
    </div>
</div>




<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.datatables.net/2.1.4/js/dataTables.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdn.datatables.net/buttons/3.1.1/js/dataTables.buttons.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.1/js/buttons.dataTables.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.1/js/buttons.print.min.js"></script>

<script>

    // Get today's date
    const today = new Date();
    const btn = document.getElementById("fullscreenBtn");
    // Format it as YYYY-MM-DD (required for input[type="date"])
    const formattedDate = today.toISOString().split('T')[0];


    // Assign to the input
    document.getElementById("date1").value = formattedDate;
    document.querySelector('.div_presences').innerHTML = '<div class="text-center w-100" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
    getUsers($('#date1').val());

    $('#btn-envoyer').on('click', function (){
        document.querySelector('.div_presences').innerHTML = '<div class="text-center w-100" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
        getUsers($('#date1').val());
    })

    setTimeout(() => {
        getUsers($('#date1').val());
    }, 30000);


    $('body').on('click','.a_photo', function() {
        document.querySelector("#photo_grand").src = "{{ asset('images/users/') }}" + this.id;
    });

    $('body').on('click','.row_employe', function() {
        let lien = "{{ path('rh_accueil') }}/getDetailsPresenceEmploye/"+ $('#date1').val() + '/'  + this.id
        window.open(lien)
        //document.location.href = lien
    });


    function getUsers(date){
        let contenu = "";
        //document.querySelector('.div_presences').innerHTML = '<div class="text-center w-100" style="width:100%;"><img class="mx-auto" src="{{ asset('rh/assets/images/roue.gif') }}" height="400"></div>'
        $.ajax({
            url : '{{ path('rh_accueil') }}/presencesJour/' + date,
            type: 'POST',
            success : function(response){
                let reponse = JSON.parse(response)
                contenu = contenu + '<table class="table table-hover" id="tbl_presences" style="">'
                contenu = contenu + '<thead>'
                contenu = contenu + '<tr style="background-color: rgba(184,184,184,0.63);">'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);"></th>'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);">Nom & Prenoms</th>'
                contenu = contenu + '<th class="text-center" style="background-color: rgba(184,184,184,0.63);;">Poste</th>'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);;">Type Horaire</th>'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);;">Heure requise</th>'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);;">Heure arrivée</th>'
                contenu = contenu + '<th style="background-color: rgba(184,184,184,0.63);;">Absences (min)</th>'
                contenu = contenu + '</tr>'
                contenu = contenu + '</thead>'
                contenu = contenu + '<tbody class="body_presences">'

                for (var i = 0; i < reponse.length; i++) {
                    contenu = contenu + '<tr  class="row_employe" id="' + reponse[i].id + '" style="cursor: pointer;">'

                    if (reponse[i].minutes > 0 && reponse[i].minutes < reponse[i].tolerance) {
                        contenu = contenu + '<td class="fw-bold text-dark" style="background: lightyellow;color: orange;"><a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="96" alt=""></a></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold my-auto" style="background: lightyellow;color: orange;font-size: 24px;">' + reponse[i].nom + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold text-center" style="background: lightyellow;color: orange;font-size: 24px;"><span class="badge p-1 mt-3 fw-bold" style="background: linear-gradient(#7a4c33, #8b5a2b)">' + reponse[i].poste + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: lightyellow;color: orange;font-size: 24px;"></span>' + reponse[i].type_horaires + '</span>';
                        if (reponse[i].h_personnalise){
                            contenu = contenu + '<br><span class="fw-bold" style="font-size:16px;color: orange;">' +  reponse[i].h_personnalise + '</span></td>'
                        } else {
                            contenu = contenu + '<br><span class="fw-bold"  style="font-size:16px;">' + reponse[i].equipe + '</span></span></td>'
                        }

                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: lightyellow;color: orange;font-size: 24px;">' + reponse[i].heure1 + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: lightyellow;color: orange;font-size: 24px;">' + reponse[i].heure_entree + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: lightyellow;color: orange;font-size: 24px;">0</span></td>'
                    } else if (reponse[i].minutes <= 0 && reponse[i].heure_entree !== "-") {
                        contenu = contenu + '<td class="fw-bold text-dark" style="background: lightpink;color: red;"><a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="96" alt=""></a></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  lightpink;font-size: 24px;">' + reponse[i].nom + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold text-center" style="background:  lightpink;color: red;font-size: 24px;"><span class="badge p-1 mt-3 fw-bold" style="background: linear-gradient(#7a4c33, #8b5a2b)">' + reponse[i].poste + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  lightpink;color: red;font-size: 24px;"></span>' + reponse[i].type_horaires + '</span> ';
                        if (reponse[i].h_personnalise){
                            contenu = contenu + '<br><span class="text-danger fw-bold" style="font-size:16px;">' +  reponse[i].h_personnalise + '</span></td>'
                        } else {
                            contenu = contenu + '<br><span class="text-danger fw-bold"  style="font-size:16px;">' + reponse[i].equipe + '</span></span></td>'
                        }

                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  lightpink;color: red;font-size: 24px;">' + reponse[i].heure1 + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  lightpink;color: red;font-size: 24px;">' + reponse[i].heure_entree + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  lightpink;color: red;font-size: 24px;">' + reponse[i].minutes + '</span></td>'
                    }  else if (reponse[i].heure_entree === "-") {
                        contenu = contenu + '<td class="fw-bold text-dark" style="background: lightgrey;color: red;"><a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="96" alt=""></a></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  #f9f9f6;font-size: 24px;">' + reponse[i].nom + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold text-center" style="background:  #f9f9f6;color: red;font-size: 24px;"><span class="badge p-1 mt-3 fw-bold" style="background: linear-gradient(#7a4c33, #8b5a2b)">' + reponse[i].poste + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  #f9f9f6;color: red;font-size: 24px;"></span>' + reponse[i].type_horaires + '</span> ';
                        if (reponse[i].h_personnalise){
                            contenu = contenu + '<br><span class="fw-bold" style="font-size:16px;">' +  reponse[i].h_personnalise + '</span></td>'
                        } else {
                            contenu = contenu + '<br><span class="fw-bold"  style="font-size:16px;">' + reponse[i].equipe + '</span></span></td>'
                        }

                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  #f9f9f6;color: red;font-size: 24px;">' + reponse[i].heure1 + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  #f9f9f6;color: red;font-size: 24px;">' + reponse[i].heure_entree + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background:  #f9f9f6;color: red;font-size: 24px;">0</span></td>'
                    } else {
                        contenu = contenu + '<td class="fw-bold text-dark" style="background: white;color: black;"><a class="a_photo" href="#" data-bs-target="#modal_photo" data-bs-toggle="modal" id="'+ reponse[i].photo + '"><img class="rounded-circle" src="{{ asset('/images/users/') }}' + reponse[i].photo + '" height="96" alt=""></a></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: white;font-size: 24px;">' + reponse[i].nom + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold text-center" style="background: white;color: black;font-size: 24px;"><span class="badge p-1 mt-3 fw-bold" style="background: linear-gradient(#7a4c33, #8b5a2b)">' + reponse[i].poste + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: white;color: black;font-size: 24px;"></span>' + reponse[i].type_horaires + '</span> ';
                        if (reponse[i].h_personnalise){
                            contenu = contenu + '<br><span class="fw-bold" style="font-size:16px;">' +  reponse[i].h_personnalise + '</span></td>'
                        } else {
                            contenu = contenu + '<br><span class="fw-bold"  style="font-size:16px;">' + reponse[i].equipe + '</span></span></td>'
                        }

                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: white;color: black;font-size: 24px;">' + reponse[i].heure1 + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: white;color: black;font-size: 24px;">' + reponse[i].heure_entree + '</span></td>'
                        contenu = contenu + '<td class="mt-2 fw-bold" style="background: white;color: black;font-size: 24px;">0</span></td>'
                    }
                    contenu = contenu + '</tr>'
                }
                contenu = contenu + '</tbody>'
                contenu = contenu + '</table>'

                document.querySelector('.div_presences').innerHTML = contenu;
                let table = new DataTable('#tbl_presences', {
                    layout: {
                        topStart: {
                            buttons: [
                                {
                                    extend: 'excelHtml5',
                                    title: 'Présences du ' + today.toLocaleDateString().split('T')[0],
                                    text: 'Exporter en excel',
                                    customize: function (xlsx) {
                                        var sheet = xlsx.xl.worksheets['sheet1.xml'];

                                        sheet.querySelectorAll('row c[r^="C"]').forEach((el) => {
                                            el.setAttribute('s', '2');
                                        });
                                    }
                                }
                            ]
                        }
                    },
                    pageLength: 100,
                    colReorder: true,
                    order: [[5, 'desc']],
                    language: {
                        processing:     "Traitement en cours...",
                        search:         "Rechercher&nbsp;:",
                        lengthMenu:    "Afficher _MENU_ &eacute;l&eacute;ments",
                        info:           "Affichage de l'&eacute;lement _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                        infoEmpty:      "Affichage de l'&eacute;lement 0 &agrave; 0 sur 0 &eacute;l&eacute;ments",
                        infoFiltered:   "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                        infoPostFix:    "",
                        loadingRecords: "Chargement en cours...",
                        zeroRecords:    "Aucun &eacute;l&eacute;ment &agrave; afficher",
                        emptyTable:     "Aucune donnée disponible dans le tableau",
                        paginate: {
                            first:      "Premier",
                            previous:   "Pr&eacute;c&eacute;dent",
                            next:       "Suivant",
                            last:       "Dernier"
                        },
                        aria: {
                            sortAscending:  ": activer pour trier la colonne par ordre croissant",
                            sortDescending: ": activer pour trier la colonne par ordre décroissant"
                        }
                    }
                });
            }
        })
    }

    function updateClock() {
        document.getElementById("clock").innerHTML =
            new Date().toLocaleTimeString("fr-FR");
    }
    setInterval(updateClock, 1000);
    updateClock();

    btn.addEventListener("click", () => {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen();
            btn.value = "Quitter le plein écran"
        } else {
            document.exitFullscreen();
            btn.value = "Plein écran"
        }
    });

    document.querySelector(".div_presences").style.maxHeight = window.innerHeight * 0.85 + "px";

</script>
</body>
</html>
