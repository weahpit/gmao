{% extends 'base.html.twig' %}
{% block title %}{{ estCreation ? 'Nouvelle offre' : 'Modifier l\'offre ' ~ offre.reference }} — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_recrutement') }}">Recrutement</a></span>
    <span class="breadcrumb-item">{{ estCreation ? 'Nouvelle offre' : offre.reference }}</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header mb-3">
        <h1 class="h4 mb-1">{{ estCreation ? 'Nouvelle offre' : 'Modifier l\'offre ' ~ offre.reference }}</h1>
        <p class="text-muted mb-0">L'offre passe ensuite par validation DRH avant publication.</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger py-2"><ul class="mb-0 small">{% for e in erreurs %}<li>{{ e }}</li>{% endfor %}</ul></div>
    {% endif %}

    <form method="post" class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px; max-width:900px;">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_offre') }}">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="reference">Reference</label>
                <input id="reference" name="reference" value="{{ donnees.reference }}" class="form-control form-control-sm" placeholder="Auto si vide">
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label small mb-1" for="intitule">Intitule du poste *</label>
                <input id="intitule" name="intitule" value="{{ donnees.intitule }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="direction">Direction</label>
                <select id="direction" name="direction" class="form-select form-select-sm">
                    <option value="">Non precisee</option>
                    {% for d in directions %}<option value="{{ d.id }}" {{ d.id == donnees.direction ? 'selected' : '' }}>{{ d.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="service">Service</label>
                <select id="service" name="service" class="form-select form-select-sm">
                    <option value="">Non precise</option>
                    {% for s in services %}<option value="{{ s.id }}" {{ s.id == donnees.service ? 'selected' : '' }}>{{ s.libelle }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="nombre_postes">Postes</label>
                <input type="number" min="1" id="nombre_postes" name="nombre_postes" value="{{ donnees.nombre_postes }}" class="form-control form-control-sm">
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="date_cloture">Cloture</label>
                <input type="date" id="date_cloture" name="date_cloture" value="{{ donnees.date_cloture }}" class="form-control form-control-sm">
            </div>
            <div class="col-12">
                <label class="form-label small mb-1" for="description">Description du poste</label>
                <textarea id="description" name="description" rows="4" class="form-control form-control-sm">{{ donnees.description }}</textarea>
            </div>
            <div class="col-12">
                <label class="form-label small mb-1" for="profil">Profil recherche</label>
                <textarea id="profil" name="profil" rows="3" class="form-control form-control-sm">{{ donnees.profil }}</textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-cacao" type="submit">Enregistrer</button>
            <a href="{{ estCreation ? path('rh_recrutement') : path('rh_recrutement_offre', {id: offre.id}) }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
