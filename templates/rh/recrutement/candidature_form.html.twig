{% extends 'base.html.twig' %}
{% block title %}Nouvelle candidature — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_recrutement') }}">Recrutement</a></span>
    <span class="breadcrumb-item">Nouvelle candidature</span>
{% endblock %}
{% block body %}
<div class="container-fluid py-3">
    <div class="page-header mb-3">
        <h1 class="h4 mb-1">Nouvelle candidature</h1>
        <p class="text-muted mb-0">Le CV peut etre depose en PDF, Word ou image (10 Mo maximum).</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger py-2"><ul class="mb-0 small">{% for e in erreurs %}<li>{{ e }}</li>{% endfor %}</ul></div>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px; max-width:900px;">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_candidature') }}">
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="offre">Offre *</label>
                <select id="offre" name="offre" class="form-select form-select-sm" required>
                    <option value="">Choisir une offre publiee...</option>
                    {% for o in offres %}<option value="{{ o.id }}" {{ o.id == donnees.offre ? 'selected' : '' }}>{{ o.reference }} — {{ o.intitule }}</option>{% endfor %}
                </select>
                {% if offres is empty %}<div class="form-text">Aucune offre publiee : validez et publiez une offre d'abord.</div>{% endif %}
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="cv">CV</label>
                <input type="file" id="cv" name="cv" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="nom">Nom *</label>
                <input id="nom" name="nom" value="{{ donnees.nom }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="prenoms">Prenoms *</label>
                <input id="prenoms" name="prenoms" value="{{ donnees.prenoms }}" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="telephone">Telephone</label>
                <input id="telephone" name="telephone" value="{{ donnees.telephone }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ donnees.email }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="adresse">Adresse</label>
                <input id="adresse" name="adresse" value="{{ donnees.adresse }}" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="diplomes">Diplomes</label>
                <textarea id="diplomes" name="diplomes" rows="3" class="form-control form-control-sm">{{ donnees.diplomes }}</textarea>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="experiences">Experiences</label>
                <textarea id="experiences" name="experiences" rows="3" class="form-control form-control-sm">{{ donnees.experiences }}</textarea>
            </div>
            <div class="col-12">
                <label class="form-label small mb-1" for="observations">Observations</label>
                <textarea id="observations" name="observations" rows="2" class="form-control form-control-sm">{{ donnees.observations }}</textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-cacao" type="submit">Enregistrer la candidature</button>
            <a href="{{ path('rh_recrutement') }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
