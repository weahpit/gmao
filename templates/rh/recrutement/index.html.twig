{% extends 'base.html.twig' %}
{% block title %}Recrutement — CITRAC{% endblock %}
{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('rh_dashboard') }}">Ressources humaines</a></span>
    <span class="breadcrumb-item">Recrutement</span>
{% endblock %}
{% block body %}<p class="p-3"><a class="btn btn-sm btn-cacao" href="{{ path('rh_vivier') }}">Vivier · Dossiers spontanés</a></p>
<div class="container-fluid py-3">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Recrutement</h1>
            <p class="text-muted mb-0">Offres, circuit de validation et suivi des candidatures.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if estRh %}
                <a href="{{ path('rh_recrutement_offre_new') }}" class="btn btn-sm btn-cacao">+ Nouvelle offre</a>
                <a href="{{ path('rh_recrutement_candidature_new') }}" class="btn btn-sm btn-outline-secondary">+ Candidature</a>
            {% endif %}
        </div>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }} py-2">{{ message }}</div>{% endfor %}
    {% endfor %}

    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="small text-muted text-uppercase">Offres ouvertes</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ publiees|length }}</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="small text-muted text-uppercase">A valider</div>
                <div class="h4 mb-0" style="color:#a15c1e;">{{ aValider|length }}</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="small text-muted text-uppercase">Candidatures en cours</div>
                <div class="h4 mb-0" style="color:#5a371e;">{{ enCours|length }}</div>
            </div>
        </div>
    </div>

    {% if pipeline is not empty %}
        <div class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
            <h2 class="h6 mb-2" style="color:#5a371e;">Pipeline</h2>
            <div class="d-flex flex-wrap gap-2">
                {% for etape, total in pipeline %}
                    <span class="badge" style="background:#f2e7dd; color:#5a371e;">{{ etape|replace({'_': ' '})|capitalize }} : {{ total }}</span>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="table-responsive" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Reference</th><th>Intitule</th><th>Service</th><th>Postes</th><th>Candidatures</th><th>Cloture</th><th>Statut</th></tr></thead>
            <tbody>
            {% for offre in offres %}
                <tr>
                    <td class="small">{{ offre.reference }}</td>
                    <td><a href="{{ path('rh_recrutement_offre', {id: offre.id}) }}" class="text-decoration-none">{{ offre.intitule }}</a></td>
                    <td class="small">{{ offre.serviceLibelle }}</td>
                    <td class="small">{{ offre.nombrePostes }}</td>
                    <td class="small">{{ offre.nombreCandidatures }}</td>
                    <td class="small">{{ offre.dateCloture ? offre.dateCloture|date('d/m/Y') : '-' }}</td>
                    <td><span class="badge" style="background:#f2e7dd; color:#5a371e;">{{ offre.statutLibelle }}</span></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune offre enregistree.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="p-3 mt-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <h2 class="h6 mb-2" style="color:#5a371e;">Candidatures en cours</h2>
        {% if enCours is empty %}
            <p class="text-muted small mb-0">Aucune candidature active.</p>
        {% else %}
            <ul class="list-unstyled small mb-0">
            {% for candidature in enCours %}
                <li class="d-flex justify-content-between border-bottom py-1">
                    <a href="{{ path('rh_recrutement_candidature', {id: candidature.id}) }}" class="text-decoration-none">
                        {{ candidature.candidat ? candidature.candidat.nomComplet : 'Candidat inconnu' }}
                        — {{ candidature.offre ? candidature.offre.intitule : 'offre supprimee' }}
                    </a>
                    <span class="text-muted">{{ candidature.statutLibelle }}{% if candidature.noteGlobale is not null %} · {{ candidature.noteGlobale }} / 100{% endif %}</span>
                </li>
            {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
