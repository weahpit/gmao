<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CITRAC GMAO{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{#    {% include '_lucide_icons.html.twig' %}#}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/table.css') }}">

{#    Choices.js#}
    {#<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/base.min.css"/>#}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

    <script src="{{ asset('js/lucide-sprite.js') }}"></script>
    <script src="{{ asset('js/app.js') }}"></script>
    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full">
<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <i data-lucide="factory" class="brand-icon"></i>
            </div>
            <div class="brand-text">
                <span class="brand-name">CITRAC</span>
                <span class="brand-sub">GMAO</span>
            </div>
            <button id="sidebarToggle" class="sidebar-toggle" aria-label="Rabattre la barre latérale">
                <i data-lucide="panel-left-close"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <span class="nav-section-title">Principal</span>

                <a href="#" class="nav-item {{ app.request.attributes.get('_route') starts with 'dashboard' ? 'active' }}">
                    <i data-lucide="layout-dashboard"></i>
                    <span class="nav-label">Tableau de bord</span>
                </a>

                <!-- Groupe Maintenance avec sous-menu -->
                {% set maintenanceRoutes = ['work_order', 'app_references', 'preventive'] %}
                {% set maintenanceActive = app.request.attributes.get('_route') starts with 'work_order'
                    or app.request.attributes.get('_route') starts with 'preventive' %}
                <div class="nav-group">
                    <button type="button" class="nav-item has-submenu {{ maintenanceActive ? 'has-active' }}">
                        <i data-lucide="wrench"></i>
                        <span class="nav-label">Maintenance</span>
                        <span class="nav-badge">0</span>
                        <i data-lucide="chevron-down" class="nav-chevron"></i>
                    </button>
                    <div class="nav-submenu">
                        <a href="#" class="nav-subitem {{ app.request.attributes.get('_route') starts with 'work_order' ? 'active' }}">
                            <span class="nav-label">Ordres de travail</span>
                        </a>

                        <a href="#" class="nav-subitem {{ app.request.attributes.get('_route') starts with 'preventive' ? 'active' }}">
                            <span class="nav-label">Plans préventifs</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Stocks</span>

                <!-- Groupe Stock avec sous-menu -->
                {% set stockActive = app.request.attributes.get('_route') starts with 'spare_part'
                    or app.request.attributes.get('_route') starts with 'app_mouvements_stock' %}
                <div class="nav-group">
                    <button type="button" class="nav-item has-submenu {{ stockActive ? 'has-active' }}">
                        <i data-lucide="package"></i>
                        <span class="nav-label">Gestion du stock</span>
                        <i data-lucide="chevron-down" class="nav-chevron"></i>
                    </button>
                    <div class="nav-submenu">
                        <a href="{{ path('app_mouvements_stock') }}" class="nav-subitem {{ app.request.attributes.get('_route') starts with 'app_mouvements_stock' ? 'active' }}">
                            <span class="nav-label">Mouvementer le stock</span>
                        </a>
                        <a href="{{ path('app_inventaires') }}" class="nav-subitem {{ app.request.attributes.get('_route') starts with 'app_inventaires' ? 'active' }}">
                            <span class="nav-label">Inventaire</span>
                        </a>
                        <a href="#" class="nav-subitem">
                            <span class="nav-label">Alertes stock</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">Achats</span>
                <a href="{{ path('app_fournisseur') }}" class="nav-item {{ app.request.attributes.get('_route') starts with 'supplier' ? 'active' }}">
                    <i data-lucide="truck"></i>
                    <span class="nav-label">Fournisseurs</span>
                </a>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <div class="nav-section">
                    <span class="nav-section-title">Administration</span>

                    <!-- Groupe Administration avec sous-menu -->
                    <div class="nav-group">
                        <button type="button" class="nav-item has-submenu">
                            <i data-lucide="shield"></i>
                            <span class="nav-label">Administration</span>
                            <i data-lucide="chevron-down" class="nav-chevron"></i>
                        </button>
                        <div class="nav-submenu">
                            <a href="#" class="nav-subitem">
                                <span class="nav-label">Utilisateurs</span>
                            </a>
                            <a href="#" class="nav-subitem">
                                <span class="nav-label">Rapports</span>
                            </a>
                            <a href="{{ path('app_references') }}" class="nav-subitem {{ app.request.attributes.get('_route') starts with 'app_references' ? 'active' }}">
                                <span class="nav-label">Références</span>
                            </a>
                            <a href="#" class="nav-subitem">
                                <span class="nav-label">Paramètres</span>
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </nav>
        <div class="sidebar-footer">
            <div class="user-avatar">{{ app.user.prenoms|first }}{{ app.user.nom|first }}</div>
            <div class="user-info">
                <span class="user-name">{{ app.user.prenoms }} {{ app.user.nom }}</span>
                <span class="user-role">{{ app.user.roles|first|replace({'ROLE_': ''})|title }}</span>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div id="main-wrapper" class="main-wrapper">
        <!-- Top Banner -->
        <header class="banner">
            <button id="bannerToggle" class="banner-toggle" aria-label="Ouvrir la barre latérale">
                <i data-lucide="panel-left-open"></i>
            </button>
            <div class="breadcrumb">
                {% block breadcrumb %}
                    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
                {% endblock %}
            </div>
            <div class="banner-actions">
                <div class="search-bar" onclick="document.getElementById('search-input').focus()">
                    <i data-lucide="search" class="search-icon"></i>
                    <label for="search-input"></label><input id="search-input" type="text" placeholder="Rechercher... (⌘K)" class="search-input">
                    <kbd class="search-kbd">⌘K</kbd>
                </div>
                <button class="notification-bell" aria-label="Notifications">
                    <i data-lucide="bell"></i>
                    <span class="notif-dot"></span>
                </button>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">
                        <i data-lucide="{{ label == 'success' ? 'check-circle' : (label == 'error' ? 'x-circle' : 'info') }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>


<script src="{{ asset('js/external/jquery.js') }}"></script>
<script src="{{ asset('js/tools/functions.js') }}"></script>
<script src="{{ asset('js/tools/showToast.js') }}"></script>
<script src="{{ asset('js/tools/table.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const ACCORDION = true;   // true = un seul sous-menu ouvert à la fois

        const triggers = document.querySelectorAll('.nav-item.has-submenu');

        triggers.forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const group = btn.closest('.nav-group');
                const isOpen = group.classList.contains('open');

                if (ACCORDION) {
                    document.querySelectorAll('.nav-group.open').forEach(function (g) {
                        if (g !== group) g.classList.remove('open');
                    });
                }
                group.classList.toggle('open', !isOpen);
            });
        });

        // Ouvre automatiquement le groupe qui contient le sous-lien actif
        document.querySelectorAll('.nav-submenu .nav-subitem.active').forEach(function (link) {
            const group = link.closest('.nav-group');
            if (group) {
                group.classList.add('open');
                const parent = group.querySelector('.nav-item.has-submenu');
                if (parent) parent.classList.add('has-active');
            }
        });
    });
</script>
</body>
</html>
