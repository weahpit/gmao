<script>
    idEquipement = 0
    document.addEventListener('DOMContentLoaded', function () {
        {% if not (app.user) %} document.location.href =  {{ path('app_login') }} {%endif %}
        const ACCORDION = true;   // true = un seul sous-menu ouvert à la fois

        const triggers = document.querySelectorAll('.nav-item.has-submenu');

        triggers.forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const group = btn.closest('.nav-group');
                const isOpen = group.classList.contains('open');

                if (ACCORDION) {
                    document.querySelectorAll('.nav-group.open').forEach(function (g) {
                        if (g !== group) g.classList.remove('open');
                    });
                }
                group.classList.toggle('open', !isOpen);
            });
        });

        // Ouvre automatiquement le groupe qui contient le sous-lien actif
        document.querySelectorAll('.nav-submenu .nav-subitem.active').forEach(function (link) {
            const group = link.closest('.nav-group');
            if (group) {
                group.classList.add('open');
                const parent = group.querySelector('.nav-item.has-submenu');
                if (parent) parent.classList.add('has-active');
            }
        });
    });

    getAllEquipementsFromTdb(document.getElementById("tbl_articles"), 1)

    document.getElementById("mes_articles").addEventListener('click', ()=>{

    })

    function getValues(){
        /*getAllFournisseurs(document.getElementById('tdb_fournisseur'), 2)*/
        getAllMarques(document.getElementById('tdb_marque'), 2)
        /*getAllNatureEquipement(document.getElementById('nature'), 2)*/
        /*getAllEquipementTypes(document.getElementById('tdb_eqType'), 2)*/
        getAllTypeEq(document.getElementById("tdb_type_eq"), 2)
        getAllTypeEquipements(document.getElementById("tdb_categorie"), 2)
        getAllCriticiteEquipement(document.getElementById("tdb_criticite"), 2)
        getAllFamilles(document.getElementById("tdb_famille"), 2)
       /* getAllTypeEmplacements (document.querySelector("#type_emplacement"), 2)
        getAllZonesExploitation(document.querySelector("#zone"), 2)*/
    }
    uploadImage(document.getElementById('tdb_eqUpload'), document.getElementById('tdb_eqPreview'));
    getValues()

    $('body').on('click', '.tr_article', function(){
        let value = this.id;
        effaceChamps()
        getSingleEquipement(value)
            .then(Eq =>{
                idEquipement = Eq.id
                document.getElementById("tdb_CodeEquipement").value = Eq.code_equipement;
                document.getElementById("tdb_nomEquipement").value = Eq.nom;
                document.getElementById('lbl_article').innerText = Eq.nom;
                document.getElementById("tdb_seuil").value = Eq.seuil;
                document.getElementById("tdb_categorie").value = Eq.categorie;
                document.getElementById("tdb_criticite").value = Eq.criticite;
                if ( Eq.photo){
                    document.getElementById("tdb_eqPreview").src = "{{ asset('data/equipements/') }}" + Eq.photo;
                }
                document.getElementById("tdb_famille").value = Eq.famille;
                document.getElementById("tdb_type_eq").value = Eq.type_eq;

                document.getElementById("tdb_marque").value = Eq.marque;
                document.getElementById("tdb_modele").value = Eq.modele;
            })
    })

            document.getElementById("tdb_famille").addEventListener('change', ()=>{
                let value = document.getElementById("tdb_famille").value;
                getTypeEquipementByFamille(document.getElementById("tdb_categorie"),2, value)
               /* getCode()*/
            })
           /* document.getElementById("tdb_categorie").addEventListener('change', ()=>{
                getCode()
            })*/

        function getCode(){
            document.getElementById('tdb_CodeEquipement').value = "";
            if (
                document.getElementById('tdb_famille').value !== "0"  ||
                document.getElementById('tdb_famille').value !== ""  ||
                document.getElementById('tdb_categorie').value !== "0"  ||
                document.getElementById('tdb_categorie').value !== ""
            ){
                let formData = new FormData

                formData.append('code_famille', document.getElementById('tdb_famille').value)
                formData.append('code_categorie', document.getElementById('tdb_categorie').value)
                getCodeArticle(formData, document.getElementById('tdb_CodeEquipement'));
            }
        }

        document.getElementById('btn-enr-equipement').addEventListener('click', ()=>{
            let formDataEquipement = new FormData();
            let eqUpload = document.getElementById("tdb_eqUpload").files;

            formDataEquipement.append('id_equipement', idEquipement)
            formDataEquipement.append('code_equipement', document.getElementById("tdb_CodeEquipement").value)
            formDataEquipement.append('nom', document.getElementById("tdb_nomEquipement").value)
            formDataEquipement.append('categorie', document.getElementById("tdb_categorie").value)
            formDataEquipement.append('criticite', document.getElementById("tdb_criticite").value)
            formDataEquipement.append('famille', document.getElementById("tdb_famille").value)
            formDataEquipement.append('type_eq', document.getElementById("tdb_type_eq").value)
            formDataEquipement.append('marque', document.getElementById("tdb_marque").value)
            formDataEquipement.append('modele', document.getElementById("tdb_modele").value)
            formDataEquipement.append('seuil', document.getElementById("tdb_seuil").value)

            formDataEquipement.append("photo", eqUpload[0]);
            saveEquipement(formDataEquipement, document.getElementById("tbl_articles"), 1)
        })

        function effaceChamps(){
            idEquipement = 0
            document.getElementById("tdb_CodeEquipement").value = "";
            document.getElementById("tdb_nomEquipement").value = "";
            /*document.getElementById("tdb_seuil").value = Eq.code;*/
            document.getElementById("tdb_categorie").value = "0";
            document.getElementById("tdb_criticite").value = "0";
            document.getElementById("tdb_eqPreview").src = "";
            document.getElementById("tdb_famille").value = "0";
            document.getElementById("tdb_type_eq").value = "0";

            document.getElementById("tdb_marque").value =  "0";
            document.getElementById("tdb_modele").value =  "";
            document.getElementById("tdb_seuil").value =  "0";

            document.getElementById('lbl_article').innerText = "Sélectionnez un article dans la liste !";
        }
    effaceChamps()
</script>
</body>
</html>
