{% extends 'base.html.twig' %}

{% block title %}Ordre d'usinage · Traçabilité des lots{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'dechargement_cacao/_styles.html.twig' %}
{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Gestion du stock</span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_dechargements_cacao') }}">Déchargements cacao</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Ordre d'usinage</span>
{% endblock %}

{% block body %}
<div class="dc-wrap py-3">

    <header class="dc-header">
        <div class="dc-header-top">
            <div>
                <span class="dc-eyebrow">Gestion du stock · Cacao · Fèves</span>
                <h1>Ordre d'usinage</h1>
                <p>
                    Cochez les lots fabriqués, cochez un ou plusieurs camions qui les ont alimentés, puis enregistrez :
                    l'application génère automatiquement un numéro d'ordre d'usinage et rattache chaque lot coché à chacun des camions cochés.
                </p>
            </div>
            <div class="dc-header-actions dc-no-print">
                <a href="{{ path('app_dechargements_cacao') }}" class="dc-chip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                    Déchargements
                </a>
                <a href="{{ path('production_lot') }}" class="dc-chip solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Lots de production
                </a>
            </div>
        </div>

        <div class="dc-steps dc-no-print">
            <span class="dc-step active"><span class="num">1</span> Choisir les lots</span>
            <span class="dc-step"><span class="num">2</span> Cocher le(s) camion(s)</span>
            <span class="dc-step"><span class="num">3</span> Enregistrer l'ordre</span>
        </div>
    </header>

    <div class="dc-stats">
        <div class="dc-stat total"><div class="lbl">Ordres d'usinage</div><div class="val">{{ nbOrdres|number_format(0, ',', ' ') }}</div><div class="sub">enregistrés au total</div></div>
        <div class="dc-stat nouveau"><div class="lbl">Lots tracés</div><div class="val">{{ globaux.lots|number_format(0, ',', ' ') }}</div><div class="sub">avec au moins un camion</div></div>
        <div class="dc-stat modifie"><div class="lbl">Camions utilisés</div><div class="val">{{ globaux.camions|number_format(0, ',', ' ') }}</div><div class="sub">déchargements distincts</div></div>
        <div class="dc-stat"><div class="lbl">Poids rattaché</div><div class="val">{{ globaux.poids|number_format(0, ',', ' ') }}</div><div class="sub">kg au total</div></div>
    </div>

    {# ---------- Barre de recherche (formulaire séparé : pas d'imbrication) ---------- #}
    <section class="dc-card dc-no-print">
        <div class="dc-card-head">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                Rechercher
            </h2>
            <span class="hint">Filtre les lots et les camions affichés</span>
        </div>
        <div class="dc-card-body">
            <form method="get" action="{{ path('stock_tracabilite_lots') }}" class="dc-ou-toolbar">
                <div class="dc-field">
                    <label class="dc-label" for="ou-q">Lot ou qualité (fèves)</label>
                    <input id="ou-q" type="search" name="q" value="{{ terme }}" class="dc-input" placeholder="Ex. 26A-012, grade 1…">
                </div>
                <div class="dc-field ou-petit">
                    <label class="dc-label" for="ou-statut">Situation du lot</label>
                    <select id="ou-statut" name="statut" class="dc-input">
                        <option value="tous" {{ statut == 'tous' ? 'selected' }}>Tous les lots</option>
                        <option value="sans_camion" {{ statut == 'sans_camion' ? 'selected' }}>Lots sans camion</option>
                        <option value="avec_camion" {{ statut == 'avec_camion' ? 'selected' }}>Lots déjà tracés</option>
                    </select>
                </div>
                <div class="dc-field">
                    <label class="dc-label" for="ou-cq">Camion (bon, coopérative, immat.)</label>
                    <input id="ou-cq" type="search" name="cq" value="{{ rechercheCamion }}" class="dc-input" placeholder="Ex. BS-2026-0001, SCOOPCA…">
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="dc-btn dc-btn-primary">Rechercher</button>
                    <a href="{{ path('stock_tracabilite_lots') }}" class="dc-btn dc-btn-ghost">Tout afficher</a>
                </div>
            </form>
        </div>
    </section>

    {# ---------- Formulaire principal : lots cochés + un ou plusieurs camions cochés ---------- #}
    <form method="post" action="{{ path('stock_ordre_usinage_creer') }}" id="form-ordre-usinage">
        <input type="hidden" name="_token" value="{{ csrf_token('ordre_usinage_creation') }}">

        <div class="row g-3">
            <div class="col-lg-7">
                <section class="dc-card h-100">
                    <div class="dc-card-head">
                        <h2>
                            <span class="dc-ou-num" style="background:#fffdfa;">1</span>
                            Lots à rattacher
                        </h2>
                        <span class="hint">Lots de fèves uniquement · {{ total|number_format(0, ',', ' ') }} lot(s) · page {{ page }} / {{ pages }}</span>
                    </div>
                    <div class="dc-card-body">
                        <div class="dc-table-wrap">
                            <div class="dc-table-scroll">
                                <table class="dc-table dc-keep">
                                    <thead>
                                        <tr>
                                            <th class="dc-check-cell"><span class="dc-subtle">Choix</span></th>
                                            <th>Lot</th>
                                            <th>Production</th>
                                            <th>Qualité</th>
                                            <th class="num">PN th. (kg)</th>
                                            <th class="num">Camions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for ligne in lignes %}
                                        {% set l = ligne.lot %}
                                        <tr>
                                            <td class="dc-check-cell">
                                                <input class="dc-check" type="checkbox" name="lots[]" value="{{ l.id }}" id="lot-{{ l.id }}" aria-label="Sélectionner le lot {{ l.numeroLot }}">
                                            </td>
                                            <td data-label="Lot" class="code">
                                                <a href="{{ path('stock_tracabilite_lot', {id: l.id}) }}" class="dc-lot-link">{{ l.numeroLot }}</a>
                                                {% if l.codeProduit %}<div class="dc-subtle trunc">{{ l.codeProduit.libelle }}</div>{% endif %}
                                            </td>
                                            <td data-label="Production">{{ l.dateProd ? l.dateProd|date('d/m/Y') : '—' }}</td>
                                            <td data-label="Qualité">{{ l.qualite ?: '—' }}</td>
                                            <td data-label="PN th." class="num">{{ ligne.theorique > 0 ? ligne.theorique|number_format(0, ',', ' ') : '—' }}</td>
                                            <td data-label="Camions" class="num">
                                                <span class="dc-tag {{ ligne.camions == 0 ? 'zero' : 'ok' }}">{{ ligne.camions }}</span>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="6"><div class="dc-empty">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
                                            <div>Aucun lot de fèves ne correspond à cette recherche.</div>
                                        </div></td></tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        {% if pages > 1 %}
                        <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 dc-no-print">
                            <span class="hint">Page {{ page }} sur {{ pages }}</span>
                            <div class="d-flex gap-2">
                                {% if page > 1 %}
                                    <a class="dc-btn dc-btn-ghost" href="{{ path('stock_tracabilite_lots', {page: page - 1, q: terme, statut: statut, cq: rechercheCamion}) }}">Précédent</a>
                                {% endif %}
                                {% if page < pages %}
                                    <a class="dc-btn dc-btn-ghost" href="{{ path('stock_tracabilite_lots', {page: page + 1, q: terme, statut: statut, cq: rechercheCamion}) }}">Suivant</a>
                                {% endif %}
                            </div>
                        </nav>
                        {% endif %}
                    </div>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="dc-card">
                    <div class="dc-card-head">
                        <h2>
                            <span class="dc-ou-num" style="background:#fffdfa;">2</span>
                            Camions utilisés
                        </h2>
                        <span class="hint">{{ camions|length }} proposé(s)</span>
                    </div>
                    <div class="dc-card-body">
                        <p class="dc-subtle mb-2">
                            Cochez un ou plusieurs camions : chaque lot sélectionné sera rattaché à tous les camions cochés.
                        </p>

                        {% if camions is empty %}
                            <div class="dc-empty">
                                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18v12H3z"/><path d="M7 6V4h10v2"/></svg>
                                <div>Aucun camion ne correspond à la recherche.</div>
                            </div>
                        {% else %}
                            <div class="dc-ou-liste">
                                {% for item in camions %}
                                    {% set d = item.camion %}
                                    <label class="dc-ou-camion" for="camion-{{ d.id }}">
                                        <input class="dc-check" type="checkbox" name="camions[]" value="{{ d.id }}" id="camion-{{ d.id }}">
                                        <span class="corps">
                                            <span class="titre">
                                                {{ d.code ?: 'Bon sans numéro' }}
                                                <span class="dc-tag {{ item.lots > 0 ? 'ok' : 'zero' }}">{{ item.lots }} lot(s)</span>
                                            </span>
                                            <span class="sous">
                                                {{ d.dateDechargement ? d.dateDechargement|date('d/m/Y') : 'date inconnue' }}
                                                {% if d.cooperative %} · {{ d.cooperative }}{% endif %}
                                                {% if d.immatriculation %} · {{ d.immatriculation }}{% endif %}
                                            </span>
                                            <span class="sous">
                                                {{ d.poidsNet is not null ? d.poidsNet|number_format(0, ',', ' ') ~ ' kg' : 'poids non renseigné' }}
                                                {% if d.nbreSacs %} · {{ d.nbreSacs|number_format(0, ',', ' ') }} sacs{% endif %}
                                            </span>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="dc-field mt-3">
                            <label class="dc-label" for="ou-observation">Observation (facultatif)</label>
                            <textarea id="ou-observation" name="observation" rows="2" class="dc-input" maxlength="255" placeholder="Ex. mélange de deux arrivages, 2e passage…"></textarea>
                        </div>

                        <div class="dc-ou-total">
                            <div>
                                <div class="dc-subtle">Numéro généré à l'enregistrement</div>
                                <strong>OU-AAAA-0001</strong>
                            </div>
                            <button type="submit" class="dc-btn dc-btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                Enregistrer l'ordre d'usinage
                            </button>
                        </div>
                        <p class="dc-actions-hint mt-2">
                            Cochez au moins un lot dans la liste et au moins un camion ici, sinon l'enregistrement est refusé.
                            Un couple lot + camion déjà rattaché est automatiquement ignoré (pas de doublon).
                        </p>
                    </div>
                </section>
            </div>
        </div>
    </form>

    {# ---------- Historique des ordres d'usinage ---------- #}
    <section class="dc-card mt-3">
        <div class="dc-card-head">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                Derniers ordres d'usinage
            </h2>
            <span class="hint">{{ nbOrdres|number_format(0, ',', ' ') }} au total</span>
        </div>
        <div class="dc-card-body">
            {% if ordres is empty %}
                <div class="dc-empty">
                    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="M9 6h6a3 3 0 0 1 3 3v6"/></svg>
                    <div>Aucun ordre d'usinage enregistré pour le moment.</div>
                </div>
            {% else %}
                <div class="dc-table-wrap">
                    <div class="dc-table-scroll">
                        <table class="dc-table dc-keep">
                            <thead>
                                <tr>
                                    <th>Numéro</th>
                                    <th>Créé le</th>
                                    <th>Camions</th>
                                    <th>Lots rattachés</th>
                                    <th class="num">Poids</th>
                                    <th>Observation</th>
                                    <th class="num dc-no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for item in ordres %}
                                {% set o = item.ordre %}
                                {% set camionsOrdre = o.camionsEffectifs %}
                                <tr>
                                    <td data-label="Numéro"><span class="dc-ou-num">{{ o.numero }}</span></td>
                                    <td data-label="Créé le">{{ o.dateCreation ? o.dateCreation|date('d/m/Y H:i') : '—' }}</td>
                                    <td data-label="Camions">
                                        {% if camionsOrdre is empty %}
                                            —
                                        {% else %}
                                            <div class="dc-ou-lots">
                                                {% for d in camionsOrdre %}
                                                    <a href="{{ path('stock_tracabilite_dechargement', {id: d.id}) }}" class="dc-ou-lot-chip">{{ d.code ?: '—' }}</a>
                                                {% endfor %}
                                            </div>
                                            <div class="dc-subtle">{{ camionsOrdre|length }} camion(s)</div>
                                        {% endif %}
                                    </td>
                                    <td data-label="Lots rattachés">
                                        <div class="dc-ou-lots">
                                            {% for lien in item.liens %}
                                                <span class="dc-ou-lot-chip">{{ lien.lot ? lien.lot.numeroLot : '—' }}</span>
                                            {% endfor %}
                                        </div>
                                        <div class="dc-subtle">{{ item.liens|length }} lot(s)</div>
                                    </td>
                                    <td data-label="Poids" class="num">{{ item.poids|number_format(0, ',', ' ') }} kg</td>
                                    <td data-label="Observation"><span class="trunc" title="{{ o.observation }}">{{ o.observation ?: '—' }}</span></td>
                                    <td data-label="Action" class="num dc-no-print">
                                        <form method="post" action="{{ path('stock_ordre_usinage_supprimer', {id: o.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('ordre_usinage_suppression') }}">
                                            <button type="submit" class="dc-mini-btn danger">Annuler</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
