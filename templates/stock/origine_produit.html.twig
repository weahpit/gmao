{% extends 'base.html.twig' %}

{% block title %}Origine du produit{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'dechargement_cacao/_styles.html.twig' %}
    <style>
        .ou-filtre {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            align-items: center;
            margin-bottom: .75rem;
            padding: .6rem .7rem;
            background: #fffdfa;
            border: 1px solid #e9dfd2;
            border-radius: 10px;
        }
        .ou-filtre .dc-input {
            flex: 1 1 220px;
            min-width: 160px;
            margin: 0;
        }
        .ou-filtre .ou-compteur {
            font-size: .82rem;
            color: #6b6259;
            white-space: nowrap;
        }
        .ou-filtre .ou-bascule {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .85rem;
            color: #4a423a;
            white-space: nowrap;
        }
        .dc-table tbody tr[hidden] {
            display: none !important;
        }
        @media print {
            .dc-no-print { display: none !important; }
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('tdb_role') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Production</span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('stock_tracabilite_produits') }}">Ordre de production</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Origine du produit</span>
{% endblock %}

{% block body %}
<div class="dc-wrap py-3">

    <header class="dc-header">
        <div class="dc-header-top">
            <div>
                <span class="dc-eyebrow">Traçabilité · Produits finis · Camions d'origine</span>
                <h1>Origine du produit</h1>
                <p>
                    Filtrez les <strong>produits finis</strong> (masse, beurre, tourteau, poudre), cochez ceux qui vous intéressent,
                    puis affichez l'origine : l'application remonte les <strong>camions distincts</strong> qui ont servi à fabriquer
                    l'ensemble de la sélection, via les lots de fèves CITRAC rattachés à chaque produit.
                </p>
            </div>
            <div class="dc-header-actions dc-no-print">
                <a href="{{ path('stock_tracabilite_produits') }}" class="dc-chip">Ordre de production</a>
                <a href="{{ path('stock_tracabilite_lots') }}" class="dc-chip">Ordre d'usinage</a>
            </div>
        </div>

        <div class="dc-steps dc-no-print">
            <span class="dc-step active"><span class="num">1</span> Filtrer les produits</span>
            <span class="dc-step"><span class="num">2</span> Les sélectionner</span>
            <span class="dc-step"><span class="num">3</span> Afficher les camions</span>
        </div>
    </header>

    {% if rechercheFaite %}
    <div class="dc-stats">
        <div class="dc-stat total"><div class="lbl">Produits sélectionnés</div><div class="val">{{ selection|length }}</div><div class="sub">lots de produits finis</div></div>
        <div class="dc-stat nouveau"><div class="lbl">Lots de fèves</div><div class="val">{{ feves|length }}</div><div class="sub">à l'origine de la sélection</div></div>
        <div class="dc-stat modifie"><div class="lbl">Camions distincts</div><div class="val">{{ camions|length }}</div><div class="sub">déchargements retrouvés</div></div>
        <div class="dc-stat"><div class="lbl">Poids tracé</div><div class="val">{{ poidsTotal|number_format(0, ',', ' ') }}</div><div class="sub">kg · {{ sacsTotal|number_format(0, ',', ' ') }} sac(s)</div></div>
    </div>
    {% endif %}

    {% if sansFeve is not empty %}
        <div class="dc-alert mb-3">
            <strong>{{ sansFeve|length }} produit(s) sélectionné(s) sans fèves rattachées</strong> —
            leur origine ne peut pas être calculée :
            {% for lot in sansFeve %}{{ lot.numeroLot }}{% if not loop.last %}, {% endif %}{% endfor %}.
            Rattachez ces produits à leurs lots de fèves depuis « Ordre de production ».
        </div>
    {% endif %}

    {# ---------------- Filtres + sélection (un seul formulaire GET) ---------------- #}
    <form method="get" action="{{ path('stock_origine_produit') }}" id="form-origine">
        <section class="dc-card mb-3">
            <div class="dc-card-head">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    1 · Filtrer les produits
                </h2>
                <span class="hint">{{ proposes|length }} produit(s) proposé(s){% if proposes|length >= 200 %} — affinez la recherche{% endif %}</span>
            </div>
            <div class="dc-card-body">
                <div class="dc-ou-toolbar">
                    <div class="dc-field">
                        <label class="dc-label" for="op-q">Lot, produit ou magasin</label>
                        <input id="op-q" type="search" name="q" value="{{ terme }}" class="dc-input" placeholder="Ex. 26B-014, BEURRE…">
                    </div>
                    <div class="dc-field">
                        <label class="dc-label" for="op-produit">Produit</label>
                        <select id="op-produit" name="produit" class="dc-input">
                            <option value="">Tous les produits finis</option>
                            {% for p in produits %}
                                <option value="{{ p.id }}" {{ produitChoisi and (produitChoisi.id ~ '') == (p.id ~ '') ? 'selected' }}>{{ p.libelle }} </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="dc-field ou-petit">
                        <label class="dc-label" for="op-du">Produit du</label>
                        <input id="op-du" type="date" name="du" value="{{ du }}" class="dc-input">
                    </div>
                    <div class="dc-field ou-petit">
                        <label class="dc-label" for="op-au">au</label>
                        <input id="op-au" type="date" name="au" value="{{ au }}" class="dc-input">
                    </div>
                    <div class="dc-field ou-petit">
                        <label class="dc-label" for="op-statut">Situation</label>
                        <select id="op-statut" name="statut" class="dc-input">
                            <option value="tous" {{ statut == 'tous' ? 'selected' }}>Tous</option>
                            <option value="avec_feve" {{ statut == 'avec_feve' ? 'selected' }}>Avec fèves rattachées</option>
                            <option value="sans_feve" {{ statut == 'sans_feve' ? 'selected' }}>Sans fèves</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="dc-btn dc-btn-primary">Rechercher</button>
                        <a href="{{ path('stock_origine_produit') }}" class="dc-btn dc-btn-ghost">Réinitialiser</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="dc-card mb-3">
            <div class="dc-card-head">
                <h2>
                    <span class="dc-ou-num" style="background:#fffdfa;">2</span>
                    Sélectionner les produits
                </h2>
                <span class="hint">Cochez un ou plusieurs lots, puis « Afficher l'origine »</span>
            </div>
            <div class="dc-card-body">
                <div class="ou-filtre dc-no-print">
                    <input type="search" id="filtre-produits" class="dc-input" autocomplete="off"
                           placeholder="Filtrer cette liste : n° de lot, produit, qualité…"
                           aria-label="Filtrer la liste des produits sans recharger la page">
                    <label class="ou-bascule">
                        <input type="checkbox" id="bascule-sans-feve">
                        Sans fèves seulement
                    </label>
                    <span class="ou-compteur" id="compteur-produits"></span>
                    <button type="button" id="cocher-visibles" class="dc-btn dc-btn-ghost">Cocher les produits affichés</button>
                    <button type="button" id="decocher-tout" class="dc-btn dc-btn-ghost">Tout décocher</button>
                </div>

                {% for id in idsCaches %}
                    <input type="hidden" name="ids[]" value="{{ id }}">
                {% endfor %}

                <div class="dc-table-wrap">
                    <div class="dc-table-scroll">
                        <table class="dc-table dc-keep">
                            <thead>
                                <tr>
                                    <th class="dc-check-cell"><span class="dc-subtle">Choix</span></th>
                                    <th>Produit fini</th>
                                    <th>Production</th>
                                    <th>Qualité</th>
                                    <th class="num">PN th. (kg)</th>
                                    <th class="num">Fèves</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for ligne in proposes %}
                                {% set l = ligne.lot %}
                                {% set cle = l.id ~ '' %}
                                <tr data-recherche="{{ (l.numeroLot ~ ' ' ~ (l.codeProduit ? l.codeProduit.libelle : '') ~ ' ' ~ ligne.qualite ~ ' ' ~ (l.codeMagasin ? l.codeMagasin.libelle : '') ~ ' ' ~ (l.dateProd ? l.dateProd|date('d/m/Y') : ''))|lower }}"
                                    data-feves="{{ ligne.feves }}">
                                    <td class="dc-check-cell">
                                        <input class="dc-check" type="checkbox" name="ids[]" value="{{ cle }}" id="produit-{{ cle }}"
                                               aria-label="Sélectionner le produit {{ l.numeroLot }}"
                                               {{ cle in ids ? 'checked' }}>
                                    </td>
                                    <td data-label="Produit fini" class="code">
                                        <strong>{{ l.numeroLot }}</strong>
                                        {% if l.codeProduit %}<div class="dc-subtle trunc">{{ l.codeProduit.libelle }}</div>{% endif %}
                                    </td>
                                    <td data-label="Production">{{ l.dateProd ? l.dateProd|date('d/m/Y') : '—' }}</td>
                                    <td data-label="Qualité">
                                        <span class="dc-badge {{ ligne.estNc ? 'rejete' : 'nouveau' }}"><span class="dot"></span>{{ ligne.estNc ? 'Non conforme' : 'Conforme' }}</span>
                                    </td>
                                    <td data-label="PN th." class="num">{{ l.pnTh is not null ? l.pnTh|number_format(0, ',', ' ') : '—' }}</td>
                                    <td data-label="Fèves" class="num">
                                        <span class="dc-tag {{ ligne.feves == 0 ? 'zero' : 'ok' }}">{{ ligne.feves }}</span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6"><div class="dc-empty">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
                                    <div>Aucun produit fini ne correspond à ces filtres.</div>
                                </div></td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="dc-ou-total mt-3">
                    <div>
                        <div class="dc-subtle">Sélection en cours</div>
                        <strong><span id="compteur-selection">0</span> produit(s) coché(s)</strong>
                    </div>
                    <button type="submit" class="dc-btn dc-btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h12M3 18h6"/></svg>
                        Afficher l'origine
                    </button>
                </div>
                <p class="dc-actions-hint mt-2">
                    La recherche porte sur tous les produits cochés, même ceux qui ne sont pas affichés à cause des filtres.
                </p>
            </div>
        </section>
    </form>

    {# ---------------- Résultat : camions distincts ---------------- #}
    {% if rechercheFaite %}
    <section class="dc-card">
        <div class="dc-card-head">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3z"/><path d="M7 6V4h10v2"/><path d="M7 12h4"/></svg>
                3 · Camions d'origine (distincts)
            </h2>
            <div class="d-flex gap-2 align-items-center">
                <span class="hint">{{ camions|length }} camion(s) pour {{ selection|length }} produit(s)</span>
                <button type="button" class="dc-chip dc-no-print" onclick="window.print()">Imprimer</button>
            </div>
        </div>
        <div class="dc-card-body">
            {% if selection is empty %}
                <div class="dc-empty">Aucun produit sélectionné : cochez au moins un produit fini ci-dessus.</div>
            {% elseif camions is empty %}
                <div class="dc-empty">
                    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17V7h8l4 4v6"/></svg>
                    <div>
                        Aucun camion retrouvé pour cette sélection.<br>
                        Vérifiez que les produits finis sont rattachés à leurs lots de fèves, et que ces fèves sont rattachées à leurs camions.
                    </div>
                </div>
            {% else %}
                <div class="dc-table-wrap">
                    <div class="dc-table-scroll">
                        <table class="dc-table dc-keep">
                            <thead>
                                <tr>
                                    <th>Camion / bon</th>
                                    <th>Déchargé le</th>
                                    <th>Coopérative</th>
                                    <th>Immatriculation</th>
                                    <th>Transporteur</th>
                                    <th class="num">Poids net</th>
                                    <th class="num">Poids affecté</th>
                                    <th class="num">Sacs</th>
                                    <th>Lots de fèves</th>
                                    <th>Produits finis</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for item in camions %}
                                {% set d = item.camion %}
                                <tr>
                                    <td data-label="Camion"><strong>{{ d.code ?: '—' }}</strong></td>
                                    <td data-label="Déchargé le">{{ d.dateDechargement ? d.dateDechargement|date('d/m/Y') : '—' }}</td>
                                    <td data-label="Coopérative">{{ d.cooperative ?: '—' }}</td>
                                    <td data-label="Immatriculation">{{ d.immatriculation ?: '—' }}</td>
                                    <td data-label="Transporteur">{{ d.transporteur ?: '—' }}</td>
                                    <td data-label="Poids net" class="num">{{ d.poidsNet is not null ? d.poidsNet|number_format(0, ',', ' ') : '—' }}</td>
                                    <td data-label="Poids affecté" class="num">{{ item.poids|number_format(0, ',', ' ') }}</td>
                                    <td data-label="Sacs" class="num">{{ item.sacs > 0 ? item.sacs|number_format(0, ',', ' ') : '—' }}</td>
                                    <td data-label="Lots de fèves">
                                        <div class="dc-ou-lots">
                                            {% for numero in item.feves %}
                                                <span class="dc-ou-lot-chip">{{ numero }}</span>
                                            {% endfor %}
                                        </div>
                                    </td>
                                    <td data-label="Produits finis">
                                        <div class="dc-ou-lots">
                                            {% for numero in item.produits %}
                                                <span class="dc-ou-lot-chip">{{ numero }}</span>
                                            {% endfor %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="6" class="text-end">Total {{ camions|length }} camion(s)</th>
                                    <th class="num">{{ poidsTotal|number_format(0, ',', ' ') }}</th>
                                    <th class="num">{{ sacsTotal > 0 ? sacsTotal|number_format(0, ',', ' ') : '—' }}</th>
                                    <th colspan="2"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
    {% endif %}
</div>

<script>
(function () {
    'use strict';

    function normaliser(valeur) {
        return (valeur || '').toString().toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    var lignes = Array.prototype.slice.call(document.querySelectorAll('#form-origine tbody tr[data-recherche]'));
    var champ = document.getElementById('filtre-produits');
    var bascule = document.getElementById('bascule-sans-feve');
    var compteur = document.getElementById('compteur-produits');
    var compteurSelection = document.getElementById('compteur-selection');

    function cases() {
        return Array.prototype.slice.call(document.querySelectorAll('#form-origine input[name="ids[]"]:not([type="hidden"])'));
    }

    function majSelection() {
        if (compteurSelection) {
            compteurSelection.textContent = cases().filter(function (c) { return c.checked; }).length;
        }
    }

    function filtrer() {
        var texte = normaliser(champ ? champ.value : '');
        var sansFeve = bascule ? bascule.checked : false;
        var visibles = 0;

        lignes.forEach(function (ligne) {
            var okTexte = texte === '' || normaliser(ligne.dataset.recherche).indexOf(texte) !== -1;
            var nb = parseInt(ligne.dataset.feves || '0', 10);
            var okFeve = !sansFeve || nb === 0;
            var visible = okTexte && okFeve;
            ligne.hidden = !visible;
            if (visible) { visibles++; }
        });

        if (compteur) {
            compteur.textContent = visibles + ' / ' + lignes.length + ' affiché(s)';
        }
    }

    if (champ) { champ.addEventListener('input', filtrer); }
    if (bascule) { bascule.addEventListener('change', filtrer); }
    filtrer();
    majSelection();

    document.addEventListener('change', function (e) {
        if (e.target && e.target.name === 'ids[]') { majSelection(); }
    });

    var cocher = document.getElementById('cocher-visibles');
    if (cocher) {
        cocher.addEventListener('click', function () {
            lignes.forEach(function (ligne) {
                if (ligne.hidden) { return; }
                var case_ = ligne.querySelector('input[name="ids[]"]');
                if (case_) { case_.checked = true; }
            });
            majSelection();
        });
    }

    var decocher = document.getElementById('decocher-tout');
    if (decocher) {
        decocher.addEventListener('click', function () {
            cases().forEach(function (c) { c.checked = false; });
            majSelection();
        });
    }
})();
</script>
{% endblock %}
