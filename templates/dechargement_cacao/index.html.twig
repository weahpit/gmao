{% extends 'base.html.twig' %}

{% block title %}Import déchargement cacao{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'dechargement_cacao/_styles.html.twig' %}
{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Gestion du stock</span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Import déchargement cacao</span>
{% endblock %}

{% block body %}
<div class="dc-wrap py-3">

    {# ---------------- En-tête ---------------- #}
    <header class="dc-header">
        <div class="dc-header-top">
            <div>
                <span class="dc-eyebrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Gestion du stock · Cacao
                </span>
                <h1>Import du déchargement cacao</h1>
                <p>
                    Déposez votre fichier <strong>Excel (.xlsx)</strong> ou <strong>CSV</strong> : l'application compare chaque bon
                    avec la base, affiche un rapport détaillé, puis n'enregistre <em>qu'après votre validation</em>.
                </p>
            </div>
            <div class="dc-header-actions">
                <a href="{{ path('app_dechargements_cacao') }}" class="dc-chip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 9l-5 5-3-3-3 3"/></svg>
                    Déchargements enregistrés
                </a>
                <a href="{{ path('app_dechargement_cacao_modele_xlsx') }}" class="dc-chip solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Télécharger le modèle
                </a>
            </div>
        </div>

        <div class="dc-steps" id="dcSteps">
            <span class="dc-step active" data-step="1"><span class="num">1</span> Fichier</span>
            <span class="dc-step" data-step="2"><span class="num">2</span> Analyse</span>
            <span class="dc-step" data-step="3"><span class="num">3</span> Rapport</span>
            <span class="dc-step" data-step="4"><span class="num">4</span> Enregistrement</span>
        </div>
    </header>

    {% if totaux.nb > 0 %}
    <div class="dc-stats" style="margin-bottom:20px;">
        <div class="dc-stat total">
            <div class="lbl">Bons en base</div>
            <div class="val">{{ totaux.nb|number_format(0, ',', ' ') }}</div>
            <div class="sub">déchargements enregistrés</div>
        </div>
        <div class="dc-stat">
            <div class="lbl">Sacs</div>
            <div class="val">{{ totaux.sacs|number_format(0, ',', ' ') }}</div>
            <div class="sub">total cumulé</div>
        </div>
        <div class="dc-stat nouveau">
            <div class="lbl">Poids net</div>
            <div class="val">{{ totaux.poids|number_format(0, ',', ' ') }}</div>
            <div class="sub">kg</div>
        </div>
        <div class="dc-stat modifie">
            <div class="lbl">PNP</div>
            <div class="val">{{ totaux.pnp|number_format(0, ',', ' ') }}</div>
            <div class="sub">kg</div>
        </div>
        <div class="dc-stat">
            <div class="lbl">Dernier bon</div>
            <div class="val" style="font-size:1.05rem;">{{ totaux.derniere ? totaux.derniere|date('d/m/Y') : '—' }}</div>
            <div class="sub">date de chargement</div>
        </div>
    </div>
    {% endif %}

    {# ---------------- 1. Dépôt du fichier ---------------- #}
    <section class="dc-card" id="dcCardUpload">
        <div class="dc-card-head">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
                Fichier de déchargement
            </h2>
            <span class="hint">.xlsx · .xls · .csv — {{ (tailleMax / 1048576)|round }} Mo maximum</span>
        </div>
        <div class="dc-card-body">
            <div class="dc-drop" id="dcDrop">
                <input type="file" id="dcInput" accept=".xlsx,.xls,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" aria-label="Choisir le fichier de déchargement">
                <div id="dcDropIdle">
                    <div class="dc-drop-ico">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </div>
                    <div class="dc-drop-title">Glissez votre fichier ici ou cliquez pour le choisir</div>
                    <div class="dc-drop-sub">Le fichier doit reprendre les colonnes du modèle officiel</div>
                </div>
                <div id="dcDropFile" class="dc-fileinfo" style="display:none;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="dc-drop-ico" style="margin:0; width:46px; height:46px; border-radius:12px; background:#eaf7ee; color:#1e7e46;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        </div>
                        <div>
                            <div class="nom" id="dcFileName">—</div>
                            <div class="meta" id="dcFileMeta">—</div>
                        </div>
                    </div>
                    <button type="button" class="dc-btn dc-btn-ghost" id="dcRetirer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Retirer
                    </button>
                </div>
            </div>

            <div class="dc-help">
                <div class="dc-help-item">
                    <strong>Colonnes du modèle</strong>
                    Code, Date, Site, Produit, Cooperative, Immat, Transporteur, Nbre Sacs, PoidsNet, Statut, Date de Déchargement, Obersavation, PNP, Traitant, Categorie.
                    <div class="dc-cols">
                        <span class="dc-col-tag oblig">Code *</span>
                        <span class="dc-col-tag oblig">Date *</span>
                        <span class="dc-col-tag oblig">PoidsNet *</span>
                        <span class="dc-col-tag">Nbre Sacs</span>
                        <span class="dc-col-tag">Cooperative</span>
                        <span class="dc-col-tag">PNP</span>
                    </div>
                </div>
                <div class="dc-help-item">
                    <strong>Règle de comparaison</strong>
                    La colonne <b>Code</b> est la clé du bon. Un code déjà présent est comparé champ par champ : identique il est ignoré, différent il apparaît en « à mettre à jour ».
                </div>
                <div class="dc-help-item">
                    <strong>Aucune écriture avant validation</strong>
                    L'analyse est en lecture seule. Rien n'est enregistré tant que vous n'avez pas cliqué sur <b>Enregistrer</b>.
                </div>
            </div>

            <div id="dcUploadErr" class="dc-alert dc-alert-error mt-3" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span id="dcUploadErrMsg"></span>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                <button type="button" class="dc-btn dc-btn-primary" id="dcAnalyser" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Analyser et comparer
                </button>
            </div>
        </div>
    </section>

    {# ---------------- 2-3. Rapport ---------------- #}
    <section class="dc-card" id="dcCardRapport" style="display:none;">
        <div class="dc-card-head">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                Rapport de comparaison
            </h2>
            <div class="hint" id="dcRapportMeta"></div>
        </div>
        <div class="dc-card-body">
            <div class="dc-stats" id="dcStats"></div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="dc-filters" id="dcFilters"></div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="input-group" style="max-width:250px;">
                        <span class="input-group-text bg-white" style="border-radius:10px 0 0 10px;border-color:#e0d2c0;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9a8877" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </span>
                        <input type="search" class="form-control" id="dcRecherche" placeholder="Code, coopérative, camion…" style="border-radius:0 10px 10px 0;border-color:#e0d2c0;font-size:.86rem;">
                    </div>
                    <button type="button" class="dc-btn dc-btn-ghost" id="dcToutSelectionner">Tout cocher</button>
                    <button type="button" class="dc-btn dc-btn-ghost" id="dcRienSelectionner">Tout décocher</button>
                </div>
            </div>

            <div class="dc-table-wrap">
                <div class="dc-table-scroll">
                    <table class="dc-table" id="dcTable">
                        <thead>
                            <tr>
                                <th style="width:38px;"><input type="checkbox" class="dc-check" id="dcCheckAll" aria-label="Tout sélectionner"></th>
                                <th>Ligne</th>
                                <th>Code</th>
                                <th>Date</th>
                                <th>Coopérative</th>
                                <th>Immat</th>
                                <th>Transporteur</th>
                                <th class="num">Sacs</th>
                                <th class="num">PoidsNet</th>
                                <th class="num">Écart</th>
                                <th>Statut / Contrôles</th>
                                <th>Verdict</th>
                            </tr>
                        </thead>
                        <tbody id="dcTbody"></tbody>
                    </table>
                </div>
            </div>

            <div class="dc-commit" id="dcCommit">
                <div class="resume">
                    <strong id="dcResumeSelection">0 ligne sélectionnée</strong>
                    <div id="dcResumeDetail" class="mt-1" style="font-size:.82rem;"></div>
                </div>
                <div class="actions">
                    <button type="button" class="dc-btn dc-btn-danger-ghost" id="dcAnnuler">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Annuler
                    </button>
                    <button type="button" class="dc-btn dc-btn-success" id="dcEnregistrer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        OK — Enregistrer en base
                    </button>
                </div>
            </div>
        </div>
    </section>

    {# ---------------- Résultat ---------------- #}
    <section class="dc-card" id="dcCardResultat" style="display:none;">
        <div class="dc-card-body">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="dc-drop-ico" style="margin:0; background:#eaf7ee; color:#1e7e46;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <div class="flex-grow-1">
                    <div style="font-weight:800;color:var(--dc-cacao);font-size:1.05rem;" id="dcResultTitle">Import terminé</div>
                    <div style="font-size:.86rem;color:#8a7a68;" id="dcResultMsg"></div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('app_dechargements_cacao') }}" class="dc-btn dc-btn-ghost">Consulter les déchargements</a>
                    <button type="button" class="dc-btn dc-btn-primary" id="dcNouvelImport">Nouvel import</button>
                </div>
            </div>
        </div>
    </section>

</div>

{# ---------------- Overlay bloquant ---------------- #}
<div class="dc-overlay" id="dcOverlay" role="alertdialog" aria-modal="true" aria-live="assertive" aria-labelledby="dcOverlayTitle">
    <div class="dc-overlay-card">
        <div class="dc-spinner"></div>
        <div class="dc-overlay-title" id="dcOverlayTitle">Traitement en cours…</div>
        <div class="dc-overlay-msg" id="dcOverlayMsg">Merci de patienter.</div>
        <div class="dc-progress"><span></span></div>
        <div class="dc-lock-note">Aucune modification n'est possible pendant l'opération.</div>
    </div>
</div>

<div class="dc-toast" id="dcToast"></div>

<script type="application/json" id="dcConfig">
{{ {
    'analyser': path('app_dechargement_cacao_analyser'),
    'enregistrer': path('app_dechargement_cacao_enregistrer'),
    'token': csrf_token('dechargement_cacao_import'),
    'tailleMax': tailleMax
}|json_encode|raw }}
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/dechargement/import.js') }}" defer></script>
{% endblock %}
