{% extends 'base.html.twig' %}

{% block title %}Postes — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Postes Utilisateurs</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title"><img class="me-2" src="{{ asset('icons/poste.png') }}" alt=""> Postes Utilisateurs</h1>
        <a href="#"  id="btn_add_mrq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddPoste">
            <i class="bi bi-plus text-white"></i> Nouveau Poste
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddPoste" tabindex="-1" aria-labelledby="modalAddPosteLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/poste.png') }}" height="40" alt=""> Enregistrer le poste</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <div class="d-flex justify-content-start">
                        <label class="fw-bold span " for="service" style="width: 150px;">Service</label>
                        <select class="input w-100" id="service"></select>
                    </div>
                    <hr>
                    <form id="formPoste">
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="poste" style="width: 150px;">Poste</label>
                            <input type="text" class="input" id="poste" style="text-transform: uppercase;">
                        </div>

                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="savePoste">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/NatureEquipement.js') }}"></script>
    <script src="{{ asset('js/api/admin/Poste.js') }}"></script>
    <script src="{{ asset('js/api/admin/Service.js') }}"></script>
    <script src="{{ asset('js/api/references/Fournisseur.js') }}"></script>
    <script>

        let idPoste = "";
        getAllPostes(document.querySelector(".card-body"), 1)
        getAllServices(document.getElementById("service"), 2)
        clearForm("formPoste", "poste")
        ValidateOnKeypress(document.getElementById("poste"), document.getElementById("savePoste"), "formPoste")
        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
            clearForm("formPoste", "poste")
        })

        document.querySelector("#savePoste").addEventListener("click", function () {
            let FormDataPoste= new FormData();
            FormDataPoste.append('id_poste', idPoste)
            FormDataPoste.append('poste', document.querySelector("#poste").value)
            FormDataPoste.append('service', document.querySelector("#service").value)
            savePoste(FormDataPoste, document.querySelector(".card-body"), 1)
        })
    </script>
{% endblock %}
