{% extends 'base.html.twig' %}

{% block title %}Groupes — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Groupes Utilisateurs</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title"><img class="me-2" src="{{ asset('icons/group.png') }}" alt=""> Groupes Utilisateurs</h1>
        <a href="#"  id="btn_add_mrq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddGroupe">
            <i class="bi bi-plus text-white"></i> Nouveau Groupe
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edith Equipement-->
    <div class="modal fade" id="modalAddGroupe" tabindex="-1" aria-labelledby="modalAddGroupeLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/groupe.png') }}" height="40" alt=""> Enregistrer une groupe</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formGroupe" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="groupe" style="width: 150px;">Groupe</label>
                            <input type="text" class="input" id="groupe" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveGroupe">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/NatureEquipement.js') }}"></script>
    <script src="{{ asset('js/api/admin/Groupe.js') }}"></script>
    <script src="{{ asset('js/api/references/Fournisseur.js') }}"></script>
    <script>

        let idGroupe = 0;
        getAllGroupes(document.querySelector(".card-body"), 1)
        clearForm("formGroupe", "groupe")
        ValidateOnKeypress(document.getElementById("groupe"), document.getElementById("saveGroupe"), "formGroupe")
        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
            clearForm("formFournisseur", "groupe")
        })

        document.querySelector("#saveGroupe").addEventListener("click", function () {
            let agree = "0";
            let FormDataGroupe= new FormData();
            FormDataGroupe.append('id_groupe', idGroupe)
            FormDataGroupe.append('groupe', document.querySelector("#groupe").value)
            saveGroupe(FormDataGroupe, document.querySelector(".card-body"), 1)
        })
    </script>
{% endblock %}
