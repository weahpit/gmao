{% extends 'base.html.twig' %}

{% block title %}Widgets — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Widgets</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title"><img class="me-2" src="{{ asset('icons/widget.png') }}" alt=""> Widgets Utilisateurs</h1>
        <a href="#"  id="btn_add_mrq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddWidget">
            <i class="bi bi-plus text-white"></i> Nouveau Widget
        </a>
    </div>
    <p>cette section gère les gadgets qui s'afficheront sur le tableau de bord</p>
    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddWidget" tabindex="-1" aria-labelledby="modalAddWidgetLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/widget.png') }}" height="40" alt=""> Enregistrer le widget</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="#" id="formWidget">
                    <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="widget" style="width: 150px;">Widget</label>
                            <input type="text" class="input" id="widget" style="">
                        </div>

                        <div class="p-1 mb-2" style="border:  1px solid #e4f8e4;background: rgba(200,215,173,0.85);">
                            <div class="d-flex justify-content-start">
                                <label class="fw-bold span " for="width" style="width: 150px;">Largeur<span id="rangeValue" class="badge bg-primary ms-2"></span></label>
                                <input type="range" class="form-range text-success" min="1" max="12" step="1" id="width" value="3">
                            </div>
                            <small class="text-dark">Choisir une valeur (1 à 12)</small>
                        </div>

                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="groupe" style="width: 150px;">Groupe</label>
                            <select name="groupe" id="groupe" class="input" multiple></select>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="reference" style="width: 150px;">Référence</label>
                            <input type="text" class="input" id="reference" style="">
                        </div>
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="render_type" style="width: 150px;">Type Rendu</label>
                            <select name="render_type" id="render_type" class="input">
                                <option value="1">Table</option>
                                <option value="2">Graphique</option>
                            </select>
                        </div>
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="app_js" style="width: 150px;">Code JS</label>
                            <input type="text" class="input" id="app_js" style="">
                        </div>
                    </div>
                    <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                        <button type="button" class="btn btn-primary" id="saveWidget">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/NatureEquipement.js') }}"></script>
    <script src="{{ asset('js/api/admin/Widget.js') }}"></script>
    <script src="{{ asset('js/api/admin/Groupe.js') }}"></script>
    <script src="{{ asset('js/api/references/Fournisseur.js') }}"></script>
    <script>

        let idWidget = "0";
        let choice_groupes = ""
        getAllWidgets(document.querySelector(".card-body"), 1)
        getAllGroupes(document.getElementById("groupe"), 2)

        const range = document.getElementById('width');
        const output = document.getElementById('rangeValue');

        // valeur initiale
        output.textContent = range.value;

        // mise à jour en temps réel
        range.addEventListener('input', () => {
            output.textContent = range.value;
        });

        clearForm("formWidget", "widget")
        ValidateOnKeypress(document.getElementById("widget"), document.getElementById("saveWidget"), "formWidget")
        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
            clearForm("formWidget", "widget")
        })

        document.querySelector("#saveWidget").addEventListener("click", function () {
            let FormDataWidget= new FormData();
            FormDataWidget.append('id_widget', idWidget)
            FormDataWidget.append('widget', document.querySelector("#widget").value)
            FormDataWidget.append('groupe', choice_groupes)
            FormDataWidget.append('width', document.querySelector("#width").value)
            FormDataWidget.append('reference', document.querySelector("#reference").value)
            FormDataWidget.append('render_type', document.querySelector("#render_type").value)
            FormDataWidget.append('app_js', document.querySelector("#app_js").value)
            saveWidget(FormDataWidget, document.querySelector(".card-body"), 1)
        })

        setTimeout(()=>{
            const element = document.getElementById("groupe");

            const choices = new Choices(element, {
                removeItemButton: true,   // bouton pour retirer un choix
                noResultsText: 'Aucun résultat'
            });

            document.addEventListener("click", () => {
                let valeurs = choices.getValue(true);
                choice_groupes = valeurs;
            });
            element.value = null;
        }, 2000)

    </script>
{% endblock %}
