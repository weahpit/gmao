{% extends 'base.html.twig' %}

{% block title %}Services — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Services</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title"><img class="me-2" src="{{ asset('icons/service.png') }}" alt=""> Services</h1>
        <a href="#"  id="btn_add_service" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddService">
            <i class="bi bi-plus text-white"></i> Nouveau Service
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddService" tabindex="-1" aria-labelledby="modalAddServiceLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/service.png') }}" height="40" alt=""> Enregistrer une service</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formService" >
                        <div class="d-flex justify-content-start mb-3">
                            <label class="fw-bold span " for="service" style="width: 150px;">Nom Service</label>
                            <input type="text" class="input" id="service" style="text-transform: uppercase;">
                        </div>
                        <div class="d-flex justify-content-start mb-3">
                            <label class="fw-bold span " for="code_direction" style="width: 150px;">Direction</label>
                            <select class="input" id="code_direction" name=""></select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveService">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/admin/Service.js') }}"></script>
    <script src="{{ asset('js/api/admin/Direction.js') }}"></script>
    <script>

        let idService = 0;
        getAllServices(document.querySelector(".card-body"), 1)
        clearForm("formService", "service")

        ValidateOnKeypress(document.getElementById("service"), document.getElementById("saveService"), "formService")

        document.querySelector("#btn_add_service").addEventListener("click", function () {
            clearForm("formService", "service")
            getAllDirections(document.getElementById("code_direction"), 2)
        })

        document.querySelector("#saveService").addEventListener("click", function () {
            let FormDataService= new FormData();
            FormDataService.append('id_service', idService)
            FormDataService.append('service', document.querySelector("#service").value)
            FormDataService.append('code_direction', document.querySelector("#code_direction").value)
            saveService(FormDataService, document.querySelector(".card-body"), 1)
            setTimeout(()=>{
                getAllDirections(document.getElementById("code_direction"), 2)
                clearForm("formService", "service") ;
            }, 500)
        })
    </script>
{% endblock %}
