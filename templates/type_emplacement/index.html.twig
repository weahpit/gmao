{% extends 'base.html.twig' %}

{% block title %}Types Emplacements — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Type</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Types Emplacements</h1>
        <a href="#"  id="btn_add_type_emplacement" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddType">
            <img src="{{ asset('icons/Type_eq.png') }}" class="me-2" alt="" height="16"> Ajouter  un type de emplacement
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Emplacement-->
    <div class="modal fade" id="modalAddType" tabindex="-1" aria-labelledby="modalAddTypeLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/Type_eq.png') }}" height="40" alt=""> Enregistrer un Type Equipement</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formTypeEmplacement" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="type_emplacement" style="width: 250px;">Type Emplacement</label>
                            <input type="text" class="input" id="type_emplacement" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveTypeEmplacement">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/TypeEmplacement.js') }}"></script>
    <script>

        let idTypeEmplacement = "0";
        getAllTypeEmplacements (document.querySelector(".card-body"), 1)
        clearForm("formTypeEmplacement", "type_emplacement")
        ValidateOnKeypress(document.getElementById("type_emplacement"), document.getElementById("saveTypeEmplacement"), "formTypeEmplacement")
        document.querySelector("#btn_add_type_emplacement").addEventListener("click", function () {
            clearForm("formTypeEmplacement", "type_emplacement")
        })

        document.querySelector("#saveTypeEmplacement").addEventListener("click", function () {
            let FormDataTypeEmplacement = new FormData();
            FormDataTypeEmplacement.append('id_type_emplacement', idTypeEmplacement)
            FormDataTypeEmplacement.append('type_emplacement', document.querySelector("#type_emplacement").value)
            saveTypeEmplacement(FormDataTypeEmplacement, document.querySelector(".card-body"), 1)
        })


    </script>
{% endblock %}
