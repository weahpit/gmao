{#
    Page PUBLIQUE de scan QR des bons de sortie (guerite / magasin).

    - Camera du telephone / de la tablette (BarcodeDetector du navigateur si
      disponible, sinon saisie du code lu par un lecteur USB ou a la main).
    - La fiche du bon est demandee a /api/scan/{code} : aucun compte n&rsquo;est
      requis, la page est en lecture seule.
    - Gabarit autonome presence_base : pas de sidebar, fond cacao clair,
      logo CITRAC en filigrane.
#}
{% extends 'reunion/presence_base.html.twig' %}
{% block title %}Controle des bons de sortie — CITRAC{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .page { max-width: 880px; }

        /* ---------- Bloc camera ---------- */
        .cam-cadre {
            position: relative; border-radius: 16px; overflow: hidden;
            background: #2b1d15; aspect-ratio: 4 / 3; display: flex;
            align-items: center; justify-content: center; margin-bottom: 12px;
        }
        .cam-cadre video { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cam-cadre .cam-voile { position: absolute; inset: 14%; border: 2px dashed rgba(255, 255, 255, .55); border-radius: 14px; pointer-events: none; }
        .cam-cadre .cam-attente { color: #e9d9c9; font-size: .9rem; text-align: center; padding: 24px; line-height: 1.5; }
        .cam-cadre .cam-ligne {
            position: absolute; left: 14%; right: 14%; height: 2px; top: 50%;
            background: linear-gradient(90deg, rgba(197, 139, 63, 0), #e0a860, rgba(197, 139, 63, 0));
            animation: cam-balayage 2.4s ease-in-out infinite;
        }
        @keyframes cam-balayage { 0%, 100% { top: 22%; } 50% { top: 78%; } }

        .actions-scan { display: flex; flex-wrap: wrap; gap: 9px; }
        .btn-scan {
            flex: 1 1 auto; min-width: 140px; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            padding: 12px 16px; border-radius: 12px; font-size: .92rem; font-weight: 650; cursor: pointer;
            border: 1px solid rgba(169, 118, 90, .30); background: #fffdfb; color: var(--cacao-900);
            transition: background-color .15s ease, color .15s ease, border-color .15s ease;
        }
        .btn-scan:hover { background: #f7ece2; }
        .btn-scan.principal { background: var(--cacao-700); border-color: var(--cacao-700); color: #fff; }
        .btn-scan.principal:hover { background: #6a4029; }
        .btn-scan[disabled] { opacity: .55; cursor: default; }

        .saisie-ref { display: flex; gap: 8px; margin-top: 12px; }
        .saisie-ref input {
            flex: 1; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(169, 118, 90, .32);
            background: #fffdfb; font-family: inherit; font-size: 1rem; text-transform: uppercase;
            letter-spacing: .04em; color: var(--ink);
        }
        .saisie-ref input:focus { outline: none; border-color: var(--cacao-500); box-shadow: 0 0 0 3px rgba(169, 118, 90, .16); }
        .saisie-ref button {
            padding: 12px 18px; border-radius: 12px; border: 0; background: var(--cacao-700);
            color: #fff; font-weight: 700; font-size: .92rem; cursor: pointer;
        }

        .aide { font-size: .78rem; color: #9a7f6d; margin: 10px 0 0; line-height: 1.5; }

        /* ---------- Bandeau verdict ---------- */
        .verdict {
            display: flex; gap: 12px; align-items: flex-start; padding: 15px 17px; border-radius: 14px;
            border: 1px solid transparent; margin: 0 0 16px; animation: apparait .25s ease-out;
        }
        .verdict .v-icone {
            width: 40px; height: 40px; border-radius: 50%; flex: 0 0 40px; display: flex;
            align-items: center; justify-content: center; font-size: 1.25rem; font-weight: 700; color: #fff;
        }
        .verdict .v-titre { font-weight: 700; font-size: .98rem; margin: 1px 0 3px; }
        .verdict .v-texte { font-size: .86rem; line-height: 1.5; }
        .verdict.ok { background: #eef7f1; border-color: #bfe0cd; color: #245c42; }
        .verdict.ok .v-icone { background: var(--ok); }
        .verdict.attente { background: #fdf4e6; border-color: #f0dcb8; color: #8a5c14; }
        .verdict.attente .v-icone { background: #c58b3f; }
        .verdict.ko { background: #fceeec; border-color: #f3cfca; color: #97302a; }
        .verdict.ko .v-icone { background: var(--err); }

        @keyframes apparait { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

        /* ---------- Fiche du bon ---------- */
        .fiche-entete { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 14px; margin-bottom: 12px; }
        .fiche-entete .ref { font-family: 'Instrument Serif', Georgia, serif; font-size: 1.75rem; color: var(--cacao-900); margin: 0; line-height: 1.1; }
        .badge-statut {
            display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: .74rem; font-weight: 700;
            letter-spacing: .04em; text-transform: uppercase; color: #fff;
        }
        .fiche-type { font-size: .8rem; color: #9a7f6d; width: 100%; }

        .grille-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px 18px; margin: 14px 0 4px; }
        .grille-info div { font-size: .85rem; color: #6b4a38; }
        .grille-info span { display: block; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: #a58b78; margin-bottom: 2px; }
        .grille-info b { color: var(--cacao-900); font-weight: 600; }

        .table-lignes { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: .87rem; }
        .table-lignes th {
            text-align: left; font-size: .7rem; letter-spacing: .07em; text-transform: uppercase; color: #a58b78;
            padding: 8px 8px; border-bottom: 1px solid rgba(169, 118, 90, .22); font-weight: 700;
        }
        .table-lignes td { padding: 10px 8px; border-bottom: 1px solid rgba(169, 118, 90, .12); color: #4b2c1d; vertical-align: top; }
        .table-lignes td.qte { font-weight: 700; white-space: nowrap; }
        .table-lignes tr:last-child td { border-bottom: 0; }

        .signatures { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 16px; }
        .signature {
            border: 1px dashed rgba(169, 118, 90, .35); border-radius: 12px; padding: 11px 13px; font-size: .82rem; color: #6b4a38;
            background: rgba(255, 253, 251, .7);
        }
        .signature span { display: block; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: #a58b78; margin-bottom: 3px; }
        .signature b { color: var(--cacao-900); font-weight: 650; }
        .signature .vide { color: #b9a696; font-style: italic; }

        .pied-fiche { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
        .pied-fiche button, .pied-fiche a { font-size: .82rem; padding: 9px 14px; border-radius: 10px; border: 1px solid rgba(169, 118, 90, .3);
            background: #fff; color: var(--cacao-700); text-decoration: none; cursor: pointer; font-family: inherit; }

        .vide-zone { text-align: center; padding: 26px 10px; color: #9a7f6d; font-size: .9rem; }
        .chargement { display: inline-block; width: 18px; height: 18px; border: 2px solid rgba(122, 76, 51, .25);
            border-top-color: var(--cacao-700); border-radius: 50%; animation: tourne .8s linear infinite; vertical-align: -4px; }
        @keyframes tourne { to { transform: rotate(360deg); } }

        /* ---------- Actions du vigil ---------- */
        .actions-vigil { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 0; }
        .btn-vigil {
            flex: 1 1 190px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
            padding: 15px 18px; border-radius: 14px; border: 1px solid transparent; cursor: pointer;
            font-family: inherit; font-size: 1rem; font-weight: 750; letter-spacing: .2px;
            transition: background-color .15s ease, transform .05s ease, box-shadow .15s ease;
        }
        .btn-vigil:active { transform: translateY(1px); }
        .btn-vigil[disabled] { opacity: .55; cursor: default; }
        .btn-vigil.sortir { background: #1f7a4d; color: #fff; box-shadow: 0 6px 16px rgba(31, 122, 77, .22); }
        .btn-vigil.sortir:hover { background: #186641; }
        .btn-vigil.signaler { background: #fff; color: #a3342b; border-color: #e0b5b0; }
        .btn-vigil.signaler:hover { background: #fdf1ef; }
        .btn-vigil.simple { background: #fffdfb; color: var(--cacao-700); border-color: rgba(169, 118, 90, .3); flex: 0 1 auto; font-weight: 650; font-size: .85rem; padding: 10px 14px; }
        .encart-motif {
            margin: 12px 0 0; padding: 12px 14px; border-radius: 12px; background: #fceeec;
            border: 1px solid #f3cfca; color: #8c2b25; font-size: .87rem; line-height: 1.5;
        }
        .encart-motif b { display: block; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 4px; color: #a3554d; }
        .note-envoi { font-size: .8rem; color: #9a7f6d; margin: 10px 0 0; }
        .note-envoi a { color: var(--cacao-700); }

        /* ---------- Boite de dialogue signalement ---------- */
        .voile-modal { position: fixed; inset: 0; background: rgba(43, 29, 21, .55); display: flex; align-items: center; justify-content: center; padding: 16px; z-index: 60; }
        .voile-modal[hidden] { display: none; }
        .boite-modal { background: #fffdfb; border-radius: 18px; padding: 20px; width: 100%; max-width: 480px; max-height: 90vh; overflow: auto; box-shadow: 0 20px 50px rgba(0, 0, 0, .25); }
        .boite-modal h2 { font-family: 'Instrument Serif', Georgia, serif; font-size: 1.35rem; color: var(--cacao-900); margin: 0 0 6px; }
        .boite-modal .muted { font-size: .86rem; color: #8a6a56; margin: 0 0 14px; line-height: 1.5; }
        .choix-motif { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
        .choix-motif button {
            font-family: inherit; font-size: .78rem; padding: 8px 12px; border-radius: 999px; cursor: pointer;
            border: 1px solid rgba(169, 118, 90, .3); background: #fffdfb; color: var(--cacao-800);
        }
        .choix-motif button.actif { background: var(--cacao-700); border-color: var(--cacao-700); color: #fff; }
        .champ-motif span { display: block; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: #a58b78; margin-bottom: 5px; }
        .champ-motif textarea {
            width: 100%; box-sizing: border-box; padding: 11px 13px; border-radius: 12px; font-family: inherit;
            font-size: .95rem; color: var(--ink); border: 1px solid rgba(169, 118, 90, .32); background: #fff; resize: vertical;
        }
        .champ-motif textarea:focus { outline: none; border-color: var(--cacao-500); box-shadow: 0 0 0 3px rgba(169, 118, 90, .16); }
        .pied-modal { display: flex; gap: 9px; margin-top: 16px; }
        .pied-modal .btn-scan { flex: 1 1 auto; }
        .btn-scan.danger { background: #a3342b; border-color: #a3342b; color: #fff; }
        .btn-scan.danger:hover { background: #8c2b25; }

        @media (max-width: 620px) {
            .fiche-entete .ref { font-size: 1.45rem; }
            .table-lignes th.stock, .table-lignes td.stock { display: none; }
        }
    </style>
{% endblock %}

{% block presence_body %}

<div class="brand no-print">
    <img src="{{ asset('images/CITRAC.png') }}" alt="CITRAC">
    <span class="sub">Controle des bons de sortie</span>
</div>

{# ---------------- Scan ---------------- #}
<section class="card no-print" id="carte-scan">
    <h1>Scanner un bon</h1>
    <p class="muted">Presentez le QR code imprime sur le bon de sortie devant la camera, ou saisissez la reference du bon.</p>

    <div class="cam-cadre" id="cam-cadre" hidden>
        <video id="cam-video" playsinline muted autoplay></video>
        <div class="cam-voile"></div>
        <div class="cam-ligne"></div>
    </div>
    <p class="aide" id="voile-coach" hidden>
        Remplissez la camera avec le QR code, a environ 15&ndash;20 cm. Si la lecture ne demarre pas,
        utilisez « Photo du QR » : vous prenez la photo et la page la decode.
    </p>
    <input type="file" id="champ-photo" accept="image/*" capture="environment" hidden>

    <div class="actions-scan">
        <button type="button" class="btn-scan principal" id="btn-camera">Ouvrir la camera</button>
        <button type="button" class="btn-scan" id="btn-arreter" hidden>Arreter la camera</button>
        <button type="button" class="btn-scan" id="btn-photo">Photo du QR</button>
    </div>

    <form class="saisie-ref" id="form-ref" autocomplete="off">
        <input type="text" id="champ-ref" name="ref" placeholder="Reference du bon — ex. BS-2026-0001"
               aria-label="Reference du bon de sortie" maxlength="80" spellcheck="false">
        <button type="submit">Rechercher</button>
    </form>

    <p class="aide">
        Le QR code du bon est reconnu automatiquement. La page fonctionne aussi avec un lecteur de code-barres USB
        (le code est saisi puis recherche tout seul).
    </p>
</section>

{# ---------------- Resultat ---------------- #}
<section class="card" id="carte-fiche"{% if not cible_initiale %} hidden{% endif %}>
    <div id="zone-fiche">{% if not cible_initiale %}<div class="vide-zone" id="zone-vide">Le bon scanne s&rsquo;affichera ici.</div>{% endif %}</div>
</section>

{# ---------------- Signalement (refus motive) ---------------- #}
<div class="voile-modal" id="voile-signal" hidden>
    <div class="boite-modal" role="dialog" aria-modal="true" aria-labelledby="titre-signal">
        <h2 id="titre-signal">Signaler un probleme sur ce bon</h2>
        <p class="muted">La sortie sera refusee et la Direction Generale verra le motif.</p>
        <div class="choix-motif" id="choix-motif">
            <button type="button" data-motif="Quantite non conforme au bon">Quantite non conforme</button>
            <button type="button" data-motif="Marchandise non conforme (qualite, etat)">Marchandise non conforme</button>
            <button type="button" data-motif="Bon non signe ou signature douteuse">Signature douteuse</button>
            <button type="button" data-motif="Porteur sans piece d'identite">Porteur sans piece</button>
            <button type="button" data-motif="Vehicule non conforme / non declare">Vehicule non conforme</button>
            <button type="button" data-motif="Autre motif">Autre motif</button>
        </div>
        <label class="champ-motif">
            <span>Motif du signalement</span>
            <textarea id="motif-signal" rows="3" maxlength="255" placeholder="Expliquez precisement ce qui ne va pas..."></textarea>
        </label>
        <div class="pied-modal">
            <button type="button" class="btn-scan" id="btn-annuler-signal">Annuler</button>
            <button type="button" class="btn-scan danger" id="btn-envoyer-signal">Envoyer le signalement</button>
        </div>
    </div>
</div>

<script type="application/json" id="cible-initiale">{{ cible_initiale ? cible_initiale|json_encode|raw : 'null' }}</script>

{% endblock %}

{% block javascripts %}
{# Lecture QR locale (jsQR) + repli BarcodeDetector natif : fonctionne sur Chrome Android, iOS, tablettes. #}
<script src="{{ asset('js/external/jsQR.js') }}" defer
        onerror="var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js';document.head.appendChild(s);"></script>
<script>
(function () {
    'use strict';

    var URL_API      = {{ url_api|json_encode|raw }};
    var URL_SORTIE   = {{ url_faire_sortir|json_encode|raw }};
    var URL_SIGNALER = {{ url_signaler|json_encode|raw }};
    var AGENT_CONNECTE = {{ (app.user is defined and app.user) ? 'true' : 'false' }};
    
    var PAGE_BON     = {{ url_page_bon|json_encode|raw }};
    var cibleInitiale = JSON.parse(document.getElementById('cible-initiale').textContent || 'null');

    var carteFiche = document.getElementById('carte-fiche');
    var zoneFiche  = document.getElementById('zone-fiche');
    var champRef   = document.getElementById('champ-ref');
    var formRef    = document.getElementById('form-ref');
    var btnCamera  = document.getElementById('btn-camera');
    var btnArreter = document.getElementById('btn-arreter');
    var cadre      = document.getElementById('cam-cadre');
    var video      = document.getElementById('cam-video');
    var voileCoach = document.getElementById('voile-coach');
    var btnPhoto   = document.getElementById('btn-photo');
    var champPhoto = document.getElementById('champ-photo');

    var flux = null, detecteur = null, boucle = null, dernierCode = '', dernierAt = 0, enCours = false;

    /* ---------- Utilitaires ---------- */
    function echapper(txt) {
        return String(txt == null ? '' : txt)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    /** Extrait le code du bon du contenu du QR (JSON CITRAC, URL, ou code brut). */
    function codeDepuisContenu(brut) {
        var txt = String(brut || '').trim();
        if (!txt) { return ''; }

        // 1) JSON imprime sur le bon : {"app":"CITRAC","typ":"BON_SORTIE","ref":"...","tok":"..."}
        //    On envoie la REFERENCE en priorite : c'est la cle la plus sure
        //    cote serveur (elle est unique dans les deux tables de bons).
        if (txt.charAt(0) === '{') {
            try {
                var obj = JSON.parse(txt);
                var code = obj.ref || obj.reference || obj.tok || obj.token || '';
                if (code) { return String(code).trim(); }
            } catch (e) { /* contenu non JSON : on continue */ }
        }

        // 2) Lien vers cette page : .../scan/<code>
        var lien = txt.match(/\/scan\/([A-Za-z0-9_\-]{6,80})\s*$/);
        if (lien) { return lien[1]; }

        // 3) Code brut : on retire les caracteres parasites de fin de lecture
        var brut = txt.replace(/^[\s"'<>]+/, '').replace(/[\s"'<>#.,;:]+$/, '');
        return brut.slice(0, 80);
    }

    function couleurStatut(statut) {
        switch (statut) {
            case 'VALIDE':   return '#2f7d5d';
            case 'CLOTURE':  return '#6f7b8a';
            case 'ANNULE':   return '#b3352c';
            default:         return '#c58b3f';
        }
    }

    /* ---------- Affichage de la fiche ---------- */
    /** Encode un texte en HTML sur : les balises de mise en forme sont construites ici. */
    function h(txt) { return echapper(txt); }

    function afficherMessage(classe, titre, texte) {
        carteFiche.hidden = false;
        zoneFiche.innerHTML =
            '<div class="verdict ' + classe + '">' +
                '<div class="v-icone">' + (classe === 'ok' ? '\u2713' : (classe === 'ko' ? '\u2715' : '!')) + '</div>' +
                '<div><div class="v-titre">' + echapper(titre) + '</div>' +
                '<div class="v-texte" style="white-space:pre-line">' + h(texte) + '</div></div>' +
            '</div>';
    }

    function afficherBon(bon) {
        carteFiche.hidden = false;

        var v = 'attente', icone = '!', titre = 'En attente de signature';
        if (bon.statut === 'VALIDE') {
            v = 'ok'; icone = '\u2713'; titre = 'Sortie autorisee';
        } else if (bon.statut === 'CLOTURE' || bon.statut === 'ANNULE') {
            v = 'ko'; icone = '\u2715';
            titre = bon.statut === 'ANNULE' ? 'Bon annule' : 'Bon deja cloture';
        }
        var texte = '';
        if (bon.statut === 'VALIDE') {
            texte = 'Ce bon est signe par la Direction Generale. Verifiez les quantites et la marchandise avec le porteur, puis touchez <b>Faire sortir</b> pour cloturer le bon, ou <b>Signaler</b> en cas de probleme.';
        } else if (bon.statut === 'CLOTURE') {
            texte = 'Ce bon a deja ete cloture a la guerite' + (bon.cloture_at ? ' le ' + echapper(bon.cloture_at) : '') +
                (bon.cloture_par ? ' par ' + echapper(bon.cloture_par) : '') + ' : la marchandise est deja sortie.';
        } else if (bon.statut === 'ANNULE') {
            texte = 'Ce bon a ete annule : la sortie N\u2019EST PAS autorisee.';
        } else {
            texte = 'Ce bon attend la signature du Directeur General : la sortie n\u2019est pas autorisee pour le moment.';
        }

        var html = '';
        html += '<div class="verdict ' + v + '">' +
                    '<div class="v-icone">' + icone + '</div>' +
                    '<div><div class="v-titre">' + echapper(titre) + '</div>' +
                    '<div class="v-texte">' + texte + '</div></div>' +
                '</div>';

        html += '<div class="fiche-entete">' +
                    '<h2 class="ref">' + echapper(bon.reference || 'Sans reference') + '</h2>' +
                    '<span class="badge-statut" style="background:' + couleurStatut(bon.statut) + '">' +
                        echapper(bon.statut_label || bon.statut) + '</span>' +
                    '<div class="fiche-type">' + echapper(bon.type_label || '') +
                        (bon.date ? '  \u00b7  ' + echapper(bon.date) : '') + '</div>' +
                '</div>';

        var infos = [
            ['Service', bon.service],
            ['Demandeur', bon.demandeur],
            ['Emplacement', bon.emplacement],
            ['Etabli par', bon.etabli_par]
        ];
        var infosHtml = '';
        for (var i = 0; i < infos.length; i++) {
            if (!infos[i][1]) { continue; }
            infosHtml += '<div><span>' + echapper(infos[i][0]) + '</span><b>' + echapper(infos[i][1]) + '</b></div>';
        }
        if (infosHtml) { html += '<div class="grille-info">' + infosHtml + '</div>'; }

        var lignes = bon.lignes || [];
        if (lignes.length) {
            html += '<table class="table-lignes"><thead><tr>' +
                        '<th>Article / rubrique</th><th>Quantite</th>' +
                        '<th class="stock">Stock avant</th><th class="stock">Stock apres</th>' +
                    '</tr></thead><tbody>';
            for (var j = 0; j < lignes.length; j++) {
                var l = lignes[j] || {};
                html += '<tr>' +
                            '<td>' + echapper(l.designation || l.code || '') +
                                (l.code && l.designation ? '<div class="aide" style="margin:2px 0 0">Code : ' + echapper(l.code) + '</div>' : '') +
                                (l.mention ? '<div class="aide" style="margin:2px 0 0">Motif : ' + echapper(l.mention) + '</div>' : '') +
                            '</td>' +
                            '<td class="qte">' + echapper(l.qte || '') + '</td>' +
                            '<td class="stock">' + echapper(l.stock_avant || '') + '</td>' +
                            '<td class="stock">' + echapper(l.stock_apres || '') + '</td>' +
                        '</tr>';
            }
            html += '</tbody></table>';
        }

        html += '<div class="signatures">' +
                    '<div class="signature"><span>Signature Direction Generale</span>' +
                        (bon.signe_par ? '<b>' + echapper(bon.signe_par) + '</b>' : '<span class="vide">Pas encore signe</span>') +
                        (bon.signe_at ? '<br>' + echapper(bon.signe_at) : '') +
                        (bon.observation_signature ? '<br>' + echapper(bon.observation_signature) : '') +
                    '</div>' +
                    '<div class="signature"><span>Controle a la guerite</span>' +
                        (bon.cloture_at
                            ? '<b>' + echapper(bon.cloture_par || 'Cloture enregistree') + '</b><br>' + echapper(bon.cloture_at) +
                              (bon.poste_controle ? '<br>' + echapper(bon.poste_controle) : '')
                            : '<span class="vide">Non encore cloture</span>') +
                    '</div>' +
                '</div>';

        var actions = bon.actions || {};
        var peutSortir = (bon.statut === 'VALIDE') && actions.peut_sortir !== false;

        if (peutSortir) {
            html += '<div class="actions-vigil">' +
                        '<button type="button" class="btn-vigil sortir" id="btn-sortir">\u2713 Faire sortir</button>' +
                        '<button type="button" class="btn-vigil signaler" id="btn-signaler">Signaler</button>' +
                    '</div>' +
                    '<p class="note-envoi" id="note-envoi">' + (AGENT_CONNECTE
                        ? 'La cloture est enregistree a votre nom.'
                        : 'Vous n\u2019etes pas connecte : la cloture sera enregistree sous « Guerite (page scan) ». <a href="#" id="lien-agent">Indiquer mon nom</a>') +
                    '</p>';
        }
        if ((bon.statut === 'ANNULE') && bon.refus_motif) {
            html += '<div class="encart-motif"><b>Motif du signalement</b>' + echapper(bon.refus_motif) +
                    (bon.refus_par ? '<br><span style="opacity:.8">Signale par ' + echapper(bon.refus_par) + (bon.refus_at ? ' le ' + echapper(bon.refus_at) : '') + '</span>' : '') +
                    '</div>';
        }

        html += '<div class="pied-fiche">' +
                    '<button type="button" id="btn-nouveau">Scanner un autre bon</button>' +
                    '<a href="' + PAGE_BON.replace('__CODE__', encodeURIComponent(bon.token || bon.reference || '')) + '">Lien permanent de ce bon</a>' +
                '</div>';

        zoneFiche.innerHTML = html;

        var btnNouveau = document.getElementById('btn-nouveau');
        if (btnNouveau) { btnNouveau.addEventListener('click', reinitialiser); }

        var btnSortir = document.getElementById('btn-sortir');
        if (btnSortir) {
            btnSortir.addEventListener('click', function () { enregistrerSortie(bon, btnSortir); });
        }
        var btnSignaler = document.getElementById('btn-signaler');
        if (btnSignaler) {
            btnSignaler.addEventListener('click', function () { ouvrirSignalement(bon); });
        }
        var lienAgent = document.getElementById('lien-agent');
        if (lienAgent) {
            lienAgent.addEventListener('click', function (e) {
                e.preventDefault();
                var nom = window.prompt('Nom du vigil a la guerite (pour la trace de cloture) :', agentLocal());
                if (nom !== null) { agentLocal(nom.trim()); }
            });
        }
    }

    function reinitialiser() {
        zoneFiche.innerHTML = '<div class="vide-zone">Le bon scanne s\u2019affichera ici.</div>';
        carteFiche.hidden = true;
        champRef.value = '';
        champRef.focus();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ---------- Vigil : nom local, faire sortir, signaler ---------- */
    function agentLocal(nom) {
        try {
            if (nom === undefined) { return localStorage.getItem('citrac_vigil') || ''; }
            if (nom === '') { localStorage.removeItem('citrac_vigil'); } else { localStorage.setItem('citrac_vigil', nom); }
        } catch (e) { /* stockage indisponible */ }
        return '';
    }

    function postAction(url, donnees) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(donnees)
        }).then(function (r) {
            return r.json().catch(function () { return { code: 'error', msg: 'Reponse illisible du serveur.' }; });
        });
    }

    function enregistrerSortie(bon, bouton) {
        var code = bon.token || bon.reference || '';
        if (!window.confirm('Confirmer la sortie de la marchandise pour le bon ' + (bon.reference || '') + ' ?\n\nLe bon sera cloture.')) { return; }

        bouton.disabled = true;
        var libelle = bouton.innerHTML;
        bouton.innerHTML = 'Enregistrement...';

        postAction(URL_SORTIE, { code: code, agent: agentLocal(), poste_controle: 'Guerite' })
            .then(function (rep) {
                if (rep && rep.data) {
                    afficherBon(rep.data);
                    alert(rep.msg || 'Sortie confirmee.');
                } else {
                    bouton.disabled = false;
                    bouton.innerHTML = libelle;
                    alert((rep && rep.msg) || 'La cloture n\'a pas pu etre enregistree.');
                    if (rep && rep.data) { afficherBon(rep.data); }
                }
            })
            .catch(function () {
                bouton.disabled = false;
                bouton.innerHTML = libelle;
                alert('Connexion impossible : la sortie n\'a pas ete enregistree. Verifiez le reseau puis reessayez.');
            });
    }

    var bonASignaler = null;

    function ouvrirSignalement(bon) {
        bonASignaler = bon;
        document.getElementById('motif-signal').value = '';
        var choix = document.querySelectorAll('#choix-motif button');
        for (var i = 0; i < choix.length; i++) { choix[i].classList.remove('actif'); }
        document.getElementById('voile-signal').hidden = false;
        document.getElementById('motif-signal').focus();
    }

    function fermerSignalement() {
        document.getElementById('voile-signal').hidden = true;
        bonASignaler = null;
    }

    (function brancherSignalement() {
        var voile = document.getElementById('voile-signal');
        if (!voile) { return; }

        var choix = document.querySelectorAll('#choix-motif button');
        for (var i = 0; i < choix.length; i++) {
            choix[i].addEventListener('click', function () {
                for (var j = 0; j < choix.length; j++) { choix[j].classList.remove('actif'); }
                this.classList.add('actif');
                document.getElementById('motif-signal').value = this.getAttribute('data-motif');
            });
        }

        document.getElementById('btn-annuler-signal').addEventListener('click', fermerSignalement);
        voile.addEventListener('click', function (e) { if (e.target === voile) { fermerSignalement(); } });

        document.getElementById('btn-envoyer-signal').addEventListener('click', function () {
            var motif = (document.getElementById('motif-signal').value || '').trim();
            if (motif.length < 5) {
                alert('Merci de preciser le motif du signalement (au moins 5 caracteres).');
                document.getElementById('motif-signal').focus();
                return;
            }
            if (!bonASignaler) { fermerSignalement(); return; }

            var bouton = this;
            bouton.disabled = true;
            postAction(URL_SIGNALER, {
                code: bonASignaler.token || bonASignaler.reference || '',
                motif: motif,
                agent: agentLocal(),
                poste_controle: 'Guerite'
            }).then(function (rep) {
                bouton.disabled = false;
                fermerSignalement();
                if (rep && rep.data) { afficherBon(rep.data); }
                alert((rep && rep.msg) || 'Signalement enregistre.');
            }).catch(function () {
                bouton.disabled = false;
                alert('Connexion impossible : le signalement n\'a pas ete enregistre.');
            });
        });
    })();

    /* ---------- Recherche du bon ---------- */
    function rechercher(code) {
        code = String(code || '').trim();
        if (!code || enCours) { return; }
        enCours = true;

        carteFiche.hidden = false;
        zoneFiche.innerHTML = '<div class="vide-zone"><span class="chargement"></span>  Recherche du bon ' + echapper(code) + '...</div>';
        var url = URL_API.replace('__CODE__', encodeURIComponent(code));

        fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json().catch(function () { return { code: 'error', msg: 'Reponse illisible du serveur.' }; }); })
            .then(function (reponse) {
                if (reponse && reponse.code === 'success' && reponse.data) {
                    afficherBon(reponse.data);
                } else {
                    var msg = (reponse && reponse.msg) ? reponse.msg : 'Bon introuvable.';
                    var diag = (reponse && reponse.diagnostic) ? reponse.diagnostic : null;
                    if (diag) {
                        msg += '\n\nCode teste : ' + (diag.code_lu || code);
                        if (diag.reference && diag.reference !== diag.code_lu) {
                            msg += '\nReference lue : ' + diag.reference;
                        }
                        if (diag.indice) { msg += '\n' + diag.indice; }
                    }
                    afficherMessage('ko', 'Bon introuvable', msg);
                }
            })
            .catch(function () {
                afficherMessage('ko', 'Connexion impossible', 'Le serveur ne repond pas. Verifiez la connexion, puis reessayez.');
            })
            .then(function () { enCours = false; });
    }

    formRef.addEventListener('submit', function (e) {
        e.preventDefault();
        rechercher(codeDepuisContenu(champRef.value));
    });

    /* ---------- Camera ---------- */
    function arreterCamera() {
        if (boucle) { clearTimeout(boucle); boucle = null; }
        if (flux) { flux.getTracks().forEach(function (t) { t.stop(); }); flux = null; }
        video.srcObject = null;
        cadre.hidden = true;
        btnArreter.hidden = true;
        btnCamera.hidden = false;
        voileCoach.hidden = true;
    }

    /** Canvas de travail (reutilise) pour la lecture des images de la camera. */
    var canvasDet = null, ctxDet = null;

    function preparerCanvas() {
        if (!canvasDet) {
            canvasDet = document.createElement('canvas');
            ctxDet = canvasDet.getContext('2d', { willReadFrequently: true });
        }
    }

    /** Dessine l'image de la video (recadree au centre) dans le canvas de travail. */
    function capturerImage(largeurMax) {
        var lv = video.videoWidth || 0, hv = video.videoHeight || 0;
        if (!lv || !hv) { return null; }
        preparerCanvas();

        // On garde une bande carree au centre : c'est la zone du cadre de visee.
        var cote = Math.min(lv, hv);
        var sx = (lv - cote) / 2, sy = (hv - cote) / 2;

        var ech = Math.min(1, (largeurMax || 720) / cote);
        canvasDet.width  = Math.max(160, Math.round(cote * ech));
        canvasDet.height = canvasDet.width;
        ctxDet.drawImage(video, sx, sy, cote, cote, 0, 0, canvasDet.width, canvasDet.height);
        return canvasDet;
    }

    /** Lecture du QR directement dans le navigateur (sans API experimentale). */
    function lireAvecJSQR() {
        if (!window.jsQR) { return null; }
        var cv = capturerImage(720);
        if (!cv) { return null; }
        try {
            var img = ctxDet.getImageData(0, 0, cv.width, cv.height);
            var res = window.jsQR(img.data, img.width, img.height, { inversionAttempts: 'attemptBoth' });
            return (res && res.data) ? res.data : null;
        } catch (e) { return null; }
    }

    /** Lecture via BarcodeDetector quand le navigateur le propose vraiment. */
    function lireAvecDetecteur() {
        if (!detecteur) { return Promise.resolve(null); }
        return detecteur.detect(video).then(function (codes) {
            return (codes && codes.length && codes[0].rawValue) ? codes[0].rawValue : null;
        }).catch(function () { return null; });
    }

    function traiterContenu(brut) {
        if (!brut) { return; }
        var valeur = codeDepuisContenu(brut);
        var maintenant = Date.now();
        if (valeur && (valeur !== dernierCode || maintenant - dernierAt > 4000)) {
            dernierCode = valeur;
            dernierAt = maintenant;
            if (navigator.vibrate) { navigator.vibrate(60); }
            champRef.value = '';
            rechercher(valeur);
            arreterCamera();
        }
    }

    /** Boucle de detection : BarcodeDetector si disponible, sinon jsQR local. */
    function lancerDetection() {
        var promesse = lireAvecDetecteur();
        if (!window.BarcodeDetector) { promesse = Promise.resolve(null); }
        promesse.then(function (brut) {
            if (!brut) { brut = lireAvecJSQR(); }
            if (brut) { traiterContenu(brut); }
            if (!flux) { return; }
            boucle = setTimeout(lancerDetection, window.BarcodeDetector ? 300 : 220);
        });
    }

    /** Verifie que le navigateur sait vraiment decoder le QR (et pas seulement
     *  annoncer l'API). Sinon on bascule sur jsQR et on le signale. */
    function verifierBarcodeDetector() {
        if (!('BarcodeDetector' in window) || typeof window.BarcodeDetector.getSupportedFormats !== 'function') {
            return Promise.resolve('jsqr');
        }
        return window.BarcodeDetector.getSupportedFormats().then(function (formats) {
            formats = formats || [];
            if (formats.indexOf('qr_code') === -1) { return 'jsqr'; }
            try {
                detecteur = new window.BarcodeDetector({ formats: ['qr_code'] });
                return 'natif';
            } catch (e) { return 'jsqr'; }
        }).catch(function () { return 'jsqr'; });
    }

    btnCamera.addEventListener('click', function () {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            afficherMessage('ko', 'Camera indisponible',
                'Ce navigateur ne permet pas d\u2019ouvrir la camera : la page doit etre ouverte en HTTPS (ou sur localhost). Saisissez la reference imprimee sur le bon.');
            champRef.focus();
            return;
        }
        if (!window.jsQR && !('BarcodeDetector' in window)) {
            afficherMessage('ko', 'Bibliotheque de lecture absente',
                'Le lecteur de QR code n\u2019a pas pu etre charge (connexion interrompue). Rechargez la page en 4G/Wi-Fi, ou saisissez la reference imprimee sur le bon.');
        }

        btnCamera.disabled = true;
        verifierBarcodeDetector().then(function (mode) {
            return navigator.mediaDevices.getUserMedia({
                video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 720 } },
                audio: false
            }).then(function (f) { return { flux: f, mode: mode }; });
        }).then(function (res) {
            flux = res.flux;
            video.srcObject = res.flux;
            video.setAttribute('playsinline', '');
            video.muted = true;
            return video.play().then(function () { return res.mode; });
        }).then(function (mode) {
            cadre.hidden = false;
            btnCamera.hidden = true;
            btnArreter.hidden = false;
            btnCamera.disabled = false;
            voileCoach.hidden = false;
            if (mode === 'natif') {
                detecteur = detecteur || new window.BarcodeDetector({ formats: ['qr_code'] });
            } else {
                detecteur = null;
                if (!window.jsQR) {
                    afficherMessage('attente', 'Lecture du QR sur cet appareil',
                        'Ce navigateur ne decode pas les QR nativement et le module de secours n\u2019a pas pu etre charge. Saisissez la reference du bon ci-dessus.');
                }
            }
            lancerDetection();
        }).catch(function (err) {
            btnCamera.disabled = false;
            var nom = (err && err.name) || '';
            if (nom === 'NotAllowedError' || nom === 'SecurityError') {
                afficherMessage('ko', 'Camera non autorisee',
                    'L\u2019acces a la camera a ete refuse. Touchez l\u2019icone de cadenas dans la barre du navigateur, autorisez la camera, puis rechargez la page. Vous pouvez aussi saisir la reference du bon.');
            } else if (nom === 'NotFoundError' || nom === 'OverconstrainedError') {
                afficherMessage('ko', 'Aucune camera detectee',
                    'Cet appareil ne signale aucune camera utilisable. Saisissez la reference imprimee sur le bon.');
            } else {
                afficherMessage('ko', 'Camera indisponible',
                    'La camera n\u2019a pas pu demarrer. Verifiez qu\u2019aucune autre application ne l\u2019utilise, en HTTPS, puis reessayez. La saisie de la reference reste possible.');
            }
        });
    });

    btnArreter.addEventListener('click', arreterCamera);

    /* ---------- Secours : photo du QR (toujours possible) ---------- */
    btnPhoto.addEventListener('click', function () { champPhoto.click(); });

    champPhoto.addEventListener('change', function () {
        var fichier = champPhoto.files && champPhoto.files[0];
        champPhoto.value = '';
        if (!fichier) { return; }

        var img = new Image();
        var url = URL.createObjectURL(fichier);
        img.onload = function () {
            var trouve = null;

            // 1) jsQR sur l'image (fonctionne sur tous les mobiles)
            if (window.jsQR) {
                try {
                    preparerCanvas();
                    var cote = Math.min(img.width, img.height);
                    var ech = Math.min(1, 1000 / cote);
                    canvasDet.width  = Math.max(160, Math.round(cote * ech));
                    canvasDet.height = canvasDet.width;
                    ctxDet.drawImage(img,
                        (img.width - cote) / 2, (img.height - cote) / 2, cote, cote,
                        0, 0, canvasDet.width, canvasDet.height);
                    var donnees = ctxDet.getImageData(0, 0, canvasDet.width, canvasDet.height);
                    var res = window.jsQR(donnees.data, donnees.width, donnees.height, { inversionAttempts: 'attemptBoth' });
                    if (res && res.data) { trouve = res.data; }
                } catch (e) { trouve = null; }
            }

            // 2) BarcodeDetector natif en dernier recours
            var apresNatif = function (brut) {
                URL.revokeObjectURL(url);
                if (brut || trouve) {
                    traiterContenu(brut || trouve);
                } else {
                    afficherMessage('attente', 'QR non reconnu sur la photo',
                        'Le code n\u2019a pas ete lu. Rapprochez-vous, evitez le reflet et cadrez uniquement le QR, puis reprenez la photo. Vous pouvez aussi saisir la reference du bon.');
                }
            };

            if (trouve || !('BarcodeDetector' in window)) {
                apresNatif(null);
            } else {
                try {
                    new window.BarcodeDetector({ formats: ['qr_code'] }).detect(img)
                        .then(function (codes) { apresNatif(codes && codes.length ? codes[0].rawValue : null); })
                        .catch(function () { apresNatif(null); });
                } catch (e) { apresNatif(null); }
            }
        };
        img.onerror = function () {
            URL.revokeObjectURL(url);
            afficherMessage('ko', 'Photo illisible', 'La photo n\u2019a pas pu etre ouverte. Reprenez la photo, ou saisissez la reference du bon.');
        };
        img.src = url;
    });
    window.addEventListener('pagehide', arreterCamera);

    /* ---------- Au chargement ---------- */
    if (cibleInitiale) {
        afficherBon(cibleInitiale);
    } else {
        // Lien direct sans bon : on place le curseur dans la saisie.
        champRef.focus();
    }
})();
</script>
{% endblock %}
