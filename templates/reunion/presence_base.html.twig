{#
    Gabarit AUTONOME de la page publique d'enregistrement de presence.
    Volontairement : aucune sidebar, aucune barre superieure, pas de session.
    Fond : degrade cacao leger et clair, logo CITRAC en filigrane + en tete.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Presence a une reunion — CITRAC{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link rel="icon" href="{{ asset('icons/favicon.png') }}">
    <style>
        :root {
            --cacao-100: #fbf5f0;
            --cacao-200: #f5e8dd;
            --cacao-300: #ecd7c6;
            --cacao-500: #a9765a;
            --cacao-700: #7a4c33;
            --cacao-900: #4b2c1d;
            --ink: #33211a;
            --ok: #2f7d5d;
            --err: #b3352c;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
            color: var(--ink);
            min-height: 100vh;
            background:
                radial-gradient(1100px 620px at 12% -10%, #fffdfb 0%, rgba(255,253,251,0) 62%),
                radial-gradient(900px 520px at 92% 108%, #f7e3d3 0%, rgba(247,227,211,0) 60%),
                linear-gradient(158deg, #fdf8f3 0%, #f7ebdf 46%, #f0dccb 100%);
            background-attachment: fixed;
        }
        /* Logo CITRAC en filigrane, tres discret */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: url('{{ asset('images/CITRAC.png') }}') center 38% / min(880px, 92vw) no-repeat;
            opacity: .055;
            pointer-events: none;
            z-index: 0;
        }
        .page { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; padding: 34px 18px 60px; }

        /* ------- entete ------- */
        .brand { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; margin-bottom: 22px; }
        .brand img { height: 58px; width: auto; }
        .brand .sub { font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--cacao-500); font-weight: 600; }

        .card {
            background: rgba(255, 255, 255, .86);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(169, 118, 90, .22);
            border-radius: 18px;
            box-shadow: 0 18px 44px rgba(75, 44, 29, .10), 0 2px 6px rgba(75, 44, 29, .05);
            padding: 26px 26px 22px;
        }
        .card + .card { margin-top: 18px; }

        h1 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 1.9rem; line-height: 1.2; margin: 0 0 6px; color: var(--cacao-900); }
        h2 { font-size: 1rem; font-weight: 700; margin: 0 0 14px; color: var(--cacao-700); letter-spacing: .01em; }
        .muted { color: #8a6a58; font-size: .86rem; margin: 0; }

        .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 14px 0 0; padding: 12px 14px; border-radius: 12px; background: rgba(245, 232, 221, .55); }
        .meta div { font-size: .84rem; color: #6b4a38; }
        .meta b { color: var(--cacao-900); font-weight: 600; }

        .pill { display: inline-flex; align-items: center; gap: 6px; font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
        .pill.open { background: #e3f4ec; color: #22684d; }
        .pill.closed { background: #f7e2df; color: #9c2f27; }
        .pill.wait { background: #f3ecdd; color: #8a6a2a; }
        .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

        /* ------- formulaire ------- */
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
        .grid .full { grid-column: 1 / -1; }
        label { display: block; font-size: .78rem; font-weight: 600; color: #6b4a38; margin-bottom: 5px; letter-spacing: .02em; }
        label .req { color: var(--err); }
        input[type=text], input[type=tel], input[type=email], select {
            width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #e2cec0;
            background: #fffdfb; font-family: inherit; font-size: .92rem; color: var(--ink);
            transition: border-color .15s, box-shadow .15s;
        }
        input:focus, select:focus { outline: none; border-color: var(--cacao-500); box-shadow: 0 0 0 3px rgba(169, 118, 90, .16); }
        .aide { font-size: .72rem; color: #9c8272; margin-top: 4px; }

        /* ------- signature ------- */
        .sig-wrap { position: relative; border: 1.5px dashed #d9c2b0; border-radius: 12px; background: #fffefc; }
        .sig-wrap.has { border-style: solid; border-color: var(--cacao-500); }
        canvas { display: block; width: 100%; height: 170px; border-radius: 12px; touch-action: none; cursor: crosshair; }
        .sig-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 8px; }
        .sig-bar .hint { font-size: .72rem; color: #9c8272; }

        button, .btn {
            font-family: inherit; font-size: .92rem; font-weight: 600; border-radius: 11px;
            padding: 11px 20px; border: 1px solid transparent; cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all .16s;
        }
        .btn-main { background: linear-gradient(180deg, #8a5636, #6f422a); color: #fff; box-shadow: 0 8px 18px rgba(111, 66, 42, .22); }
        .btn-main:hover { background: linear-gradient(180deg, #7a4a2d, #5f3722); transform: translateY(-1px); }
        .btn-ghost { background: #fffdfb; border-color: #e2cec0; color: var(--cacao-700); }
        .btn-ghost:hover { background: #fbf3ec; }
        .btn-sm { padding: 7px 13px; font-size: .8rem; border-radius: 9px; }
        .actions { grid-column: 1 / -1; display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

        .alert { border-radius: 12px; padding: 12px 14px; font-size: .87rem; margin-bottom: 16px; }
        .alert.err { background: #fdecea; border: 1px solid #f2c3bd; color: #91251d; }
        .alert.err ul { margin: 6px 0 0; padding-left: 18px; }
        .alert.ok { background: #e8f6ee; border: 1px solid #bfe3cd; color: #1f6146; }

        /* ------- liste des presents ------- */
        .count { font-size: .82rem; color: #7a5c4c; }
        table { width: 100%; border-collapse: collapse; font-size: .84rem; }
        thead th { text-align: left; font-size: .7rem; letter-spacing: .07em; text-transform: uppercase; color: #8a6a58; padding: 8px 10px; border-bottom: 1px solid #ecdbd0; background: rgba(245, 232, 221, .55); }
        tbody td { padding: 9px 10px; border-bottom: 1px solid #f2e6dd; color: #4a3325; vertical-align: middle; }
        tbody tr:last-child td { border-bottom: none; }
        .sig-thumb { height: 30px; width: auto; max-width: 120px; object-fit: contain; }
        .nom { font-weight: 600; color: var(--cacao-900); }
        .num { color: #9c8272; font-size: .76rem; }

        /* ------- compte rendu ------- */
        .cr-box { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 16px; border-radius: 14px; background: linear-gradient(120deg, #fdf6ef, #f8ece1); border: 1px solid #eed9c8; }
        .cr-box .t { font-weight: 600; color: var(--cacao-900); }

        footer.page-foot { text-align: center; font-size: .74rem; color: #a2887a; margin-top: 26px; }

        @media (max-width: 620px) {
            .grid { grid-template-columns: 1fr; }
            .page { padding: 22px 12px 48px; }
            .card { padding: 20px 16px; }
            h1 { font-size: 1.55rem; }
            .brand img { height: 46px; }
            .hide-sm { display: none; }
        }
        @media print {
            body { background: #fff; }
            body::before { display: none; }
            .card { box-shadow: none; border-color: #ddd; }
            .no-print { display: none !important; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="page">
        {% block presence_body %}{% endblock %}
        <footer class="page-foot">
            CITRAC Process — San-Pedro, Côte d'Ivoire
        </footer>
    </div>
    {% block javascripts %}{% endblock %}
</body>
</html>
