<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
    .chart-card { border:0; border-radius:14px; box-shadow:0 4px 18px rgba(20,49,27,.08); }
    .chart-card .card-header { background:transparent; border-bottom:1px solid var(--green-100);
        font-weight:700; color:var(--green-800); }
    .chart-box { position:relative; height:150px; }
    .chart-box-sm { position:relative; height:125px; }
    .alert-tile { border:0; border-radius:14px; color:#fff; overflow:hidden; position:relative;
        box-shadow:0 4px 16px rgba(0,0,0,.12); transition:transform .15s ease; }
    .alert-tile:hover { transform:translateY(-3px); }
    .alert-tile .ico { position:absolute; right:-6px; top:-10px; font-size:4.2rem; opacity:.18; }
    .alert-tile .val { font-size:2rem; font-weight:800; line-height:1; }
    .alert-tile .lbl { font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; opacity:.95; }
    .at-danger  { background:linear-gradient(135deg,#b91c1c,#ef4444); }
    .at-warning { background:linear-gradient(135deg,#b45309,#f59e0b); }
    .at-info    { background:linear-gradient(135deg,#1b5e20,#43a047); }
    .at-muted   { background:linear-gradient(135deg,#4b5563,#6b7280); }
    .alert-list .list-group-item { border-color:var(--green-100); }
    .badge-soft-danger { background:#fee2e2; color:#b91c1c; }
    .badge-soft-warning{ background:#fef3c7; color:#b45309; }
</style>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card alert-tile at-danger h-100"><div class="card-body">
                <i class="bi bi-exclamation-octagon-fill ico"></i>
                <div class="val">{{ nb_alertes_enc_cours }}</div>
                <div class="lbl">Alertes</div>
                <div class="small mt-1" style="opacity:.9">Statut : Ouvert</div>
            </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card alert-tile at-info h-100"><div class="card-body">
                <i class="bi bi-shield-exclamation ico"></i>
                <div class="val">{{ nb_articles }}</div>
                <div class="lbl">Equipements</div>
                <div class="small mt-1" style="opacity:.9">Actifs 100 %</div>
            </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card alert-tile at-warning h-100"><div class="card-body">
             <i class="bi bi-exclamation-triangle-fill ico"></i>
                <div class="val">{{ nb_alertes_equipements }}</div>
                <div class="lbl">Alertes Stocks</div>
                <div class="small mt-1" style="opacity:.9">Statut : <span class="badge bg-danger p-1 fw-bold">Rupture</span></div>
            </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card alert-tile at-muted h-100"><div class="card-body">
                <i class="bi bi-question-circle-fill ico"></i>
                <div class="val">{{ nb_fiches_intervention }}</div>
                <div class="lbl">Fiches Intervention</div>
                <div class="small mt-1" style="opacity:.9">
                    <u>Currative</u>     :<span class="badge bg-dark p-1 fw-bold">{{ nb_fiches_intervention_corrective }}</span>
                    <u>PREVENTIVE</u> : <span class="badge bg-dark p-1 fw-bold">{{ nb_fiches_intervention_preventif }}</span>
                </div>
            </div></div>
    </div>
</div>
