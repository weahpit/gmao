{% extends 'base.html.twig' %}

{% block title %}Types Equipements— CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Type</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Types équipements</h1>
        <a href="#"  id="btn_add_type_eq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddType">
            <img src="{{ asset('icons/Type_eq.png') }}" class="me-2" alt="" height="16"> Nouveau type
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edith Equipement-->
    <div class="modal fade" id="modalAddType" tabindex="-1" aria-labelledby="modalAddTypeLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/Type_eq.png') }}" height="40" alt=""> Enregistrer un Type Equipement</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formType" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="Type_eq" style="width: 150px;">Nom</label>
                            <input type="text" class="input" id="Type_eq" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveType">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/TypeEq.js') }}"></script>
    <script>

        let idType = 0;
        getAllTypeEq(document.querySelector(".card-body"), 1)
        clearForm("formType", "Type_eq")
        ValidateOnKeypress(document.getElementById("Type_eq"), document.getElementById("saveType"), "formType")
        document.querySelector("#btn_add_type_eq").addEventListener("click", function () {
            clearForm("formType", "Type_eq")
        })

        document.querySelector("#saveType").addEventListener("click", function () {
            let FormDatatypeEq = new FormData();
            FormDatatypeEq.append('id_type_eq', idType)
            FormDatatypeEq.append('type_eq', document.querySelector("#Type_eq").value)
            saveTypeEq(FormDatatypeEq, document.querySelector(".card-body"), 1)
        })
    </script>
{% endblock %}
