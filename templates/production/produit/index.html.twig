{% extends 'base.html.twig' %}

{% block title %}Produits — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Produit</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Produit</h1>
        <a href="#"  id="btn_add_produit" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddProduit">
            <img src="{{ asset('icons/_eq.png') }}" class="me-2" alt="" height="16"> Ajouter  un produit
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Produit-->
    <div class="modal fade" id="modalAddProduit" tabindex="-1" aria-labelledby="modalAddLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/produit.png') }}" height="40" alt=""> Enregistrer un produit</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formProduit" >
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="produit" style="width: 250px;">Produit</label>
                            <input type="text" class="input" id="produit" style="text-transform: uppercase;">
                        </div>
                        <div class="d-flex justify-content-start mb-2">
                            <label class="fw-bold span " for="zone" style="width: 250px;">Propriétaire</label>
                            <select class="input" id="proprietaire"></select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveProduit">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/Production/Produit.js') }}"></script>
    <script src="{{ asset('js/api/Logistique/Proprietaire.js') }}"></script>
    <script>

        let idProduit = "0";
        getAllProduits(document.querySelector(".card-body"), 1)
        getAllProprietaires(document.getElementById('proprietaire'), 2)
        clearForm("formProduit", "produit")
        ValidateOnKeypress(document.getElementById("produit"), document.getElementById("saveProduit"), "formProduit")

        document.querySelector("#btn_add_produit").addEventListener("click", function () {
            clearForm("formProduit", "produit")
        })

        document.querySelector("#saveProduit").addEventListener("click", function () {
            let FormDataProduit = new FormData();
            FormDataProduit.append('id_produit', idProduit)
            FormDataProduit.append('produit', document.querySelector("#produit").value)
            FormDataProduit.append('code_proprio', document.querySelector("#proprietaire").value)
            saveProduit(FormDataProduit, document.querySelector(".card-body"), 1)
        })

    </script>
{% endblock %}
