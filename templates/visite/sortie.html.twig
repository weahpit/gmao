{% extends 'base.html.twig' %}

{% block title %}Sortie visiteur — CITRAC{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-item"><a href="{{ path('app_visites') }}">Visites</a></span>
    <span class="breadcrumb-item">Sortie {{ visite.reference }}</span>
{% endblock %}

{% block body %}
<div class="container-fluid py-3">

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Sortie du visiteur</h1>
            <p class="text-muted mb-0">Vérifiez l'identité, remettez la pièce, puis validez la sortie.</p>
        </div>
        <a href="{{ path('app_visites') }}" class="btn btn-sm btn-outline-secondary">Retour à la liste des présents</a>
    </div>

    {% if erreurs %}
        <div class="alert alert-danger" role="alert">
            <div class="fw-semibold mb-1">La sortie n'a pas été enregistrée :</div>
            <ul class="mb-0 ps-3">
                {% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if not visite.enCours %}
        <div class="alert alert-info" role="alert">
            Ce passage est déjà clôturé ({{ visite.statutLibelle }}
            {%- if visite.heureSortie %}, sortie à {{ visite.heureSortie|date('H:i') }}{% endif %}).
            La pièce d'identité a été remise.
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted">Référence {{ visite.reference }}</div>
                        <h2 class="h5 mb-0">{{ visite.visiteur.nomComplet }}</h2>
                        <div class="small text-muted">
                            {{ visite.visiteur.pieceComplete }}
                            {% if visite.visiteur.societe %} · {{ visite.visiteur.societe }}{% endif %}
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Présent depuis</div>
                        <div class="h5 mb-0" style="color:#7a4c33;">{{ visite.dureeLibelle }}</div>
                        <div class="small text-muted">entrée à {{ visite.heureEntree|date('H:i') }}</div>
                    </div>
                </div>

                <hr style="border-color:#eadfd6;">

                <div class="row g-2 small">
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Service visité</span>{{ visite.serviceLibelle }}</div>
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Personne visitée</span>{{ visite.personneVisitee ?? '—' }}</div>
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Motif</span>{{ visite.motif ?? '—' }}</div>
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Accompagnants</span>{{ visite.nombreAccompagnants }}</div>
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Téléphone</span>{{ visite.visiteur.telephone ?? '—' }}</div>
                    <div class="col-6 col-md-4"><span class="text-muted d-block">Enregistré par</span>{{ visite.agentEntree ? ((visite.agentEntree.nom ~ ' ' ~ (visite.agentEntree.prenoms ?? ''))|trim ?: visite.agentEntree.email) : '—' }}</div>
                </div>

                {% if visite.observations %}
                    <div class="mt-3 p-2 small" style="background:#faf6f2; border-radius:8px;">
                        <span class="text-muted">Observations :</span> {{ visite.observations }}
                    </div>
                {% endif %}
            </div>

            {% if visite.enCours %}
                <form method="post" action="{{ path('app_visites_sortie', {id: visite.id}) }}"
                      class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                    <input type="hidden" name="_token" value="{{ csrf_token('visite_sortie_' ~ visite.id) }}">

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="1" id="piece_remise" name="piece_remise" required>
                        <label class="form-check-label" for="piece_remise">
                            Je confirme avoir remis sa pièce d'identité à <strong>{{ visite.visiteur.nomComplet }}</strong>
                            et je clôture le passage.
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-cacao">Remettre la pièce et enregistrer la sortie</button>
                        <a href="{{ path('app_visites') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            {% endif %}
        </div>

        <div class="col-12 col-lg-5">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <h2 class="h6">Pièce d'identité déposée</h2>

                {% if visite.aUnePieceJointe %}
                    {% if visite.pieceTypeMime and visite.pieceTypeMime starts with 'image/' %}
                        <a href="{{ path('app_visites_piece', {id: visite.id}) }}" target="_blank" rel="noopener">
                            <img src="{{ path('app_visites_piece', {id: visite.id}) }}" alt="Pièce d'identité de {{ visite.visiteur.nomComplet }}"
                                 class="img-fluid rounded border" style="border-color:#e9ded5 !important; max-height:360px;">
                        </a>
                    {% else %}
                        <div class="p-3 text-center" style="background:#faf6f2; border-radius:10px;">
                            <div class="mb-2">Document PDF enregistré</div>
                            <a href="{{ path('app_visites_piece', {id: visite.id}) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                                Ouvrir le document
                            </a>
                        </div>
                    {% endif %}
                    <div class="small text-muted mt-2">
                        {{ visite.pieceNomOriginal }}
                        {% if visite.pieceTaille %} · {{ (visite.pieceTaille / 1024)|round }} Ko{% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-warning mb-0">
                        Aucune pièce n'est rattachée à ce passage : vérifiez le registre papier avant de remettre une pièce.
                    </div>
                {% endif %}

                <hr style="border-color:#eadfd6;">
                <p class="small text-muted mb-0">
                    La pièce reste conservée dans le dossier du passage après la sortie, pour permettre le contrôle
                    en cas de litige ou de réclamation.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
