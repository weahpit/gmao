{% extends 'base.html.twig' %}

{% block title %}Accueil des visiteurs — CITRAC{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('tdb_role') }}">Accueil</a></span>
    <span class="breadcrumb-item">Visites</span>
{% endblock %}

{% block body %}
<div class="container-fluid py-3">

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Accueil des visiteurs</h1>
            <p class="text-muted mb-0">Entrées, pièces d'identité déposées à la réception, sorties et historique.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_visites_entree') }}" class="btn btn-sm btn-cacao">+ Enregistrer une entrée</a>
            <a href="{{ path('app_visites_etat') }}" class="btn btn-sm btn-outline-secondary">État des visites</a>
            <a href="{{ path('app_visites_etat_pdf') }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">État PDF du mois</a>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="text-muted small text-uppercase" style="letter-spacing:.03em;">Présents à CITRAC</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ nbPresents }}</div>
                <div class="small text-muted">pièce d'identité non encore remise</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="text-muted small text-uppercase" style="letter-spacing:.03em;">Entrées aujourd'hui</div>
                <div class="h4 mb-0" style="color:#5a371e;">{{ nbEntreesJour }}</div>
                <div class="small text-muted">{{ maintenant|date('d/m/Y') }}</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="text-muted small text-uppercase" style="letter-spacing:.03em;">Sorties aujourd'hui</div>
                <div class="h4 mb-0" style="color:#22684d;">{{ nbSortiesJour }}</div>
                <div class="small text-muted">pièces remises</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
                <div class="text-muted small text-uppercase" style="letter-spacing:.03em;">Visites ce mois</div>
                <div class="h4 mb-0" style="color:#7a4c33;">{{ nbMois }}</div>
                <div class="small text-muted">{{ maintenant|date('m/Y') }}</div>
            </div>
        </div>
    </div>

    <form method="get" action="{{ path('app_visites') }}" class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label mb-1 small" for="q">Rechercher un visiteur (nom, pièce, société, personne visitée)</label>
                <input type="search" id="q" name="q" value="{{ recherche }}" class="form-control form-control-sm"
                       placeholder="Ex. KOUAME, CNI, SIFCA, chef de service...">
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-cacao">Rechercher</button>
                {% if recherche %}
                    <a href="{{ path('app_visites') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
                {% endif %}
            </div>
        </div>
    </form>

    <div class="p-3 mb-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Visiteurs présents — à faire sortir</h2>
            <span class="badge" style="background:#7a4c33;">{{ presents|length }}</span>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Réf.</th>
                        <th>Visiteur</th>
                        <th>Pièce d'identité</th>
                        <th>Société</th>
                        <th>Service visité</th>
                        <th>Personne visitée</th>
                        <th>Entrée</th>
                        <th>Présence</th>
                        <th class="text-end">Sortie</th>
                    </tr>
                </thead>
                <tbody>
                {% for visite in presents %}
                    <tr>
                        <td class="small text-muted">{{ visite.reference }}</td>
                        <td>
                            <div class="fw-semibold">{{ visite.visiteur.nomComplet }}</div>
                            <div class="small text-muted">
                                {{ visite.motif ?? 'Motif non précisé' }}
                                {% if visite.nombreAccompagnants > 0 %}
                                    · +{{ visite.nombreAccompagnants }} accompagnant(s)
                                {% endif %}
                            </div>
                        </td>
                        <td class="small">
                            {{ visite.visiteur.pieceComplete }}
                            {% if visite.aUnePieceJointe %}
                                <div>
                                    <a href="{{ path('app_visites_piece', {id: visite.id}) }}" target="_blank" rel="noopener" class="small">Voir le scan</a>
                                </div>
                            {% endif %}
                        </td>
                        <td class="small">{{ visite.visiteur.societe ?? '—' }}</td>
                        <td class="small">{{ visite.serviceLibelle }}</td>
                        <td class="small">{{ visite.personneVisitee ?? '—' }}</td>
                        <td class="small">{{ visite.heureEntree|date('H:i') }}</td>
                        <td class="small">{{ visite.dureeLibelle }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_visites_sortie', {id: visite.id}) }}" class="btn btn-sm btn-cacao">Sortie</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            {{ recherche ? 'Aucun visiteur présent ne correspond à cette recherche.' : 'Aucun visiteur présent : toutes les pièces d\'identité ont été remises.' }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="p-3" style="background:#fff; border:1px solid #e9ded5; border-radius:14px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Passages du jour</h2>
            <a href="{{ path('app_visites_etat') }}" class="small">Voir l'état complet</a>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Entrée</th>
                        <th>Visiteur</th>
                        <th>Société</th>
                        <th>Service</th>
                        <th>Motif</th>
                        <th>Sortie</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                {% for visite in jour %}
                    <tr>
                        <td class="small">{{ visite.heureEntree|date('H:i') }}</td>
                        <td>
                            <a href="{{ path('app_visites_visiteur', {id: visite.visiteur.id}) }}" class="fw-semibold text-decoration-none">
                                {{ visite.visiteur.nomComplet }}
                            </a>
                        </td>
                        <td class="small">{{ visite.visiteur.societe ?? '—' }}</td>
                        <td class="small">{{ visite.serviceLibelle }}</td>
                        <td class="small">{{ visite.motif ?? '—' }}</td>
                        <td class="small">{{ visite.heureSortie ? visite.heureSortie|date('H:i') : '—' }}</td>
                        <td>
                            {% if visite.enCours %}
                                <span class="badge" style="background:#7a4c33;">Présent</span>
                            {% else %}
                                <span class="badge" style="background:#22684d;">Sorti</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Aucun passage enregistré aujourd'hui.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
