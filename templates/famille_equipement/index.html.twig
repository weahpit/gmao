{% extends 'base.html.twig' %}

{% block title %}Familles Equipements — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Famille</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Familles équipements</h1>
        <a href="#"  id="btn_add_mrq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddFamille">
            <img src="{{ asset('icons/famille.png') }}" class="me-2" alt="" height="16"> Nouvelle famille
        </a>
    </div>

    <!-- Table -->
        <div class="card-body">

        </div>

    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddFamille" tabindex="-1" aria-labelledby="modalAddFamilleLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/famille.png') }}" height="40" alt=""> Enregistrer une famille</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formFamille" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="famille" style="width: 150px;">Nom</label>
                            <input type="text" class="input" id="famille" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveFamille">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/references/NatureEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/FamilleEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/Fournisseur.js') }}"></script>
    <script>

        let idFamille = 0;
        getAllFamilles(document.querySelector(".card-body"), 1)
        clearForm("formFamille", "famille")

        ValidateOnKeypress(document.getElementById("famille"), document.getElementById("saveFamille"),"formFamille",)
        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
            clearForm("formFamille", "famille")
        })

        document.querySelector("#saveFamille").addEventListener("click", function () {
            let agree = "0";
            let FormDataFournisseur = new FormData();
            FormDataFournisseur.append('id_famille', idFamille)
            FormDataFournisseur.append('famille', document.querySelector("#famille").value)
            saveFamille(FormDataFournisseur, document.querySelector(".card-body"), 1)
        })
    </script>
{% endblock %}
