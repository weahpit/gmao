{% extends 'base.html.twig' %}

{% block title %}Références — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Références</span>
{% endblock %}

{% block body %}
    <h2 class="p-1" style="background: var(--green-100)">Données de références</h2>
    <div class="row bg-white">
        {%  for menu in menus %}
            <div class="col-md-2 p-2">
                {% if (menu.classnameMenu) %}
                    <a href="{{ path(menu.classnameMenu) }}" target="_blank">
                        <div class="card bg-light text-center mx-auto" style="cursor: pointer;height: 150px;border-radius: 0;border: lightgrey 1px solid;">
                            <div class="card-title" style="height: 60px;background: #b4c8db;font-size: 13px;border-bottom: 3px solid darkblue;">{{ menu.nomMenu }}</div>
                            <div class="card-body"><img src="{{ asset('icons/SVG/database.svg') }}" class="py-auto" alt="" height="40" style="color: #2563EB;"></div>
                        </div>
                    </a>
                {% else %}
                    <div class="card bg-light text-center mx-auto" style="cursor: pointer;height: 150px;border-radius: 0;border: grey;">

                        <div class="card-title" style="height: 60px;background: #b4c8db;font-size: 13px;border-bottom: 3px solid darkblue;">{{ menu.nomMenu }}</div>
                        <div class="card-body"><img src="{{ asset('icons/SVG/database.svg') }}" class="py-auto" alt="" height="40" style="color: #2563EB;"></div>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <!-- Development version -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/admin/Menu.js') }}"></script>

{% endblock %}
