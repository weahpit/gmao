{% extends 'base.html.twig' %}{% block body %}<h1 class="h4">Références : {{ type }}</h1><a href="{{ path('references_edition') }}">Toutes les références</a><form method="get"><input name="q" value="{{ q }}" placeholder="Rechercher" class="form-control form-control-sm"><button class="btn btn-sm btn-cacao">Filtrer</button></form><div class="table-responsive"><table class="table table-sm"><thead><tr>{% for f in champs %}<th>{{ f }}</th>{% endfor %}<th>Action</th></tr></thead><tbody>{% for l in lignes %}<tr>{% for f in champs %}<td>{{ l.valeurs[f] }}</td>{% endfor %}<td><a href="{{ path('references_edition_form',{type:type,id:l.id}) }}">Modifier</a></td></tr>{% endfor %}</tbody></table></div>{% if page>1 %}<a href="{{ path('references_edition_liste',{type:type,q:q,page:page-1}) }}">Précédent</a>{% endif %} {{ page }}/{{ pages }} {% if page<pages %}<a href="{{ path('references_edition_liste',{type:type,q:q,page:page+1}) }}">Suivant</a>{% endif %}{% endblock %}
