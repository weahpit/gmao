{% extends 'base.html.twig' %}{% block title %}Modifier les références — CITRAC{% endblock %}{% block body %}<h1 class="h4">Administration des références</h1><p>Modification des valeurs existantes, sans suppression des liens métier. Réservé aux administrateurs.</p><div class="row g-2">{% for type,classe in catalogue %}<div class="col-md-4"><a class="btn btn-sm btn-outline-secondary" href="{{ path('references_edition_liste',{type:type}) }}">{{ type|replace({'-':' / '})|title }}</a></div>{% endfor %}</div>{% endblock %}
