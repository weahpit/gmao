{% extends 'base.html.twig' %}{% block body %}<h1 class="h4">Modifier — {{ type }}</h1>{% for e in erreurs %}<div class="alert alert-danger">{{ e }}</div>{% endfor %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('ref_edit_' ~ type ~ '_' ~ id) }}"><div class="row g-2">{% for f,i in fields %}<div class="col-md-6"><label class="form-label">{{ f }} {{ i.nullable?'(facultatif)':'' }}</label>{% if i.type=='boolean' %}<select name="{{ f }}" class="form-select form-select-sm"><option value="1" {{ i.valeur=='1'?'selected':'' }}>Oui</option><option value="0" {{ i.valeur=='0'?'selected':'' }}>Non</option>{% if i.nullable %}<option value="" {{ i.valeur==''?'selected':'' }}>Non renseigné</option>{% endif %}</select>{% elseif i.type in ['json','text'] %}<textarea name="{{ f }}" class="form-control form-control-sm">{{ i.valeur }}</textarea>{% else %}<input name="{{ f }}" value="{{ i.valeur }}" class="form-control form-control-sm" {{ i.length?'maxlength=' ~ i.length:'' }}>{% endif %}</div>{% endfor %}{% for f,i in relations %}<div class="col-md-6"><label>{{ f }}</label><select class="form-select form-select-sm" name="{{ f }}"><option value="">Non renseigné</option>{% for c in i.choix %}<option value="{{ c.id }}" {{ c.id==i.valeur?'selected':'' }}>{{ c.libelle }}</option>{% endfor %}</select></div>{% endfor %}</div><button class="btn btn-sm btn-cacao my-3">Enregistrer la modification</button> <a href="{{ path('references_edition_liste',{type:type}) }}">Annuler</a></form>{% endblock %}
