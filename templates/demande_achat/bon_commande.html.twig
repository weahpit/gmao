<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bon de commande - {{ da.numero }}</title>
<style>
  :root{--cacao:#5b8cc4;--cacao-clair:#86b0d8;--cacao-fonce:#3f6896;--line:#d9e3ef;}
  *{box-sizing:border-box;}
  body{font-family:system-ui,Segoe UI,Roboto,sans-serif;color:#33506e;margin:0;background:#eef4fa;-webkit-text-size-adjust:100%;}
  .sheet{max-width:820px;margin:18px auto;background:#fff;padding:28px 34px;border-radius:12px;box-shadow:0 8px 24px rgba(90,55,30,.12);}
  .entete{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid var(--cacao);padding-bottom:14px;margin-bottom:18px;}
  .soc{display:flex;gap:14px;align-items:center;}
  .soc img{height:62px;}
  .soc .nom{font-size:1.3rem;font-weight:800;color:var(--cacao-fonce);}
  .soc .coord{font-size:.8rem;color:#6b513a;line-height:1.35;}
  .doc-title{text-align:right;}
  .doc-title h1{margin:0;font-size:1.25rem;color:var(--cacao);letter-spacing:.5px;}
  .doc-title .ref{font-size:.85rem;color:#6b513a;margin-top:4px;}
  .meta{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0 20px;}
  .box{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:#fbf6f0;}
  .box h3{margin:0 0 8px;font-size:.82rem;text-transform:uppercase;letter-spacing:.5px;color:var(--cacao);}
  .box p{margin:2px 0;font-size:.9rem;}
  table{width:100%;border-collapse:collapse;font-size:.9rem;margin-top:6px;}
  thead th{background:var(--cacao);color:#fff;text-align:left;padding:9px 11px;}
  tbody td{padding:8px 11px;border-bottom:1px solid var(--line);}
  tbody tr:nth-child(even){background:#f5f9fd;}
  .tot{margin-top:14px;text-align:right;font-size:.95rem;}
  .sign{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:46px;}
  .sign div{border-top:1px solid #b89a7e;padding-top:6px;font-size:.82rem;color:#6b513a;text-align:center;}
  .noprint{text-align:center;margin:14px;}
  .btn{background:var(--cacao);color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:700;cursor:pointer;}
  @media print{body{background:#fff;}.sheet{box-shadow:none;margin:0;border-radius:0;}.noprint{display:none;}}
  @media (max-width:640px){
    .sheet{padding:18px 16px;margin:10px;}
    .entete{flex-direction:column;gap:12px;}
    .doc-title{text-align:left;}
    .meta{grid-template-columns:1fr;gap:12px;}
    .sign{grid-template-columns:1fr;gap:28px;}
    table{font-size:.85rem;}
    thead th,tbody td{padding:7px 8px;}
  }
</style>
</head>
<body>
<div class="noprint"><button class="btn" onclick="window.print()">Imprimer le bon de commande</button></div>
<div class="sheet">
  <div class="entete">
    <div class="soc">
      {# Adaptez le chemin du logo si besoin #}
      <img src="{{ asset('images/logo-citrac.png') }}" alt="CITRAC" onerror="this.style.display='none'">
      <div>
        <div class="nom">CITRAC</div>
        <div class="coord">San-Pedro, Cote d'Ivoire<br>Tel : +225 00 00 00 00<br>Email : contact@citrac.ci</div>
      </div>
    </div>
    <div class="doc-title">
      <h1>BON DE COMMANDE</h1>
      <div class="ref">Ref. DA : {{ da.numero }}<br>Date : {{ "now"|date('d/m/Y') }}</div>
    </div>
  </div>

  <div class="meta">
    <div class="box">
      <h3>Fournisseur</h3>
      <p><b>{{ da.fournisseurNom|default('(a preciser)') }}</b></p>
      {% if da.fournisseur %}
        {% if da.fournisseur.adresse %}<p>{{ da.fournisseur.adresse }}</p>{% endif %}
        {% if da.fournisseur.tel %}<p>Tel : {{ da.fournisseur.tel }}</p>{% endif %}
        {% if da.fournisseur.email %}<p>{{ da.fournisseur.email }}</p>{% endif %}
      {% endif %}
    </div>
    <div class="box">
      <h3>Demande d'origine</h3>
      <p>Demandeur : {{ da.demandeur|default('-') }}</p>
      <p>Service : {{ da.service|default('-') }}</p>
      <p>Validee par : {{ da.validePar|default('-') }}</p>
    </div>
  </div>

  <table>
    <thead>
      <tr><th style="width:40px;">#</th><th style="width:120px;">Code</th><th>Designation</th><th style="width:110px;">Quantite</th></tr>
    </thead>
    <tbody>
      {% for l in lignes %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ l.code|default('-') }}</td>
          <td>{{ l.designation }}{% if l.observation|default %}<br><span style="font-size:.8rem;color:#8a715a;">{{ l.observation }}</span>{% endif %}</td>
          <td>{{ l.quantite_validee|default(l.quantite) }}</td>
        </tr>
      {% else %}
        <tr><td colspan="4" style="text-align:center;color:#8a715a;">Aucun article marque a commander.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="tot">Nombre d'articles a commander : <b>{{ lignes|length }}</b></div>

  <div class="sign">
    <div>Le Magasinier</div>
    <div>La Direction</div>
  </div>
</div>
</body>
</html>
