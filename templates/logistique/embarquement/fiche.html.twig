{% extends 'base.html.twig' %}{% block title %}Fiche dossier {{ dossier.numeroOt }} — CITRAC{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('css/citrac/evolutions-v5.css') }}"><div class="exp-wrap"><p><a class="btn btn-sm btn-outline-secondary" href="{{ path('embarquements_index') }}">Retour aux dossiers</a> <a class="btn btn-sm btn-outline-secondary" href="{{ path('logistique_dossier_export',{id:dossier.id,format:'pdf'}) }}">Exporter PDF</a> <a class="btn btn-sm btn-outline-secondary" href="{{ path('logistique_dossier_export',{id:dossier.id,format:'xlsx'}) }}">Exporter Excel</a></p><p>Lecture seule — aucune donnée ne peut être modifiée ici.</p><div class="table-responsive">{% include 'logistique/embarquement/_fiche_contenu.html.twig' %}</div><h3>Photos d’empotage</h3><div class="v5-photos">{% for photo in (suivi ? suivi.photosEmpotage : []) %}<figure><a href="{{ path('logistique_photo_empotage',{id:dossier.id,nom:photo.fichier}) }}" target="_blank" rel="noopener"><img src="{{ path('logistique_photo_empotage',{id:dossier.id,nom:photo.fichier}) }}" alt="{{ photo.nom }}" loading="lazy"></a><figcaption>{{ photo.nom }}</figcaption></figure>{% else %}<p>Aucune photo.</p>{% endfor %}</div>{% if suivi and suivi.fichierRapport %}<p><a href="{{ path('logistique_fichier_rapport',{id:dossier.id}) }}">Télécharger le rapport : {{ suivi.nomRapport }}</a></p>{% endif %}<h3>Pièces à consulter</h3><ul>{% for doc in documents %}{% if doc.filename %}<li><a href="{{ path('logistique_fichier_document',{id:doc.id,visualiser:1}) }}" target="_blank" rel="noopener">{{ doc.libelle }}</a></li>{% endif %}{% endfor %}{% for f in formules %}{% if f.fichier %}<li><a href="{{ path('logistique_fichier_formule',{id:f.id}) }}">Formule {{ f.numero }}</a></li>{% endif %}{% endfor %}</ul>{% if photosHistoriques|length %}<h3>Photos documentaires historiques</h3><ul>{% for p in photosHistoriques %}<li>{{ p.filename }} / {{ p.fichier }}</li>{% endfor %}</ul>{% endif %}</div>{% endblock %}
