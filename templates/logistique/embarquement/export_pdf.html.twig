<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>CITRAC dossier</title><style>@page{margin:20mm 15mm}body{font-family:DejaVu Sans,sans-serif;font-size:9pt;color:#342c23}h1{color:#5a3c26}h3{background:#eee8df;padding:5pt}table{width:100%;border-collapse:collapse;table-layout:fixed}td,th{border:1px solid #ccc;padding:4pt;overflow-wrap:anywhere;text-align:left}thead{display:table-header-group}tr{page-break-inside:avoid}.photo{page-break-inside:avoid;margin:10pt 0}.photo img{max-width:100%;max-height:430pt}.prewrap{white-space:pre-wrap}</style></head><body>{% include 'logistique/embarquement/_fiche_contenu.html.twig' %}<h3>Photos de l’opération d’empotage</h3>{% for image in images %}<div class="photo"><p>{{ image.nom }}</p><img src="{{ image.uri }}" alt="{{ image.nom }}"></div>{% else %}<p>Aucune photo.</p>{% endfor %}{% if photosHistoriques|length %}<h3>Pièces photographiques historiques</h3>{% for photo in photosHistoriques %}<p>{{ photo.filename }} / {{ photo.fichier }}</p>{% endfor %}{% endif %}<p>CITRAC — Export du {{ 'now'|date('d/m/Y H:i') }}</p></body></html>
