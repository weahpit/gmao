<script src="{{ asset('js/api/Logistique/Cv.js') }}"></script>
<script src="{{ asset('js/api/Logistique/Banque.js') }}"></script>
<script src="{{ asset('js/api/Logistique/Pays.js') }}"></script>
<script src="{{ asset('js/api/Logistique/Client.js') }}"></script>
<script src="{{ asset('js/api/Logistique/Navire.js') }}"></script>
<script src="{{ asset('js/api/Logistique/Magasin.js') }}"></script>

<script>
/* =========================================================================
   Enregistrement Embarquement — logique de la page
   - Referentiels : API existantes (getAllProprietaires, getAllProduits...,
     getAllCvs..., getAllBanques, getAllPays, getAllNavires, getAllClients)
   - Conteneurs : tableaux locaux + repli par ligne
   - Les identifiants de champs et les fonctions existantes sont conserves
   ========================================================================= */
(function () {
    'use strict';

    var el = function (id) { return document.getElementById(id); };

    var selProprio = el('code_proprietaire');
    var selProduit = el('code_produit');
    var cvDeb = el('select_cv_deblocage');
    var cvExe = el('select_cv_execution');
    var selBanque = el('select_banque');
    var selPays = el('select_pays');
    var selPaysDest = el('pays_destination');
    var selNavire = el('select_navire');
    var selClient = el('select_client');

    /* ---------------- Utilitaires ---------------- */
    function nf(nb) {
        var n = parseFloat(nb);
        if (isNaN(n)) { n = 0; }
        try { return n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        catch (e) { return n.toFixed(2); }
    }
    function mapCommande(ctrl, apercu) {
        if (!apercu) { return; }
        var premiere = apercu.querySelector('option');
        if (premiere && premiere.value === '0') {
            premiere.textContent = '-- ' + ctrl.replace(/^select_/, '').replace(/^code_/, '') + ' --';
        }
    }
    /* Chargement generique : remplit un <select> a partir d'une fonction API existante */
    function charger(ctrl, fonction, apercu, args) {
        try {
            fonction(ctrl, 2, args);
        } catch (e) {
            console.error('Chargement impossible pour ' + ctrl.id, e);
            return;
        }
        setTimeout(function () { mapCommande(ctrl, apercu); }, 900);
    }
    function toast(msg, type, titre) {
        if (window.showToast) { showToast(msg, { type: type || 'info', title: titre || 'Embarquement', duration: 3500 }); }
    }

    /* ---------------- Indicateurs (KPI) ---------------- */
    var conteneurs = [];

    function majKpi() {
        var poidsNet = 0;
        conteneurs.forEach(function (c) { poidsNet += c.poids_net || 0; });
        el('kpi_tc').textContent = conteneurs.length;
        el('kpi_tc_sub').textContent = 'Total poids net ' + nf(poidsNet) + ' Kg';

        var ot = el('demandeur').value.trim();
        el('kpi_ot').textContent = ot ? ot.toUpperCase() : '—';

        var vgm = parseFloat(el('poids_vgm').value) || 0;
        var sigam = parseFloat(el('poids_sigam').value) || 0;
        el('kpi_vgm').textContent = nf(vgm);
        el('kpi_sigam').textContent = nf(sigam);

        var ecart = vgm - sigam;
        var cible = el('kpi_ecart');
        cible.textContent = nf(ecart);
        cible.style.color = (Math.abs(ecart) > 0 && Math.abs(ecart) / (sigam || 1) > 0.02) ? '#c0392b' : '#5A371E';

        var valides = 0;
        ['formule', 'cheque', 'fumigue', 'etiquette'].forEach(function (cle) {
            var choisi = document.querySelector('.opt-suivi[data-cle="' + cle + '"]:checked');
            if (choisi && choisi.value === 'oui') { valides += 1; }
        });
        el('kpi_controles').textContent = valides + ' / 4';
    }

    /* ---------------- Tableau des conteneurs ---------------- */
    function afficherConteneurs() {
        var corps = el('corps_tc');
        if (!conteneurs.length) {
            corps.innerHTML = '<tr class="lg-vide"><td colspan="8">Aucun conteneur ajouté pour l\'instant.</td></tr>';
            majKpi();
            return;
        }
        var html = '';
        conteneurs.forEach(function (c, i) {
            var idDetail = 'tc_detail_' + i;
            var nbLots = c.lots.length;
            html += '<tr class="lg-ligne" data-cible="' + idDetail + '" tabindex="0" role="button" aria-expanded="false">';
            html += '  <td class="lg-chev"><span class="lg-chevron"></span></td>';
            html += '  <td class="lg-num-cell">' + c.tc + '</td>';
            html += '  <td>' + (c.plomb || '—') + '</td>';
            html += '  <td><span class="lg-badge cacao">' + nbLots + ' lot' + (nbLots > 1 ? 's' : '') + '</span></td>';
            html += '  <td class="text-end lg-montant">' + (c.nb_cartons || '—') + '</td>';
            html += '  <td class="text-end lg-montant">' + nf(c.poids_brut) + '</td>';
            html += '  <td class="text-end lg-montant lg-fort">' + nf(c.poids_net) + '</td>';
            html += '  <td class="text-center"><button type="button" class="btn btn-outline-cacao btn-sm btn-retirer-tc" data-index="' + i + '" title="Retirer ce conteneur"><i class="fa-solid fa-trash"></i></button></td>';
            html += '</tr>';
            html += '<tr class="lg-detail" id="' + idDetail + '"><td colspan="8"><div class="lg-detail-box"><h6>Lots du conteneur ' + c.tc + '</h6>';
            if (nbLots) {
                html += '<table class="lg-mini"><thead><tr><th>Lot</th><th class="text-end">Nb Cartons</th><th class="text-end">Poids Brut</th><th class="text-end">Poids Net</th></tr></thead><tbody>';
                c.lots.forEach(function (l) {
                    html += '<tr><td>' + l.lot + '</td><td class="text-end">' + (l.cartons || '—') + '</td><td class="text-end">' + nf(l.brut) + '</td><td class="text-end">' + nf(l.net) + '</td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<div style="font-size:.82rem;color:#a89b8c;">Aucun lot rattaché à ce conteneur.</div>';
            }
            html += '</div></td></tr>';
        });
        corps.innerHTML = html;
        majKpi();
    }

    document.addEventListener('click', function (e) {
        var retirer = e.target.closest('.btn-retirer-tc');
        if (retirer) {
            e.stopPropagation();
            conteneurs.splice(parseInt(retirer.getAttribute('data-index'), 10), 1);
            afficherConteneurs();
            return;
        }
        var ligne = e.target.closest('#corps_tc tr.lg-ligne');
        if (!ligne) { return; }
        var detail = document.getElementById(ligne.getAttribute('data-cible'));
        var ouvert = ligne.classList.toggle('lg-ouvert');
        if (detail) { detail.classList.toggle('lg-ouvert', ouvert); }
        ligne.setAttribute('aria-expanded', ouvert ? 'true' : 'false');
    });

    /* ---------------- Lots d'un conteneur (modale TC) ---------------- */
    var lotsTc = [];

    function afficherLotsTc() {
        var corps = el('select_lot_tbody');
        if (!lotsTc.length) {
            corps.innerHTML = '<tr class="lg-vide"><td colspan="4">Aucun lot ajouté à ce conteneur.</td></tr>';
            return;
        }
        var html = '';
        lotsTc.forEach(function (l, i) {
            html += '<tr><td class="lg-num-cell" style="font-size:.8rem;">' + l.lot + '</td>';
            html += '<td class="text-end">' + (l.cartons || '—') + '</td>';
            html += '<td class="text-end">' + nf(l.brut) + '</td>';
            html += '<td class="text-end">' + nf(l.net) + ' <button type="button" class="btn btn-sm p-0 ms-2 btn-retirer-lot-tc" data-index="' + i + '" style="color:#c0392b;"><i class="fa-solid fa-xmark"></i></button></td></tr>';
        });
        corps.innerHTML = html;
    }

    document.addEventListener('click', function (e) {
        var s = e.target.closest('.btn-retirer-lot-tc');
        if (!s) { return; }
        lotsTc.splice(parseInt(s.getAttribute('data-index'), 10), 1);
        afficherLotsTc();
    });

    /* ---------------- Photos ---------------- */
    var fileInput = el('fileInput');
    var preview = el('preview');
    fileInput.addEventListener('change', function () {
        preview.innerHTML = '';
        var fichiers = fileInput.files;
        var images = 0;
        Array.prototype.forEach.call(fichiers, function (file) {
            if (file.type.indexOf('image/') === 0) {
                images += 1;
                var lecteur = new FileReader();
                lecteur.onload = function (ev) {
                    var img = document.createElement('img');
                    img.src = ev.target.result;
                    img.alt = file.name;
                    img.className = 'a_photo';
                    img.setAttribute('data-bs-toggle', 'modal');
                    img.setAttribute('data-bs-target', '#modal_photo');
                    preview.appendChild(img);
                };
                lecteur.readAsDataURL(file);
            }
        });
        var badge = preview.parentNode.querySelector('.lbl_emp');
        if (badge) {
            badge.textContent = fichiers.length + ' fichier(s), ' + images + ' image(s)';
        }
    });

    $('body').on('click', '.a_photo', function () {
        el('img_photo').src = this.src;
    });

    /* ---------------- Evenements du formulaire ---------------- */
    ['poids_vgm', 'poids_sigam', 'demandeur'].forEach(function (id) {
        el(id).addEventListener('input', majKpi);
    });
    document.querySelectorAll('.opt-suivi').forEach(function (r) {
        r.addEventListener('change', majKpi);
    });

    el('hero_imprimer').addEventListener('click', function () { window.print(); });
    el('hero_annuler').addEventListener('click', function () { el('da-form').reset(); lotsTc = []; conteneurs = []; afficherConteneurs(); majKpi(); });
    el('btn_annuler').addEventListener('click', function () { el('da-form').reset(); lotsTc = []; conteneurs = []; afficherConteneurs(); majKpi(); });
    el('btn_enregistrer_dossier').addEventListener('click', function (e) {
        e.preventDefault();
        var manquants = [];
        if (!el('demandeur').value.trim()) { manquants.push('le N° OT'); }
        if (!selProprio.value || selProprio.value === '0') { manquants.push('le propriétaire'); }
        if (!selProduit.value || selProduit.value === '0') { manquants.push('le produit'); }
        if (!selClient.value || selClient.value === '0') { manquants.push('le client'); }
        if (!selNavire.value || selNavire.value === '0') { manquants.push('le navire'); }
        if (manquants.length) {
            toast('Merci de renseigner : ' + manquants.join(', ') + '.', 'warning', 'Dossier');
        } else {
            toast('Dossier complet (' + conteneurs.length + ' conteneur(s)). L\'enregistrement en base sera assuré par le service serveur du dossier.', 'success', 'Dossier');
        }
    });

    /* ---------------- Modales : contrats, banque, client, navire, pays ---------------- */
    el('btn-add-cv-deb').addEventListener('click', function () {
        var formCvDeb = new FormData();
        formCvDeb.append('numero_cv', el('cv_deblocage').value);
        formCvDeb.append('tonnage', el('tonnage_cv_deblocage').value);
        formCvDeb.append('code_proprietaire', selProprio.value);
        if (typeof saveCvDeblocage === 'function') {
            saveCvDeblocage(formCvDeb, cvDeb, 2, selProprio.value);
        }
    });
    el('ajt_cv_deb').addEventListener('click', function () {
        el('cv_deblocage').value = '';
        el('tonnage_cv_deblocage').value = '';
    });
    cvDeb.addEventListener('change', function () {
        if (typeof getAllCvsExecutionByDeb === 'function') { getAllCvsExecutionByDeb(cvExe, 2, cvDeb.value); }
    });

    el('btn-add-cv-exe').addEventListener('click', function () {
        var formCvExe = new FormData();
        formCvExe.append('numero_cv', el('cv_execution').value);
        formCvExe.append('code_cv_deblocage', cvDeb.value);
        if (typeof saveCvExecution === 'function') { saveCvExecution(formCvExe, cvExe, 2, cvDeb.value); }
    });
    el('ajt_cv_exe').addEventListener('click', function () { el('cv_execution').value = ''; });

    el('btn-add-banque').addEventListener('click', function () {
        var formBanque = new FormData();
        formBanque.append('banque', el('banque').value);
        if (typeof saveBanque === 'function') { saveBanque(formBanque, selBanque, 2); }
    });
    el('ajt_banque').addEventListener('click', function () { el('banque').value = ''; });

    el('btn-add-client').addEventListener('click', function () {
        var formClient = new FormData();
        formClient.append('client', el('client').value);
        formClient.append('pays', selPays.value);
        formClient.append('ville', el('ville').value);
        formClient.append('adresse', el('adresse').value);
        if (typeof saveClient === 'function') { saveClient(formClient, selClient, 2); }
    });
    el('ajt_clt').addEventListener('click', function () {
        ['client', 'ville', 'adresse'].forEach(function (id) { el(id).value = ''; });
    });

    el('btn-add-navire').addEventListener('click', function () {
        var formNavire = new FormData();
        formNavire.append('navire', el('navire').value);
        if (typeof saveNavire === 'function') { saveNavire(formNavire, selNavire, 2); }
    });
    el('ajt_navire').addEventListener('click', function () { el('navire').value = ''; });

    el('btn-add-pays').addEventListener('click', function () {
        var formPays = new FormData();
        formPays.append('pays', el('pays').value);
        if (typeof savePays === 'function') { savePays(formPays, selPays, 2); }
        setTimeout(function () { if (typeof getAllPays === 'function') { getAllPays(selPaysDest, 2); } }, 1500);
    });
    el('ajt_pays').addEventListener('click', function () { el('pays').value = ''; });

    /* ---------------- Modale TC ---------------- */
    el('btn_ajouter_tc').addEventListener('click', function () {
        el('tc').value = '';
        el('plomb').value = '';
        el('nb_cartons').value = '';
        el('poids_brut').value = '';
        el('poids_net').value = '';
        lotsTc = [];
        afficherLotsTc();
    });

    el('add-lot').addEventListener('click', function () {
        var lotChoisi = el('select_lot_tc');
        if (!lotChoisi.value || lotChoisi.value === '0') {
            toast('Sélectionnez un lot à rattacher au conteneur.', 'warning', 'Conteneur');
            return;
        }
        lotsTc.push({
            lot: lotChoisi.options[lotChoisi.selectedIndex].text,
            cartons: el('nb_cartons').value,
            brut: parseFloat(el('poids_brut').value) || 0,
            net: parseFloat(el('poids_net').value) || 0
        });
        el('nb_cartons').value = '';
        el('poids_brut').value = '';
        el('poids_net').value = '';
        afficherLotsTc();
    });

    el('btn-add-tc').addEventListener('click', function () {
        var numero = el('tc').value.trim().toUpperCase();
        if (!numero) {
            toast('Saisissez le numéro du conteneur.', 'warning', 'Conteneur');
            return;
        }
        var brut = 0, net = 0;
        lotsTc.forEach(function (l) { brut += l.brut; net += l.net; });
        if (!lotsTc.length) {
            brut = parseFloat(el('poids_brut').value) || 0;
            net = parseFloat(el('poids_net').value) || 0;
        }
        conteneurs.push({
            tc: numero,
            plomb: el('plomb').value.trim().toUpperCase(),
            nb_cartons: el('nb_cartons').value,
            poids_brut: brut,
            poids_net: net,
            lots: lotsTc.slice()
        });
        lotsTc = [];
        afficherLotsTc();
        afficherConteneurs();
        if (window.bootstrap) {
            var m = el('modalTc');
            var inst = bootstrap.Modal.getInstance(m);
            if (inst) { inst.hide(); }
        }
        toast('Conteneur ajouté au dossier.', 'success', 'Conteneur');
    });

    /* ---------------- Chargement initial des referentiels ---------------- */
    charger(selProprio, getAllProprietaires, false);
    charger(selBanque, getAllBanques, false);
    charger(selPays, getAllPays, false);
    charger(selPaysDest, getAllPays, false);
    charger(selNavire, getAllNavires, false);
    charger(selClient, getAllClients, false);
    if (typeof getAllLots === 'function') {
        try { getAllLots(el('select_lot_tc'), 2); } catch (e) { /* liste optionnelle */ }
    }

    selProprio.addEventListener('change', function () {
        var valeur = selProprio.value;
        if (typeof getAllProduitsByProprietaire === 'function') { getAllProduitsByProprietaire(selProduit, 2, valeur); }
        if (typeof getAllCvsDeblocageByProprio === 'function') { getAllCvsDeblocageByProprio(cvDeb, 2, valeur); }
    });

    afficherConteneurs();
    majKpi();
})();
</script>
{% endblock %}
