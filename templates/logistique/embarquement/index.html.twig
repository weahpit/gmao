{% extends 'base.html.twig' %}
{% block title %}{{ dossier ? 'Gestion du dossier' : 'Nouvel embarquement' }}{% endblock %}
{% block body %}
<link rel="stylesheet" href="{{ asset('css/citrac/operations-logistiques.css') }}">
<link rel="stylesheet" href="{{ asset('css/citrac/embarquement-sections.css') }}">
<link rel="stylesheet" href="{{ asset('css/citrac/lecture-compacte.css') }}">
    <style>
        .icon_color {
            color: #fdf000;
        }
    </style>
<link rel="stylesheet" href="{{ asset('css/citrac/evolutions-v5.css') }}"><div class="exp-wrap"><h1>{{ dossier ? 'Gestion de l’OT ' ~ dossier.numeroOt : 'Nouvel embarquement' }}</h1>
<p>Seuls le N° OT, le propriétaire, le produit et le client sont obligatoires. Complétez les autres rubriques progressivement.</p>
{% include 'logistique/gestion/_nav.html.twig' %}{% if dossier %}<a class="exp-btn" href="{{ path('logistique_dossier_fiche',{id:dossier.id}) }}">Fiche en lecture seule · PDF · Excel</a>{% endif %}
{% if dossier and dossier.isCloture %}<div class="alert alert-warning">Dossier clôturé : consultation uniquement. Rouvrez-le depuis la liste pour le modifier.</div>{% endif %}
<form method="post" enctype="multipart/form-data" id="export-form" data-turbo="false" data-dossier="{{ dossier ? dossier.id : '' }}" data-quick-url="{{ path('logistique_ajout_rapide') }}" data-cv-url="{{ path('logistique_cv_rapide') }}" data-documents-url="{{ path('logistique_documents_attendus') }}">
<input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}">
<fieldset class="exp-fieldset" {{ dossier and dossier.isCloture ? 'disabled' : '' }}>
<section class="exp-card exp-section"><details open><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg><span>Ordre de transit</span></span></summary><div class="exp-section-content"><div class="exp-grid">
<div class="exp-field"><label for="numero_ot">N° OT</label><input id="numero_ot" name="numero_ot" maxlength="20" value="{{ donnees.numero_ot|default('') }}" required></div>
<div class="exp-field"><label for="proprietaire">Propriétaire</label><select id="proprietaire" name="proprietaire" required><option value="">Sélectionnez</option>{% for p in proprietaires %}<option value="{{ p.id }}" {{ donnees.proprietaire|default('') == (p.id ~ '') ? 'selected' : '' }}>{{ p.denomination }}</option>{% endfor %}</select><button type="button" class="exp-btn exp-quick-button" data-quick-type="proprietaire" data-quick-target="proprietaire">+ Ajouter un propriétaire</button></div>
<div class="exp-field"><label for="produit">Produit</label><select id="produit" name="produit" required><option value="">Sélectionnez</option>{% for p in produits %}<option value="{{ p.id }}" data-proprietaire="{{ p.codeProprio ? p.codeProprio.id : '' }}" {{ donnees.produit|default('') == (p.id ~ '') ? 'selected' : '' }}>{{ p.libelle }}</option>{% endfor %}</select><button type="button" class="exp-btn exp-quick-button" data-quick-type="produit" data-quick-target="produit">+ Ajouter un produit</button></div>
<div class="exp-field"><label for="client">Client</label><select id="client" name="client" required><option value="">Sélectionnez</option>{% for c in clients %}<option value="{{ c.id }}" {{ donnees.client|default('') == (c.id ~ '') ? 'selected' : '' }}>{{ c.nomClient }}</option>{% endfor %}</select><button type="button" class="exp-btn exp-quick-button" data-quick-type="client" data-quick-target="client">+ Ajouter un client</button></div>
<div class="exp-field"><label for="navire">Navire</label><select id="navire" name="navire"><option value="">Non affecté</option>{% for n in navires %}<option value="{{ n.id }}" {{ donnees.navire|default('') == (n.id ~ '') ? 'selected' : '' }}>{{ n.nom }}</option>{% endfor %}</select><button type="button" class="exp-btn exp-quick-button" data-quick-type="navire" data-quick-target="navire">+ Ajouter un navire</button></div>
<div class="exp-field"><label for="destination">Pays / destination</label><select id="destination" name="destination"><option value="">Non renseigné</option>{% for d in destinations %}<option value="{{ d.id }}" {{ donnees.destination|default('') == (d.id ~ '') ? 'selected' : '' }}>{{ d.denomination }}</option>{% endfor %}</select><button type="button" class="exp-btn exp-quick-button" data-quick-type="pays" data-quick-target="destination">+ Ajouter un pays</button></div>
<div class="exp-field"><label for="port_destination">Port de destination</label><input id="port_destination" name="port_destination" maxlength="150" value="{{ donnees.port_destination|default('') }}"></div>
<div class="exp-field"><label for="date_ot">Date OT</label><input type="date" id="date_ot" name="date_ot" value="{{ donnees.date_ot|default('') }}"></div>
<div class="exp-field"><label for="booking">Booking</label><input type="text" id="booking" name="booking" maxlength="100" value="{{ donnees.booking|default('') }}"></div>
<div class="exp-field"><label for="port_embarquement">Port d’embarquement</label><input type="text" id="port_embarquement" name="port_embarquement" maxlength="150" value="{{ donnees.port_embarquement|default('') }}"></div>
<div class="exp-field"><label for="numero_bl">N° BL</label><input type="text" id="numero_bl" name="numero_bl" maxlength="100" value="{{ donnees.numero_bl|default('') }}"></div>
<div class="exp-field"><label for="date_bl">Date BL</label><input type="date" id="date_bl" name="date_bl" value="{{ donnees.date_bl|default('') }}"></div>
<div class="exp-field"><label for="banque_nantissement">Banque de nantissement</label><select id="banque_nantissement" name="banque_nantissement"><option value="">Non renseigné</option>{% for ref in banques %}<option value="{{ ref.id }}" {{ donnees.banque_nantissement|default('') == (ref.id ~ '') ? 'selected' : '' }}>{{ ref.libelle }}</option>{% endfor %}</select><button type="button" class="exp-btn" data-quick-type="banque" data-quick-target="banque_nantissement">+ Ajouter</button></div>
<div class="exp-field"><label for="transitaire">Transitaire</label><select id="transitaire" name="transitaire"><option value="">Non renseigné</option>{% for ref in transitaires %}<option value="{{ ref.id }}" {{ donnees.transitaire|default('') == (ref.id ~ '') ? 'selected' : '' }}>{{ ref.libelle }}</option>{% endfor %}</select><button type="button" class="exp-btn" data-quick-type="transitaire" data-quick-target="transitaire">+ Ajouter</button></div>
<div class="exp-field"><label for="compagnie_navigation">Compagnie de navigation</label><select id="compagnie_navigation" name="compagnie_navigation"><option value="">Non renseigné</option>{% for ref in compagnies %}<option value="{{ ref.id }}" {{ donnees.compagnie_navigation|default('') == (ref.id ~ '') ? 'selected' : '' }}>{{ ref.libelle }}</option>{% endfor %}</select><button type="button" class="exp-btn" data-quick-type="compagnie" data-quick-target="compagnie_navigation">+ Ajouter</button></div>
<div class="exp-field"><label for="contrat_africao">Contrat AFRICAO</label><input id="contrat_africao" name="contrat_africao" maxlength="100" value="{{ donnees.contrat_africao|default('') }}"></div>
<div class="exp-field"><label for="type_montant">Type de montant</label><select id="type_montant" name="type_montant">{% for v in ['Reversement','Soutien'] %}<option {{ donnees.type_montant|default('Reversement') == v ? 'selected' : '' }}>{{ v }}</option>{% endfor %}</select></div>
<div class="exp-field"><label for="montant">Montant</label><input type="number" min="0" step="0.01" id="montant" name="montant" value="{{ donnees.montant|default('') }}"></div>
</div></div></details></section>
<section class="exp-card exp-section"><details><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg><span>Conteneurs et poids chargés</span></span></summary><div class="exp-section-content"><p class="exp-note">Choisissez les lots du produit, le nombre de sacs et le poids net chargé (kg). Le serveur contrôle le stock disponible.</p>
<div id="export-tcs"></div><button type="button" id="export-add-tc" class="exp-btn">+ Ajouter un conteneur</button>
<textarea id="export-conteneurs" name="conteneurs_json" class="exp-hide">{{ conteneurs|json_encode }}</textarea>
<noscript><p class="exp-error">Activez JavaScript pour saisir les conteneurs et calculer les poids.</p></noscript>
</div></details></section>
<section class="exp-card exp-section"><details><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/><path d="M9 13h6M9 17h6M9 9h2"/></svg><span>Formules et contrats de vente</span></span></summary><div class="exp-section-content">
<p>Chaque formule appartient à un CV d’exécution. Plusieurs formules du même CV de déblocage peuvent couvrir le dossier.</p>
<button type="button" class="exp-btn" data-cv-type="deblocage">+ CV de déblocage</button> <button type="button" class="exp-btn" data-cv-type="execution">+ CV d’exécution</button> <button type="button" class="exp-btn" data-cv-type="formule">+ Créer une formule</button>
<a class="exp-btn" href="{{ path('logistique_cvs_formules') }}" target="_blank" rel="noopener">Gérer les CV et charger les formules</a>
<div class="exp-scroll"><table class="exp-table" data-pagination="off"><thead><tr><th>Formule / CV</th><th>Poids affecté (kg)</th><th>Action</th></tr></thead><tbody id="export-formules"></tbody></table></div>
<button type="button" id="export-add-formule" class="exp-btn">+ Ajouter une autre formule</button>
<div class="exp-totals" aria-live="polite"><span>TC : <output id="export-total">0,000</output> kg</span><span>Formules : <output id="export-couvert">0,000</output> kg</span><span id="export-ecart"></span></div>
<template id="export-formule-options"><option value="">Sélectionnez une formule</option>{% for f in formules %}<option value="{{ f.id }}" data-volume="{{ f.volume }}" data-proprietaire="{{ f.execution.codeCvDeblocage.codeProprietaire.id }}">{{ f.numero }} — {{ f.execution.numeroCvExecution }} / {{ f.execution.codeCvDeblocage.numeroCv }} — {{ f.volume }} kg</option>{% endfor %}</template>
<textarea id="export-affectations-initiales" class="exp-hide">{{ affectations|json_encode }}</textarea>
<textarea id="export-reservations-originales" class="exp-hide">{{ reservationsOriginales|json_encode }}</textarea>
<textarea id="export-lots" class="exp-hide">{{ lotsDonnees|json_encode }}</textarea>
</div></details></section>
<section class="exp-card exp-section"><details><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v16H4z"/><path d="M8 3v4M16 3v4M4 10h16"/><path d="M9 15h2v2H9z"/></svg><span>Planning et rapport d’empotage</span></span></summary><div class="exp-section-content"><div class="exp-grid">
{% for cle,libelle in {'eta':'ETA','date_empotage':'Empotage','date_relevage':'Relevage','date_embarquement':'Embarquement','date_remise':'Remise des documents'} %}
<div class="exp-field"><label for="{{ cle }}">{{ libelle }}</label><input type="date" id="{{ cle }}" name="{{ cle }}" value="{{ donnees[cle]|default('') }}"></div>{% endfor %}
</div><div class="exp-field mt-3"><label for="rapport_empotage">Rapport d’empotage / observations</label><textarea id="rapport_empotage" name="rapport_empotage" maxlength="20000">{{ donnees.rapport_empotage|default('') }}</textarea></div>
<div class="exp-field mt-3"><label for="rapport_fichier">Charger le rapport d’empotage (facultatif)</label><input type="file" id="rapport_fichier" name="rapport_fichier" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp"><small>20 Mo maximum. PDF, Office ou image. Un champ vide conserve le fichier existant.</small></div>
<div class="exp-field mt-3"><label for="photos_empotage">Photos de l’opération d’empotage</label><input id="photos_empotage" name="photos_empotage[]" type="file" accept="image/jpeg,image/png,image/webp" multiple><small>25 photos maximum, existantes comprises. JPEG, PNG, WEBP ; source ≤ 12 Mo / 24 MP, conversion serveur à moins de 200 Ko par photo.</small></div>
<div class="v5-photos">{% for photo in (suivi ? suivi.photosEmpotage : []) %}<figure><a href="{{ path('logistique_photo_empotage',{id:dossier.id,nom:photo.fichier}) }}" target="_blank" rel="noopener"><img src="{{ path('logistique_photo_empotage',{id:dossier.id,nom:photo.fichier}) }}" alt="{{ photo.nom }}" loading="lazy"></a><figcaption>{{ photo.nom }} — {{ (photo.octets / 1000)|round }} Ko</figcaption><label><input type="checkbox" name="retirer_photos[]" value="{{ photo.fichier }}"> Retirer lors de l’enregistrement</label></figure>{% endfor %}</div>
{% if suivi and suivi.fichierRapport %}<a href="{{ path('logistique_fichier_rapport', {id:dossier.id}) }}">Télécharger {{ suivi.nomRapport }}</a>{% endif %}
</div></details></section><section class="exp-card exp-section"><details><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="8" cy="18" r="2"/></svg><span>Traitements</span></span></summary><div class="exp-section-content"><div class="exp-grid">
{% for cle, libelle in {'formule':'Formule','cheque':'Chèque','fumigue':'TC fumigué','etiquette':'Étiquette'} %}
<div class="exp-field"><label>{{ libelle }}</label><div class="exp-radio">
{% for valeur,texte in {'oui':'OUI','non':'NON'} %}<label for="{{ cle }}-{{ valeur }}"><input type="radio" id="{{ cle }}-{{ valeur }}" name="options-{{ cle }}" value="{{ valeur }}" {{ donnees['options-' ~ cle]|default('non') == valeur ? 'checked' : '' }}>{{ texte }}</label>{% endfor %}
</div></div>{% endfor %}</div></div></details></section>
<section class="exp-card exp-section"><details><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="M8.5 13.5L7 21l5-2.5L17 21l-1.5-7.5"/><path d="M10 9l1.5 1.5L14.5 7.5"/></svg><span>Certificats et approbation</span></span></summary><div class="exp-section-content"><div class="exp-grid">
{% for cle,libelle in {'draft':'Draft BL','pl':'Packing List','cert_poids':'Certificat de poids','coa':'COA','phyto':'Certificat phytosanitaire','co':'Certificat d’origine','conformite':'Certificat de conformité','hygiene':'Certificat d’hygiène','fumigation':'Certificat de fumigation','halal':'Halal / Kosher / FSSC 22000'} %}
<div class="exp-field"><label for="cert_{{ cle }}">{{ libelle }}</label><select id="cert_{{ cle }}" name="cert_{{ cle }}">{% for code,texte in statuts %}<option value="{{ code }}" {{ donnees['cert_' ~ cle]|default('POUR_APPROBATION') == code ? 'selected' : '' }}>{{ texte }}</option>{% endfor %}</select></div>
{% endfor %}</div><p class="exp-note">Ces états opérationnels ne remplacent pas l’approbation de chaque fichier dans le suivi documentaire.</p></div></details></section>
<section class="exp-card exp-section"><details id="export-doc-rubrique"><summary class="exp-section-head"><span class="exp-section-title"><svg class="exp-section-icon icon_color" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2h8v14H4z"/><path d="M8 12h8M8 16h5"/></svg><span>Documents attendus pour le produit / client</span></span></summary><div class="exp-section-content"><p id="export-doc-modele">Sélectionnez un produit et un client.</p><ul id="export-doc-liste"></ul><p class="exp-note">Les fichiers déjà chargés sont consultables ici. Les PDF et images s’ouvrent dans un nouvel onglet ; les fichiers Office sont téléchargés selon le navigateur.</p>{% if dossier %}<a class="exp-btn" href="{{ path('logistique_suivi_documents',{id:dossier.id}) }}">Charger ou gérer les documents du dossier</a>{% else %}<p class="exp-note">Après enregistrement, chargez les pièces dans le suivi du dossier.</p>{% endif %}</div></details></section>
<p id="export-erreur" class="exp-error" role="alert"></p><button class="exp-btn exp-btn-primary" id="export-enregistrer" type="submit">Enregistrer le dossier et ouvrir le suivi documentaire</button>
{% include 'logistique/gestion/_ajout_rapide.html.twig' %}{% include 'logistique/gestion/_cv_rapide.html.twig' %}</fieldset></form></div>
{% endblock %}
{% block javascripts %}<script src="{{ asset('js/citrac/ajout-rapide-export.js') }}" defer></script><script src="{{ asset('js/citrac/operations-logistiques.js') }}" defer></script><script src="{{ asset('js/citrac/cv-rapide-v5.js') }}" defer></script><script src="{{ asset('js/citrac/embarquement-ajax.js') }}" defer></script>{% endblock %}
