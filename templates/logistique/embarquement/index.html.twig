                reponse = JSON.parse(response)
                if (reponse.data.length > 0){

                    contenu += ' <legend class="bg-warning p-1" style="font-size: 16px;"><i class="fa fa-file me-2 text-secondary"></i>Documentation:</legend>'
                    contenu += '<div class="progress "><div class="progress-bar progress-bar-striped bg-success" role="progressbar" style="width: ' + reponse.suivi + '%;" aria-valuenow="' + reponse.suivi + '" aria-valuemin="0" aria-valuemax="100">' + reponse.suivi + '%</div></div>'
                    contenu += '<table class="table table-hover" id="tbl_docs" style="">'
                    contenu += '<thead>'
                    contenu += '<tr>'
                    contenu += '<th class="p-1 text-center" style="background-color: #703508;color:white;border-right: 1px lightgray solid;font-weight: lighter;">Fichier à charger</th>'
                    contenu += '<th  class="p-1" style="background-color: #703508;color:white;border-right: 1px lightgray solid;font-weight: lighter;">Actions</th>'
                    contenu += '</tr>'
                    contenu += '</thead>'
                    contenu += '<tbody class="bg-white">'

                    for(var i = 0; i< reponse.data.length; i++){
                        contenu += '<tr>'
                        if ( reponse.data[i].filename === "") {
                            contenu += '<td class="fw-bold" style="font-size: 12px;color: #033050"><i class="fa-solid fa-arrow-right"></i> ' + reponse.data[i].doc + '</td>'
                            contenu += '<td class="p-1">' +
                                '<div class="columns is-mobile is-centered "><div class="column is-12 mt-1"><div class="file">' +
                                '<label class="file-label">' +
                                '<input class="file-input btn btn-outline-secondary" accept="application/pdf" title="Télécharger un fichier PDF"  id="' + reponse.data[i].id_doc + '"  type="file" name="fichier">' +
                                '<span class="file-cta">' +
                                '<span class="file-icon">' +
                                '<i class="fas fa-upload"></i>' +
                                '</span>' +
                                '<span class="file-label"> Charger</span>' +
                                '</span>' +
                                '</label>'+
                                '</div></div></div>'+
                                '</td>'
                        }  else {
                            contenu += '<td class="fw-bold" style="font-size: 12px;color: #033050;background-color: #e7fcf2;"><i class="fa-solid fa-arrow-right"></i> ' + reponse.data[i].doc + '</td>'
                            contenu += '<td class="p-1 d-inline-flex row" style="background-color: #e7fcf2;"><div class="col-6 text-center"><a class=" btn btn-sm btn-outline-primary" href="{{ asset('files/docs_dossier/') }}' + reponse.data[i].filename+ '">Voir</a></div><div class="col-6 text-center"><a class=" btn btn-sm btn-outline-danger supprimer"  id="' + reponse.data[i].id_doc + '" href="#"><i  class="fa fa-times"></a></div></td>'
                        }
                        contenu += '</tr>'
                    }
                } else {
                    contenu += '<h5 class="text-danger">Aucun document généré !</h5>'
                }
                contenu += '</tbody>'
                contenu += '</table>'
                document.querySelector('.docs_contenu').innerHTML = contenu;

            },
            error : function (erreur){
                reponse = "Erreur !";
                contenu += '</tbody>'
                contenu += '</table>'
                //document.querySelector('.div_donnees').innerHTML = contenu;
            }
        })

        //alert(contenu_body)
    }

    function getApprobation(){
        let reponse = "";
        let contenu = "";
        $.ajax({
            url : '{{ url('app_api_approbations') }}',
            type : 'POST',
            success: function (response){
                reponse = JSON.parse(response)
                contenu += '<option value="0">Sélectionnez une valeur</option>'
                for(var i = 0; i< reponse.length; i++){
                    contenu += '<option value ="' + reponse[i].id_approbation + '">' + reponse[i].valeur + '</option>'
                }
                contenu_approbation = contenu;
                affecte_contenu_approbation()
            },
            error : function (){
                reponse = "Erreur"
            }
        })
    }
</script>
