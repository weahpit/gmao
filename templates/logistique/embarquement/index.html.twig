{% extends 'base.html.twig' %}
{% block title %}Enregistrement Embarquement{% endblock %}

{% block body %}
{% include 'logistique/_styles_cacao.html.twig' %}

<div class="lg-page container-fluid px-3 px-lg-4 py-3">

    {# ============================ EN-TETE ============================ #}
    <div class="lg-header">
        <div>
            <h1><i class="fa-solid fa-ship"></i> Enregistrement Embarquement</h1>
            <p>Ordre de Transit (OT) : contrats de vente, client, expédition, conteneurs, échéances et documentation.</p>
        </div>
        <div class="lg-hero-actions">
            <button type="button" class="btn" id="hero_annuler"><i class="fa-solid fa-rotate-left me-1"></i> Rétablir</button>
            <button type="button" class="btn" id="hero_imprimer"><i class="fa-solid fa-print me-1"></i> Récapitulatif</button>
        </div>
    </div>

    {# ============================ CARTES KPI ============================ #}
    <div class="lg-cards">
        <div class="lg-card">
            <div class="lbl">N° OT</div>
            <div class="val" id="kpi_ot" style="font-size:1.05rem;">—</div>
            <div class="sub">Ordre de transit courant</div>
        </div>
        <div class="lg-card">
            <div class="lbl">Conteneurs</div>
            <div class="val" id="kpi_tc">0</div>
            <div class="sub" id="kpi_tc_sub">Total poids net 0,00 Kg</div>
        </div>
        <div class="lg-card">
            <div class="lbl">Poids SIGAM</div>
            <div class="val" id="kpi_sigam">0,00</div>
            <div class="sub">Kg — pesée portuaire</div>
        </div>
        <div class="lg-card is-accent">
            <div class="lbl">Poids VGM</div>
            <div class="val" id="kpi_vgm">0,00</div>
            <div class="sub">Kg — poids embarquement</div>
        </div>
        <div class="lg-card is-accent">
            <div class="lbl">Écart VGM / SIGAM</div>
            <div class="val" id="kpi_ecart">0,00</div>
            <div class="sub">Kg — à surveiller</div>
        </div>
        <div class="lg-card">
            <div class="lbl">Contrôles validés</div>
            <div class="val" id="kpi_controles">0 / 4</div>
            <div class="sub">Formule, chèque, fumigation, étiquettes</div>
        </div>
    </div>

    <form method="post" action="{{ path('da_nouvelle') }}" id="da-form" onsubmit="return false;">

        {# ============================ 1. OT ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">1</span> Ordre de Transit (OT)
                <span class="lg-hint">Identification du dossier</span>
            </div>
            <div class="lg-grille">
                <div class="lg-champ">
                    <label for="demandeur">N° OT <span class="text-danger">*</span></label>
                    <input type="text" class="form-control text-uppercase" id="demandeur" value="" placeholder="N° de l'ordre de transit" autocomplete="off">
                </div>
                <div class="lg-champ">
                    <label for="code_proprietaire">Propriétaire <span class="text-danger">*</span></label>
                    <select class="form-select" name="code_proprietaire" id="code_proprietaire"></select>
                </div>
                <div class="lg-champ">
                    <label for="code_produit">Produit <span class="text-danger">*</span></label>
                    <select class="form-select" name="code_produit" id="code_produit"></select>
                    <div class="lg-aide">Produits filtrés par propriétaire.</div>
                </div>
            </div>
        </div>

        {# ============================ 2. CONTRATS DE VENTE ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">2</span> Contrats de vente
                <span class="lg-hint">Déblocage / exécution, montant, banque</span>
            </div>
            <div class="lg-grille">
                <div class="lg-champ">
                    <label for="select_cv_deblocage">N° CV Déblocage</label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="select_cv_deblocage" id="select_cv_deblocage"></select>
                        <button class="lg-plus" id="ajt_cv_deb" type="button" data-bs-toggle="modal" data-bs-target="#modalCvDeblocage" title="Ajouter un contrat de déblocage">+</button>
                    </div>
                </div>
                <div class="lg-champ">
                    <label for="select_cv_execution">N° CV Exécution</label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="select_cv_execution" id="select_cv_execution"></select>
                        <button class="lg-plus" id="ajt_cv_exe" type="button" data-bs-toggle="modal" data-bs-target="#modalCvExecution" title="Ajouter un contrat d'exécution">+</button>
                    </div>
                </div>
                <div class="lg-champ">
                    <label for="type_montant">Type de montant</label>
                    <select class="form-select" name="type_montant" id="type_montant">
                        <option value="Reversement">Reversement</option>
                        <option value="Soutien">Soutien</option>
                    </select>
                </div>
                <div class="lg-champ">
                    <label for="montant_contrat">Montant</label>
                    <input type="number" step="0.01" class="form-control" id="montant_contrat" value="" placeholder="0.00">
                </div>
                <div class="lg-champ">
                    <label for="numero_formule">N° Formule</label>
                    <input type="text" class="form-control text-uppercase" id="numero_formule" value="" placeholder="N° de la formule">
                </div>
                <div class="lg-champ">
                    <label for="formule_file">Formule (fichier)</label>
                    <input type="file" class="form-control" id="formule_file">
                </div>
                <div class="lg-champ">
                    <label for="numero_contrat_africao">N° Contrat (AFRICAO)</label>
                    <input type="text" class="form-control text-uppercase" id="numero_contrat_africao" value="" placeholder="N° contrat AFRICAO">
                </div>
                <div class="lg-champ">
                    <label for="select_banque">Banque</label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="select_banque" id="select_banque"></select>
                        <button class="lg-plus" id="ajt_banque" type="button" data-bs-toggle="modal" data-bs-target="#modalBanque" title="Ajouter une banque">+</button>
                    </div>
                </div>
            </div>
        </div>

        {# ============================ 3. CLIENT ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">3</span> Client
                <span class="lg-hint">Acheteur et coordonnées</span>
            </div>
            <div class="lg-grille">
                <div class="lg-champ lg-largement">
                    <label for="select_client">Client <span class="text-danger">*</span></label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="select_client" id="select_client"></select>
                        <button class="lg-plus" id="ajt_clt" type="button" data-bs-toggle="modal" data-bs-target="#modalClient" title="Ajouter un client">+</button>
                    </div>
                </div>
            </div>
            <div id="infos_client" class="mt-2"></div>
        </div>

        {# ============================ 4. EXPEDITION ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">4</span> Expédition
                <span class="lg-hint">Navire et destination</span>
            </div>
            <div class="lg-grille">
                <div class="lg-champ">
                    <label for="select_navire">Navire <span class="text-danger">*</span></label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="select_navire" id="select_navire"></select>
                        <button class="lg-plus" id="ajt_navire" type="button" data-bs-toggle="modal" data-bs-target="#modalNavire" title="Ajouter un navire">+</button>
                    </div>
                </div>
                <div class="lg-champ">
                    <label for="pays_destination">Pays de destination</label>
                    <div class="lg-avec-plus">
                        <select class="form-select" name="pays_destination" id="pays_destination"></select>
                        <button class="lg-plus" id="ajt_pays" type="button" data-bs-toggle="modal" data-bs-target="#modalPays" title="Ajouter un pays">+</button>
                    </div>
                </div>
                <div class="lg-champ">
                    <label for="port_destination">Port de destination</label>
                    <input type="text" class="form-control text-uppercase" id="port_destination" value="" placeholder="Port de débarquement">
                </div>
            </div>
        </div>

        {# ============================ 5. CONTENEURS ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">5</span> Conteneurs
                <span class="lg-hint">Poids d'embarquement et détail des TC</span>
            </div>
            <div class="lg-grille mb-3">
                <div class="lg-champ">
                    <label for="poids_vgm">Poids Embarquement VGM (Kg)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="poids_vgm" placeholder="0.00">
                </div>
                <div class="lg-champ">
                    <label for="poids_sigam">Poids SIGAM (Kg)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="poids_sigam" placeholder="0.00">
                </div>
                <div class="lg-champ" style="justify-content:flex-end;">
                    <button class="btn btn-outline-cacao" id="btn_ajouter_tc" type="button" data-bs-toggle="modal" data-bs-target="#modalTc">
                        <i class="fa-solid fa-box me-2"></i>Ajouter des conteneurs
                    </button>
                </div>
            </div>

            <div class="table-responsive lg-table">
                <table>
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>N° TC</th>
                            <th>N° Plomb</th>
                            <th>Lots</th>
                            <th class="text-end">Nb Cartons / Sacs / Big Bag</th>
                            <th class="text-end">Poids Brut (Kg)</th>
                            <th class="text-end">Poids Net (Kg)</th>
                            <th class="lg-chev"></th>
                        </tr>
                    </thead>
                    <tbody id="corps_tc">
                        <tr class="lg-vide"><td colspan="8">Aucun conteneur ajouté pour l'instant.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        {# ============================ 6. DATES ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">6</span> Dates &amp; échéances
                <span class="lg-hint">Suivi du calendrier d'embarquement</span>
            </div>
            <div class="lg-grille">
                <div class="lg-champ">
                    <label for="date_eta">ETA</label>
                    <input type="date" class="form-control" id="date_eta">
                </div>
                <div class="lg-champ">
                    <label for="date_empotage">Empotage</label>
                    <input type="date" class="form-control" id="date_empotage">
                </div>
                <div class="lg-champ">
                    <label for="date_relevage">Relevage</label>
                    <input type="date" class="form-control" id="date_relevage">
                </div>
                <div class="lg-champ">
                    <label for="date_embarquement">Embarquement</label>
                    <input type="date" class="form-control" id="date_embarquement">
                </div>
                <div class="lg-champ">
                    <label for="date_remise">Remise Doc</label>
                    <input type="date" class="form-control" id="date_remise">
                </div>
            </div>
        </div>

        {# ============================ 7. TRAITEMENT / CERTIFICATS ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">7</span> Traitement et certificats
                <span class="lg-hint">Contrôles et documentation</span>
            </div>
            <div class="row g-3">
                <div class="col-lg-5">
                    <div class="lg-detail-box" style="margin:0;">
                        <h6>Traitement</h6>
                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:.86rem;color:#4a3b2e;">
                            <span>Formule établie ?</span>
                            <span class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check opt-suivi" data-cle="formule" name="options-formule" id="success-formule" value="oui" autocomplete="off" checked>
                                <label class="btn btn-outline-cacao" for="success-formule">OUI</label>
                                <input type="radio" class="btn-check opt-suivi" data-cle="formule" name="options-formule" id="danger-formule" value="non" autocomplete="off">
                                <label class="btn btn-outline-cacao" for="danger-formule">NON</label>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:.86rem;color:#4a3b2e;">
                            <span>Chèque établi ?</span>
                            <span class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check opt-suivi" data-cle="cheque" name="options-cheque" id="success-cheque" value="oui" autocomplete="off" checked>
                                <label class="btn btn-outline-cacao" for="success-cheque">OUI</label>
                                <input type="radio" class="btn-check opt-suivi" data-cle="cheque" name="options-cheque" id="danger-cheque" value="non" autocomplete="off">
                                <label class="btn btn-outline-cacao" for="danger-cheque">NON</label>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:.86rem;color:#4a3b2e;">
                            <span>TCs Fumigués ?</span>
                            <span class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check opt-suivi" data-cle="fumigue" name="options-fumigue" id="success-fumigue" value="oui" autocomplete="off" checked>
                                <label class="btn btn-outline-cacao" for="success-fumigue">OUI</label>
                                <input type="radio" class="btn-check opt-suivi" data-cle="fumigue" name="options-fumigue" id="danger-fumigue" value="non" autocomplete="off">
                                <label class="btn btn-outline-cacao" for="danger-fumigue">NON</label>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center" style="font-size:.86rem;color:#4a3b2e;">
                            <span>Étiquettes ?</span>
                            <span class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check opt-suivi" data-cle="etiquette" name="options-etiquette" id="success-etiquette" value="oui" autocomplete="off" checked>
                                <label class="btn btn-outline-cacao" for="success-etiquette">OUI</label>
                                <input type="radio" class="btn-check opt-suivi" data-cle="etiquette" name="options-etiquette" id="danger-etiquette" value="non" autocomplete="off">
                                <label class="btn btn-outline-cacao" for="danger-etiquette">NON</label>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="lg-detail-box" style="margin:0;">
                        <h6>Certificats et autres documents</h6>
                        <div class="lg-grille">
                            <div class="lg-champ"><label for="approbation">Draft BL</label><select class="form-select" name="approbation" id="approbation"></select></div>
                            <div class="lg-champ"><label for="sel_pl">Packing List</label><select class="form-select" name="sel_pl" id="sel_pl"></select></div>
                            <div class="lg-champ"><label for="sel_cert_poids">Certificat Poids</label><select class="form-select" name="sel_cert_poids" id="sel_cert_poids"></select></div>
                            <div class="lg-champ"><label for="sel_cert_coa">COA</label><select class="form-select" name="sel_cert_coa" id="sel_cert_coa"></select></div>
                            <div class="lg-champ"><label for="sel_cert_phyto">Certificat Phyto</label><select class="form-select" name="sel_cert_phyto" id="sel_cert_phyto"></select></div>
                            <div class="lg-champ"><label for="sel_cert_co">Certificat Origine</label><select class="form-select" name="sel_cert_co" id="sel_cert_co"></select></div>
                            <div class="lg-champ"><label for="sel_cert_conformite">Certificat Conformité</label><select class="form-select" name="sel_cert_conformite" id="sel_cert_conformite"></select></div>
                            <div class="lg-champ"><label for="sel_cert_hygienne">Certificat Hygiène</label><select class="form-select" name="sel_cert_hygienne" id="sel_cert_hygienne"></select></div>
                            <div class="lg-champ"><label for="sel_cert_fumigation">Certificat Fumigation</label><select class="form-select" name="sel_cert_fumigation" id="sel_cert_fumigation"></select></div>
                            <div class="lg-champ"><label for="sel_cert_halal">Halal / Kosher / FSSC22000</label><select class="form-select" name="sel_cert_halal" id="sel_cert_halal"></select></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ============================ 8. PHOTOS ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">8</span> Photos d'empotage et rapports
                <span class="lg-hint">Images, PDF, Word, Excel</span>
            </div>
            <form id="uploadForm" enctype="multipart/form-data">
                <input type="file" class="form-control" id="fileInput" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" name="fichiers[]">
            </form>
            <div class="lg-preview" id="preview"></div>
            <div class="mt-2"><span class="lg-badge neutre lbl_emp">Aucun fichier sélectionné</span></div>
        </div>

        {# ============================ 9. SUIVI DOCUMENTAIRE ============================ #}
        <div class="lg-bloc">
            <div class="lg-bloc-title">
                <span class="lg-num">9</span> Suivi documentaire &amp; consignation
                <span class="lg-hint">Pièces à constituer pour le dossier</span>
            </div>
            <div class="div_donnees"></div>
            <div class="mt-2 docs_contenu"></div>
        </div>

        <div class="lg-bloc" style="display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;">
            <button type="button" class="btn btn-outline-cacao" id="btn_annuler">Annuler</button>
            <button type="submit" class="btn btn-cacao" id="btn_enregistrer_dossier">
                <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer le dossier
            </button>
        </div>
    </form>
</div>

{# ======================================================================
   MODALES (ajout rapide des referentiels) — formulaires existants conserves
   ====================================================================== #}

{# Modal CV Deblocage #}
<div class="modal fade" id="modalCvDeblocage" tabindex="-1" aria-labelledby="AddmodalCvDeblocageLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#5A371E,#8B5A2B);color:#fff;">
                <h1 class="modal-title fs-6" id="modalCvDeblocageLabel"><i class="fa-solid fa-file-invoice me-2"></i>CV Déblocage</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <form id="formCvDeblocage">
                    <div class="lg-grille">
                        <div class="lg-champ">
                            <label for="cv_deblocage">N° CV</label>
                            <input class="form-control text-uppercase" type="text" id="cv_deblocage">
                        </div>
                        <div class="lg-champ">
                            <label for="tonnage_cv_deblocage">Tonnage (Kg)</label>
                            <input class="form-control" type="text" id="tonnage_cv_deblocage" placeholder="tonnage (Kg)">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid #ece3d8;">
                <button type="button" class="btn btn-outline-cacao" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-cacao" id="btn-add-cv-deb">Ajouter</button>
            </div>
        </div>
    </div>
</div>

{# Modal CV Execution #}
<div class="modal fade" id="modalCvExecution" tabindex="-1" aria-labelledby="AddmodalCvExecutionLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#5A371E,#8B5A2B);color:#fff;">
                <h1 class="modal-title fs-6" id="modalCvExecutionLabel"><i class="fa-solid fa-file-contract me-2"></i>CV Exécution</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <form id="formCvExecution">
                    <div class="lg-champ">
                        <label for="cv_execution">N° CV</label>
                        <input class="form-control text-uppercase" type="text" id="cv_execution">
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid #ece3d8;">
                <button type="button" class="btn btn-outline-cacao" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-cacao" id="btn-add-cv-exe">Ajouter</button>
            </div>
        </div>
    </div>
</div>

{# Modal Banque #}
<div class="modal fade" id="modalBanque" tabindex="-1" aria-labelledby="AddmodalBanqueLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#5A371E,#8B5A2B);color:#fff;">
                <h1 class="modal-title fs-6" id="modalBanqueLabel"><i class="fa-solid fa-building-columns me-2"></i>Banque</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <form id="formBanque">
                    <div class="lg-champ">
                        <label for="banque">Nom</label>
                        <input class="form-control text-uppercase" type="text" id="banque">
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid #ece3d8;">
                <button type="button" class="btn btn-outline-cacao" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-cacao" id="btn-add-banque">Ajouter</button>
            </div>
        </div>
    </div>
</div>

{# Modal Client #}
<div class="modal fade" id="modalClient" tabindex="-1" aria-labelledby="AddmodalClientLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#5A371E,#8B5A2B);color:#fff;">
                <h1 class="modal-title fs-6" id="modalClientLabel"><i class="fa-solid fa-user-star me-2"></i>Client</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <form id="formClient">
