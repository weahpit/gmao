            /** Docs et Photos ***/

    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById('preview');

    fileInput.addEventListener('change', () => {
        preview.innerHTML = ""; // Nettoyer l'aperçu précédent
        const files = fileInput.files;

        Array.from(files).forEach(file => {
            if (file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = document.createElement("img");

                    img.src = e.target.result;
                    img.style.height = "200px";
                    img.style.margin = "10px;";
                    img.classList = "m-2 a_photo";
                    img.style.cursor = "pointer";

                    preview.appendChild(img);
                };
                // Aller automatiquement au bloc preview
                preview.scrollIntoView({ behavior: "smooth" });

                reader.readAsDataURL(file);

            }
        });
        const btn_upload = document.createElement("button");

        btn_upload.classList ="btn btn-outline-success p-0 ms-2"
        btn_upload.style.width ="30px"
        btn_upload.id ="btn_upload"
        btn_upload.type = "submit"
        btn_upload.innerHTML = '<i class="fa-solid fa-check-to-slot"></i>'
        document.querySelector("#uploadForm").appendChild(btn_upload);
    });

    function reinitialise_photo(){
        let btn_upload = document.querySelector("#btn_upload")
        document.querySelector("#uploadForm").removeChild(btn_upload)
        document.querySelector("#fileInput").value = null;
    }

    function affiche_docs_empotage(){
        let contenu = '';
        let contenu_other = '';
        let j = "0";
        $.ajax({
            url : '{{ url('app_login') }}api/getDossiersFiles/' + id_dossier,
            type : 'POST',
            success: function (response){
                reponse = JSON.parse(response)
                if (reponse.code === "SUCCESS"){
                    for (var i = 0 ; i < reponse.data.length; i++){
                        if (reponse.data[i].extension === "doc" || reponse.data[i].extension === "docx" || reponse.data[i].extension === "pdf" || reponse.data[i].extension === "xls" || reponse.data[i].extension === "xlsx"){
                            j = j + 1;
                            if (j === 1) { contenu_other +='<span class="text-dark text-decoration-underline fw-bold" >Fichiers associés :<br></span>' }
                            contenu_other += '<div class="text-left ms-2"  style="font-size:13px;" ><i class="fa-solid fa-arrow-right me-1"></i><a href="{{ asset('files/photos_dossier/') }}' + reponse.data[i].filename + '" >' + reponse.data[i].fichier + '</a></div>'
                        } else {
                            contenu += '<a class="col-5 m-1 mx-auto a_photo" data-bs-target="#modal_photo" data-bs-toggle="modal" id ="{{ asset('files/photos_dossier/') }}' + reponse.data[i].filename + '" ><img class="border border-2 border-secondary" style="border-radius:4px;" src="{{ asset('files/photos_dossier/') }}' + reponse.data[i].filename + '" alt="thumbnail_file"></a>'
                        }
                    }
                    // Ajout  des contenus dans le Div preview

                    const div_files = document.createElement("div");
                    const div_images = document.createElement("div");

                    div_files.classList ="p-1 mb-4"
                    div_files.style.borderBottomStyle ="2px solid grey;"
                    div_files.style.backgroundColor = "#f2f9fa"
                    div_images.classList ="p-2 row"
                    div_images.style.backgroundColor = "lightyellow"
                    div_files.innerHTML = contenu_other;
                    div_images.innerHTML = contenu;

                    document.querySelector("#preview").innerHTML =''
                    document.querySelector("#preview").appendChild(div_files);
                    document.querySelector("#preview").appendChild(div_images);
                    $(".lbl_emp").html(j +' fichier(s), ' + i + ' image(s)');
                }
            },
            error : function (erreur){
                reponse = "Erreur"
                console.log(erreur)
            }
        })
    }

