{% extends 'base.html.twig' %}
{% block title %}Enregistrement Embarquement{% endblock %}

{% block body %}
    <style>
        .input-shipping {
            border: 1px solid lightgrey;
            background: #f7fbfc;
            width: 100%;
        }
        .input-shipping:focus{
            border: 1px solid #707070;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/Logistique/style.css') }}">
    <div class="da-wrap">
        <div class="da-hero">
            <h1>Nouvel Embarquement</h1>
            <p>Renseignez toutes les informations correspondant à l'Ordre de Transit..</p>
      </div>

      <div class="da-nav">
        <a href="#" class="da-btn da-btn-light">Mes Dossiers</a>
      </div>

      <form method="post" action="{{ path('da_nouvelle') }}" id="da-form">
        <div class="da-card p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
          <h2>Enregistrement de l'OT (Ordre de Transit)</h2>

            <div class="da-field">
              <label for="demandeur">N° OT</label>
              <input type="text" id="demandeur" value="" required>
            </div>
            <div class="da-field">
              <label for="code_proprietaire">Propriétaire</label>
              <select name="code_proprietaire" id="code_proprietaire" required>
              </select>
            </div>
            <div class="da-field">
                <label for="code_produit">Produit</label>
                <select name="code_produit" id="code_produit" required>
                </select>
            </div>

        </div>
        <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Contrats de ventes</h2>
              <div class="da-grid">
                  <div class="d-flex justify-content-between">
                      <div class="da-field">
                          <label for="cv_deblocage">N° CV Déblocage</label>
                          <select name="select_cv_deblocage" id="select_cv_deblocage">
                          </select>
                      </div>
                      <button  class="btn btn-light p-2 fw-bold text-danger btn-outline-success"  id="ajt_cv_deb" type="button"  style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;" data-bs-toggle="modal" data-bs-target="#modalCvDeblocage" title="ajouter un contrat de déblocage">...</button>
                  </div>
                  <div class="d-flex justify-content-between">
                    <div class="da-field">
                      <label for="select_cv_execution">N° CV Exécution</label>
                      <select name="select_cv_execution" id="select_cv_execution" required></select>
                    </div>
                    <button class="btn btn-light p-2 fw-bold text-danger btn-outline-success" id="ajt_cv_exe" type="button" style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;" data-bs-toggle="modal" data-bs-target="#modalCvExecution" title="ajouter un contrat d'exécution">...</button>
                  </div>
                  <div class="da-field"></div>
              </div>
              <div class="da-grid">
                  <div class="da-field">
                      <label for="type_montant">Type Montant</label>
                      <select name="type_montant" id="type_montant">
                          <option value="Reversement">Reversement</option>
                          <option value="Soutien">Soutien</option>
                      </select>
                  </div>
                  <div class="da-field">
                      <label for="montant_contrat">Montant</label>
                      <input type="number" id="montant_contrat" value="">
                  </div>
                  <div class="da-field"></div>
              </div>
              <div class="da-grid">
                  <div class="da-field">
                      <label for="montant_contrat">N° Formule</label>
                      <input type="text" id="montant_contrat" value="">
                  </div>
                  <div class="da-field">
                      <label for="code_client">Charger la formule</label>
                      <input type="file" class="p-0" id="formule_file" value="">
                  </div>
                  <div class="da-field"></div>
              </div>
              <hr>
              <div class="da-grid">
                  <div class="da-field">
                      <label for="numero_contrat_africao">N° Contrat (AFRICAO)</label>
                      <input type="text" id="numero_contrat_africao" value="">
                  </div>
                  <div class="d-flex justify-content-between">
                  <div class="da-field">
                      <label for="select_banque">Banque</label>
                      <select name="select_banque" id="select_banque"></select>
                  </div>
                  <button  class="btn btn-light p-2 fw-bold text-danger btn-outline-success"  id="ajt_banque" type="button"  style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;" data-bs-toggle="modal" data-bs-target="#modalBanque" title="ajouter une banque">...</button>
                  </div>
                  <div class="da-field"></div>
                </div>
          </div>
        <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Enregistrement du client</h2>
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class="w-100">
                              <label for="select_client">Client</label>
                              <select class="w-100" name="select_client" id="select_client" required>
                              </select>
                          </div>
                          <button class="btn btn-light ms-2 test-danger btn-outline-success" id="ajt_clt" type="button" data-bs-toggle="modal" data-bs-target="#modalClient" style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;"  title="ajouter un client">...</button>
                      </div>
                      <div class="da-field" id="infos_client"></div>
                  </div>
          </div>
        <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Expédition</h2>
              <div class="da-grid">
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class=""><label for="select_navire">Navire</label>
                              <select name="select_navire" id="select_navire" style="width: 250px;" required>
                              </select></div>
                          <button class="btn btn-light ms-2 test-danger btn-outline-success" id="ajt_navire"  data-bs-toggle="modal" data-bs-target="#modalNavire"  type="button" style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;" title="ajouter un navire">...</button>
                      </div>
                  </div>
                  <div class="d-flex content-justify-between">
                      <div class="da-field">
                          <label for="pays_destination">Pays de destination</label>
                          <select name="pays_destination" id="pays_destination">
                          </select>
                      </div>
                      <button class="btn btn-light ms-2 test-danger btn-outline-success" id="ajt_pays"   data-bs-toggle="modal" data-bs-target="#modalPays"  type="button" style="height: 25px;margin-top: 25px;width: 25px;border-radius: 0;border:2px solid darkgreen;"  title="ajouter un pays">...</button>
                  </div>
                  <div class="da-field">
                      <label for="port_destination">Port de destination</label>
                      <input type="text" id="port_destination" value="">
                  </div>
              </div>
          </div>
          <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Enregistrement des conteneurs</h2>
                  <div class="da-field d-flex content-justify-between mb-2">
                      <label for="poids_vgm">Poids Embarquement VGM (Kg)</label>
                      <input class="input" type="text" id="poids_vgm" style="width: 120px;border-radius: 0;">
                  </div>
              <button class="btn mb-2" id="ajt_clt" style="background: #a6ebf9" type="button" data-bs-toggle="modal" data-bs-target="#modalTc" title="ajouter des conteneurs">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-container preview-icon"><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5Z"/><path d="M10 21.9V14L2.1 9.1"/><path d="m10 14 11.9-6.9"/><path d="M14 19.8v-8.1"/><path d="M18 17.5V9.4"/></svg>
                  Ajouter des conteneurs
              </button>
              <div class="da-field col-9">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="background: #e9e9e9;color: black;">N°</th>
                                <th style="background: #e9e9e9;color: black;">N° TC</th>
                                <th style="background: #e9e9e9;color: black;">N° Plomb</th>
                                <th style="background: #e9e9e9;color: black;">Lots</th>
                                <th style="background: #e9e9e9;color: black;">Nb Cartons / Sacs / Big Bag</th>
                                <th style="background: #e9e9e9;color: black;">Poids Brut (Kg)</th>
                                <th style="background: #e9e9e9;color: black;">Poids Net (Kg)</th>
                            </tr>
                        </thead>
                        <tbody>

                        </tbody>
                    </table>
              </div>
          </div>
          <hr>
          <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Dates & Echéances</h2>
              <div class="da-grid">
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class="">
                              <label for="date_eta">ETA</label>
                                    <input type="date" id="date_eta" style="width: 250px;">
                              </div>
                      </div>
                  </div>
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class="">
                              <label for="date_empotage">Empotage</label>
                              <input type="date" id="date_empotage" style="width: 250px;">
                          </div>
                      </div>
                  </div>
              </div>
              <div class="da-grid">
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class="">
                              <label for="date_relevage">Relevage</label>
                              <input type="date" id="date_relevage" style="width: 250px;">
                          </div>
                      </div>
                  </div>
                  <div class="da-field">
                      <div class="d-flex content-justify-between">
                          <div class="">
                              <label for="date_embarquement">Embarquement</label>
                              <input type="date" id="date_embarquement" style="width: 250px;">
                          </div>
                      </div>
                  </div>
              </div>
              <div class="da-field">
                  <div class="d-flex content-justify-between">
                      <div class="">
                          <label for="date_remise">Remise Doc</label>
                          <input type="date" id="date_remise" style="width: 250px;">
                      </div>
                  </div>
              </div>
          </div>

          <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Applications et Documentation</h2>
              <div class="da-grid">
                  <div class="">
                      <h5 class="p-1"  style="background: linear-gradient(120deg, #bdfcf9, #b2e1fa)">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-virus-off preview-icon"><path d="M10.01 10h.01"/><path d="M12 14.991h.01"/><path d="M12 22v-3"/><path d="M12 2v3"/><path d="M13 22h-2"/><path d="M13 2h-2"/><path d="m16.5 19.794-1-1.733"/><path d="m16.5 4.205-1 1.732"/><path d="M18.891 13.235a7 7 0 00-8.126-8.126"/><path d="m19.794 7.5-1.732 1"/><path d="M2 12h3"/><path d="M2 13v-2"/><path d="m2 2 20 20"/><path d="M22 12h-3"/><path d="M22 13v-2"/><path d="m4.206 16.5 1.732-1"/><path d="m4.206 7.5 1.732 1"/><path d="M7.05 7.05a7 7 0 009.9 9.9"/><path d="m7.5 19.794 1-1.733"/><path d="M9 12h.01"/></svg>
                          Traitement
                      </h5>
                      <div class="d-flex content-justify-between mb-2">
                          <div style="width: 200px;">Formule établie ?</div>
                          <div class="d-flex content-justify-between ms-2" style="height: 35px;">
                              <input type="radio" class="btn-check" name="options-formule"   id="success-formule" autocomplete="off" checked>
                              <label class="btn btn-outline-success btn-sm" for="success-formule">OUI</label>
                              <input type="radio" class="btn-check" name="options-formule" id="danger-formule" autocomplete="off">
                              <label class="btn btn-outline-danger btn-sm" for="danger-formule">NON</label>
                          </div>
                      </div>
                      <div class="d-flex content-justify-between mb-2">
                          <div style="width: 200px;">Chèque établi ?</div>
                          <div class="d-flex content-justify-between ms-2" style="height: 35px;">
                              <input type="radio" class="btn-check" name="options-cheque" id="success-cheque" autocomplete="off" checked>
                              <label class="btn btn-outline-success btn-sm" for="success-cheque">OUI</label>
                              <input type="radio" class="btn-check" name="options-cheque" id="danger-cheque" autocomplete="off">
                              <label class="btn btn-outline-danger btn-sm" for="danger-cheque">NON</label>
                          </div>
                      </div>
                      <div class="d-flex content-justify-between mb-2">
                          <div style="width: 200px;">TCs Fumigués ?</div>
                          <div class="d-flex content-justify-between ms-2" style="height: 35px;">
                              <input type="radio"  class="btn-check right" name="options-fumigue" id="success-fumigue" autocomplete="off" checked>
                              <label class="btn btn-outline-success btn-sm" for="success-fumigue">OUI</label>
                              <input type="radio" class="btn-check right" name="options-fumigue" id="danger-fumigue" autocomplete="off">
                              <label class="btn btn-outline-danger btn-sm" for="danger-fumigue">NON</label>
                          </div>
                      </div>
                      <div class="d-flex content-justify-between mb-2">
                          <div style="width: 200px;">Etiquettes ?</div>
                          <div class="d-flex content-justify-between ms-2" style="height: 35px;">
                              <input type="radio" class="btn-check btn-sm" name="options-etiquette" id="success-etiquette" autocomplete="off" checked>
                              <label class="btn btn-outline-success btn-sm" for="success-etiquette">OUI</label>
                              <input type="radio" class="btn-check btn-sm" name="options-etiquette" id="danger-etiquette" autocomplete="off">
                              <label class="btn btn-outline-danger btn-sm" for="danger-etiquette">NON</label>
                          </div>
                      </div>
                  </div>
                  <div class="">
                      <h5 class="p-1"   style="background: linear-gradient(120deg, #b2e1fa, #bdfcf9)">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-certificate preview-icon"><path d="M12 10H6"/><path d="m20.69 15.479 1.29 4.88a.5.5 0 01-.698.591l-1.843-.849a1 1 0 00-.879.001l-1.846.85a.5.5 0 01-.692-.593l1.29-4.88"/><path d="M22 6.675V6a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2h8"/><path d="M6 14h4"/><circle cx="19" cy="13" r="3"/></svg>
                          Certificats et autres document
                      </h5>
                      <div class="da-grid">
                          <div class="da-field">
                              <label for="approbation">Draft BL</label>
                              <select name="approbation" id="approbation" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_pl">Packing List</label>
                              <select name="sel_pl" id="sel_pl" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_pl">Certificat Poids</label>
                              <select name="sel_cert_poids" id="sel_cert_poids" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_coa">COA</label>
                              <select name="sel_cert_coa" id="sel_cert_coa" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_phyto">Certificat Phyto</label>
                              <select name="sel_cert_phyto" id="sel_cert_phyto" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_co">Certificat Origine</label>
                              <select name="sel_cert_co" id="sel_cert_co" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_conformite">Certificat Conformité</label>
                              <select name="sel_cert_conformite" id="sel_cert_conformite" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_hygienne">Certificat Hygiene</label>
                              <select name="sel_cert_hygienne" id="sel_cert_hygienne" style="width: 150px;"></select>
                          </div>
                        <div class="da-field">
                              <label for="sel_cert_fumigation">Certificat Fumigation</label>
                              <select name="sel_cert_fumigation" id="sel_cert_fumigation" style="width: 150px;"></select>
                          </div>
                          <div class="da-field">
                              <label for="sel_cert_hygienne">Certificat Halal / Kosher / FSSC22000</label>
                              <select name="sel_cert_halal" id="sel_cert_halal" style="width: 150px;"></select>
                          </div>
                      </div>

                  </div>
              </div>

          </div>
          <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <h2>Photos Empotage & Rapport</h2>
                <div class="da-field">
                      <div class="col-5"><label class="fs-6">Photos / Rapports: </label></div>
                      <div class="col-7 d-inline-flex w-100" id="div_upload">
                          {#<input type="file" id="fileInput" name="photos" accept="image/ application/msword" multiple>#}
                          <form id="uploadForm"  enctype="multipart/form-data" style="border-top:  2px solid grey">
                              <input type="file" id="fileInput"  multiple accept="image/*,.pdf, .doc, .docx, .xls, .xlsx" name="fichiers[]" />
                          </form>
                      </div>
                  </div>
                    <div class="da-field">
                        <div class="mt-2 mb-2 mx-auto" style="max-height: 300px;overflow-y: scroll;width: 75%;background: #dad9d9;" id="preview"></div>
                    </div>
          </div>

          <div class="da-card mt-5 p-2" style="background: #f9f9f6;border-radius: 0;border: 1px solid #d6d5d5;box-shadow: 1px 1px #cdcccc;">
              <div class="d-flex justify-content-between">
                <h2>Suivi documentaire & Consignation</h2>
                  <a href="#" class="btn btn-success p-1 mb-1" style="border-radius: 0;">Modèles de dossier</a>
              </div>
                    <div class="da-field">
                        <div class="div_donnees mb-2 bg-light" style="border: 1px solid lightgray;overflow-y: scroll;font-size: 13px;max-height: 250px;">
                        </div>
                        <hr>
                        <div class="mt-2{# border border-1 p-2#} docs_contenu"></div>
                  </div>
          </div>


        <div class="da-toolbar" style="justify-content:flex-end;">
          <a href="#" class="da-btn da-btn-light">Annuler</a>
          <button type="submit" class="da-btn da-btn-primary">Enregistrer le dossier</button>
        </div>
      </form>
</div>




    {#
    ------------------------------------------------------------------------------------------------------
    ---------------------------------------------- MODAL -------------------------------------------
    ------------------------------------------------------------------------------------------------------
#}
    <!-- Modal Cv Déblocage-->
    <div class="modal fade" id="modalCvDeblocage" tabindex="-1" aria-labelledby="AddmodalCvDeblocageLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content modal-center"  style="border-radius: 0;">
                <div class="modal-header" style="background: var(--green-100)">
                    <h1 class="modal-title fs-5" id="modalCvDeblocageLabel"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt-text preview-icon"><path d="M13 16H8"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"/></svg> CV Déblocage</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formCvDeblocage">
                        <div class="d-flex justify-content-start">
                            <label for="cv_deblocage" class="fw-bold span">N° CV</label>
                            <input class="input-shipping fw-bold" type="text" id="cv_deblocage" style="text-transform: uppercase;width:100%;">
                            <input class="input-shipping ms-2 text-center fw-bold" type="text" id="tonnage_cv_deblocage" style="color: #480202;width:50%;" placeholder="tonnage (Kg)">
                        </div>
                        <hr>
                        <button type="button" class="btn ms-2 mx-auto" id="btn-add-cv-deb" style="border-radius: 0;background: #2563EB;color: white;">Ajouter</button>
                    </form>
                </div>
                </div>
            </div>
        </div>

    <!-- Modal Cv Exécution-->
    <div class="modal fade" id="modalCvExecution" tabindex="-1" aria-labelledby="AddmodalCvExecutionLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
