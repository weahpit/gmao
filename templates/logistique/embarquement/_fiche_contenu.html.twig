<header><h1>CITRAC</h1><h2>Fiche dossier d’embarquement — {{ dossier.numeroOt }}</h2><p>Avancement : {{ indicateur.pourcentage }}% · {{ indicateur.realise }}/{{ indicateur.total }} étapes — Délai documentaire : {{ indicateur.jours is not null ? indicateur.jours ~ ' jour(s)' : 'Non embarqué' }}{% if indicateur.depasse %} — DÉLAI SUPÉRIEUR À 5 JOURS{% endif %}{% if indicateur.incoherent %} — DATES HISTORIQUES INCOHÉRENTES{% endif %}</p></header>
<h3>Données du dossier</h3><table><tbody>{% for cle,valeur in champs %}<tr><th>{{ cle }}</th><td>{{ valeur is not null ? valeur : '—' }}</td></tr>{% endfor %}</tbody></table>
{% if suivi %}<h3>Planning, rapport et observations</h3><p class="prewrap">{{ suivi.rapportEmpotage }}</p><p>Contrat AFRICAO : {{ suivi.contratAfricao }} · Port de destination : {{ suivi.portDestination }} · {{ suivi.typeMontant }} : {{ suivi.montant }}</p><p>Rapport joint : {{ suivi.nomRapport ?: 'Non chargé' }}</p>
<h3>Conteneurs et poids chargés</h3><table><thead><tr><th>TC / Type / Plomb</th><th>Lot</th><th>Sacs</th><th>Net (kg)</th><th>Brut (kg)</th></tr></thead><tbody>{% for tc in suivi.conteneurs %}{% for lot in tc.lots %}<tr><td>{{ tc.tc }} / {{ tc.typeTc }} / {{ tc.plomb }}{{ tc.vrac|default(false) ? ' / Vrac' : '' }}</td><td>{{ lot.numero }}</td><td>{{ lot.nbCartons }}</td><td>{{ lot.qteExporter }}</td><td>{{ lot.pbExporter|default('') }}</td></tr>{% endfor %}{% endfor %}</tbody></table>
<h3>Traitements et certificats</h3><table><tbody>{% for cle,v in suivi.traitements %}<tr><th>{{ cle }}</th><td>{{ v }}</td></tr>{% endfor %}{% for cle,v in suivi.certificats %}<tr><th>{{ cle }}</th><td>{{ statuts[v]|default(v) }}</td></tr>{% endfor %}</tbody></table>{% endif %}
<h3>Formules et CV</h3><table><thead><tr><th>Formule</th><th>Exécution / période</th><th>Déblocage / période</th><th>Volume / utilisé (kg)</th></tr></thead><tbody>{% for f in formules %}<tr><td>{{ f.numero }}</td><td>{{ f.execution.numeroCvExecution }} / {{ f.execution.periode }}</td><td>{{ f.execution.codeCvDeblocage.numeroCv }} / {{ f.execution.codeCvDeblocage.periode }}</td><td>{{ f.volume }} / {{ f.utilise }}</td></tr>{% else %}<tr><td colspan="4">Aucune formule affectée.</td></tr>{% endfor %}</tbody></table>
<h3>Origine des lots — N° LOTS ⇒ N° CAMIONS</h3><table><thead><tr><th>Lot embarqué</th><th>N° camion / immatriculation / lot source</th></tr></thead><tbody>{% for o in origines %}<tr><td>{{ o.lot }}</td><td>{% for c in o.camions %}{{ c.numero }} / {{ c.immatriculation }} / {{ c.lotSource }}<br>{% else %}Origine non renseignée {{ o.origineLibre }}{% endfor %}</td></tr>{% endfor %}</tbody></table>
<h3>Suivi documentaire</h3><table><thead><tr><th>Document</th><th>Statut</th><th>Fichier</th><th>Transmission</th></tr></thead><tbody>{% for doc in documents %}<tr><td>{{ doc.libelle }}</td><td>{{ statuts[doc.statut]|default(doc.statut) }}</td><td>{{ doc.nomOriginal ?: doc.filename }}</td><td>{{ doc.transmisLe ? doc.transmisLe|date('d/m/Y H:i') : 'En attente' }} {{ doc.transmisPar }}</td></tr>{% endfor %}{% for doc in historiques %}<tr><td>{{ doc.codeTypeDoc ? doc.codeTypeDoc.libelle : 'Document historique' }}</td><td>Historique</td><td>{{ doc.filename }}</td><td>{{ doc.createdAt ? doc.createdAt|date('d/m/Y H:i') : '' }}</td></tr>{% endfor %}</tbody></table>
