{% extends 'base.html.twig' %}
{% block title %}Enregistrement Embarquement{% endblock %}

{% block body %}
{% include 'logistique/_styles.html.twig' %}
<div class="da-wrap">
  <div class="da-hero">
    <h1>Nouvel Embarquement</h1>
    <p>Renseignez toutes les informations correspondant à l'Ordre de Transit..</p>
  </div>

  <div class="da-nav">
    <a href="#" class="da-btn da-btn-light">Mes Dossiers</a>
  </div>

  <form method="post" action="{{ path('da_nouvelle') }}" id="da-form">
    <div class="da-card">
      <h2>Enregistrement de l'OT (Ordre de Transit)</h2>

        <div class="da-field">
          <label for="demandeur">N° OT</label>
          <input type="text" id="demandeur" value="" required>
        </div>
        <div class="da-field">
          <label for="code_proprietaire">Propriétaire</label>
          <select name="code_proprietaire" id="code_proprietaire" required>
          </select>
        </div>
        <div class="da-field">
            <label for="code_produit">Produit</label>
            <select name="code_produit" id="code_produit" required>
            </select>
        </div>

    </div>

      <div class="da-card mt-4">
          <h2>Contrats de ventes</h2>
          <div class="da-grid">
              <div class="da-field">
                  <label for="cv_deblocage">N° CV Déblocage</label>
                  <select name="cv_deblocage" id="cv_deblocage" required>
                  </select>
                </div>
              <div class="da-field">
                  <label for="cv_execution">N° CV Exécution</label>
                  <input type="text" id="cv_execution" value="" required>
              </div>
          </div>
          <div class="da-field">
              <label for="type_montant">Type Montant</label>
              <select name="type_montant" id="type_montant">
                  <option value="Reversement">Reversement</option>
                  <option value="Soutien">Soutien</option>
              </select>
          </div>
          <div class="da-field">
              <label for="montant_contrat">Montant</label>
              <input type="number" id="montant_contrat" value="">
          </div>
          <div class="da-grid">
              <div class="da-field">
                  <label for="montant_contrat">N° Formule</label>
                  <input type="text" id="montant_contrat" value="">
              </div>
              <div class="da-field">
                  <label for="code_client">Charger la formule</label>
                  <input type="file" id="formule_file" value="">
              </div>
          </div>

          <hr>
          <div class="da-field">
              <label for="numero_contrat_africao">N° Contrat (AFRICAO)</label>
              <input type="text" id="numero_contrat_africao" value="">
          </div>
          <hr>
          <div class="da-field">
              <label for="banque">Banque</label>
              <input type="text" id="banque" value="">
          </div>
      </div>
          <div class="da-card mt-4">
              <h2>Enregistrement du client</h2>
              <div class="da-field">
                  <div class="d-flex content-justify-between">
                      <div class=""><label for="code_client">Client</label>
                          <select name="code_client" id="code_client" required>
                          </select></div>
                      <button class="btn btn-light ms-2 p-2" type="button" style="height: 25px;margin-top: 25px;width: 25px;">...</button>
                  </div>

              </div>
              <div class="da-grid">
                  <div class="da-field">
                      <label for="pays">Pays</label>
                      <select name="pays" id="pays">
                      </select>
                  </div>
                  <div class="da-field">
                      <label for="ville">Ville</label>
                      <input type="text" id="ville" value="">
                  </div>
                  <div class="da-field">
                      <label for="adresse">Adresse</label>
                      <input type="text" id="adresse" value="">
                  </div>
              </div>
      </div>


    <div class="da-toolbar" style="justify-content:flex-end;">
      <a href="{{ path('da_mes_demandes') }}" class="da-btn da-btn-light">Annuler</a>
      <button type="submit" class="da-btn da-btn-primary">Envoyer la demande</button>
    </div>
  </form>
</div>

<script>
(function(){
  var URLAPP = (typeof URL_APP !== 'undefined' && URL_APP) ? URL_APP : (window.location.origin + '/');
  var ARTICLES = [];
  var BY_NOM = {};
  var idx = 0;
  var body = document.getElementById('da-lignes-body');
  var datalist = document.getElementById('da-articles');

  function loadArticles(){
    fetch(URLAPP + 'api/demande-achat/articles', {headers:{'X-Requested-With':'XMLHttpRequest'}})
      .then(function(r){ return r.json(); })
      .then(function(list){
        ARTICLES = Array.isArray(list) ? list : [];
        datalist.innerHTML = '';
        ARTICLES.forEach(function(a){
          BY_NOM[(a.nom||'').toLowerCase()] = a;
          var o = document.createElement('option');
          o.value = a.nom;
          o.label = (a.nom ? a.nom + ' - ' : '') + 'Réf. : ' + a.code;
          datalist.appendChild(o);
        });
      })
      .catch(function(){});
  }

  function labelFor(tr){
    var artInput = tr.querySelector('.da-art');
    var qteInput = tr.querySelector('.da-qte');
    var lbl = tr.querySelector('.da-dispo');
    var hidId = tr.querySelector('.da-eqid');
    var hidCode = tr.querySelector('.da-code');
    var a = BY_NOM[(artInput.value||'').trim().toLowerCase()];
    var qte = parseFloat(qteInput.value || '0') || 0;
    if (a){
      hidId.value = a.id;
      hidCode.value = a.code || '';
      var stock = parseFloat(a.qte || 0) || 0;
      if (qte > 0 && stock >= qte){
        lbl.innerHTML = '<span class="da-badge st-SERVIE">Disponible</span>';
      } else if (stock > 0 && qte > stock){
        lbl.innerHTML = '<span class="da-badge st-SOUMISE">Partiel</span>';
      } else {
        lbl.innerHTML = '<span class="da-badge st-EN_COMMANDE">Indisponible</span>';
      }
    } else {
      hidId.value = '';
      lbl.innerHTML = '<span class="da-badge st-NOUVELLE">Hors catalogue</span>';
    }
  }

  function row(){
    var i = idx++;
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td>'+
        '<input type="text" class="da-art" style="min-width: 400px;" list="da-articles" name="lignes['+i+'][designation]" placeholder="Tapez pour filtrer ou saisir un article" autocomplete="off">'+
        '<input type="hidden" class="da-eqid" name="lignes['+i+'][equipement_id]">'+
        '<input type="hidden" class="da-code" name="lignes['+i+'][code]">'+
      '</td>'+
      '<td><input type="number" class="da-qte" name="lignes['+i+'][quantite]" min="0" step="1" value="1"></td>'+
      '<td class="da-dispo"><span class="da-badge st-NOUVELLE">-</span></td>'+
      '<td><input type="text" name="lignes['+i+'][observation]" placeholder="Remarque"></td>'+
      '<td><button type="button" class="da-btn da-btn-danger" style="padding:6px 10px;">&times;</button></td>';
    body.appendChild(tr);
    tr.querySelector('.da-art').addEventListener('input', function(){ labelFor(tr); });
    tr.querySelector('.da-art').addEventListener('change', function(){ labelFor(tr); });
    tr.querySelector('.da-qte').addEventListener('input', function(){ labelFor(tr); });
    tr.querySelector('button').addEventListener('click', function(){ tr.remove(); });
  }

  document.getElementById('da-add-ligne').addEventListener('click', row);
  loadArticles();
  row();
})();

        {#{% if(app.user) %}
            {% if(app.user.codeService) %}
                document.getElementById('code_service').value = "{{ app.user.codeService.id }}"
            {% endif %}
        {% endif %}#}
        document.getElementById('motif').focus()

</script>
{% endblock %}
