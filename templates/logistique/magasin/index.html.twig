{% extends 'base.html.twig' %}

{% block title %}Magasins — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Magasin</span>
{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Magasins équipements</h1>
    <a href="#"  id="btn_add_mrq" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddMagasin">
        <img src="{{ asset('icons/magasin.png') }}" class="me-2" alt="" height="16"> Nouvelle magasin
    </a>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body">

    </div>
</div>

    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddMagasin" tabindex="-1" aria-labelledby="modalAddMagasinLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/magasin.png') }}" height="40" alt=""> Enregistrer une magasin</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formMagasin" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="magasin" style="width: 150px;">Nom</label>
                            <input type="text" class="input" id="magasin" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveMagasin">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/Logistique/Magasin.js') }}"></script>
    <script>

        let idMagasin = "0";
       getAllMagasins(document.querySelector(".card-body"), 1)
       clearForm("formMagasin", "magasin")
        ValidateOnKeypress(document.getElementById("magasin"), document.getElementById("saveMagasin"), "formMagasin")

        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
           clearForm("formMagasin", "magasin")
       })

       document.querySelector("#saveMagasin").addEventListener("click", function () {
           let FormDataMagasin = new FormData();
           FormDataMagasin.append('id_magasin', idMagasin)
           FormDataMagasin.append('magasin', document.querySelector("#magasin").value)
           saveMagasin(FormDataMagasin, document.querySelector(".card-body"), 1)
       })
    </script>
{% endblock %}
