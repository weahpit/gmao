<dialog id="cv-quick-dialog" class="exp-quick-dialog"><h2 id="cv-quick-title">Création rapide</h2><div class="exp-field"><label for="cv-quick-parent">CV parent</label><select id="cv-quick-parent"></select></div><div class="exp-field"><label for="cv-quick-numero">Numéro</label><input id="cv-quick-numero" maxlength="60"></div><div class="exp-field"><label for="cv-quick-volume">Volume (kg)</label><input id="cv-quick-volume" type="number" min="0.001" step="0.001"></div><div class="exp-field" id="cv-quick-periode-field"><label for="cv-quick-periode">Période</label><input id="cv-quick-periode" maxlength="100" placeholder="Ex. Novembre 2026"></div><div class="exp-field" id="cv-quick-file-field"><label for="cv-quick-file">Fichier formule (facultatif)</label><input type="file" id="cv-quick-file" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp"></div><p id="cv-quick-msg" role="status"></p><button type="button" id="cv-quick-save" class="exp-btn">Créer</button><button type="button" id="cv-quick-cancel" class="exp-btn">Annuler</button></dialog>
