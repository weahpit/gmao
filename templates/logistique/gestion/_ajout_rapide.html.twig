<dialog id="export-quick-dialog" class="exp-quick-dialog" aria-labelledby="export-quick-title">
<h2 id="export-quick-title">Ajout rapide</h2>
<div class="exp-field"><label for="export-quick-libelle">Libellé / nom</label><input id="export-quick-libelle" maxlength="255" autocomplete="off"></div>
<p id="export-quick-message" class="exp-error" role="status"></p>
<div class="exp-actions"><button type="button" id="export-quick-save" class="exp-btn exp-btn-primary">Créer et sélectionner</button><button type="button" id="export-quick-cancel" class="exp-btn">Annuler</button></div>
</dialog>
