{% extends 'base.html.twig' %}
{% block title %}Gestion des CV et formules{% endblock %}
{% block body %}
<link rel="stylesheet" href="{{ asset('css/citrac/evolutions-v5.css') }}">
<script src="{{ asset('js/citrac/ajax-v5.js') }}?v=57" defer></script>

<link rel="stylesheet" href="{{ asset('css/citrac/operations-logistiques.css') }}">
<link rel="stylesheet" href="{{ asset('css/citrac/lecture-compacte.css') }}">
<div class="exp-wrap" data-ajax-region><h1>Gestion des CV et formules</h1><p>Tous les volumes sont exprimés en kg. Les contrats d’exécution ne peuvent pas dépasser le volume accordé du CV de déblocage.</p>
{% include 'logistique/gestion/_nav.html.twig' %}
<section class="exp-card"><h2>1. Nouveau CV de déblocage</h2>
<form data-ajax method="post"><input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}"><input type="hidden" name="action" value="deblocage"><div class="exp-grid">
<div class="exp-field"><label>Période<input name="periode" maxlength="100" placeholder="Ex. Novembre 2026"></label></div><div class="exp-field"><label>N° CV<input name="numero" maxlength="25" required></label></div><div class="exp-field"><label>Volume accordé (kg)<input type="number" name="volume" min="0.001" step="0.001" required></label></div>
<div class="exp-field"><label>Propriétaire<select name="proprietaire" required><option value="">Sélectionnez</option>{% for p in proprietaires %}<option value="{{ p.id }}">{{ p.denomination }}</option>{% endfor %}</select></label></div>
</div><button class="exp-btn exp-btn-primary mt-3">Créer le CV de déblocage</button></form>
<div class="exp-scroll"><table class="exp-table"><thead><tr><th>CV de déblocage</th><th>Propriétaire</th><th>Accordé (kg)</th><th>Octroyé aux exécutions (kg)</th><th>Solde (kg)</th></tr></thead><tbody>
{% for d in deblocages %}{% set b = bilansDeb[d.id ~ ''] %}<tr><td>{{ d.numeroCv }}<br><small>{{ d.periode ?: 'Période non renseignée' }}</small></td><td>{{ d.codeProprietaire ? d.codeProprietaire.denomination : 'Non renseigné' }}</td><td>{{ b.volume|number_format(3, ',', ' ') }}</td><td>{{ b.octroye|number_format(3, ',', ' ') }}</td><td class="{{ b.restant < 0 ? 'exp-error' : '' }}">{{ b.restant|number_format(3, ',', ' ') }}</td></tr>{% else %}<tr><td colspan="5">Aucun CV.</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="exp-card"><h2>2. Nouveau contrat d’exécution</h2><form data-ajax method="post"><input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}"><input type="hidden" name="action" value="execution"><div class="exp-grid">
<div class="exp-field"><label>CV de déblocage<select name="deblocage" required><option value="">Sélectionnez</option>{% for d in deblocages %}<option value="{{ d.id }}">{{ d.numeroCv }} — solde {{ bilansDeb[d.id ~ ''].restant|number_format(3, ',', ' ') }} kg</option>{% endfor %}</select></label></div>
<div class="exp-field"><label>Période<input name="periode" maxlength="100" placeholder="Ex. Novembre 2026"></label></div><div class="exp-field"><label>N° CV d’exécution<input name="numero" maxlength="25" required></label></div><div class="exp-field"><label>Volume octroyé (kg)<input type="number" name="volume" min="0.001" step="0.001" required></label></div>
</div><button class="exp-btn exp-btn-primary mt-3">Créer le contrat d’exécution</button></form>
<div class="exp-scroll"><table class="exp-table"><thead><tr><th>Exécution / déblocage</th><th>Volume octroyé (kg)</th><th>Consommé (kg)</th><th>Restant (kg)</th><th>Renseigner / corriger le volume</th></tr></thead><tbody>
{% for e in executions %}{% set b = bilansExe[e.id ~ ''] %}<tr><td>{{ e.numeroCvExecution }}<br><small>{{ e.periode ?: 'Période non renseignée' }}</small><br><small>{{ e.codeCvDeblocage ? e.codeCvDeblocage.numeroCv : 'Déblocage manquant' }}</small></td><td>{{ b.volume|number_format(3, ',', ' ') }}</td><td>{{ b.consomme|number_format(3, ',', ' ') }}</td><td class="{{ b.restant < 0 ? 'exp-error' : '' }}">{{ b.restant|number_format(3, ',', ' ') }}</td><td>
<form data-ajax method="post"><input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}"><input type="hidden" name="action" value="volume_execution"><input type="hidden" name="execution" value="{{ e.id }}"><input aria-label="Volume du CV {{ e.numeroCvExecution }}" type="number" name="volume" min="0.001" step="0.001" value="{{ e.poids }}" required><button class="exp-btn mt-2">Actualiser</button></form></td></tr>{% else %}<tr><td colspan="5">Aucun contrat d’exécution.</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="exp-card"><h2>3. Ajouter et charger une formule</h2><p class="exp-note">Le volume d’une formule ne peut pas dépasser le solde du CV d’exécution. Le fichier peut être chargé maintenant ou plus tard.</p>
<form data-ajax method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}"><input type="hidden" name="action" value="formule"><div class="exp-grid">
<div class="exp-field"><label>CV d’exécution<select name="execution" required><option value="">Sélectionnez</option>{% for e in executions %}<option value="{{ e.id }}">{{ e.numeroCvExecution }} — {{ e.codeCvDeblocage ? e.codeCvDeblocage.numeroCv : '?' }} — {{ bilansExe[e.id ~ ''].restant|number_format(3, ',', ' ') }} kg restants</option>{% endfor %}</select></label></div>
<div class="exp-field"><label>N° formule<input name="numero" maxlength="60" required></label></div><div class="exp-field"><label>Volume de la formule (kg)<input type="number" name="volume" min="0.001" step="0.001" required></label></div>
<div class="exp-field"><label>Fichier de la formule<input type="file" name="fichier" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp"></label><small>20 Mo maximum.</small></div>
</div><button class="exp-btn exp-btn-primary mt-3">Enregistrer la formule</button></form>
<div class="exp-scroll"><table class="exp-table"><thead><tr><th>Formule</th><th>CV d’exécution</th><th>Volume (kg)</th><th>Utilisé (kg)</th><th>Dossier</th><th>Fichier</th></tr></thead><tbody>
{% for f in formules %}<tr><td>{{ f.numero }}</td><td>{{ f.execution.numeroCvExecution }}</td><td>{{ f.volume|number_format(3, ',', ' ') }}</td><td>{{ f.utilise|number_format(3, ',', ' ') }}</td><td>{% if f.dossier %}<a href="{{ path('logistique_dossier_gestion', {id:f.dossier.id}) }}">{{ f.dossier.numeroOt }}</a>{% else %}Disponible{% endif %}</td><td>
{% if f.fichier %}<a href="{{ path('logistique_fichier_formule', {id:f.id}) }}">{{ f.nomOriginal }}</a>{% endif %}
<form data-ajax method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('operations_logistiques') }}"><input type="hidden" name="action" value="fichier_formule"><input type="hidden" name="formule" value="{{ f.id }}"><input type="file" name="fichier" aria-label="Charger le fichier de {{ f.numero }}" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp" required><button class="exp-btn mt-2">{{ f.fichier ? 'Remplacer le fichier' : 'Charger le fichier' }}</button></form>
</td></tr>{% else %}<tr><td colspan="6">Aucune formule.</td></tr>{% endfor %}
</tbody></table></div></section></div>
{% endblock %}
