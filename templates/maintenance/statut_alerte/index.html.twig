{% extends 'base.html.twig' %}

{% block title %}Priorités — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item"><a href="{{ path('app_references') }}">Références</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Priorités</span>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Statuts Alertes</h1>
        <a href="#"  id="btn_add_statut_alerte" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAddStatutAlerte">
            <img src="{{ asset('icons/statut_alerte.png') }}" class="me-2" alt="" height="16"> Ajouter un statut
        </a>
    </div>

    <!-- Table -->

        <div class="card-body">

        </div>


    <!-- Modal Add/Edit Equipement-->
    <div class="modal fade" id="modalAddStatutAlerte" tabindex="-1" aria-labelledby="modalAddStatutAlerteLabel" aria-hidden="true"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background: var(--green-700); line-height: 1.6; -webkit-font-smoothing: antialiased;color:lightgrey;">
                    <h1 class="modal-title fs-5" id="exampleModalLabel"><img class="me-2" src="{{ asset('icons/statut_alerte.png') }}" height="40" alt=""> Enregistrer une priorité</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background: rgba(205,218,195,0.52)">
                    <form id="formStatutAlerte" >
                        <div class="d-flex justify-content-start">
                            <label class="fw-bold span " for="statut_alerte" style="width: 150px;">Libellé</label>
                            <input type="text" class="input" id="libelle" style="text-transform: uppercase;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background: linear-gradient(#dbf0ce, #b4d6c9) ">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">fermer</button>
                    <button type="button" class="btn btn-primary" id="saveStatutAlerte">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/Maintenance/StatutAlerte.js') }}"></script>
    <script>

        let idStatutAlerte = "0";
        getAllStatutAlerte(document.querySelector(".card-body"), 1)
        clearForm("formStatutAlerte", "libelle")
        ValidateOnKeypress(document.getElementById("libelle"), document.getElementById("saveStatutAlerte"), "formStatutAlerte")

        document.querySelector("#btn_add_statut_alerte").addEventListener("click", function () {
            clearForm("formStatutAlerte", "libelle")
        })

        document.querySelector("#saveStatutAlerte").addEventListener("click", function () {
            let agree = "0";
            let FormDataStatutAlerte = new FormData();
            FormDataStatutAlerte.append('id_statut_alerte', idStatutAlerte)
            FormDataStatutAlerte.append('libelle', document.querySelector("#libelle").value)
            saveStatutAlerte(FormDataStatutAlerte, document.querySelector(".card-body"), 1)
        })
    </script>
{% endblock %}
