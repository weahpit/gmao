{% extends 'base.html.twig' %}

{% block title %}Consultation des stocks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'saisie_stock/_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid py-3">

    <div class="ss-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 8h10"/><path d="M7 12h10"/><path d="M7 16h7"/></svg>Consultation des stocks</h1>
            <p>Entrées (saisies terrain / application mobile), sorties et solde par type de stock</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_saisie_stock_nouvelle') }}" class="btn btn-success" style="border-radius:10px;">
                Entrée
            </a>
            <a href="{{ path('app_sorties_stock') }}" class="btn btn-warning" style="border-radius:10px;">
                Sortie
            </a>
            <a href="{{ path('app_saisies_stock_csv', app.request.query.all) }}" class="btn btn-cacao">
                CSV
            </a>
            <a href="{{ path('app_saisies_stock_pdf', app.request.query.all) }}" target="_blank" class="btn btn-cacao">
                PDF
            </a>
        </div>
    </div>

    {% set aujourdhui = 'now'|date('Y-m-d') %}
    {% set t = stats.totaux %}

    <div class="ss-cards">
        <div class="ss-card">
            <div class="lbl">Entrées (saisies)</div>
            <div class="val">{{ t.nbEntrees }}</div>
            <div class="sub">selon les filtres</div>
        </div>
        <div class="ss-card">
            <div class="lbl">Sorties</div>
            <div class="val">{{ t.nbSorties }}</div>
            <div class="sub">selon les filtres</div>
        </div>
        <div class="ss-card">
            <div class="lbl">Solde Kg</div>
            <div class="val {{ t.soldeKg < 0 ? 'ss-neg' }}">{{ t.soldeKg|number_format(2, ',', ' ') }}</div>
            <div class="sub">{{ t.entreeKg|number_format(2, ',', ' ') }} entrés − {{ t.sortieKg|number_format(2, ',', ' ') }} sortis</div>
        </div>
        <div class="ss-card">
            <div class="lbl">Solde Litres</div>
            <div class="val {{ t.soldeLitres < 0 ? 'ss-neg' }}">{{ t.soldeLitres|number_format(2, ',', ' ') }}</div>
            <div class="sub">{{ t.entreeLitres|number_format(2, ',', ' ') }} entrés − {{ t.sortieLitres|number_format(2, ',', ' ') }} sortis</div>
        </div>
        <div class="ss-card">
            <div class="lbl">Avec photo</div>
            <div class="val">{{ stats.nbPhotos }}</div>
            <div class="sub">justificatifs joints</div>
        </div>
    </div>
    <form method="get" class="ss-filtres row m-1 mt-2" style="background: #efefef;">
        <h6 class="mb-0" style="color: var(--ss-cacao); font-weight:700;">Filtrer...</h6>
        <div class="col-md-3">
            <label class="mb-1">Stock</label>
            <select name="rubrique" class="form-select p-0">
                <option value="">Tous les stocks</option>
                {% for r in rubriques %}
                    <option value="{{ r }}" {{ filtres.rubrique == r ? 'selected' }}>{{ r }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label class="mb-1">Service</label>
            <select name="service" class="form-select p-0">
                <option value="">Tous les services</option>
                {% for s in services %}
                    <option value="{{ s.id }}" {{ filtres.service == s.id|trim ? 'selected' }}>{{ s.libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label class="mb-1">Agent</label>
            <input type="text" name="agent" value="{{ filtres.agent }}" class="form-control p-0" placeholder="Nom de l'agent">
        </div>
        <div class="col-md-2">
            <label class="mb-1">Du</label>
            <input type="date" name="du" value="{{ filtres.du }}" class="form-control p-0">
        </div>
        <div class="col-md-2">
            <label class="mb-1">Au</label>
            <input type="date" name="au" value="{{ filtres.au }}" class="form-control p-0">
        </div>
        <div class="col-md-8">
            <label class="mb-1">Recherche libre</label>
            <input type="text" name="q" value="{{ filtres.q }}" class="form-control p-0" placeholder="Type de Stock, service, agent...">
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-cacao w-100">Filtrer</button>
            <a href="{{ path('app_saisies_stock') }}" class="btn btn-outline-cacao w-100" title="Revenir aux données du jour">Aujourd'hui</a>
            <a href="{{ path('app_saisies_stock') }}?du=&au=" class="btn btn-outline-cacao w-100" title="Toutes les dates">Tout</a>
        </div>
    </form>

    <div class="ss-table mt-4 p-3 pb-2" style="background:linear-gradient(75deg,#e7ecf8, #eef1f6)">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-3">
            <h6 class="mb-0" style="color: var(--ss-cacao); font-weight:700;">Récapitulatif par stock</h6>
            <small class="text-muted">
                {% if filtres.du == aujourdhui and filtres.au == aujourdhui %}
                    Période : aujourd'hui ({{ aujourdhui|date('d/m/Y') }})
                {% elseif filtres.du or filtres.au %}
                    Période : du {{ filtres.du ? filtres.du|date('d/m/Y') : '…' }} au {{ filtres.au ? filtres.au|date('d/m/Y') : '…' }}
                {% else %}
                    Période : toutes les dates
                {% endif %}
                · solde = entrées − sorties de la période
            </small>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    {% set th = 'background: #547cd3;color: white' %}
                    <th style="{{ th }}">Type Stock</th>
                    <th class="text-end" style="{{ th }}">Nb entrées</th>
                    <th class="text-end" style="{{ th }}">Entrées Kg</th>
                    <th class="text-end" style="{{ th }}">Entrées Litres</th>
                    <th class="text-end" style="{{ th }}">Nb sorties</th>
                    <th class="text-end" style="{{ th }}">Sorties Kg</th>
                    <th class="text-end" style="{{ th }}">Sorties Litres</th>
                    <th class="text-end" style="{{ th }}">Solde Kg</th>
                    <th class="text-end" style="{{ th }}">Solde Litres</th>
                </tr>
                </thead>
                <tbody>
                {% for rubrique, v in stats.parRubrique %}
                    <tr>
                        <td>{{ rubrique }}</td>
                        <td class="text-end {{ v.nbEntrees == 0 ? 'ss-zero' }}">{{ v.nbEntrees }}</td>
                        <td class="text-end {{ v.entreeKg == 0 ? 'ss-zero' }}" style=";background: #f9eded;color: #c53030;{% if (v.entreeKg > 0)  %}font-weight: bold;{% endif %}">{{ v.entreeKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end {{ v.entreeLitres == 0 ? 'ss-zero' }}">{{ v.entreeLitres|number_format(2, ',', ' ') }}</td>
                        <td class="text-end {{ v.nbSorties == 0 ? 'ss-zero' }}">{{ v.nbSorties }}</td>
                        <td class="text-end {{ v.sortieKg == 0 ? 'ss-zero' }}" style=";background: #ecf9ef;color: #1d692e;{% if (v.sortieKg > 0)  %}font-weight: bold;{% endif %}">{{ v.sortieKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end {{ v.sortieLitres == 0 ? 'ss-zero' }}">{{ v.sortieLitres|number_format(2, ',', ' ') }}</td>
                        <td class="text-end fw-semibold {{ v.soldeKg < 0 ? 'ss-neg' : (v.soldeKg == 0 ? 'ss-zero') }}">{{ v.soldeKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end fw-semibold {{ v.soldeLitres < 0 ? 'ss-neg' : (v.soldeLitres == 0 ? 'ss-zero') }}">{{ v.soldeLitres|number_format(2, ',', ' ') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold" style="background: rgba(84,124,211,.12);">
                        <td>TOTAL</td>
                        <td class="text-end">{{ t.nbEntrees }}</td>
                        <td class="text-end">{{ t.entreeKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end">{{ t.entreeLitres|number_format(2, ',', ' ') }}</td>
                        <td class="text-end">{{ t.nbSorties }}</td>
                        <td class="text-end">{{ t.sortieKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end">{{ t.sortieLitres|number_format(2, ',', ' ') }}</td>
                        <td class="text-end {{ t.soldeKg < 0 ? 'ss-neg' }}">{{ t.soldeKg|number_format(2, ',', ' ') }}</td>
                        <td class="text-end {{ t.soldeLitres < 0 ? 'ss-neg' }}">{{ t.soldeLitres|number_format(2, ',', ' ') }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>



    <div class="ss-section-title">Entrées de stock (saisies)</div>
    <div class="ss-table">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Date saisie</th>
                        <th>Type Stock</th>
                        <th>Service</th>
                        <th>Agent</th>
                        <th class="text-end">Quantite</th>
                        <th>Photo</th>
                        <th>Recu le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in saisies %}
                        <tr>
                            <td>{{ s.dateSaisie ? s.dateSaisie|date('d/m/Y H:i') : '-' }}</td>
                            <td><span class="fw-semibold">{{ s.rubrique }}</span></td>
                            <td>{{ s.serviceLibelle ?? '-' }}</td>
                            <td>{{ s.agentLibelle ?? '-' }}</td>
                            <td class="text-end">
                                <span class="ss-badge {{ s.unite == 'Litres' ? '' : 'kg' }}">
                                    {{ s.quantite|number_format(2, ',', ' ') }} {{ s.unite }}
                                </span>
                            </td>
                            <td>
                                {% if s.photo %}
                                    <img src="{{ asset(dossierPhotos ~ s.photo) }}"
                                         class="ss-thumb"
                                         alt="Photo saisie"
                                         data-bs-toggle="modal"
                                         data-bs-target="#photoModal"
                                         data-photo-url="{{ asset(dossierPhotos ~ s.photo) }}"
                                         data-photo-info="{{ s.rubrique }} - {{ s.quantite|number_format(2, ',', ' ') }} {{ s.unite }}">
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ s.createdAt ? s.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Aucune saisie pour ces criteres.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="ss-section-title">Sorties de stock</div>
    <div class="ss-table">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Date sortie</th>
                        <th>Type Stock</th>
                        <th>Motif</th>
                        <th>Emplacement</th>
                        <th>Service</th>
                        <th>Agent</th>
                        <th class="text-end">Quantité</th>
                        <th>Photo</th>
                    </tr>
                </thead>
                <tbody>
                    {% for o in sorties %}
                        <tr>
                            <td>{{ o.dateSortie ? o.dateSortie|date('d/m/Y H:i') : '-' }}</td>
                            <td><span class="fw-semibold">{{ o.rubrique }}</span></td>
                            <td>{{ o.motif }}</td>
                            <td>{{ o.emplacementLibelle ?? '-' }}</td>
                            <td>{{ o.serviceLibelle ?? '-' }}</td>
                            <td>{{ o.agentLibelle ?? '-' }}</td>
                            <td class="text-end">
                                <span class="ss-badge sortie">
                                    − {{ o.quantite|number_format(2, ',', ' ') }} {{ o.unite }}
                                </span>
                            </td>
                            <td>
                                {% if o.photo %}
                                    <img src="{{ asset(dossierPhotosSorties ~ o.photo) }}"
                                         class="ss-thumb"
                                         alt="Photo sortie"
                                         data-bs-toggle="modal"
                                         data-bs-target="#photoModal"
                                         data-photo-url="{{ asset(dossierPhotosSorties ~ o.photo) }}"
                                         data-photo-info="{{ o.rubrique }} - {{ o.motif }} - {{ o.quantite|number_format(2, ',', ' ') }} {{ o.unite }}">
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Aucune sortie pour ces critères.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Visionneuse photo -->
<div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header" style="background:var(--ss-creme);">
                <h6 class="modal-title" id="photoModalInfo" style="color:var(--ss-cacao);"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body text-center">
                <img id="photoModalImg" src="" alt="Photo" class="img-fluid" style="border-radius:10px;max-height: 700px;">
            </div>
        </div>
    </div>
</div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('photoModal');
            modal.addEventListener('show.bs.modal', function (event) {
                var img = event.relatedTarget;
                if (!img) return;
                modal.querySelector('#photoModalImg').src = img.getAttribute('data-photo-url');
                modal.querySelector('#photoModalInfo').textContent = img.getAttribute('data-photo-info');
            });
        });
    </script>
{% endblock %}

