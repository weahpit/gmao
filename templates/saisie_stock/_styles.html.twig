<style>
        :root {
            --ss-cacao: #5A371E;
            --ss-cacao-clair: #8B5A2B;
            --ss-creme: #F5EFE6;
            --ss-accent: #C8912B;
        }
        .ss-header {
            background: linear-gradient(135deg, var(--ss-cacao) 0%, var(--ss-cacao-clair) 100%);
            color: #fff;
            border-radius: 14px;
            padding: 22px 26px;
            margin-bottom: 20px;
            box-shadow: 0 6px 18px rgba(90, 55, 30, .18);
        }
        .ss-header h1 { font-size: 1.35rem; font-weight: 700; margin: 0; }
        .ss-header p { margin: 4px 0 0; opacity: .85; font-size: .9rem; }

        .ss-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-bottom: 20px; }
        .ss-card {
            background: #fff; border-radius: 14px; padding: 16px 18px;
            border: 1px solid #ece3d8; box-shadow: 0 2px 8px rgba(90,55,30,.06);
        }
        .ss-card .lbl { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: #9a8877; font-weight: 600; }
        .ss-card .val { font-size: 1.45rem; font-weight: 700; color: var(--ss-cacao); margin-top: 4px; }
        .ss-card .sub { font-size: .78rem; color: #a89b8c; }

        .ss-filtres {
            background: #fff; border-radius: 14px; padding: 18px;
            border: 1px solid #ece3d8; margin-bottom: 20px;
        }
        .ss-filtres label { font-size: .8rem; font-weight: 600; color: #6b5a4a; }
        .ss-filtres .form-control, .ss-filtres .form-select {
            border-radius: 10px; border-color: #e3d8ca;
        }
        .btn-cacao { background: var(--ss-cacao); color: #fff; border-radius: 10px; border: none; }
        .btn-cacao:hover { background: var(--ss-cacao-clair); color: #fff; }
        .btn-outline-cacao { border: 1px solid var(--ss-cacao); color: var(--ss-cacao); border-radius: 10px; }
        .btn-outline-cacao:hover { background: var(--ss-cacao); color: #fff; }

        .ss-table { background: #fff; border-radius: 14px; overflow: hidden; border: 1px solid #ece3d8; }
        .ss-table table { margin: 0; }
        .ss-table thead th {
            background: var(--ss-creme); color: var(--ss-cacao); font-size: .8rem;
            text-transform: uppercase; letter-spacing: .03em; border-bottom: 2px solid #e6dccf;
        }
        .ss-table tbody tr:nth-child(even) { background: #fbf8f4; }
        .ss-badge { background: rgba(200,145,43,.14); color: #8a5f00; border-radius: 999px; padding: 3px 10px; font-size: .78rem; font-weight: 600; }
        .ss-badge.kg { background: rgba(90,55,30,.1); color: #5A371E; }
        .ss-thumb { width: 38px; height: 38px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 1px solid #e6dccf; }
        .table-responsive { border-radius: 14px; }
        .ss-badge.sortie { background: rgba(192,57,43,.12); color: #a93226; }
        .ss-neg { color: #c0392b; font-weight: 700; }
        .ss-zero { color: #b5aa9d; }
        .ss-section-title { font-size: 1rem; font-weight: 700; color: var(--ss-cacao); margin: 26px 0 10px; }
        .ss-errors { color: #c0392b; font-size: .8rem; margin-top: 4px; }
        .ss-preview { max-height: 120px; border-radius: 10px; border: 1px solid #e6dccf; margin-top: 8px; display: none; }

        /* --- État "envoi en cours" (anti double-saisie) --- */
        .ss-btn-spinner {
            display: none;
            width: 1rem; height: 1rem;
            margin-right: .5rem;
            vertical-align: -2px;
            border: .15em solid rgba(255,255,255,.55);
            border-top-color: #fff;
            border-radius: 50%;
            animation: ss-spin .7s linear infinite;
        }
        @keyframes ss-spin { to { transform: rotate(360deg); } }
        /* Bouton grisé pendant l'envoi */
        .ss-filtres.is-sending button[type="submit"],
        button[type="submit"].is-sending {
            opacity: .65;
            cursor: progress;
            pointer-events: none;
        }
        button[type="submit"].is-sending .ss-btn-spinner { display: inline-block; }
        /* Lien "Annuler" désactivé pendant l'envoi */
        .ss-filtres.is-sending a.btn { pointer-events: none; opacity: .55; }
        /* Voile léger sur le formulaire pendant l'envoi */
        .ss-filtres.is-sending { position: relative; }
        .ss-filtres.is-sending::after {
            content: "";
            position: absolute; inset: 0;
            background: rgba(255,255,255,.35);
            border-radius: 14px;
            cursor: progress;
        }
    </style>
