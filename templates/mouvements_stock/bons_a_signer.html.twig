{% extends 'base.html.twig' %}

{% block title %}Bons à signer — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Bons à signer (DG)</span>
{% endblock %}

{% block body %}
<style>
    :root { --cacao:#5a371e; --cacao-clair:#8b5a2b; --cacao-fonce:#3b2412; }
    .bs-wrap { padding: 8px 4px 40px; }
    .bs-title { color: var(--cacao-fonce); font-weight: 700; }
    .bs-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin: 14px 0 22px; }
    .bs-card { border-radius: 14px; padding: 6px 7px; color: #ffffff; box-shadow: 0 6px 16px rgba(90,55,30,.18); }
    .bs-card .lbl { font-size: 16px; opacity: .9; }
    .bs-card .val { font-size: 32px; font-weight: 800; line-height: 1.1; }
    .bs-c-wait { background: linear-gradient(135deg, #fa4242, #ab1717); }
    .bs-filters { display:flex; flex-wrap:wrap; gap:12px; align-items:end; margin-bottom:16px; }
    .bs-filters label { font-size:12px; color:#6b6b6b; display:block; margin-bottom:2px; }
    .bs-filters input[type=date], .bs-filters input[type=text] { border:1px solid #d8cfc6; border-radius:8px; padding:7px 10px; }
    .bs-table { width:100%; border-collapse:separate; border-spacing:0; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 4px 14px rgba(0,0,0,.06); }
    .bs-table thead th { background:var(--cacao); color:#fff; font-size:12.5px; font-weight:600; padding:12px 10px; text-align:left; position:sticky; top:0; }
    .bs-table tbody td { font-size:13px; padding:10px; border-bottom:1px solid #efe9e3; vertical-align:middle; }
    .bs-table tbody tr:nth-child(4n+1) td { background:#faf7f4; }
    .bs-table tbody tr.bs-row:hover td { background:#f1e7df; }
    .badge-attente { background:#fdecea; color:#b71c1c; font-weight:600; padding:5px 10px; border-radius:20px; font-size:12px; }
    .bs-detail td { background:#fffdf9 !important; }
    .bs-detail table { width:100%; border-collapse:collapse; margin:4px 0; }
    .bs-detail table th { background:#dcdbda; color:var(--cacao-fonce); font-size:11.5px; padding:6px 8px; text-align:left; }
    .bs-detail table td { font-size:12px; padding:5px 8px; border-bottom:1px solid #f0ece7; }
    .bs-toggle { border:1px solid var(--cacao-clair); color:var(--cacao-clair); background:#fff; border-radius:6px; font-weight:bold; padding:0 8px; line-height:1.6; cursor:pointer; }
    .bs-empty { text-align:center; color:#8a8a8a; padding:40px; }
    .btn-cacao { background:var(--cacao); border:none; color:#fff; border-radius:8px; padding:8px 16px; font-weight:600; }
    .btn-signer-bon { background:#5a371e; border:none; color:#fff; padding:7px 14px; border-radius:8px; font-weight:600; font-size:12.5px; cursor:pointer; }
    .btn-signer-bon:hover { background:#3b2412; }
</style>

<div class="bs-wrap">
    <div class=" d-flex  justify-content-between">
        <div class="">
            <h1 class="bs-title h4 mb-1">Bons de sortie en attente de signature</h1>
            <p class="text-muted" style="font-size:13px;">
                Bons émis par le magasinier, non encore signés par le Directeur Général.
            </p>
        </div>

        <div class="bs-cards">
            <div class="bs-card bs-c-wait d-flex  justify-content-between" style="width: 300px;">
                <div class="lbl">En attente de votre signature</div>
                <div class="val text-center" id="bsCompteur">{{ nbTotal }}</div>
            </div>
        </div>
    </div>
    <hr>

    <form method="get" class="bs-filters">
        <div>
            <label>Créé du</label>
            <input type="date" name="du" value="{{ du }}">
        </div>
        <div>
            <label>au</label>
            <input type="date" name="au" value="{{ au }}">
        </div>
        <div>
            <button type="submit" class="btn-cacao">Filtrer</button>
            <a href="{{ path('app_bons_a_signer') }}" class="btn btn-light" style="border:1px solid #ddd;">Réinitialiser</a>
        </div>
        <div style="margin-left:auto;">
            <label>Recherche</label>
            <input type="text" id="bsSearch" placeholder="Référence, service, demandeur..." style="width:240px;">
        </div>
    </form>

    {% if bons is empty %}
        <div class="bs-table"><div class="bs-empty">Aucun bon en attente de signature.</div></div>
    {% else %}
    <div style="overflow-x:auto;">
    <table class="bs-table" id="bsTable">
        <thead>
            <tr>
                <th style="width:36px;"></th>
                <th>Référence</th>
                <th>Service</th>
                <th>Demandeur</th>
                <th>Établi par</th>
                <th>Créé le</th>
                <th class="text-center" >Statut</th>
                <th style="width:170px;">Action</th>
            </tr>
        </thead>
        <tbody>
        {% for b in bons %}
            {% set rid = 'det-' ~ loop.index %}
            <tr class="bs-row" data-bon-token="{{ b.token }}"
                data-search="{{ (b.reference ~ ' ' ~ b.service ~ ' ' ~ b.demandeur ~ ' ' ~ b.etabliPar)|lower }}">
                <td><button type="button" class="bs-toggle" data-target="{{ rid }}">+</button></td>
                <td class="fw-bold" style="color:var(--cacao-fonce);">{{ b.reference }}</td>
                <td>{{ b.service }}</td>
                <td>{{ b.demandeur }}</td>
                <td>{{ b.etabliPar }}</td>
                <td>{{ b.createdAt ? b.createdAt|date('d/m/Y H:i') : '' }}</td>
                <td class="text-center" style="width: 200px;"><span class="badge-attente statut-bon">En cours de validation</span></td>
                <td>
                    <span class="bon-signature-zone" data-token="{{ b.token }}">
                        <button type="button" class="btn-signer-bon" data-token="{{ b.token }}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;">
                                <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                            </svg>Signer
                        </button>
                    </span>
                </td>
            </tr>
            <tr class="bs-detail" id="{{ rid }}" style="display:none;">
                <td colspan="8">
                    <div style="padding:4px 8px;">
                        <div style="font-weight:600;color:var(--cacao-fonce);margin-bottom:4px;">
                            Articles du bon {{ b.reference }}
                        </div>
                        {% if b.lignes is not empty %}
                        <table>
                            <thead style="background: #e5e4e4;"><tr><th>Code</th><th>Désignation</th><th style="text-align:right;">Quantité</th></tr></thead>
                            <tbody>
                            {% for l in b.lignes %}
                                <tr>
                                    <td>{{ l.code ?? l.code_equipement ?? '' }}</td>
                                    <td>{{ l.designation ?? l.nom ?? l.libelle ?? '' }}</td>
                                    <td style="text-align:right;">{{ l.quantite ?? l.qte ?? '' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        {% else %}
                            <span class="text-muted" style="font-size:12px;">Aucun article détaillé.</span>
                        {% endif %}
                        <div style="font-size:11.5px;color:#999;margin-top:6px;">
                            Créé le {{ b.createdAt ? b.createdAt|date('d/m/Y H:i') : '' }}
                            {% if b.createdBy %} par {{ b.createdBy }}{% endif %}
                        </div>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}
</div>

<script>
(function () {
    // Dépliage des lignes de détail
    document.querySelectorAll('.bs-toggle').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var id = btn.getAttribute('data-target');
            var row = document.getElementById(id);
            if (!row) return;
            var visible = row.style.display !== 'none';
            row.style.display = visible ? 'none' : 'table-row';
            btn.textContent = visible ? '+' : '\u2212';
        });
    });
    // Recherche côté client
    var search = document.getElementById('bsSearch');
    if (search) {
        search.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('#bsTable tbody tr.bs-row').forEach(function (row) {
                var match = row.getAttribute('data-search').indexOf(q) !== -1;
                row.style.display = match ? '' : 'none';
                var det = document.getElementById(row.querySelector('.bs-toggle').getAttribute('data-target'));
                if (det && !match) det.style.display = 'none';
            });
        });
    }
    // Après signature réussie (déclenchée par BonSortie.js), on décrémente le compteur.
    // BonSortie.js remplace la zone .bon-signature-zone par le badge « Validé ».
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-signer-bon');
        if (!btn) return;
        // Observe la zone : quand elle passe en « Validé », on met à jour le compteur.
        var zone = btn.closest('.bon-signature-zone');
        if (!zone) return;
        var obs = new MutationObserver(function () {
            if (zone.textContent.indexOf('Valid\u00e9') !== -1) {
                var c = document.getElementById('bsCompteur');
                if (c) { var n = parseInt(c.textContent, 10) || 0; c.textContent = Math.max(0, n - 1); }
                var tr = zone.closest('tr.bs-row');
                if (tr) { var s = tr.querySelector('.statut-bon'); if (s) { s.textContent = 'Valid\u00e9'; s.className = 'statut-bon'; s.style.color = '#1b5e20'; s.style.fontWeight = '600'; } }
                obs.disconnect();
            }
        });
        obs.observe(zone, { childList: true, subtree: true });
    });
})();
</script>
{% endblock %}
