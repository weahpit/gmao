{% extends 'base.html.twig' %}

{% block title %}Gestion du stock — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Opérations Stock</span>
{% endblock %}

{% block body %}
    <style>
        table tbody td {
            font-size: 11px;
            border-bottom: #7e7d7d 1px solid;
            padding: 2px 2px 2px 10px;
        }
        table thead tr {
            font-size: 13px;
            border-bottom: grey 1px solid;
            position: sticky;
            top: 0;
        }
        .tr-danger {
            background: linear-gradient(45deg, #f6dfdf, #f9c7c7, #fd7171);
            color: #c53030;
            font-size: 14px;
            font-weight: bold;
        }

        .tr-warning {
            background: linear-gradient(45deg, #f2f1ea, #f8eca8, #fce66c);
            color: #110f0f;
            font-size: 14px;
            font-weight: bold;
        }

        .tr-success {
            background-color: #ffffff;
            color: #110f0f;
        }

        .selected {
            background-color: rgb(83, 68, 43);
            color: #FFFFFF;
            font-weight: bold;
            font-size: 16px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
        }
        tbody tr:nth-child(odd) {
            background-color: #f9f9f9; /* lignes impaires */
        }
        tbody tr:nth-child(even) {
            background-color: #e9ecef; /* lignes paires */
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/MvtsStocks/table.css') }}">
    <div class="page-header">
        <h1 class="page-title"><img src="{{ asset('icons/inventory.png') }}" height="32" class="me-2" alt=""> Opérations Journalières sur Mouvements Stock</h1>
        <div class="d-flex">
        </div>
    </div>

    <!-- Table -->
    <div class="" style="border: 1px solid #d2d0d0;background: radial-gradient(rgb(233,233,233), rgba(246,246,246,0.96));border-radius: 0;">
        <div class="card-body" style="border: 1px solid #dedede;">
            <div class="container pb-3">
                <div class="d-flex p-1 text-center" style="background: linear-gradient(165deg, #567e64, #567e64);border: 1px solid #023902;color: white;">
                    <label for="date">Date de l'opération</label>
                    <input type="date" class="input ms-2" id="date_operation" style="width: 150px;">
                    <button type="button" class="btn btn-success ms-2 p-0 fw-light d-flex justify-content-center align-items-center" id="btn-search" style="border: 1px solid lightgrey;border-radius: 0;width: 130px;"><i data-lucide="search" class="search"></i>Afficher</button>
                    <button type="button" class="btn btn-light ms-2 p-0 fw-light d-flex justify-content-center align-items-center gap-1" id="btn-print" title="Imprimer en PDF" style="border: 1px solid lightgrey;border-radius: 0;width: 130px;"><i data-lucide="printer" class="printer"></i>Imprimer</button>
                    <button type="button" class="btn btn-warning ms-2 p-0 fw-light d-flex justify-content-center align-items-center gap-1" id="btn-email" title="Envoyer par email" style="border: 1px solid lightgrey;border-radius: 0;width: 130px;"><i data-lucide="mail" class="mail"></i>Envoyer</button>
                </div>
            </div>
            <div class="mb-2" id="div_operations" >

            </div>
        </div>
    </div>

    <script>let chemin = "{{ asset('data/stock/bons/bl/') }}"</script>

    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/stock/RequetesStock.js') }}"></script>
    <script>

        document.getElementById("date_operation").value = new Date().toISOString().split('T')[0];
        getData()

        $("#btn-search").on('click', function(){
            getData()
        })

        function getData(){
            if (!document.getElementById("date_operation").value) { showToast("Merci de saisir une date Opération valide", {title : 'Movements Stock', duration: 3000, type:"error"})} else {
                let formData = new FormData();
                formData.append('date_operation', document.getElementById("date_operation").value)
                getMouvementsByDate(document.getElementById('div_operations'), formData)
            }
        }

        function dateValide(){
            let d = document.getElementById("date_operation").value;
            if (!d) { showToast("Merci de saisir une date Opération valide", {title:'Opérations Stock', duration: 3000, type:"error"}); return null; }
            return d;
        }

        /* --- Impression PDF : on reçoit un binaire -> blob -> nouvel onglet --- */
        $("#btn-print").on('click', function(){
            let d = dateValide(); if (!d) return;
            let formData = new FormData();
            formData.append('date_operation', d);
            fetch(URL_APP + "api/operations-journalieres/pdf", { method: "POST", body: formData })
                .then(res => { if(!res.ok) throw new Error('HTTP ' + res.status); return res.blob(); })
                .then(blob => {
                    let url = window.URL.createObjectURL(blob);
                    window.open(url, '_blank');
                    setTimeout(() => window.URL.revokeObjectURL(url), 60000);
                })
                .catch(err => showToast("❌ Impression impossible : " + err.message, {title:'Opérations Stock', duration: 4000, type:"error"}));
        });

        /* --- Envoi par email : SweetAlert2 demande l'adresse --- */
        $("#btn-email").on('click', function(){
            let d = dateValide(); if (!d) return;
            Swal.fire({
                title: 'Envoyer par email',
                html: '<p class="mb-2">Opérations du <b>' + d + '</b> (PDF en pièce jointe)</p>' +
                      '<input id="swal-email" class="swal2-input" type="email" placeholder="destinataire@exemple.com">' +
                      '<textarea id="swal-message" class="swal2-textarea" placeholder="Message (optionnel)"></textarea>',
                confirmButtonText: 'Envoyer',
                confirmButtonColor: '#53442b',
                showCancelButton: true,
                cancelButtonText: 'Annuler',
                focusConfirm: false,
                preConfirm: () => {
                    let email = document.getElementById('swal-email').value.trim();
                    if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
                        Swal.showValidationMessage('Adresse email invalide');
                        return false;
                    }
                    return { email: email, message: document.getElementById('swal-message').value.trim() };
                }
            }).then((result) => {
                if (!result.isConfirmed) return;
                let formData = new FormData();
                formData.append('date_operation', d);
                formData.append('destinataire', result.value.email);
                formData.append('message', result.value.message);
                Swal.showLoading();
                fetch(URL_APP + "api/operations-journalieres/email", { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        showToast(data.msg, { type: data.code, duration: 4000, title: 'Opérations Stock' });
                        Swal.close();
                    })
                    .catch(err => { showToast("❌ Envoi impossible : " + err, {title:'Opérations Stock', duration: 4000, type:"error"}); Swal.close(); });
            });
        });
    </script>
{% endblock %}
