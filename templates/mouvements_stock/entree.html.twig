    <script src="{{ asset('js/api/references/EquipementType.js') }}"></script>
    <script src="{{ asset('js/api/references/NatureEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/EtatEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/TypeEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/ZoneExploitation.js') }}"></script>
    <script src="{{ asset('js/api/references/TypeEq.js') }}"></script>
    <script src="{{ asset('js/api/references/FamilleEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/CriticiteEquipement.js') }}"></script>
    <script src="{{ asset('js/api/references/Emplacement.js') }}"></script>
    <script src="{{ asset('js/api/references/TypeEmplacement.js') }}"></script>

    <script>
        let type_ajout = 0
        let code = document.getElementById('CodeEquipement');
        let eqType = document.getElementById('eqType');
        let nom = document.getElementById('nomEquipement');
        let famille = document.getElementById('famille');
        let categorie = document.getElementById('categorie');
       /* let nature = document.getElementById('nature');*/
        let type_eq = document.getElementById('type_eq');
        let seuil = document.getElementById('seuil');
        let criticite = document.getElementById('criticite');

        let fournisseur = document.getElementById('fournisseur');
        let marque = document.getElementById('marque');
        let modele = document.getElementById('modele');

        getValues()

        function getValues(){
            getAllFournisseurs(document.getElementById('fournisseur'), 2)
            getAllMarques(document.getElementById('marque'), 2)
            /*getAllNatureEquipement(document.getElementById('nature'), 2)*/
            getAllEquipementTypes(document.getElementById('eqType'), 2)
            getAllTypeEq(document.getElementById("type_eq"), 2)
            getAllTypeEquipements(document.getElementById("categorie"), 2)
            getAllCriticiteEquipement(document.getElementById("criticite"), 2)
            getAllFamilles(document.getElementById("famille"), 2)
        }
        getArticlesFromStock(document.getElementById("div_entree"), 1, "1")



        uploadImage(document.getElementById('eqUpload'), document.getElementById('eqPreview'));



        document.getElementById("famille").addEventListener('change', ()=>{
            let value = document.getElementById("famille").value;
            getTypeEquipementByFamille(document.getElementById("categorie"),2, value)
            getCode()
        })

        document.getElementById("categorie").addEventListener('change', ()=>{
            getCode()
        })

        document.getElementById("btn_add_eq").addEventListener('click', ()=>{
            document.getElementById('nomError').innerText = ""
            toggleArticlesMode()
            getValues()
        })

        document.addEventListener('change', function(e){

            if(e.target.classList.contains('chk_input')){

                e.target.closest('tr')
                    .classList.toggle(
                    'selected',
                    e.target.checked
                );
            }
        });

        document.querySelectorAll('.input').forEach(element => {
            element.addEventListener('change', function () {
                ActiveOuDescativeReferences()
            });
        });

        document.getElementById("nomEquipement").addEventListener('change', ()=>{
            let formDataDoublon = new FormData();
            formDataDoublon.append('nom', document.getElementById("nomEquipement").value)
            RechercheDoublonArticle(formDataDoublon, document.getElementById('nomError'))
        })

        document.getElementById("saveEquipement").addEventListener('click', ()=>{
            let eqUpload = document.getElementById("eqUpload").files;

            let formDataEquipement = new FormData();
            formDataEquipement.append('type_ajout', type_ajout)
            formDataEquipement.append('selectEq', eqType.value)
            formDataEquipement.append('code', code.value)
            formDataEquipement.append('nom', nom.value)
            formDataEquipement.append('categorie', categorie.value)
            formDataEquipement.append('criticite', criticite.value)
           /* formDataEquipement.append('nature', nature)*/
            formDataEquipement.append('type_eq', type_eq.value)
            formDataEquipement.append('seuil', seuil.value)
            formDataEquipement.append('fournisseur', fournisseur.value)
            formDataEquipement.append('marque', marque.value)
            formDataEquipement.append('modele', modele.value)

            formDataEquipement.append("photo", eqUpload[0]);
            saveEquipementWithReference(formDataEquipement)
        })

        const addArticleRadio = document.getElementById('add-article');
        const selectArticleRadio = document.getElementById('select-article');

        const addBlock = document.getElementById('bloc-add-article');
        const selectBlock = document.getElementById('bloc-select-article');

        addArticleRadio.checked = true;


        function toggleArticlesMode(){
            if (addArticleRadio.checked) {
                addBlock.style.display = 'block';
                selectBlock.style.display = 'none';
                clearForm("formEquipementType", "nomEquipement")
                seuil.value = 0;
                type_ajout = 1
            }

            if (selectArticleRadio.checked) {
                addBlock.style.display = 'none';
                selectBlock.style.display = 'block';
                clearForm("formReference", "fournisseur")
                type_ajout = 2
            }
        }

        addArticleRadio.addEventListener('change', toggleArticlesMode);
        selectArticleRadio.addEventListener('change', toggleArticlesMode);



        function getCode(){
            document.getElementById('CodeEquipement').value = "";
            if (
                document.getElementById('famille').value !== "0"  ||
                document.getElementById('famille').value !== ""  ||
                document.getElementById('categorie').value !== "0"  ||
                document.getElementById('categorie').value !== ""
            ){
                let formData = new FormData

                formData.append('code_famille_', document.getElementById('famille').value)
                formData.append('code_categorie_', document.getElementById('categorie').value)

                //alert(document.getElementById('famille').value)

                getCodeArticle(formData, document.getElementById('CodeEquipement'));
            }

        }

        function ActiveOuDescativeReferences(){
            if (
                code.value &&
                nom.value &&
                categorie.value &&
                categorie.value !== "0" &&
                famille.value &&
                famille.value !== "0" &&
               /* nature.value &&*/
               /* nature.value !== "0" &&*/
                type_eq.value
            ){
                activeReference()
            }  else if (eqType.value !== "0" && eqType.value ) {
                activeReference()
            } else {
                desactiveReference()
            }
        }

        function activeReference(){
            fournisseur.style.backgroundColor = "#ffffff"
            marque.style.backgroundColor = "#ffffff"
            modele.style.backgroundColor = "#ffffff"
            fournisseur.disabled = false;
            marque.disabled = false;
            modele.disabled = false;
        }

        function desactiveReference(){
            fournisseur.style.backgroundColor = "#f4fdf9"
            marque.style.backgroundColor = "#f4fdf9"
            modele.style.backgroundColor = "#f4fdf9"
            fournisseur.disabled = true;
            marque.disabled = true;
            modele.disabled = true;
        }


        /* Enregistrement Fournisseur */
        let idFournisseur = "0";
        clearForm("formFournisseur", "CodeFournisseur")
        ValidateOnKeypress(document.querySelector("#CodeFournisseur"), document.querySelector("#saveFournisseur"),"formFournisseur")

        document.querySelector("#saveFournisseur").addEventListener("click", function () {
            let agree = "0";
            let FormDataFournisseur = new FormData();
            FormDataFournisseur.append('id_fournisseur', idFournisseur)
            FormDataFournisseur.append('code_fournisseur', document.querySelector("#CodeFournisseur").value)
            FormDataFournisseur.append('rs_fournisseur', document.querySelector("#rsFournisseur").value)
            FormDataFournisseur.append('sigle_fournisseur', document.querySelector("#sigleFournisseur").value)
            FormDataFournisseur.append('email_fournisseur', document.querySelector("#emailFournisseur").value)
            FormDataFournisseur.append('site_fournisseur', document.querySelector("#siteFournisseur").value)
            FormDataFournisseur.append('tel_fournisseur', document.querySelector("#telFournisseur").value)
            FormDataFournisseur.append('mobile_fournisseur', document.querySelector("#mobileFournisseur").value)
            FormDataFournisseur.append('adresse_fournisseur', document.querySelector("#adresseFournisseur").value)
            FormDataFournisseur.append('bp_fournisseur', document.querySelector("#bpFournisseur").value)
            FormDataFournisseur.append('rccim_fournisseur', document.querySelector("#rccimFournisseur").value)
            FormDataFournisseur.append('cc_fournisseur', document.querySelector("#ccFournisseur").value)
            FormDataFournisseur.append('nom_contact_fournisseur', document.querySelector("#nomContactFournisseur").value)
            FormDataFournisseur.append('mobile_contact_fournisseur', document.querySelector("#mobileContactFournisseur").value)
            FormDataFournisseur.append('notes_fournisseur', document.querySelector("#notesFournisseur").value)

            if (document.querySelector("#btn-check-agree").checked === true) { agree = "1";}
            FormDataFournisseur.append('agree_fournisseur', agree)

            saveFournisseur(FormDataFournisseur, document.querySelector(".div_fournisseur"), 1)
        })


        /* Enregistrement Marques */
        let idMarque = 0;
        clearForm("formMarque", "libelle_marque")
        ValidateOnKeypress(document.getElementById("libelle_marque"), document.getElementById("saveMarque"), "formMarque")
        document.querySelector("#saveMarque").addEventListener("click", function () {
            let FormDataMarque = new FormData();
            FormDataMarque.append('id_marque', idMarque)
            FormDataMarque.append('marque', document.querySelector("#libelle_marque").value)
            saveMarque(FormDataMarque, document.querySelector(".card-body"), 1)
        })




        let idType = 0;

        getAllFamilles(document.querySelector("#code_famille"), 2)
        clearForm("formType", "typeEquipement")

        ValidateOnKeypress(document.querySelector("#typeEquipement"), document.querySelector("#saveType"),"formType")
        ValidateOnKeypress(document.querySelector("#code_famille"), document.querySelector("#saveType"),"formType")

        /* Enregistrement Catégories Equipements */
        document.querySelector("#saveType").addEventListener("click", function () {
            let FormDataType = new FormData();
            FormDataType.append('id_type', idType)
            FormDataType.append('type_equipement', document.querySelector("#typeEquipement").value)
            FormDataType.append('initial', document.querySelector("#initial").value)
            FormDataType.append('code_famille', document.querySelector("#code_famille").value)
            saveTypeEquipement(FormDataType, document.querySelector(".card-body"), 1)
        })

        /*Familles Equipements*/
        let idFamille = 0;
        clearForm("formFamille", "famille")

        ValidateOnKeypress(document.getElementById("famille"), document.getElementById("saveFamille"),"formFamille",)
        document.querySelector("#btn_add_mrq").addEventListener("click", function () {
            clearForm("formFamille", "famille")
        })

        document.querySelector("#saveFamille").addEventListener("click", function () {
            let FormDataFamille = new FormData();
            FormDataFamille.append('id_famille', idFamille)
            FormDataFamille.append('famille', document.querySelector("#familleEq").value)
            FormDataFamille.append('initial', document.querySelector("#initialFamille").value)
            saveFamille(FormDataFamille, document.querySelector(".card-body"), 1)
        })


        /*Emplacements Equipements*/
        let idEmplacement = "0";

        getAllTypeEmplacements (document.querySelector("#type_emplacement"), 2)
        getAllZonesExploitation(document.querySelector("#zone"), 2)
        clearForm("formEmplacement", "emplacement")
        ValidateOnKeypress(document.getElementById("emplacement"), document.getElementById("saveEmplacement"), "formEmplacement")

        document.querySelector("#saveEmplacement").addEventListener("click", function () {
            let FormDataEmplacement = new FormData();
            FormDataEmplacement.append('id_emplacement', idEmplacement)
            FormDataEmplacement.append('emplacement', document.querySelector("#emplacement").value)
            FormDataEmplacement.append('zone', document.querySelector("#zone").value)
            FormDataEmplacement.append('type_emplacement', document.querySelector("#type_emplacement").value)
            saveEmplacement(FormDataEmplacement, document.querySelector(".card-body"), 1)
        })

        let idTypeEmplacement = "0";
        clearForm("formTypeEmplacement", "type_emp")
        ValidateOnKeypress(document.getElementById("type_emp"), document.getElementById("saveTypeEmplacement"), "formTypeEmplacement")

        document.querySelector("#saveTypeEmplacement").addEventListener("click", function () {
            let FormDataTypeEmplacement = new FormData();
            FormDataTypeEmplacement.append('id_type_emplacement', idTypeEmplacement)
            FormDataTypeEmplacement.append('type_emplacement', document.querySelector("#type_emp").value)
            saveTypeEmplacement(FormDataTypeEmplacement, document.querySelector(".card-body"), 1)
        })


        // Events on li button
    </script>



