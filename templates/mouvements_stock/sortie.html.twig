{% extends 'base.html.twig' %}

{% block title %}Gestion du stock — CITRAC GMAO{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-item">Opérations de Sortie</span>
{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('css/MvtsStocks/table.css') }}">

    <div class="page-header">
        <h1 class="page-title"><img src="{{ asset('images/arrow.png') }}" height="32" class="me-2" alt="">Opérations de Sortie</h1>
        <div class="d-flex">
        </div>
    </div>

    <!-- Table -->
    <div class="" style="border: 1px solid #d2d0d0;background: radial-gradient(rgb(233,233,233), rgba(246,246,246,0.96));border-radius: 0;">
        <div class="table-responsive" id="div_entree" style="border: 1px solid #dedede;">

        </div>
    </div>

    <div class="modal fade" id="confirmStockModal"
         tabindex="-1"
         aria-labelledby="confirmStockModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="confirmStockModalLabel">
                        <i class="fas fa-check-circle text-primary"></i>
                        Confirmation de l'opération
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-3">
                        Vous êtes sur le point de valider les mouvements suivants :
                    </p>

                    <div id="confirmStockContent"></div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Annuler

                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnConfirmStock">

                        <i class="fas fa-save"></i>
                        Confirmer

                    </button>

                </div>

            </div>

        </div>

    </div>

    <script src="{{ asset('js/external/jquery.js') }}"></script>
    <script src="{{ asset('js/tools/functions.js') }}"></script>
    <script src="{{ asset('js/tools/showToast.js') }}"></script>
    <script src="{{ asset('js/api/stock/MouvementsStock.js') }}"></script>
    <script src="{{ asset('js/api/admin/Service.js') }}"></script>

    <script>
        getArticlesFromStock(document.getElementById("div_entree"), 1, "2")

        document.addEventListener('change', function(e){

            if(e.target.classList.contains('chk_input')){

                e.target.closest('tr')
                    .classList.toggle(
                    'selected',
                    e.target.checked
                );
            }
        });

        function showStockConfirmation(articles, callback){

            let html = `
        <table class="table table-striped align-middle">

            <thead>
                <tr>
                    <th>Article</th>
                    <th>Quantité</th>
                    <th>Mention</th>
                </tr>
            </thead>

            <tbody>
    `;

            articles.forEach(article => {

                html += `
            <tr>

                <td>${article.article_nom}</td>

                <td>
                    <span class="badge bg-primary">
                        ${article.quantite}
                    </span>
                </td>

                <td>
                    ${article.mention || '-'}
                </td>

            </tr>
        `;
            });

            html += `
            </tbody>

        </table>
    `;

            $('#confirmStockContent').html(html);

            const modal = new bootstrap.Modal(
                document.getElementById('confirmStockModal')
            );

            modal.show();

            $('#btnConfirmStock')
                .off('click')
                .on('click', function(){

                    modal.hide();

                    callback();
                });
        }
    </script>
{% endblock %}
